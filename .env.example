# Supabase project configuration

VITE_SUPABASE_URL=<SUBSTITUTE_SUPABASE_URL>
VITE_SUPABASE_PUBLISHABLE_OR_ANON_KEY=<SUBSTITUTE_SUPABASE_PUBLISHABLE_KEY>

# Main site URL (e.g. marketing site where legal pages live). Used for Terms and Privacy links.
VITE_MAIN_SITE_URL=http://localhost:3000

# Google OAuth client secret
VITE_SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=<SUBSTITUTE_SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID>
VITE_SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=<SUBSTITUTE_SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET>

# Resend (for Supabase local auth emails when using smtp in config.toml). Export before `supabase start` or set in env.
RESEND_API_KEY=re_xxxx
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Orbit