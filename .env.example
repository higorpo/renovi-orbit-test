# Supabase project configuration

VITE_SUPABASE_URL=<SUBSTITUTE_SUPABASE_URL>
VITE_SUPABASE_PUBLISHABLE_OR_ANON_KEY=<SUBSTITUTE_SUPABASE_PUBLISHABLE_KEY>

# Main site URL (e.g. marketing site where legal pages live). Used for Terms and Privacy links.
VITE_MAIN_SITE_URL=http://localhost:3000

# Google reCAPTCHA v3 (frontend public key)
# Example format: 6LcXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_RECAPTCHA_SITE_KEY=<SUBSTITUTE_RECAPTCHA_SITE_KEY>

# Google OAuth client secret
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=<SUBSTITUTE_SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID>
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=<SUBSTITUTE_SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET>

# Resend (for Supabase local auth emails when using smtp in config.toml). Export before `supabase start` or set in env.
RESEND_API_KEY=re_xxxx
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Orbit

# Progressive Web App (manifest + service worker). Set to "true" to enable at build time.
# Required for web/PWA push (FCM uses the same service worker as the PWA).
# VITE_ENABLE_PWA=true

# Firebase Cloud Messaging (web/PWA). Create a Web app in Firebase Console and copy values.
# VAPID key: Firebase Console → Project settings → Cloud Messaging → Web Push certificates.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=orbit-c98b6.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=orbit-c98b6
VITE_FIREBASE_MESSAGING_SENDER_ID=451707949870
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# React Query cache behavior. Set to "true" to disable cache persistence and force fresh refetching.
# VITE_DISABLE_REACT_QUERY_CACHE=true

# Sentry (frontend errors and performance). Optional; leave empty to disable.
VITE_SENTRY_DSN=

# ClearSale Behavior Analytics (checkout card step). Non-secret AppKey from ClearSale portal.
# Sandbox AppKey ≠ production AppKey. Safe in browser bundle (identifies app only).
# VITE_CLEARSALE_APP_KEY=

# SUPABASE_SERVICE_ROLE_KEY=<your-service-role-secret>

# --- Internal pg_net → Edge Functions (docs/internal-edge-functions-auth.md) ---
# Postgres Vault ([db.vault] in supabase/config.toml) — RPC HMAC + pg_cron → EF invoke.
# Production: Supabase Dashboard → Vault only — never commit real values.
ORBIT_SUPABASE_URL=http://127.0.0.1:54321
ORBIT_CRON_SECRET=local-dev-orbit-cron-secret-min-32-chars
PRICING_SIGNATURE_SECRET=renovi-provider-pricing-secret-v1
INSTALLMENT_SIGNING_SECRET=renovi-installment-signing-secret-v1

# Payment pg_cron → Edge (production Vault only; optional local override via SQL/GUC):
# payment_supabase_url, payment_service_role_key — see docs/payment-system/vault-secrets-runbook.md

# Payment Edge Functions — NetCred secrets live in supabase/functions/.env (local) or
# Dashboard → Edge Functions → Secrets (prod). Do NOT put NETCRED_* in this root file.
# See docs/payment-system/vault-secrets-runbook.md
# NETCRED_USERNAME=
# NETCRED_PASSWORD=
# NETCRED_WEBHOOK_SECRET=
# NETCRED_API_BASE_URL=https://api.sandbox.netcredbrasil.com.br
# NETCRED_PLATFORM_BANK_ACCOUNT_ID=
# NETCRED_PLATFORM_COMPANY_ID=

# Sentry build plugin (source map upload). Only needed in CI for release builds.
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# SENTRY_AUTH_TOKEN=your-auth-token