+    assertEquals(result.ok, true);
+    if (result.ok) {
+      assertEquals(result.vendorMessageId, "email_abc123");
+      assertEquals(result.httpStatus, 200);
+    }
+  } finally {
+    Deno.env.delete("RESEND_API_KEY");
+    Deno.env.delete("RESEND_FROM_EMAIL");
+  }
