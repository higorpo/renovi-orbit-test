+      html: "<p>Welcome</p>",
+      correlationId: "corr-1",
+    });
+    assertEquals(payload.to, ["checkout@renovi.com.br"]);
+  } finally {
+    Deno.env.delete("RESEND_FROM_EMAIL");
+  }
+});
