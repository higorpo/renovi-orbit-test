+
+    const body = JSON.parse(init.body as string);
+    assertEquals(body.to, ["user@test.com"]);
+    assertEquals(body.subject, "Hi");
+  } finally {
+    Deno.env.delete("RESEND_FROM_EMAIL");
+    Deno.env.delete("RESEND_FROM_NAME");
