+describe("database.types message_dispatcher schema (task 111)", () => {
+  it("exports MMD tables and RPCs from generated Database type", () => {
+    const _tables: MmdTables[] = REQUIRED_TABLES;
+    const _rpcs: MmdRpcs[] = REQUIRED_RPCS;
