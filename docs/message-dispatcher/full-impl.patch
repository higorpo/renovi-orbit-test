+  "message_dispatches",
+  "message_dispatch_deliveries",
+  "message_dispatcher_audit",
+  "message_dispatcher_stats",
+  "message_dispatcher_user_limits",
+  "message_dispatcher_vendor_events",
+  "message_templates",
