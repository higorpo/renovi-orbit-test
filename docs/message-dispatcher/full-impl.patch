index 0000000..d8fdf98
--- /dev/null
+++ b/supabase/scripts/mmd-rollout-phase1-disable-worker.sql
@@ -0,0 +1,20 @@
+-- Phase 1 rollout: disable pg_net worker invoke (task 119, design §13.1).
+-- Safe to re-run. Phase 2 re-enables via migration 00300 schedule or manual cron.schedule.
+
+do $cron$
+declare
+  v_jobid integer;
+begin
+  select j.jobid
+  into v_jobid
+  from cron.job j
+  where j.jobname = 'mmd_invoke_worker';
+
+  if v_jobid is not null then
+    perform cron.unschedule(v_jobid);
+    raise notice 'Unscheduled mmd_invoke_worker (jobid=%)', v_jobid;
+  else
+    raise notice 'mmd_invoke_worker not scheduled — already disabled';
+  end if;
+end;
+$cron$;
