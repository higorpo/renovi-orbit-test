+import { useQuery } from "@tanstack/react-query";
+import { fetchAuditTimeline } from "../api/auditTimeline.api";
+
+const AUDIT_STALE_MS = 30_000;
+
+export function useAuditTimeline(dispatchId: string | null | undefined) {
+  return useQuery({
+    queryKey: ["message-dispatcher", "audit-timeline", dispatchId],
+    queryFn: async () => {
+      const { entries, error } = await fetchAuditTimeline(dispatchId!);
+      if (error) {
+        throw new Error(error);
+      }
+      return entries;
+    },
+    enabled: Boolean(dispatchId),
+    staleTime: AUDIT_STALE_MS,
+  });
+}
diff --git a/src/features/notifications/hooks/useCancelDispatch.ts b/src/features/notifications/hooks/useCancelDispatch.ts
new file mode 100644
index 0000000..a474a70
--- /dev/null
+++ b/src/features/notifications/hooks/useCancelDispatch.ts
@@ -0,0 +1,28 @@
+import { useCallback, useState } from "react";
+import { cancelDispatch } from "../api/dispatchCancel.api";
+import type { CancelDispatchResult } from "../types/notifications.types";
+
+export function useCancelDispatch() {
+  const [isPending, setIsPending] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+
+  const cancel = useCallback(
+    async (
+      dispatchId: string,
+      reason?: string,
+    ): Promise<CancelDispatchResult | null> => {
+      setIsPending(true);
+      setError(null);
+      const { result, error: apiError } = await cancelDispatch({ dispatchId, reason });
+      setIsPending(false);
+      if (apiError) {
+        setError(apiError);
+        return null;
+      }
+      return result;
+    },
+    [],
+  );
+
+  return { cancel, isPending, error };
+}
