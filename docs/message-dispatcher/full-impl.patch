+-- Phase 1 smoke (task 119). Run as service_role / superuser after migrations.
+-- Uses source_system = mmd_smoke_test only.
+
+\set ON_ERROR_STOP on
+
+select 'ingest_smoke' as step,
+  message_dispatcher.message_dispatcher_ingest(
+    gen_random_uuid(),
+    (select id from public.profiles limit 1),
+    'email'::message_dispatcher.message_channel,
+    'welcome_template',
+    '{"name":"Smoke"}'::jsonb,
+    now(),
+    'mmd_smoke_test',
+    '{}'::jsonb
+  ) as ingest_result;
+
+-- Future SCHEDULED must not checkout
+with ins as (
+  insert into message_dispatcher.message_dispatches (
+    idempotency_key,
+    profile_id,
+    channel,
+    template_key,
+    status,
+    scheduled_for
+  )
+  select
+    gen_random_uuid(),
+    (select id from public.profiles limit 1),
+    'email'::message_dispatcher.message_channel,
+    'welcome_template',
+    'SCHEDULED'::message_dispatcher.message_dispatch_status,
+    now() + interval '1 day'
+  returning id
+)
+select 'scheduled_not_in_checkout' as step,
+  (select count(*) from message_dispatcher.message_dispatcher_checkout_batch(10) c
+   where (c->>'id')::uuid in (select id from ins)) as checked_out_count;
+
+select 'activate_scheduled' as step,
+  message_dispatcher.message_dispatcher_activate_scheduled() as activated;
+
+select 'reclaim_leases' as step,
+  message_dispatcher.message_dispatcher_reclaim_leases() as reclaimed;
