+++ b/supabase/tests/payment/accept_proposal_rpc_test.sql
@@ -0,0 +1,275 @@
+-- pgTAP: accept_proposal_rpc idempotency and emergency scheduling (task 18).
+
+begin;
+
+select plan(6);
+
+select ok(
+  (
+    select p.prosecdef
+    from pg_proc p
+    join pg_namespace n on n.oid = p.pronamespace
+    where n.nspname = 'public'
+      and p.proname = 'accept_proposal_rpc'
+  ),
+  'accept_proposal_rpc is SECURITY DEFINER'
+);
+
+do $seed$
+declare
+  v_client_id uuid := gen_random_uuid();
+  v_provider_id uuid := gen_random_uuid();
+  v_sr_id uuid := gen_random_uuid();
+  v_proposal_id uuid := gen_random_uuid();
+  v_token_id uuid := gen_random_uuid();
+  v_provider_gateway_id uuid;
+  v_idempotency_key uuid := gen_random_uuid();
+begin
+  perform set_config('test.accept_client_id', v_client_id::text, true);
+  perform set_config('test.accept_provider_id', v_provider_id::text, true);
+  perform set_config('test.accept_proposal_id', v_proposal_id::text, true);
+  perform set_config('test.accept_token_id', v_token_id::text, true);
+  perform set_config('test.accept_idempotency_key', v_idempotency_key::text, true);
+
+  insert into auth.users (
+    instance_id, id, aud, role, email, encrypted_password, email_confirmed_at,
+    raw_app_meta_data, raw_user_meta_data, created_at, updated_at,
+    confirmation_token, email_change, email_change_token_new, recovery_token
+  )
+  values
+    (
+      '00000000-0000-0000-0000-000000000000', v_client_id, 'authenticated', 'authenticated',
+      v_client_id::text || '@accept-rpc-client.local', crypt('Abc123', gen_salt('bf')), now(),
+      '{"provider":"email"}'::jsonb, '{}'::jsonb, now(), now(), '', '', '', ''
+    ),
+    (
+      '00000000-0000-0000-0000-000000000000', v_provider_id, 'authenticated', 'authenticated',
+      v_provider_id::text || '@accept-rpc-provider.local', crypt('Abc123', gen_salt('bf')), now(),
+      '{"provider":"email"}'::jsonb, '{}'::jsonb, now(), now(), '', '', '', ''
+    );
+
+  insert into public.profiles (id, role, full_name)
+  values
+    (v_client_id, 'client', 'Accept RPC client'),
+    (v_provider_id, 'provider', 'Accept RPC provider');
+
+  insert into public.service_requests (
+    id, client_id, service_id, address_id, title, description, form_data, form_version, status, urgency
+  )
+  select
+    v_sr_id,
+    v_client_id,
+    sr.service_id,
+    sr.address_id,
+    'accept rpc fixture',
+    sr.description,
+    sr.form_data,
+    sr.form_version,
+    'OPEN'::public.service_request_status,
+    sr.urgency
+  from public.service_requests sr
+  limit 1;
+
+  insert into public.provider_proposals (
+    id,
+    provider_id,
+    service_request_id,
+    proposed_amount,
+    proposal_description,
+    proposal_duration_value,
+    proposal_duration_unit,
+    proposal_suggested_slots,
+    photos,
+    tax_rate,
+    tax_amount,
+    final_amount,
+    pricing_signature,
+    status,
+    selected_slot
+  )
+  values (
+    v_proposal_id,
+    v_provider_id,
+    v_sr_id,
+    500.00,
+    'Accept RPC fixture proposal',
+    2,
+    'hours',
+    jsonb_build_array(
+      jsonb_build_object('start_date', to_char(current_date + 1, 'YYYY-MM-DD'), 'shift', 'morning')
+    ),
+    '{}',
+    0.15,
+    75.00,
+    425.00,
+    'test-signature',
+    'ACCEPTED'::public.proposal_status,
+    jsonb_build_object('start_date', to_char(current_date + 1, 'YYYY-MM-DD'), 'shift', 'morning')
+  );
+
+  select pp.id
+  into v_provider_gateway_id
+  from public.payment_providers pp
+  where pp.slug = 'netcred'
+  limit 1;
+
+  insert into public.payment_tokens (
+    id,
+    client_id,
+    provider_id,
+    gateway_payment_profile_id,
+    card_number_masked,
+    card_brand,
+    gateway_card_token,
+    expiry_month,
+    expiry_year,
+    cardholder_name,
+    billing_address
+  )
+  values (
+    v_token_id,
+    v_client_id,
+    v_provider_gateway_id,
+    'accept-rpc-profile',
+    '497010XXXXXX0048',
+    'VCC',
+    'tok_accept_rpc',
+    12,
+    2030,
+    'Client',
+    '{"street":"Rua A","number":"1","district":"Centro","city":"SP","state":"SP","zipCode":"01001000"}'::jsonb
+  );
+end;
+$seed$;
+
+select ok(
+  (
+    select r.is_idempotent = false
+    from public.accept_proposal_rpc(
+      current_setting('test.accept_proposal_id')::uuid,
+      current_setting('test.accept_client_id')::uuid,
+      current_setting('test.accept_provider_id')::uuid,
+      'netcred',
+      current_setting('test.accept_token_id')::uuid,
+      1::smallint,
+      500.00,
+      now() + interval '7 days',
+      'clearsale-session',
+      '127.0.0.1',
+      current_setting('test.accept_client_id')::uuid,
+      current_setting('test.accept_idempotency_key')::uuid
+    ) r
+    limit 1
+  ),
+  'first accept_proposal_rpc call succeeds (non-idempotent)'
+);
+
+select ok(
+  (
+    select r.is_idempotent = true
+    from public.accept_proposal_rpc(
+      current_setting('test.accept_proposal_id')::uuid,
+      current_setting('test.accept_client_id')::uuid,
+      current_setting('test.accept_provider_id')::uuid,
+      'netcred',
+      current_setting('test.accept_token_id')::uuid,
+      1::smallint,
+      500.00,
+      now() + interval '7 days',
+      'clearsale-session',
+      '127.0.0.1',
+      current_setting('test.accept_client_id')::uuid,
+      current_setting('test.accept_idempotency_key')::uuid
+    ) r
+    limit 1
+  ),
+  'retry with same idempotency key returns cached response'
+);
+
+select throws_ok(
+  format(
+    $sql$
+    select * from public.accept_proposal_rpc(
+      %L::uuid, %L::uuid, %L::uuid, 'netcred', %L::uuid,
+      1::smallint, 999.00, now() + interval '7 days',
+      'clearsale-session', '127.0.0.1', %L::uuid, %L::uuid
+    )
+    $sql$,
+    current_setting('test.accept_proposal_id'),
+    current_setting('test.accept_client_id'),
+    current_setting('test.accept_provider_id'),
+    current_setting('test.accept_token_id'),
+    current_setting('test.accept_client_id'),
+    current_setting('test.accept_idempotency_key')
+  ),
+  'P0001',
+  'IDEMPOTENCY_CONFLICT',
+  'hash mismatch on same idempotency key raises IDEMPOTENCY_CONFLICT'
+);
+
+select ok(
+  (
+    select ps.charge_scheduled_at >= (now() + interval '7 days' - interval '2 days' - interval '1 minute')
+      and ps.charge_scheduled_at <= (now() + interval '7 days' - interval '2 days' + interval '1 minute')
+    from public.payment_schedules ps
+    join public.contracted_services cs on cs.id = ps.contracted_service_id
+    where cs.accepted_proposal_id = current_setting('test.accept_proposal_id')::uuid
+  ),
+  'standard scheduling sets charge_scheduled_at to service_scheduled_at - 2 days'
+);
+
+do $emergency$
+declare
+  v_client_id uuid := current_setting('test.accept_client_id')::uuid;
+  v_provider_id uuid := current_setting('test.accept_provider_id')::uuid;
+  v_sr_id uuid := gen_random_uuid();
+  v_proposal_id uuid := gen_random_uuid();
+  v_schedule_id uuid;
+begin
+  insert into public.service_requests (
+    id, client_id, service_id, address_id, title, description, form_data, form_version, status, urgency
+  )
+  select
+    v_sr_id, v_client_id, sr.service_id, sr.address_id,
+    'accept rpc emergency fixture', sr.description, sr.form_data, sr.form_version,
+    'OPEN'::public.service_request_status, sr.urgency
+  from public.service_requests sr
+  limit 1;
+
+  insert into public.provider_proposals (
+    id, provider_id, service_request_id, proposed_amount, proposal_description,
+    proposal_duration_value, proposal_duration_unit, proposal_suggested_slots,
+    photos, tax_rate, tax_amount, final_amount, pricing_signature, status, selected_slot
+  )
+  values (
+    v_proposal_id, v_provider_id, v_sr_id, 300.00, 'Emergency accept RPC',
+    1, 'hours',
+    jsonb_build_array(jsonb_build_object('start_date', to_char(current_date, 'YYYY-MM-DD'), 'shift', 'morning')),
+    '{}', 0.15, 45.00, 255.00, 'sig-emergency', 'ACCEPTED'::public.proposal_status,
+    jsonb_build_object('start_date', to_char(current_date, 'YYYY-MM-DD'), 'shift', 'morning')
+  );
+
+  select r.schedule_id
+  into v_schedule_id
+  from public.accept_proposal_rpc(
+    v_proposal_id, v_client_id, v_provider_id, 'netcred',
+    current_setting('test.accept_token_id')::uuid,
+    1::smallint, 300.00, now() + interval '12 hours',
+    'cs-emergency', '127.0.0.1', v_client_id, gen_random_uuid()
+  ) r;
+
+  perform set_config('test.emergency_schedule_id', v_schedule_id::text, true);
+end;
+$emergency$;
+
+select ok(
+  (
+    select ps.charge_scheduled_at <= now() + interval '5 seconds'
+    from public.payment_schedules ps
+    where ps.id = current_setting('test.emergency_schedule_id')::uuid
+  ),
+  'emergency scheduling (<48h) sets charge_scheduled_at to now()'
+);
+
+select * from finish();
+rollback;
