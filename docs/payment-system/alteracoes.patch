--- /dev/null
+++ b/supabase/migrations/20260705210300_rpc_webhook_refund_void_dispute.sql
@@ -0,0 +1,302 @@
+-- Payment System — task 47: refund, void, and dispute webhook RPCs.
+
+alter table public.payment_schedules
+  add column if not exists voided_at timestamptz;
+
+comment on column public.payment_schedules.voided_at is
+  'When CHARGE_VOID/TRANSACTION_VOID webhook confirmed void at gateway.';
+
+create or replace function public.webhook_transaction_refund_rpc(
+  p_reference_code uuid,
+  p_webhook_event_id text,
+  p_refunded_amount numeric(12, 2)
+)
+returns jsonb
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_schedule public.payment_schedules%rowtype;
+  v_from_state text;
+  v_to_state text;
+begin
+  if p_refunded_amount is null or p_refunded_amount <= 0 then
+    raise exception 'INVALID_REFUND_AMOUNT' using errcode = 'P0001';
+  end if;
+
+  select ps.*
+  into v_schedule
+  from public.payment_schedules ps
+  where ps.contracted_service_id = p_reference_code
+  for update;
+
+  if not found then
+    return jsonb_build_object('outcome', 'not_found');
+  end if;
+
+  v_from_state := v_schedule.state;
+
+  if v_schedule.state in ('REFUNDED', 'PARTIALLY_REFUNDED') then
+    return jsonb_build_object(
+      'outcome', 'already_terminal',
+      'schedule_id', v_schedule.id,
+      'service_id', v_schedule.contracted_service_id,
+      'from_state', v_from_state,
+      'to_state', v_schedule.state,
+      'refunded_amount', v_schedule.refunded_amount
+    );
+  end if;
+
+  if v_schedule.state <> 'REFUND_REQUESTED' then
+    return jsonb_build_object(
+      'outcome', 'skipped',
+      'reason', 'invalid_transition',
+      'schedule_id', v_schedule.id,
+      'service_id', v_schedule.contracted_service_id,
+      'from_state', v_from_state
+    );
+  end if;
+
+  v_to_state := case
+    when v_schedule.paid_amount is not null
+      and p_refunded_amount < v_schedule.paid_amount then 'PARTIALLY_REFUNDED'
+    else 'REFUNDED'
+  end;
+
+  update public.payment_schedules ps
+  set
+    state = v_to_state,
+    refunded_amount = p_refunded_amount,
+    refunded_at = coalesce(ps.refunded_at, now()),
+    updated_at = now()
+  where ps.id = v_schedule.id;
+
+  insert into public.payment_audit_log (
+    event_type,
+    entity_type,
+    entity_id,
+    service_id,
+    schedule_id,
+    from_state,
+    to_state,
+    actor,
+    metadata
+  )
+  values (
+    'REFUND_CONFIRMED',
+    'payment_schedule',
+    v_schedule.id,
+    v_schedule.contracted_service_id,
+    v_schedule.id,
+    v_from_state,
+    v_to_state,
+    'webhook',
+    jsonb_build_object(
+      'webhook_event_id', p_webhook_event_id,
+      'refunded_amount', p_refunded_amount,
+      'source', 'TRANSACTION_REFUND'
+    )
+  );
+
+  insert into public.payment_events (
+    event_type,
+    aggregate_type,
+    aggregate_id,
+    service_id,
+    payload
+  )
+  values (
+    'RefundConfirmed',
+    'payment_schedule',
+    v_schedule.id,
+    v_schedule.contracted_service_id,
+    jsonb_build_object(
+      'to_state', v_to_state,
+      'refunded_amount', p_refunded_amount,
+      'initiator', 'webhook',
+      'webhook_event_id', p_webhook_event_id
+    )
+  );
+
+  return jsonb_build_object(
+    'outcome', 'refunded',
+    'schedule_id', v_schedule.id,
+    'service_id', v_schedule.contracted_service_id,
+    'client_id', v_schedule.client_id,
+    'from_state', v_from_state,
+    'to_state', v_to_state,
+    'refunded_amount', p_refunded_amount
+  );
+end;
+$$;
+
+create or replace function public.webhook_charge_void_rpc(
+  p_reference_code uuid,
+  p_webhook_event_id text
+)
+returns jsonb
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_schedule public.payment_schedules%rowtype;
+  v_from_state text;
+begin
+  select ps.*
+  into v_schedule
+  from public.payment_schedules ps
+  where ps.contracted_service_id = p_reference_code
+  for update;
+
+  if not found then
+    return jsonb_build_object('outcome', 'not_found');
+  end if;
+
+  v_from_state := v_schedule.state;
+
+  if v_schedule.state = 'VOIDED' then
+    return jsonb_build_object(
+      'outcome', 'already_terminal',
+      'schedule_id', v_schedule.id,
+      'service_id', v_schedule.contracted_service_id,
+      'from_state', v_from_state
+    );
+  end if;
+
+  if v_schedule.state not in ('PAID', 'IN_ANALYSIS', 'PROCESSING', 'REFUND_REQUESTED') then
+    return jsonb_build_object(
+      'outcome', 'skipped',
+      'reason', 'invalid_transition',
+      'schedule_id', v_schedule.id,
+      'service_id', v_schedule.contracted_service_id,
+      'from_state', v_from_state
+    );
+  end if;
+
+  update public.payment_schedules ps
+  set
+    state = 'VOIDED',
+    voided_at = coalesce(ps.voided_at, now()),
+    updated_at = now()
+  where ps.id = v_schedule.id;
+
+  insert into public.payment_audit_log (
+    event_type,
+    entity_type,
+    entity_id,
+    service_id,
+    schedule_id,
+    from_state,
+    to_state,
+    actor,
+    metadata
+  )
+  values (
+    'CHARGE_VOIDED',
+    'payment_schedule',
+    v_schedule.id,
+    v_schedule.contracted_service_id,
+    v_schedule.id,
+    v_from_state,
+    'VOIDED',
+    'webhook',
+    jsonb_build_object(
+      'webhook_event_id', p_webhook_event_id,
+      'source', 'CHARGE_VOID'
+    )
+  );
+
+  return jsonb_build_object(
+    'outcome', 'voided',
+    'schedule_id', v_schedule.id,
+    'service_id', v_schedule.contracted_service_id,
+    'from_state', v_from_state
+  );
+end;
+$$;
+
+create or replace function public.webhook_transaction_dispute_rpc(
+  p_reference_code uuid,
+  p_webhook_event_id text,
+  p_gateway_transaction_id text default null
+)
+returns jsonb
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_schedule public.payment_schedules%rowtype;
+begin
+  select ps.*
+  into v_schedule
+  from public.payment_schedules ps
+  where ps.contracted_service_id = p_reference_code
+  for update;
+
+  if not found then
+    return jsonb_build_object('outcome', 'not_found');
+  end if;
+
+  update public.payment_schedules ps
+  set
+    is_disputed = true,
+    updated_at = now()
+  where ps.id = v_schedule.id;
+
+  insert into public.payment_audit_log (
+    event_type,
+    entity_type,
+    entity_id,
+    service_id,
+    schedule_id,
+    from_state,
+    to_state,
+    actor,
+    metadata
+  )
+  values (
+    'TRANSACTION_DISPUTED',
+    'payment_schedule',
+    v_schedule.id,
+    v_schedule.contracted_service_id,
+    v_schedule.id,
+    v_schedule.state,
+    v_schedule.state,
+    'webhook',
+    jsonb_build_object(
+      'webhook_event_id', p_webhook_event_id,
+      'gateway_transaction_id', p_gateway_transaction_id,
+      'source', 'TRANSACTION_DISPUTE'
+    )
+  );
+
+  return jsonb_build_object(
+    'outcome', 'disputed',
+    'schedule_id', v_schedule.id,
+    'service_id', v_schedule.contracted_service_id,
+    'state', v_schedule.state,
+    'gateway_transaction_id', coalesce(
+      p_gateway_transaction_id,
+      v_schedule.gateway_transaction_id
+    ),
+    'is_disputed', true
+  );
+end;
+$$;
+
+revoke all on function public.webhook_transaction_refund_rpc(uuid, text, numeric)
