+  VCC: { 1: "cc_visa_master_1x_rate", 3: "cc_visa_master_2_6x_rate", 10: "cc_visa_master_7_12x_rate" },
+  MASTER: { 1: "cc_visa_master_1x_rate", 3: "cc_visa_master_2_6x_rate", 10: "cc_visa_master_7_12x_rate" },
+  ELO: { 1: "cc_elo_other_1x_rate", 3: "cc_elo_other_2_6x_rate", 10: "cc_elo_other_7_12x_rate" },
+  AMEX: { 1: "cc_elo_other_1x_rate", 3: "cc_elo_other_2_6x_rate", 10: "cc_elo_other_7_12x_rate" },
+  HIPER: { 1: "cc_elo_other_1x_rate", 3: "cc_elo_other_2_6x_rate", 10: "cc_elo_other_7_12x_rate" },
+  DINERS: { 1: "cc_elo_other_1x_rate", 3: "cc_elo_other_2_6x_rate", 10: "cc_elo_other_7_12x_rate" },
