@@ -0,0 +1,84 @@
+import { assertEquals } from "std/testing/asserts";
+
+const PAYMENT_SECRET_NAMES = [
+  "NETCRED_USERNAME",
+  "NETCRED_PASSWORD",
+  "NETCRED_WEBHOOK_SECRET",
+  "INSTALLMENT_SIGNING_SECRET",
+] as const;
+
+const VAULT_CONSUMER_FILES = [
+  new URL("../payment/netcred-auth.ts", import.meta.url),
+  new URL("../../netcred-webhook/index.ts", import.meta.url),
+  new URL("../../calculate-installment-options/index.ts", import.meta.url),
+  new URL("../../accept-proposal/index.ts", import.meta.url),
+  new URL("../../update-payment-method/index.ts", import.meta.url),
+  new URL("../../calculate-installment-options/getVaultSecret.ts", import.meta.url),
+] as const;
+
+const FORBIDDEN_HARDCODED_PATTERNS = [
+  /NETCRED_PASSWORD\s*=\s*["'][^"']+["']/,
+  /NETCRED_USERNAME\s*=\s*["'][^"']+["']/,
+  /INSTALLMENT_SIGNING_SECRET\s*=\s*["'][^"']+["']/,
+  /NETCRED_WEBHOOK_SECRET\s*=\s*["'][^"']+["']/,
+];
+
+Deno.test("payment secret consumers use getVaultSecret or read_vault_secret RPC", async () => {
+  for (const fileUrl of VAULT_CONSUMER_FILES) {
+    const source = await Deno.readTextFile(fileUrl);
+    assertEquals(
+      source.includes("getVaultSecret") || source.includes("read_vault_secret"),
+      true,
+      `${fileUrl.pathname} must load secrets via Vault helper`,
+    );
+  }
+});
+
+Deno.test("netcred-auth does not read NETCRED credentials directly from Deno.env", async () => {
+  const source = await Deno.readTextFile(
+    new URL("../payment/netcred-auth.ts", import.meta.url),
+  );
+
+  assertEquals(source.includes('Deno.env.get("NETCRED_USERNAME")'), false);
+  assertEquals(source.includes('Deno.env.get("NETCRED_PASSWORD")'), false);
+  assertEquals(source.includes("getVaultSecret"), true);
+});
+
+Deno.test("payment Edge Function sources contain no hardcoded secret literals", async () => {
+  const violations: string[] = [];
+
+  for await (const entry of Deno.readDir(new URL("../../", import.meta.url))) {
+    if (!entry.isDirectory) continue;
+    if (entry.name.startsWith("_")) continue;
+
+    const indexPath = new URL(`../../${entry.name}/index.ts`, import.meta.url);
+    try {
+      const source = await Deno.readTextFile(indexPath);
+      for (const pattern of FORBIDDEN_HARDCODED_PATTERNS) {
+        if (pattern.test(source)) {
+          violations.push(`${entry.name}/index.ts matches ${pattern}`);
+        }
+      }
+    } catch {
+      // Not every folder is a payment EF.
+    }
+  }
+
+  if (violations.length > 0) {
+    throw new Error(`Hardcoded secret violations:\n${violations.join("\n")}`);
+  }
+});
+
+Deno.test(".env.example does not document payment gateway secrets", async () => {
+  const envExample = await Deno.readTextFile(
+    new URL("../../.env.example", import.meta.url),
+  );
+
+  for (const secretName of PAYMENT_SECRET_NAMES) {
+    assertEquals(
+      envExample.includes(secretName),
+      false,
+      `.env.example must not include ${secretName}`,
+    );
+  }
+});
