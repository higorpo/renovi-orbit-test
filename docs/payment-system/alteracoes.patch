+import { assertEquals } from "std/testing/asserts";
+import {
+  TERMINAL_ERROR_CODES,
+  classifyChargeError,
+  isTerminalGatewayState,
+  isValidWebhookTransition,
+} from "../error-classification.ts";
+
+Deno.test("classifyChargeError marks all TERMINAL_ERROR_CODES as terminal", () => {
+  for (const originalCode of TERMINAL_ERROR_CODES) {
+    assertEquals(
+      classifyChargeError({
+        code: "RETRYABLE",
+        message: "gateway error",
+        originalCode,
+      }),
+      "terminal",
+    );
+  }
+});
+
+Deno.test("classifyChargeError maps TERMINAL code to terminal", () => {
+  assertEquals(
+    classifyChargeError({ code: "TERMINAL", message: "declined" }),
+    "terminal",
+  );
+});
+
+Deno.test("classifyChargeError maps AUTH_FAILURE to retryable", () => {
+  assertEquals(
+    classifyChargeError({ code: "AUTH_FAILURE", message: "token expired" }),
+    "retryable",
+  );
+});
+
+Deno.test("classifyChargeError maps generic RETRYABLE to retryable", () => {
+  assertEquals(
+    classifyChargeError({
+      code: "RETRYABLE",
+      message: "timeout",
+      originalCode: "INTERNAL_SERVER_ERROR",
+    }),
+    "retryable",
+  );
+});
+
+Deno.test("isTerminalGatewayState identifies terminal transaction states", () => {
+  assertEquals(isTerminalGatewayState("PAID"), true);
+  assertEquals(isTerminalGatewayState("REFUNDED"), true);
+  assertEquals(isTerminalGatewayState("IN_ANALYSIS"), false);
+  assertEquals(isTerminalGatewayState("SCHEDULED"), false);
+});
+
+Deno.test("isValidWebhookTransition allows IN_ANALYSIS to PAID", () => {
+  assertEquals(isValidWebhookTransition("IN_ANALYSIS", "PAID"), true);
+});
+
+Deno.test("isValidWebhookTransition blocks PAID to IN_ANALYSIS regression", () => {
+  assertEquals(isValidWebhookTransition("PAID", "IN_ANALYSIS"), false);
+});
+
+Deno.test("isValidWebhookTransition allows non-terminal state changes", () => {
+  assertEquals(isValidWebhookTransition("SCHEDULED", "IN_ANALYSIS"), true);
+});
