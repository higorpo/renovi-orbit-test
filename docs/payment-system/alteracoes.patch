+$$;
+
+create or replace function public.payment_cron_enable_all()
+returns void
+language plpgsql
+security definer
+set search_path = extensions, public
+as $$
+declare
+  v_job_name text;
+begin
+  foreach v_job_name in array array[
+    'schedule-netcred-charges',
+    'auto-cancel-unpaid-services',
+    'notify-upcoming-charges',
+    'recover-payment-leases',
+    'reconcile-netcred-payments',
+    'process-webhook-retry',
+    'detect-netcred-onboarding',
+    'auto-complete-executed-services'
+  ]
+  loop
+    perform public.payment_cron_set_active(v_job_name, true);
+  end loop;
+end;
+$$;
+
+create or replace function public.payment_cron_disable_all()
+returns void
+language plpgsql
+security definer
+set search_path = extensions, public
+as $$
+declare
+  v_job_name text;
+begin
+  foreach v_job_name in array array[
+    'schedule-netcred-charges',
+    'auto-cancel-unpaid-services',
+    'notify-upcoming-charges',
+    'recover-payment-leases',
+    'reconcile-netcred-payments',
+    'process-webhook-retry',
+    'detect-netcred-onboarding',
+    'auto-complete-executed-services'
+  ]
+  loop
+    perform public.payment_cron_set_active(v_job_name, false);
+  end loop;
+end;
+$$;
+
+comment on function public.payment_cron_enable(text) is
+  'Enable a single payment pg_cron job after EF smoke tests pass.';
+comment on function public.payment_cron_disable(text) is
+  'Disable a single payment pg_cron job.';
+comment on function public.payment_cron_enable_all() is
+  'Enable all 8 payment pg_cron jobs (production cutover only).';
+comment on function public.payment_cron_disable_all() is
+  'Disable all 8 payment pg_cron jobs.';
+
+revoke all on function public.payment_cron_set_active(text, boolean) from public, anon, authenticated;
+revoke all on function public.payment_cron_enable(text) from public, anon, authenticated;
+revoke all on function public.payment_cron_disable(text) from public, anon, authenticated;
+revoke all on function public.payment_cron_enable_all() from public, anon, authenticated;
+revoke all on function public.payment_cron_disable_all() from public, anon, authenticated;
+
+grant execute on function public.payment_cron_set_active(text, boolean) to service_role, postgres;
+grant execute on function public.payment_cron_enable(text) to service_role, postgres;
+grant execute on function public.payment_cron_disable(text) to service_role, postgres;
+grant execute on function public.payment_cron_enable_all() to service_role, postgres;
+grant execute on function public.payment_cron_disable_all() to service_role, postgres;
+
+do $cron$
+declare
+  v_jobid integer;
+  v_jobname text;
+begin
+  foreach v_jobname in array array[
+    'schedule-netcred-charges',
+    'auto-cancel-unpaid-services',
+    'notify-upcoming-charges',
+    'recover-payment-leases',
+    'reconcile-netcred-payments',
+    'process-webhook-retry',
+    'detect-netcred-onboarding',
+    'auto-complete-executed-services'
+  ]
+  loop
+    select j.jobid
+    into v_jobid
+    from cron.job j
+    where j.jobname = v_jobname;
+
+    if v_jobid is not null then
+      perform cron.unschedule(v_jobid);
+    end if;
+  end loop;
+end;
+$cron$;
+
+select cron.schedule(
+  'schedule-netcred-charges',
+  '0 9,15,21,3 * * *',
+  $$select public.cron_schedule_netcred_charges();$$
+);
+
+select cron.schedule(
+  'auto-cancel-unpaid-services',
+  '15 9,15,21,3 * * *',
+  $$select public.cron_auto_cancel_unpaid_services();$$
+);
+
+select cron.schedule(
+  'notify-upcoming-charges',
+  '30 9,15,21,3 * * *',
+  $$select public.cron_notify_upcoming_charges();$$
+);
+
+select cron.schedule(
+  'recover-payment-leases',
+  '*/30 * * * *',
+  $$select public.cron_recover_payment_leases();$$
+);
+
+select cron.schedule(
+  'reconcile-netcred-payments',
+  '*/30 * * * *',
+  $$select public.cron_reconcile_netcred_payments();$$
+);
+
+select cron.schedule(
+  'process-webhook-retry',
+  '*/5 * * * *',
+  $$select public.cron_process_webhook_retry();$$
+);
+
+select cron.schedule(
+  'detect-netcred-onboarding',
+  '0 10 * * *',
+  $$select public.cron_detect_netcred_onboarding();$$
+);
+
+select cron.schedule(
+  'auto-complete-executed-services',
+  '0 11 * * *',
+  $$select public.cron_auto_complete_executed_services();$$
+);
+
+update cron.job j
+set active = false
+where j.jobname in (
+  'schedule-netcred-charges',
+  'auto-cancel-unpaid-services',
+  'notify-upcoming-charges',
+  'recover-payment-leases',
+  'reconcile-netcred-payments',
+  'process-webhook-retry',
+  'detect-netcred-onboarding',
+  'auto-complete-executed-services'
+);
diff --git a/supabase/migrations/20260705208800_rpc_acquire_or_refresh_netcred_token.sql b/supabase/migrations/20260705208800_rpc_acquire_or_refresh_netcred_token.sql
new file mode 100644
index 0000000..b73af26
--- /dev/null
+++ b/supabase/migrations/20260705208800_rpc_acquire_or_refresh_netcred_token.sql
@@ -0,0 +1,131 @@
+-- Payment System — Phase 5 task 26: acquire_or_refresh_netcred_token RPC (design §6.3, Req 2).
+-- Serializes JWT refresh via FOR UPDATE + advisory lock; EF performs tokenAuth GraphQL call.
+
+create or replace function public.acquire_or_refresh_netcred_token(
+  p_new_token text default null,
+  p_expires_at timestamptz default null
+)
+returns jsonb
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_row public.payment_gateway_tokens%rowtype;
+  v_refresh_threshold interval := interval '60 minutes';
+  v_lock_key bigint := 880001;
+  v_wait_attempt int;
+begin
+  perform set_config('lock_timeout', '500ms', true);
+
+  if p_new_token is not null then
+    insert into public.payment_gateway_tokens (
+      gateway_slug,
+      token,
+      expires_at,
+      refreshed_at
+    )
+    values (
+      'netcred',
+      p_new_token,
+      coalesce(p_expires_at, now() + interval '24 hours'),
+      now()
+    )
+    on conflict (gateway_slug) do update
+    set
+      token = excluded.token,
+      expires_at = excluded.expires_at,
+      refreshed_at = now(),
+      updated_at = now()
+    returning * into v_row;
+
+    perform pg_advisory_unlock(v_lock_key);
+
+    return jsonb_build_object(
+      'status', 'refreshed',
+      'token', v_row.token,
+      'expires_at', v_row.expires_at
+    );
+  end if;
+
+  select *
+  into v_row
+  from public.payment_gateway_tokens pgt
+  where pgt.gateway_slug = 'netcred'
+  for update;
+
+  if found and v_row.expires_at > now() + v_refresh_threshold then
+    return jsonb_build_object(
+      'status', 'cached',
+      'token', v_row.token,
+      'expires_at', v_row.expires_at
+    );
+  end if;
+
+  if not pg_try_advisory_lock(v_lock_key) then
+    for v_wait_attempt in 1..30 loop
+      select *
+      into v_row
+      from public.payment_gateway_tokens pgt
+      where pgt.gateway_slug = 'netcred';
+
+      if found and v_row.expires_at > now() + v_refresh_threshold then
+        return jsonb_build_object(
+          'status', 'cached',
+          'token', v_row.token,
+          'expires_at', v_row.expires_at
+        );
+      end if;
+
+      perform pg_sleep(0.2);
+    end loop;
+
+    raise exception 'NETCRED_TOKEN_REFRESH_WAIT_TIMEOUT'
+      using errcode = 'P0001';
+  end if;
+
+  select *
+  into v_row
+  from public.payment_gateway_tokens pgt
+  where pgt.gateway_slug = 'netcred'
+  for update;
+
+  if found and v_row.expires_at > now() + v_refresh_threshold then
+    perform pg_advisory_unlock(v_lock_key);
+    return jsonb_build_object(
+      'status', 'cached',
+      'token', v_row.token,
+      'expires_at', v_row.expires_at
+    );
+  end if;
+
+  return jsonb_build_object('status', 'needs_refresh');
+end;
+$$;
+
+comment on function public.acquire_or_refresh_netcred_token(text, timestamptz) is
+  'Lock + read NetCred JWT cache; upsert after EF tokenAuth; advisory lock serializes refresh.';
+
+create or replace function public.release_netcred_token_refresh_lock()
+returns void
+language plpgsql
+security definer
+set search_path = public
+as $$
+begin
+  perform pg_advisory_unlock(880001);
+end;
+$$;
+
+comment on function public.release_netcred_token_refresh_lock() is
+  'Best-effort release of NetCred JWT refresh advisory lock after tokenAuth failure.';
+
+revoke all on function public.acquire_or_refresh_netcred_token(text, timestamptz)
+  from public, anon, authenticated;
+revoke all on function public.release_netcred_token_refresh_lock()
+  from public, anon, authenticated;
+
+grant execute on function public.acquire_or_refresh_netcred_token(text, timestamptz)
+  to service_role, postgres;
+grant execute on function public.release_netcred_token_refresh_lock()
+  to service_role, postgres;
diff --git a/supabase/migrations/20260705208900_rpc_read_vault_secret.sql b/supabase/migrations/20260705208900_rpc_read_vault_secret.sql
new file mode 100644
index 0000000..ffd759c
--- /dev/null
+++ b/supabase/migrations/20260705208900_rpc_read_vault_secret.sql
@@ -0,0 +1,35 @@
+-- Payment System — read named secrets from Supabase Vault for Edge Functions (design §4.3.2).
+
+create or replace function public.read_vault_secret(p_name text)
+returns text
+language plpgsql
+security definer
+set search_path = public, vault, extensions
+as $$
+declare
+  v_secret text;
+begin
+  if nullif(trim(p_name), '') is null then
+    raise exception 'VAULT_SECRET_NAME_REQUIRED' using errcode = 'P0001';
+  end if;
+
+  select nullif(trim(decrypted_secret), '')
+  into v_secret
+  from vault.decrypted_secrets
+  where name = p_name;
+
+  if v_secret is null then
+    raise exception 'VAULT_SECRET_NOT_CONFIGURED:%', p_name using errcode = 'P0001';
+  end if;
+
+  return v_secret;
+end;
+$$;
+
+comment on function public.read_vault_secret(text) is
+  'Returns a Vault secret by name for service_role Edge Functions (payment HMAC, webhooks).';
+
+revoke all on function public.read_vault_secret(text) from public;
+revoke all on function public.read_vault_secret(text) from anon;
+revoke all on function public.read_vault_secret(text) from authenticated;
+grant execute on function public.read_vault_secret(text) to service_role;
diff --git a/supabase/migrations/20260705209000_rpc_update_payment_method.sql b/supabase/migrations/20260705209000_rpc_update_payment_method.sql
new file mode 100644
index 0000000..bff1f74
--- /dev/null
+++ b/supabase/migrations/20260705209000_rpc_update_payment_method.sql
@@ -0,0 +1,85 @@
+-- Payment System — task 33: update_payment_method_rpc (design §4.4.2, Req 8 AC8).
+
+create or replace function public.update_payment_method_rpc(
+  p_contracted_service_id uuid,
+  p_client_id uuid,
+  p_new_payment_token_id uuid,
+  p_actor_id uuid,
+  p_old_payment_token_id uuid,
+  p_old_brand text,
+  p_new_brand text
+)
+returns uuid
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_schedule public.payment_schedules%rowtype;
+begin
+  select *
+  into v_schedule
+  from public.payment_schedules ps
+  where ps.contracted_service_id = p_contracted_service_id
+    and ps.client_id = p_client_id
+    and ps.state in ('SCHEDULED', 'FAILED')
+  for update;
+
+  if not found then
+    raise exception 'INVALID_SCHEDULE_STATE' using errcode = 'P0001';
+  end if;
+
+  update public.payment_schedules ps
+  set
+    payment_token_id = p_new_payment_token_id,
+    needs_payment_method_update = false,
+    updated_at = now()
+  where ps.id = v_schedule.id;
+
+  insert into public.payment_audit_log (
+    event_type,
+    entity_type,
+    entity_id,
+    service_id,
+    schedule_id,
+    actor,
+    actor_id,
+    metadata
+  )
+  values (
+    'PAYMENT_METHOD_UPDATED',
+    'payment_schedule',
+    v_schedule.id,
+    p_contracted_service_id,
+    v_schedule.id,
+    'client',
+    p_actor_id,
+    jsonb_build_object(
+      'old_token_id', p_old_payment_token_id,
+      'new_token_id', p_new_payment_token_id,
+      'old_brand', p_old_brand,
+      'new_brand', p_new_brand
+    )
+  );
+
+  return v_schedule.id;
+end;
+$$;
+
+comment on function public.update_payment_method_rpc(
+  uuid, uuid, uuid, uuid, uuid, text, text
+) is
+  'Locks eligible payment_schedules row and updates payment_token_id with audit trail.';
+
+revoke all on function public.update_payment_method_rpc(
+  uuid, uuid, uuid, uuid, uuid, text, text
+) from public;
+revoke all on function public.update_payment_method_rpc(
+  uuid, uuid, uuid, uuid, uuid, text, text
+) from anon;
+revoke all on function public.update_payment_method_rpc(
+  uuid, uuid, uuid, uuid, uuid, text, text
+) from authenticated;
+grant execute on function public.update_payment_method_rpc(
+  uuid, uuid, uuid, uuid, uuid, text, text
+) to service_role;
diff --git a/supabase/migrations/20260705209100_rpc_manual_charge_payment.sql b/supabase/migrations/20260705209100_rpc_manual_charge_payment.sql
new file mode 100644
index 0000000..a897353
--- /dev/null
+++ b/supabase/migrations/20260705209100_rpc_manual_charge_payment.sql
@@ -0,0 +1,342 @@
+-- Payment System — task 34: manual charge lease acquire + result commit (design §4.11).
+
+create or replace function public.manual_charge_acquire_lease_rpc(
+  p_schedule_id uuid,
+  p_client_id uuid,
+  p_clearsale_session_id text,
+  p_client_ip_address text,
+  p_actor_id uuid
+)
+returns jsonb
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_schedule public.payment_schedules%rowtype;
+  v_service public.contracted_services%rowtype;
+  v_cancel_hours int;
+  v_lease_minutes int;
+  v_from_state text;
+begin
+  if p_clearsale_session_id is null or btrim(p_clearsale_session_id) = '' then
+    raise exception 'CLEARSALE_SESSION_REQUIRED' using errcode = 'P0001';
+  end if;
+
+  select ps.*
+  into v_schedule
+  from public.payment_schedules ps
+  where ps.id = p_schedule_id
+    and ps.client_id = p_client_id
+  for update skip locked;
+
+  if not found then
+    if exists (
+      select 1
+      from public.payment_schedules ps
+      where ps.id = p_schedule_id
+        and ps.client_id = p_client_id
+    ) then
+      raise exception 'PAYMENT_ALREADY_IN_PROGRESS' using errcode = 'P0001';
+    end if;
+
+    raise exception 'SCHEDULE_NOT_FOUND' using errcode = 'P0001';
+  end if;
+
+  select cs.*
+  into v_service
+  from public.contracted_services cs
+  where cs.id = v_schedule.contracted_service_id;
+
+  if not found or v_service.client_id <> p_client_id then
+    raise exception 'SCHEDULE_NOT_FOUND' using errcode = 'P0001';
+  end if;
+
+  if v_service.status = 'CANCELLED' then
+    raise exception 'SERVICE_CANCELLED' using errcode = 'P0001';
+  end if;
+
+  if v_schedule.state not in ('FAILED', 'FAILED_PERMANENT') then
+    raise exception 'INVALID_SCHEDULE_STATE' using errcode = 'P0001';
+  end if;
+
+  v_cancel_hours := public.platform_constant_int('auto_cancel_hours_before_service', 12);
+
+  if v_service.service_scheduled_at is null
+    or v_service.service_scheduled_at - now() <= make_interval(hours => v_cancel_hours) then
+    raise exception 'SERVICE_AUTO_CANCELLED' using errcode = 'P0001';
+  end if;
+
+  v_lease_minutes := public.platform_constant_int('payment_lease_duration_minutes', 10);
+
+  v_from_state := v_schedule.state;
+
+  update public.payment_schedules ps
+  set
+    state = 'PROCESSING',
+    locked_until = now() + make_interval(mins => v_lease_minutes),
+    manual_attempt_count = ps.manual_attempt_count + 1,
+    clearsale_session_id = p_clearsale_session_id,
+    client_ip_address = p_client_ip_address,
+    updated_at = now()
+  where ps.id = v_schedule.id
+  returning * into v_schedule;
+
+  insert into public.payment_audit_log (
+    event_type,
+    entity_type,
+    entity_id,
+    service_id,
+    schedule_id,
+    from_state,
+    to_state,
+    actor,
+    actor_id,
+    metadata
+  )
+  values (
+    'MANUAL_PAYMENT_INITIATED',
+    'payment_schedule',
+    v_schedule.id,
+    v_schedule.contracted_service_id,
+    v_schedule.id,
+    v_from_state,
+    'PROCESSING',
+    'client',
+    p_actor_id,
+    jsonb_build_object(
+      'clearsale_session_id', p_clearsale_session_id,
+      'manual_attempt_count', v_schedule.manual_attempt_count
+    )
+  );
+
+  return jsonb_build_object(
+    'id', v_schedule.id,
+    'contracted_service_id', v_schedule.contracted_service_id,
+    'client_id', v_schedule.client_id,
+    'provider_id', v_schedule.provider_id,
+    'gateway_slug', v_schedule.gateway_slug,
+    'payment_token_id', v_schedule.payment_token_id,
+    'installment_number', v_schedule.installment_number,
+    'base_amount', v_schedule.base_amount,
+    'state', v_schedule.state,
+    'manual_attempt_count', v_schedule.manual_attempt_count,
+    'automatic_attempt_count', v_schedule.automatic_attempt_count,
+    'max_attempts', v_schedule.max_attempts,
+    'clearsale_session_id', v_schedule.clearsale_session_id,
+    'client_ip_address', v_schedule.client_ip_address
+  );
+end;
+$$;
+
+create or replace function public.manual_charge_commit_result_rpc(
+  p_schedule_id uuid,
+  p_client_id uuid,
+  p_outcome text,
+  p_charge_amount numeric(12, 2),
+  p_gateway_charge_id text,
+  p_gateway_transaction_id text,
+  p_failure_code text,
+  p_failure_reason text,
+  p_gateway_latency_ms int,
+  p_provider_response_summary jsonb,
+  p_actor_id uuid
+)
+returns uuid
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_schedule public.payment_schedules%rowtype;
+  v_from_state text;
+  v_audit_event text;
+  v_event_type text;
+begin
+  if p_outcome not in ('PAID', 'IN_ANALYSIS', 'FAILED', 'FAILED_PERMANENT') then
+    raise exception 'INVALID_OUTCOME' using errcode = 'P0001';
+  end if;
+
+  select ps.*
+  into v_schedule
+  from public.payment_schedules ps
+  where ps.id = p_schedule_id
+    and ps.client_id = p_client_id
+    and ps.state = 'PROCESSING'
+  for update;
+
+  if not found then
+    raise exception 'INVALID_SCHEDULE_STATE' using errcode = 'P0001';
+  end if;
+
+  v_from_state := v_schedule.state;
+
+  if p_outcome = 'PAID' then
+    update public.payment_schedules ps
+    set
+      state = 'PAID',
+      paid_at = now(),
+      paid_amount = p_charge_amount,
+      gateway_charge_id = p_gateway_charge_id,
+      gateway_transaction_id = p_gateway_transaction_id,
+      locked_until = null,
+      failure_code = null,
+      failure_reason = null,
+      updated_at = now()
+    where ps.id = v_schedule.id;
+
+    update public.contracted_services cs
+    set status = 'CONFIRMED'
+    where cs.id = v_schedule.contracted_service_id
+      and cs.status = 'PENDING_PAYMENT';
+
+    v_audit_event := 'CHARGE_PAID';
+    v_event_type := 'ChargeSucceeded';
+  elsif p_outcome = 'IN_ANALYSIS' then
+    update public.payment_schedules ps
+    set
+      state = 'IN_ANALYSIS',
+      gateway_charge_id = coalesce(p_gateway_charge_id, ps.gateway_charge_id),
+      gateway_transaction_id = coalesce(p_gateway_transaction_id, ps.gateway_transaction_id),
+      locked_until = null,
+      updated_at = now()
+    where ps.id = v_schedule.id;
+
+    v_audit_event := 'CHARGE_IN_ANALYSIS';
+    v_event_type := 'ChargeInAnalysis';
+  elsif p_outcome = 'FAILED_PERMANENT' then
+    update public.payment_schedules ps
+    set
+      state = 'FAILED_PERMANENT',
+      failed_at = now(),
+      failed_permanently_at = coalesce(ps.failed_permanently_at, now()),
+      failure_code = p_failure_code,
+      failure_reason = p_failure_reason,
+      locked_until = null,
+      updated_at = now()
+    where ps.id = v_schedule.id;
+
+    v_audit_event := 'CHARGE_FAILED_PERMANENT';
+    v_event_type := 'ChargePermanentlyFailed';
+  else
+    update public.payment_schedules ps
+    set
+      state = 'FAILED',
+      failed_at = now(),
+      failure_code = p_failure_code,
+      failure_reason = p_failure_reason,
+      locked_until = null,
+      updated_at = now()
+    where ps.id = v_schedule.id;
+
+    v_audit_event := 'CHARGE_FAILED';
+    v_event_type := 'ChargeFailed';
+  end if;
+
+  insert into public.payment_attempts (
+    schedule_id,
+    attempt_number,
+    initiator,
+    completed_at,
+    outcome,
+    provider_response_summary,
+    failure_code,
+    failure_reason,
+    charge_amount,
+    gateway_latency_ms
+  )
+  values (
+    v_schedule.id,
+    v_schedule.manual_attempt_count,
+    'client',
+    now(),
+    case p_outcome
+      when 'PAID' then 'PAID'
+      when 'IN_ANALYSIS' then 'IN_ANALYSIS'
+      else 'REJECTED'
+    end,
+    p_provider_response_summary,
+    p_failure_code,
+    p_failure_reason,
+    p_charge_amount,
+    p_gateway_latency_ms
+  );
+
+  insert into public.payment_audit_log (
+    event_type,
+    entity_type,
+    entity_id,
+    service_id,
+    schedule_id,
+    from_state,
+    to_state,
+    actor,
+    actor_id,
+    metadata
+  )
+  values (
+    v_audit_event,
+    'payment_schedule',
+    v_schedule.id,
+    v_schedule.contracted_service_id,
+    v_schedule.id,
+    v_from_state,
+    p_outcome,
+    'client',
+    p_actor_id,
+    jsonb_build_object(
+      'charge_amount', p_charge_amount,
+      'manual_attempt_count', v_schedule.manual_attempt_count,
+      'gateway_charge_id', p_gateway_charge_id,
+      'gateway_transaction_id', p_gateway_transaction_id
+    )
+  );
+
+  insert into public.payment_events (
+    event_type,
+    aggregate_type,
+    aggregate_id,
+    service_id,
+    payload
+  )
+  values (
+    v_event_type,
+    'payment_schedule',
+    v_schedule.id,
+    v_schedule.contracted_service_id,
+    jsonb_build_object(
+      'outcome', p_outcome,
+      'charge_amount', p_charge_amount,
+      'initiator', 'client'
+    )
+  );
+
+  return v_schedule.id;
+end;
+$$;
