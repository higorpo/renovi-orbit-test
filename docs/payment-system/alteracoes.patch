diff --git a/supabase/functions/netcred-webhook/validateSignature.ts b/supabase/functions/netcred-webhook/validateSignature.ts
new file mode 100644
index 0000000..08648d0
--- /dev/null
+++ b/supabase/functions/netcred-webhook/validateSignature.ts
@@ -0,0 +1,16 @@
+import { computeHMACSHA256 } from "../calculate-installment-options/hmac.ts";
+import { timingSafeEqualStrings } from "../accept-proposal/timingSafeEqual.ts";
+
+export async function validateNetcredWebhookSignature(
+  rawBody: string,
+  signatureHeader: string,
+  secret: string,
+): Promise<boolean> {
+  const signature = signatureHeader.trim().toLowerCase();
+  if (!signature) {
+    return false;
+  }
+
+  const computed = await computeHMACSHA256(secret, rawBody);
+  return timingSafeEqualStrings(computed.toLowerCase(), signature);
+}
