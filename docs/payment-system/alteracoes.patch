+import { assertEquals } from "std/testing/asserts";
+import {
+  computeHMACSHA256,
+  serializeInstallmentHmacPayload,
+} from "../../calculate-installment-options/hmac.ts";
+import type { InstallmentHmacPayload } from "../../calculate-installment-options/types.ts";
+import {
+  handleAcceptProposalRequest,
+  type AcceptProposalDeps,
+} from "../handleRequest.ts";
+import { validateInstallmentHmac } from "../validateInstallmentHmac.ts";
+import { computePricingSignature } from "../validatePricingSignature.ts";
+
+const installmentOptions = [{
+  installment_number: 1,
+  applicable_rate_pct: 2.39,
+  total_with_fees: 1024.29,
+  installment_amount: 1024.29,
+}];
+
+const proposal = {
+  id: "proposal-1",
+  provider_id: "provider-1",
+  proposed_amount: 1000,
+  tax_rate: 0.1,
+  tax_amount: 100,
+  final_amount: 900,
+  pricing_signature: "",
+};
+
+function buildHmacPayload(overrides: Partial<InstallmentHmacPayload> = {}): InstallmentHmacPayload {
+  return {
+    proposal_id: "proposal-1",
+    service_id: "service-1",
+    base_amount: 1000,
+    card_brand: "VCC",
+    installment_options: installmentOptions,
+    computed_at: "2026-06-24T12:00:00.000Z",
+    expires_at: "2026-06-24T12:10:00.000Z",
+    ...overrides,
+  };
+}
+
+async function signPayload(
+  secret: string,
+  payload: InstallmentHmacPayload,
+): Promise<string> {
+  return computeHMACSHA256(secret, serializeInstallmentHmacPayload(payload));
+}
+
+function createDeps(overrides: Partial<AcceptProposalDeps> = {}): AcceptProposalDeps {
+  return {
+    getUser: async () => ({ user: { id: "client-1" }, error: null }),
+    getInstallmentSigningSecret: async () => "installment-secret",
+    getPricingSignatureSecret: async () => "pricing-secret",
+    loadProposal: async () => ({ ...proposal }),
+    loadPaymentToken: async () => ({
+      id: "token-1",
+      client_id: "client-1",
+      state: "ACTIVE",
+    }),
+    loadProviderAccount: async () => ({
+      provider_id: "provider-1",
+      onboarding_status: "ACTIVE",
+    }),
+    acceptProposalRpc: async () => ({
+      contracted_service_id: "service-contract-1",
+      schedule_id: "schedule-1",
+      is_idempotent: false,
+    }),
+    checkRateLimit: async () => ({ allowed: true, retryAfter: 0 }),
+    getPaymentRolloutPercentage: async () => 100,
+    ...overrides,
+  };
+}
+
+async function buildAcceptProposalBody(
+  secret: string,
+  pricingSecret: string,
+  payload: InstallmentHmacPayload,
+  overrides: Record<string, unknown> = {},
+): Promise<Record<string, unknown>> {
+  proposal.pricing_signature = await computePricingSignature(pricingSecret, proposal);
+
+  return {
+    proposal_id: payload.proposal_id,
+    provider_id: "provider-1",
+    service_id: payload.service_id,
+    installment_number: 1,
+    installment_selection_hmac: await signPayload(secret, payload),
+    payment_token_id: "token-1",
+    scheduled_date: "2026-07-01T10:00:00.000Z",
+    clearsale_session_id: "clearsale-session",
+    base_amount: payload.base_amount,
+    card_brand: payload.card_brand,
+    installment_options: payload.installment_options,
+    computed_at: payload.computed_at,
+    expires_at: payload.expires_at,
+    idempotency_key: "11111111-1111-1111-1111-111111111111",
+    ...overrides,
+  };
+}
+
+function authRequest(body: Record<string, unknown>): Request {
+  return new Request("https://example.com/accept-proposal", {
+    method: "POST",
+    headers: {
+      Authorization: "Bearer jwt-token",
+      "Content-Type": "application/json",
+      "CF-Connecting-IP": "189.0.0.1",
+    },
+    body: JSON.stringify(body),
+  });
+}
+
+Deno.test("validateInstallmentHmac rejects payload 11 minutes after computed_at", async () => {
+  const payload = buildHmacPayload({
+    computed_at: "2026-06-24T12:00:00.000Z",
+    expires_at: "2026-06-24T12:10:00.000Z",
+  });
+  const hmac = await signPayload("installment-secret", payload);
+
+  const result = await validateInstallmentHmac(
+    hmac,
+    payload,
+    "installment-secret",
+    new Date("2026-06-24T12:11:00.000Z"),
+  );
+
+  assertEquals(result.valid, false);
+  if (!result.valid) {
+    assertEquals(result.error_code, "INSTALLMENT_SIGNATURE_EXPIRED");
+    assertEquals(result.expired, true);
+  }
+});
+
+Deno.test("validateInstallmentHmac rejects tampered base_amount", async () => {
+  const payload = buildHmacPayload();
+  const hmac = await signPayload("installment-secret", payload);
+  const tampered = { ...payload, base_amount: 999 };
+
+  const result = await validateInstallmentHmac(
+    hmac,
+    tampered,
+    "installment-secret",
+    new Date("2026-06-24T12:05:00.000Z"),
+  );
+
+  assertEquals(result.valid, false);
+  if (!result.valid) {
+    assertEquals(result.error_code, "INVALID_INSTALLMENT_SIGNATURE");
+    assertEquals(result.expired, false);
+  }
+});
+
+Deno.test("validateInstallmentHmac rejects tampered installment_number in options", async () => {
+  const payload = buildHmacPayload();
+  const hmac = await signPayload("installment-secret", payload);
+  const tampered = {
+    ...payload,
+    installment_options: [{
+      ...installmentOptions[0]!,
+      installment_number: 6,
+    }],
+  };
+
+  const result = await validateInstallmentHmac(
+    hmac,
+    tampered,
+    "installment-secret",
+    new Date("2026-06-24T12:05:00.000Z"),
+  );
+
+  assertEquals(result.valid, false);
+  if (!result.valid) {
+    assertEquals(result.error_code, "INVALID_INSTALLMENT_SIGNATURE");
+  }
+});
+
+Deno.test("accept-proposal returns INVALID_INSTALLMENT_SIGNATURE for tampered service_id", async () => {
+  const payload = buildHmacPayload({
+    expires_at: "2026-06-24T12:10:00.000Z",
+  });
+  const body = await buildAcceptProposalBody("installment-secret", "pricing-secret", payload, {
+    service_id: "service-tampered",
+  });
+
+  const response = await handleAcceptProposalRequest(
+    authRequest(body),
+    createDeps({ now: () => new Date("2026-06-24T12:05:00.000Z") }),
+  );
+  const json = await response.json();
+
+  assertEquals(response.status, 400);
+  assertEquals(json.error_code, "INVALID_INSTALLMENT_SIGNATURE");
+});
+
+Deno.test("accept-proposal returns INVALID_INSTALLMENT_SIGNATURE for tampered installment options", async () => {
+  const payload = buildHmacPayload({
+    expires_at: "2026-06-24T12:10:00.000Z",
+  });
+  const body = await buildAcceptProposalBody("installment-secret", "pricing-secret", payload, {
+    installment_options: [{
+      ...installmentOptions[0]!,
+      installment_number: 3,
+    }],
+  });
+
+  const response = await handleAcceptProposalRequest(
+    authRequest(body),
+    createDeps({ now: () => new Date("2026-06-24T12:05:00.000Z") }),
+  );
+  const json = await response.json();
+
+  assertEquals(response.status, 400);
+  assertEquals(json.error_code, "INVALID_INSTALLMENT_SIGNATURE");
+});
+
+const HMAC_COMPARE_FILES = [
+  new URL("../validateInstallmentHmac.ts", import.meta.url),
+  new URL("../validatePricingSignature.ts", import.meta.url),
+  new URL("../../netcred-webhook/validateSignature.ts", import.meta.url),
+] as const;
+
+Deno.test("installment HMAC validators use constant-time comparison helper", async () => {
+  for (const fileUrl of HMAC_COMPARE_FILES) {
+    const source = await Deno.readTextFile(fileUrl);
+    assertEquals(
+      source.includes("timingSafeEqualStrings"),
+      true,
+      `${fileUrl.pathname} must use timingSafeEqualStrings`,
+    );
+    assertEquals(
+      /submittedHmac\s*===|pricing_signature\s*===|signature\s*===/.test(source),
+      false,
+      `${fileUrl.pathname} must not compare signatures with ===`,
+    );
+  }
+});
+
+Deno.test("timingSafeEqualStrings compares full byte length without early exit on prefix match", async () => {
+  const source = await Deno.readTextFile(new URL("../timingSafeEqual.ts", import.meta.url));
+
+  assertEquals(source.includes("leftBytes.length !== rightBytes.length"), true);
+  assertEquals(source.includes("diff |="), true);
+  assertEquals(source.includes("return diff === 0"), true);
+});
