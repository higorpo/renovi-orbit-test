+import type { WebhookHandlerContext } from "../types.ts";
+import {
+  extractProviderIds,
+  extractReferenceCode,
+} from "./extractTransactionPayload.ts";
+
+export type TransactionDisputeApplyResult = {
+  outcome: "disputed" | "not_found";
+  schedule_id?: string;
+  service_id?: string;
+  state?: string;
+  gateway_transaction_id?: string;
+  is_disputed?: boolean;
+};
+
+export type TransactionDisputeDeps = {
+  applyDispute: (input: {
+    referenceCode: string;
+    webhookEventId: string;
+    providerTransactionId?: string;
+  }) => Promise<TransactionDisputeApplyResult>;
+  emitCritical: (extra: Record<string, unknown>) => void;
+};
+
+export async function handleTransactionDispute(
+  deps: TransactionDisputeDeps,
+  context: WebhookHandlerContext,
+): Promise<"processed" | "skipped"> {
+  const referenceCode = extractReferenceCode(context.payload);
+  if (!referenceCode) {
+    throw new Error("REFERENCE_CODE_MISSING");
+  }
+
+  const providerIds = extractProviderIds(context.payload);
+  const result = await deps.applyDispute({
+    referenceCode,
+    webhookEventId: context.eventId,
+    providerTransactionId: providerIds.transactionId,
+  });
+
+  if (result.outcome === "disputed") {
+    deps.emitCritical({
+      event: "transaction_dispute_received",
+      contracted_service_id: result.service_id,
+      gateway_transaction_id: result.gateway_transaction_id,
+      schedule_id: result.schedule_id,
+      schedule_state: result.state,
+      webhook_event_id: context.eventId,
+    });
+    return "processed";
+  }
+
+  throw new Error("SCHEDULE_NOT_FOUND");
+}
