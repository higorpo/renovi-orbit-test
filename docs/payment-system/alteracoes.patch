index 0000000..9974a29
--- /dev/null
+++ b/supabase/functions/accept-proposal/__tests__/handleRequest_test.ts
@@ -0,0 +1,209 @@
+import { assertEquals } from "std/testing/asserts";
+import {
+  computeHMACSHA256,
+  serializeInstallmentHmacPayload,
+} from "../../calculate-installment-options/hmac.ts";
+import type { InstallmentHmacPayload } from "../../calculate-installment-options/types.ts";
+import {
+  handleAcceptProposalRequest,
+  type AcceptProposalDeps,
+} from "../handleRequest.ts";
+import { computePricingSignature } from "../validatePricingSignature.ts";
+
+const proposal = {
+  id: "proposal-1",
+  provider_id: "provider-1",
+  proposed_amount: 1000,
+  tax_rate: 0.1,
+  tax_amount: 100,
+  final_amount: 900,
+  pricing_signature: "",
+};
+
+const installmentOptions = [{
+  installment_number: 1,
+  applicable_rate_pct: 2.39,
+  total_with_fees: 1024.29,
+  installment_amount: 1024.29,
+}];
+
+function buildHmacPayload(expiresAt: string): InstallmentHmacPayload {
+  return {
+    proposal_id: "proposal-1",
+    service_id: "service-1",
+    base_amount: 1000,
+    card_brand: "VCC",
+    installment_options: installmentOptions,
+    computed_at: "2026-06-24T12:00:00.000Z",
+    expires_at: expiresAt,
+  };
+}
+
+async function buildRequestBody(
+  secret: string,
+  pricingSecret: string,
+  expiresAt: string,
+): Promise<Record<string, unknown>> {
+  const hmacPayload = buildHmacPayload(expiresAt);
+  proposal.pricing_signature = await computePricingSignature(pricingSecret, proposal);
+
+  return {
+    proposal_id: "proposal-1",
+    provider_id: "provider-1",
+    service_id: "service-1",
+    installment_number: 1,
+    installment_selection_hmac: await computeHMACSHA256(
+      secret,
+      serializeInstallmentHmacPayload(hmacPayload),
+    ),
+    payment_token_id: "token-1",
+    scheduled_date: "2026-07-01T10:00:00.000Z",
+    clearsale_session_id: "clearsale-session",
+    base_amount: 1000,
+    card_brand: "VCC",
+    installment_options: installmentOptions,
+    computed_at: hmacPayload.computed_at,
+    expires_at: hmacPayload.expires_at,
+    idempotency_key: "11111111-1111-1111-1111-111111111111",
+  };
+}
+
+function createDeps(overrides: Partial<AcceptProposalDeps> = {}): AcceptProposalDeps {
+  return {
+    getUser: async () => ({ user: { id: "client-1" }, error: null }),
+    getInstallmentSigningSecret: async () => "installment-secret",
+    getPricingSignatureSecret: async () => "pricing-secret",
+    loadProposal: async () => ({ ...proposal }),
+    loadPaymentToken: async () => ({
+      id: "token-1",
+      client_id: "client-1",
+      state: "ACTIVE",
+    }),
+    loadProviderAccount: async () => ({
+      provider_id: "provider-1",
+      onboarding_status: "ACTIVE",
+    }),
+    acceptProposalRpc: async () => ({
+      contracted_service_id: "service-contract-1",
+      schedule_id: "schedule-1",
+      is_idempotent: false,
+    }),
+    checkRateLimit: async () => ({ allowed: true, retryAfter: 0 }),
+    getPaymentRolloutPercentage: async () => 100,
+    ...overrides,
+  };
+}
+
+function authRequest(body: Record<string, unknown>): Request {
+  return new Request("https://example.com/accept-proposal", {
+    method: "POST",
+    headers: {
+      Authorization: "Bearer jwt-token",
+      "Content-Type": "application/json",
+      "CF-Connecting-IP": "189.0.0.1",
+    },
+    body: JSON.stringify(body),
+  });
+}
+
+Deno.test("expired installment HMAC returns HTTP 400 INSTALLMENT_SIGNATURE_EXPIRED", async () => {
+  const body = await buildRequestBody(
+    "installment-secret",
+    "pricing-secret",
+    "2020-01-01T00:00:00.000Z",
+  );
+
+  const response = await handleAcceptProposalRequest(
+    authRequest(body),
+    createDeps({ now: () => new Date("2026-06-24T12:00:00.000Z") }),
+  );
+
+  assertEquals(response.status, 400);
+  const payload = await response.json();
+  assertEquals(payload.error_code, "INSTALLMENT_SIGNATURE_EXPIRED");
+});
+
+Deno.test("inactive provider returns HTTP 409 PROVIDER_NOT_CREDENTIALED", async () => {
+  const body = await buildRequestBody(
+    "installment-secret",
+    "pricing-secret",
+    "2099-01-01T00:00:00.000Z",
+  );
+
+  const response = await handleAcceptProposalRequest(
+    authRequest(body),
+    createDeps({
+      loadProviderAccount: async () => ({
+        provider_id: "provider-1",
+        onboarding_status: "PENDING_DOCUMENTS",
+      }),
+    }),
+  );
+
+  assertEquals(response.status, 409);
+  const payload = await response.json();
+  assertEquals(payload.error_code, "PROVIDER_NOT_CREDENTIALED");
+});
+
+Deno.test("feature flag gate returns 403 when rollout percentage is 0", async () => {
+  const body = await buildRequestBody(
+    "installment-secret",
+    "pricing-secret",
+    "2099-01-01T00:00:00.000Z",
+  );
+
+  const response = await handleAcceptProposalRequest(
+    authRequest(body),
+    createDeps({
+      getPaymentRolloutPercentage: async () => 0,
+      rolloutRandom: () => 50,
+    }),
+  );
+
+  assertEquals(response.status, 403);
+  const payload = await response.json();
+  assertEquals(payload.error, "feature_not_available");
+});
+
+Deno.test("idempotent retry returns existing contracted_service_id", async () => {
+  const body = await buildRequestBody(
+    "installment-secret",
+    "pricing-secret",
+    "2099-01-01T00:00:00.000Z",
+  );
+
+  let callCount = 0;
+  const response = await handleAcceptProposalRequest(
+    authRequest(body),
+    createDeps({
+      acceptProposalRpc: async () => {
+        callCount += 1;
+        return {
+          contracted_service_id: "service-contract-1",
+          schedule_id: "schedule-1",
+          is_idempotent: callCount > 1,
+        };
+      },
+    }),
+  );
+
+  assertEquals(response.status, 200);
+  const payload = await response.json();
+  assertEquals(payload.contracted_service_id, "service-contract-1");
+
+  const retry = await handleAcceptProposalRequest(
+    authRequest(body),
+    createDeps({
+      acceptProposalRpc: async () => ({
+        contracted_service_id: "service-contract-1",
+        schedule_id: "schedule-1",
+        is_idempotent: true,
+      }),
+    }),
+  );
+
+  assertEquals(retry.status, 200);
+  const retryPayload = await retry.json();
+  assertEquals(retryPayload.contracted_service_id, "service-contract-1");
+  assertEquals(retryPayload.is_idempotent, true);
+});
