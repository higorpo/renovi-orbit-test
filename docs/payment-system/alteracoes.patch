+};
+
+Deno.test("TRANSACTION_UPDATE with PAID delegates to capture handler", async () => {
+  const ingested: string[] = [];
+  let captureCalled = false;
+
+  const result = await handleTransactionUpdate(
+    createDeps({
+      capture: {
+        applyCapture: async () => {
+          captureCalled = true;
+          return {
+            outcome: "paid",
+            service_id: "service-1",
+            client_id: "client-1",
+            provider_id: "provider-1",
+            installment_number: 1,
+            charge_amount: "250.00",
+            from_state: "IN_ANALYSIS",
+          };
