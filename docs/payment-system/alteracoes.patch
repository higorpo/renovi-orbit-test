@@ -0,0 +1,166 @@
+-- Payment System — task 45: TRANSACTION_CAPTURE webhook PAID transition (design §4.7.2).
+
+alter table public.payment_schedules
+  add column if not exists webhook_confirmed_at timestamptz;
+
+comment on column public.payment_schedules.webhook_confirmed_at is
+  'Set when TRANSACTION_CAPTURE webhook confirms PAID (including redundant confirmations).';
+
+create or replace function public.webhook_transaction_capture_rpc(
+  p_reference_code uuid,
+  p_webhook_event_id text,
+  p_paid_amount numeric(12, 2) default null,
+  p_gateway_charge_id text default null,
+  p_gateway_transaction_id text default null
+)
+returns jsonb
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_schedule public.payment_schedules%rowtype;
+  v_from_state text;
+  v_charge_amount numeric(12, 2);
+begin
+  select ps.*
+  into v_schedule
+  from public.payment_schedules ps
+  where ps.contracted_service_id = p_reference_code
+  for update;
+
+  if not found then
+    return jsonb_build_object('outcome', 'not_found');
+  end if;
+
+  v_from_state := v_schedule.state;
+
+  if v_schedule.state = 'PAID' then
+    update public.payment_schedules ps
+    set
+      webhook_confirmed_at = now(),
+      updated_at = now()
+    where ps.id = v_schedule.id;
+
+    return jsonb_build_object(
+      'outcome', 'already_paid',
+      'schedule_id', v_schedule.id,
+      'service_id', v_schedule.contracted_service_id,
+      'from_state', v_from_state
+    );
+  end if;
+
+  if v_schedule.state not in ('IN_ANALYSIS', 'PROCESSING') then
+    return jsonb_build_object(
+      'outcome', 'skipped',
+      'reason', 'invalid_transition',
+      'schedule_id', v_schedule.id,
+      'service_id', v_schedule.contracted_service_id,
+      'from_state', v_from_state
+    );
+  end if;
+
+  v_charge_amount := coalesce(
+    p_paid_amount,
+    v_schedule.paid_amount,
+    public.calculate_charge_amount(
+      v_schedule.payment_token_id,
+      v_schedule.base_amount,
+      v_schedule.installment_number
+    )
+  );
+
+  update public.payment_schedules ps
+  set
+    state = 'PAID',
+    paid_at = coalesce(ps.paid_at, now()),
+    paid_amount = v_charge_amount,
+    gateway_charge_id = coalesce(p_gateway_charge_id, ps.gateway_charge_id),
+    gateway_transaction_id = coalesce(p_gateway_transaction_id, ps.gateway_transaction_id),
+    webhook_confirmed_at = now(),
+    locked_until = null,
+    next_retry_at = null,
+    failure_code = null,
+    failure_reason = null,
+    updated_at = now()
+  where ps.id = v_schedule.id;
+
+  update public.contracted_services cs
+  set status = 'CONFIRMED'::public.contracted_service_status
+  where cs.id = v_schedule.contracted_service_id
+    and cs.status = 'PENDING_PAYMENT'::public.contracted_service_status;
+
+  insert into public.payment_audit_log (
+    event_type,
+    entity_type,
+    entity_id,
+    service_id,
+    schedule_id,
+    from_state,
+    to_state,
+    actor,
+    metadata
+  )
+  values (
+    'CHARGE_PAID',
+    'payment_schedule',
+    v_schedule.id,
+    v_schedule.contracted_service_id,
+    v_schedule.id,
+    v_from_state,
+    'PAID',
+    'webhook',
+    jsonb_build_object(
+      'webhook_event_id', p_webhook_event_id,
+      'charge_amount', v_charge_amount,
+      'gateway_charge_id', p_gateway_charge_id,
+      'gateway_transaction_id', p_gateway_transaction_id,
+      'source', 'TRANSACTION_CAPTURE'
+    )
+  );
+
+  insert into public.payment_events (
+    event_type,
+    aggregate_type,
+    aggregate_id,
+    service_id,
+    payload
+  )
+  values (
+    'ChargeSucceeded',
+    'payment_schedule',
+    v_schedule.id,
+    v_schedule.contracted_service_id,
+    jsonb_build_object(
+      'outcome', 'PAID',
+      'charge_amount', v_charge_amount,
+      'initiator', 'webhook',
+      'webhook_event_id', p_webhook_event_id
+    )
+  );
+
+  return jsonb_build_object(
+    'outcome', 'paid',
+    'schedule_id', v_schedule.id,
+    'service_id', v_schedule.contracted_service_id,
+    'client_id', v_schedule.client_id,
+    'provider_id', v_schedule.provider_id,
+    'installment_number', v_schedule.installment_number,
+    'charge_amount', v_charge_amount,
+    'from_state', v_from_state,
+    'service_status', 'CONFIRMED'
+  );
+end;
+$$;
+
+comment on function public.webhook_transaction_capture_rpc(
+  uuid, text, numeric, text, text
+) is
+  'TRANSACTION_CAPTURE webhook: IN_ANALYSIS/PROCESSING → PAID; redundant PAID updates webhook_confirmed_at.';
+
+revoke all on function public.webhook_transaction_capture_rpc(
+  uuid, text, numeric, text, text
+) from public, anon, authenticated;
+grant execute on function public.webhook_transaction_capture_rpc(
+  uuid, text, numeric, text, text
+) to service_role;
