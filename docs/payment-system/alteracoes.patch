+export function extractReferenceCode(
+  payload: Record<string, unknown>,
+): string | null {
+  const candidates = [
+    payload.referenceCode,
+    payload.reference_code,
+    (payload.transaction as Record<string, unknown> | undefined)?.referenceCode,
+    (payload.charge as Record<string, unknown> | undefined)?.referenceCode,
+    (payload.data as Record<string, unknown> | undefined)?.referenceCode,
+  ];
+
+  for (const candidate of candidates) {
+    if (typeof candidate === "string" && candidate.trim().length > 0) {
+      return candidate.trim();
+    }
+  }
+
+  return null;
+}
+
+export function extractPaidAmount(payload: Record<string, unknown>): string | null {
+  const candidates = [
+    payload.paidAmount,
+    payload.paid_amount,
+    (payload.transaction as Record<string, unknown> | undefined)?.paidAmount,
+    (payload.transaction as Record<string, unknown> | undefined)?.amount,
+  ];
+
+  for (const candidate of candidates) {
+    if (typeof candidate === "string" && candidate.trim().length > 0) {
+      return candidate.trim();
+    }
+    if (typeof candidate === "number" && Number.isFinite(candidate)) {
+      return candidate.toFixed(2);
+    }
+  }
+
+  return null;
+}
+
+export function extractProviderIds(payload: Record<string, unknown>): {
+  chargeId?: string;
+  transactionId?: string;
+} {
+  const transaction = payload.transaction as Record<string, unknown> | undefined;
+  const charge = payload.charge as Record<string, unknown> | undefined;
+
+  const chargeId = [
+    payload.chargeId,
+    charge?.id,
+    transaction?.chargeId,
+  ].find((value) => typeof value === "string" && value.trim().length > 0);
+
+  const transactionId = [
+    payload.transactionId,
+    transaction?.id,
+  ].find((value) => typeof value === "string" && value.trim().length > 0);
+
+  return {
+    chargeId: typeof chargeId === "string" ? chargeId : undefined,
+    transactionId: typeof transactionId === "string" ? transactionId : undefined,
+  };
+}
+
+export function extractTransactionState(
+  payload: Record<string, unknown>,
+): string | null {
+  const candidates = [
+    payload.transactionState,
+    payload.transaction_state,
+    (payload.transaction as Record<string, unknown> | undefined)?.transactionState,
+    (payload.data as Record<string, unknown> | undefined)?.transactionState,
+  ];
+
+  for (const candidate of candidates) {
+    if (typeof candidate === "string" && candidate.trim().length > 0) {
+      return candidate.trim().toUpperCase();
+    }
+  }
+
+  return null;
+}
+
+export function extractFailureDetails(payload: Record<string, unknown>): {
+  failureCode?: string;
+  failureReason?: string;
+} {
+  const transaction = payload.transaction as Record<string, unknown> | undefined;
+
+  const failureCode = [
+    payload.failureCode,
+    payload.failure_code,
+    transaction?.failureCode,
+    transaction?.reasonCode,
+  ].find((value) => typeof value === "string" && value.trim().length > 0);
+
+  const failureReason = [
+    payload.failureReason,
+    payload.failure_reason,
+    transaction?.failureReason,
+    transaction?.reason,
+  ].find((value) => typeof value === "string" && value.trim().length > 0);
+
+  return {
+    failureCode: typeof failureCode === "string" ? failureCode : undefined,
+    failureReason: typeof failureReason === "string" ? failureReason : undefined,
+  };
+}
+
+export function extractRefundedAmount(payload: Record<string, unknown>): string | null {
+  const candidates = [
+    payload.refundedAmount,
+    payload.refunded_amount,
+    (payload.transaction as Record<string, unknown> | undefined)?.refundedAmount,
+    (payload.refund as Record<string, unknown> | undefined)?.amount,
+  ];
+
+  for (const candidate of candidates) {
+    if (typeof candidate === "string" && candidate.trim().length > 0) {
+      return candidate.trim();
+    }
+    if (typeof candidate === "number" && Number.isFinite(candidate)) {
+      return candidate.toFixed(2);
+    }
