+    ...PAYMENT_PLATFORM_CONSTANT_DEFAULTS,
+    cc_fixed_processing_fee_brl: 0,
+  });
+  const withFee = calculateChargeAmount(1000, "VCC", 1, PAYMENT_PLATFORM_CONSTANT_DEFAULTS);
