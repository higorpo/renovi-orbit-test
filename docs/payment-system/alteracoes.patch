+import { assertEquals } from "std/testing/asserts";
+import {
+  handleNotifyUpcomingChargesRequest,
+  type NotifyUpcomingChargesDeps,
+} from "../handleRequest.ts";
+import type { UpcomingChargeSchedule } from "../types.ts";
+
+function createDeps(
+  overrides: Partial<NotifyUpcomingChargesDeps> = {},
+): NotifyUpcomingChargesDeps {
+  return {
+    claimSchedules: async () => [],
+    ingestNotification: async () => {},
+    ...overrides,
+  };
+}
+
+function cronRequest(): Request {
+  return new Request("https://example.com/notify-upcoming-charges", {
+    method: "POST",
+    headers: { Authorization: "Bearer test-service-role" },
+  });
+}
+
+const eligibleSchedule: UpcomingChargeSchedule = {
+  schedule_id: "schedule-1",
+  service_id: "service-1",
+  client_id: "client-1",
+  charge_scheduled_at: "2026-06-25T12:00:00.000Z",
+  installment_number: 3,
+  base_amount: 300,
+  charge_amount: 105.42,
+  card_number_masked: "**** 4242",
+  card_brand: "VCC",
+};
+
+Deno.test("claimed schedules enqueue client push and email only", async () => {
+  const ingested: string[] = [];
+
+  Deno.env.set("SUPABASE_SERVICE_ROLE_KEY", "test-service-role");
+  try {
+    const response = await handleNotifyUpcomingChargesRequest(
+      cronRequest(),
+      createDeps({
+        claimSchedules: async () => [eligibleSchedule],
+        ingestNotification: async (input) => {
+          ingested.push(`${input.profileId}:${input.templateKey}`);
+        },
+      }),
+    );
+
+    assertEquals(response.status, 200);
+    const body = await response.json();
+    assertEquals(body.claimed_count, 1);
+    assertEquals(body.notifications_enqueued, 2);
+    assertEquals(ingested.includes("client-1:upcoming_charge_reminder"), true);
+    assertEquals(ingested.includes("client-1:upcoming_charge_reminder_email"), true);
+    assertEquals(ingested.some((entry) => entry.startsWith("provider-")), false);
+  } finally {
+    Deno.env.delete("SUPABASE_SERVICE_ROLE_KEY");
+  }
+});
+
+Deno.test("duplicate invocation returns no claimed rows and sends no notifications", async () => {
+  let claimCount = 0;
+  let ingestCalled = false;
+
+  Deno.env.set("SUPABASE_SERVICE_ROLE_KEY", "test-service-role");
+  try {
+    const deps = createDeps({
+      claimSchedules: async () => {
+        claimCount += 1;
+        return claimCount === 1 ? [eligibleSchedule] : [];
+      },
+      ingestNotification: async () => {
+        ingestCalled = true;
+      },
+    });
+
+    const first = await handleNotifyUpcomingChargesRequest(cronRequest(), deps);
+    assertEquals((await first.json()).claimed_count, 1);
+
+    ingestCalled = false;
+    const second = await handleNotifyUpcomingChargesRequest(cronRequest(), deps);
+    const secondBody = await second.json();
+
+    assertEquals(secondBody.claimed_count, 0);
+    assertEquals(secondBody.notifications_enqueued, 0);
+    assertEquals(ingestCalled, false);
+  } finally {
+    Deno.env.delete("SUPABASE_SERVICE_ROLE_KEY");
+  }
+});
+
+Deno.test("emergency scheduled charge is excluded from claim results", async () => {
+  let ingestCalled = false;
+
+  Deno.env.set("SUPABASE_SERVICE_ROLE_KEY", "test-service-role");
+  try {
+    const response = await handleNotifyUpcomingChargesRequest(
+      cronRequest(),
+      createDeps({
+        claimSchedules: async () => [],
+        ingestNotification: async () => {
+          ingestCalled = true;
+        },
+      }),
+    );
+
+    assertEquals(response.status, 200);
+    const body = await response.json();
+    assertEquals(body.claimed_count, 0);
+    assertEquals(body.notifications_enqueued, 0);
+    assertEquals(ingestCalled, false);
+  } finally {
+    Deno.env.delete("SUPABASE_SERVICE_ROLE_KEY");
+  }
+});
