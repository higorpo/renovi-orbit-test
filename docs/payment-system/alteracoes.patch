diff --git a/supabase/migrations/20260705209200_rpc_process_refund.sql b/supabase/migrations/20260705209200_rpc_process_refund.sql
new file mode 100644
index 0000000..563d76a
--- /dev/null
+++ b/supabase/migrations/20260705209200_rpc_process_refund.sql
@@ -0,0 +1,358 @@
+-- Payment System — task 35: process-refund RPCs (design §4.8).
+
+create or replace function public.process_refund_pre_charge_cancel_rpc(
+  p_service_id uuid,
+  p_actor_id uuid,
+  p_cancellation_reason text,
+  p_initiator text
+)
+returns uuid
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_service public.contracted_services%rowtype;
+  v_schedule public.payment_schedules%rowtype;
+  v_reason text;
+begin
+  if p_initiator not in ('client', 'provider') then
+    raise exception 'INVALID_INITIATOR' using errcode = 'P0001';
+  end if;
+
+  select cs.*
+  into v_service
+  from public.contracted_services cs
+  where cs.id = p_service_id
+  for update;
+
+  if not found then
+    raise exception 'SERVICE_NOT_FOUND' using errcode = 'P0001';
+  end if;
+
+  if p_initiator = 'client' and v_service.client_id <> p_actor_id then
+    raise exception 'FORBIDDEN' using errcode = 'P0001';
+  end if;
+
+  if p_initiator = 'provider' and v_service.provider_id <> p_actor_id then
+    raise exception 'FORBIDDEN' using errcode = 'P0001';
+  end if;
+
+  if v_service.status = 'COMPLETED' then
+    raise exception 'SERVICE_NOT_CANCELLABLE' using errcode = 'P0001';
+  end if;
+
+  select ps.*
+  into v_schedule
+  from public.payment_schedules ps
+  where ps.contracted_service_id = p_service_id
+  for update;
+
+  if not found then
+    raise exception 'SCHEDULE_NOT_FOUND' using errcode = 'P0001';
+  end if;
+
+  if v_schedule.state = 'IN_ANALYSIS' then
+    raise exception 'PAYMENT_IN_ANALYSIS' using errcode = 'P0001';
+  end if;
+
+  if v_schedule.state not in ('SCHEDULED', 'FAILED', 'FAILED_PERMANENT') then
+    raise exception 'INVALID_SCHEDULE_STATE' using errcode = 'P0001';
+  end if;
+
+  v_reason := coalesce(
+    nullif(btrim(p_cancellation_reason), ''),
+    case p_initiator
+      when 'client' then 'CLIENT_INITIATED'
+      else 'PROVIDER_INITIATED'
+    end
+  );
+
+  update public.contracted_services cs
+  set
+    status = 'CANCELLED',
+    cancellation_reason = v_reason
+  where cs.id = p_service_id;
+
+  update public.payment_schedules ps
+  set
+    state = 'CANCELLED',
+    cancelled_at = now(),
+    cancellation_reason = v_reason,
+    updated_at = now()
+  where ps.id = v_schedule.id;
+
+  insert into public.payment_audit_log (
+    event_type,
+    entity_type,
+    entity_id,
+    service_id,
+    schedule_id,
+    from_state,
+    to_state,
+    actor,
+    actor_id,
+    metadata
+  )
+  values (
+    'PRE_CHARGE_CANCELLED',
+    'payment_schedule',
+    v_schedule.id,
+    p_service_id,
+    v_schedule.id,
+    v_schedule.state,
+    'CANCELLED',
+    case p_initiator when 'client' then 'client' else 'system' end,
+    p_actor_id,
+    jsonb_build_object(
+      'cancellation_reason', v_reason,
+      'initiator', p_initiator
+    )
+  );
+
+  insert into public.payment_events (
+    event_type,
+    aggregate_type,
+    aggregate_id,
+    service_id,
+    payload
+  )
+  values (
+    'ServiceAutoCancelled',
+    'contracted_service',
+    p_service_id,
+    p_service_id,
+    jsonb_build_object(
+      'schedule_id', v_schedule.id,
+      'cancellation_reason', v_reason,
+      'pre_charge', true
+    )
+  );
+
+  return v_schedule.id;
+end;
+$$;
+
+create or replace function public.process_refund_submit_rpc(
+  p_service_id uuid,
+  p_actor_id uuid,
+  p_cancellation_reason text,
+  p_initiator text,
+  p_refund_amount numeric(12, 2),
+  p_penalty_tier text
+)
+returns jsonb
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_service public.contracted_services%rowtype;
+  v_schedule public.payment_schedules%rowtype;
+  v_reason text;
+begin
+  if p_initiator not in ('client', 'provider') then
+    raise exception 'INVALID_INITIATOR' using errcode = 'P0001';
+  end if;
+
+  select cs.*
+  into v_service
+  from public.contracted_services cs
+  where cs.id = p_service_id
+  for update;
+
+  if not found then
+    raise exception 'SERVICE_NOT_FOUND' using errcode = 'P0001';
+  end if;
+
+  if p_initiator = 'client' and v_service.client_id <> p_actor_id then
+    raise exception 'FORBIDDEN' using errcode = 'P0001';
+  end if;
+
+  if p_initiator = 'provider' and v_service.provider_id <> p_actor_id then
+    raise exception 'FORBIDDEN' using errcode = 'P0001';
+  end if;
+
+  if v_service.status = 'COMPLETED' then
+    raise exception 'SERVICE_NOT_CANCELLABLE' using errcode = 'P0001';
+  end if;
+
+  select ps.*
+  into v_schedule
+  from public.payment_schedules ps
+  where ps.contracted_service_id = p_service_id
+    and ps.state = 'PAID'
+  for update;
+
+  if not found then
+    if exists (
+      select 1
+      from public.payment_schedules ps
+      where ps.contracted_service_id = p_service_id
+        and ps.state = 'IN_ANALYSIS'
+    ) then
+      raise exception 'PAYMENT_IN_ANALYSIS' using errcode = 'P0001';
+    end if;
+
+    if exists (
+      select 1
+      from public.payment_schedules ps
+      where ps.contracted_service_id = p_service_id
+        and ps.state = 'REFUND_REQUESTED'
+    ) then
+      return jsonb_build_object(
+        'schedule_id', (
+          select ps.id
+          from public.payment_schedules ps
+          where ps.contracted_service_id = p_service_id
+            and ps.state = 'REFUND_REQUESTED'
+          limit 1
+        ),
+        'gateway_transaction_id', (
+          select ps.gateway_transaction_id
+          from public.payment_schedules ps
+          where ps.contracted_service_id = p_service_id
+            and ps.state = 'REFUND_REQUESTED'
+          limit 1
+        ),
+        'refund_amount', p_refund_amount,
+        'already_submitted', true
+      );
+    end if;
+
+    raise exception 'INVALID_SCHEDULE_STATE' using errcode = 'P0001';
+  end if;
+
+  if v_schedule.gateway_transaction_id is null then
+    raise exception 'TRANSACTION_NOT_FOUND' using errcode = 'P0001';
+  end if;
+
+  v_reason := coalesce(
+    nullif(btrim(p_cancellation_reason), ''),
+    case p_initiator
+      when 'client' then 'CLIENT_INITIATED'
+      else 'PROVIDER_INITIATED'
+    end
+  );
+
+  update public.payment_schedules ps
+  set
+    state = 'REFUND_REQUESTED',
+    updated_at = now()
+  where ps.id = v_schedule.id;
+
+  update public.contracted_services cs
+  set
+    status = 'CANCELLED',
+    cancellation_reason = v_reason
+  where cs.id = p_service_id;
+
+  insert into public.payment_audit_log (
+    event_type,
+    entity_type,
+    entity_id,
+    service_id,
+    schedule_id,
+    from_state,
+    to_state,
+    actor,
+    actor_id,
+    metadata
+  )
+  values (
+    'REFUND_SUBMITTED',
+    'payment_schedule',
+    v_schedule.id,
+    p_service_id,
+    v_schedule.id,
+    'PAID',
+    'REFUND_REQUESTED',
+    case p_initiator when 'client' then 'client' else 'system' end,
+    p_actor_id,
+    jsonb_build_object(
+      'refund_amount', p_refund_amount,
+      'penalty_tier', p_penalty_tier,
+      'cancellation_reason', v_reason
+    )
+  );
+
+  insert into public.payment_events (
+    event_type,
+    aggregate_type,
+    aggregate_id,
+    service_id,
+    payload
+  )
+  values (
+    'RefundRequested',
+    'payment_schedule',
+    v_schedule.id,
+    p_service_id,
+    jsonb_build_object(
+      'refund_amount', p_refund_amount,
+      'penalty_tier', p_penalty_tier,
+      'initiator', p_initiator
+    )
+  );
+
+  return jsonb_build_object(
+    'schedule_id', v_schedule.id,
+    'gateway_transaction_id', v_schedule.gateway_transaction_id,
+    'paid_amount', v_schedule.paid_amount,
+    'base_amount', v_schedule.base_amount,
+    'refund_amount', p_refund_amount,
+    'already_submitted', false
+  );
+end;
+$$;
+
+create or replace function public.process_refund_record_failed_rpc(
+  p_schedule_id uuid,
+  p_service_id uuid,
+  p_actor_id uuid,
+  p_initiator text,
+  p_error_message text
+)
+returns void
+language plpgsql
+security definer
