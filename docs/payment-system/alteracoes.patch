diff --git a/supabase/migrations/20260705208000_rpc_calculate_charge_amount.sql b/supabase/migrations/20260705208000_rpc_calculate_charge_amount.sql
new file mode 100644
index 0000000..d8c4ff7
--- /dev/null
+++ b/supabase/migrations/20260705208000_rpc_calculate_charge_amount.sql
@@ -0,0 +1,70 @@
+-- Payment System — Phase 3 task 17: calculate_charge_amount RPC (design §4.3.1).
+-- Requirements: 7, 10, 25. Acceptance: 7A.5, 7A.6, 10A.3, 25A.5.
+
+create or replace function public.calculate_charge_amount(
+  p_token_id uuid,
+  p_base_amount numeric(12, 2),
+  p_installment_n smallint
+)
+returns numeric(12, 2)
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_brand text;
+  v_rate_key text;
+  v_rate numeric;
+  v_fixed_fee numeric;
+  v_total_with_fees numeric;
+  v_charge_amount numeric(12, 2);
+begin
+  if p_installment_n < 1 or p_installment_n > 12 then
+    raise exception 'INVALID_INSTALLMENT_COUNT' using errcode = 'P0001';
+  end if;
+
+  select pt.card_brand
+  into v_brand
+  from public.payment_tokens pt
+  where pt.id = p_token_id;
+
+  if not found then
+    raise exception 'TOKEN_NOT_FOUND' using errcode = 'P0001';
+  end if;
+
+  v_rate_key := case
+    when v_brand in ('VCC', 'MASTER') and p_installment_n = 1
+      then 'cc_visa_master_1x_rate'
+    when v_brand in ('VCC', 'MASTER') and p_installment_n between 2 and 6
+      then 'cc_visa_master_2_6x_rate'
+    when v_brand in ('VCC', 'MASTER') and p_installment_n between 7 and 12
+      then 'cc_visa_master_7_12x_rate'
+    when p_installment_n = 1
+      then 'cc_elo_other_1x_rate'
+    when p_installment_n between 2 and 6
+      then 'cc_elo_other_2_6x_rate'
+    when p_installment_n between 7 and 12
+      then 'cc_elo_other_7_12x_rate'
+    else 'cc_elo_other_1x_rate'
+  end;
+
+  v_rate := public.platform_constant_numeric(v_rate_key, 2.69);
+  v_fixed_fee := public.platform_constant_numeric('cc_fixed_processing_fee_brl', 0.39);
+
+  v_total_with_fees := round(
+    (p_base_amount * (1 + v_rate / 100)) + v_fixed_fee,
+    2
+  );
+  v_charge_amount := round(v_total_with_fees / p_installment_n, 2);
+
+  return v_charge_amount;
+end;
+$$;
+
+comment on function public.calculate_charge_amount(uuid, numeric, smallint) is
+  'Authoritative per-installment charge amount from live platform_constants (design §4.3.1).';
+
+revoke all on function public.calculate_charge_amount(uuid, numeric, smallint) from public;
+revoke all on function public.calculate_charge_amount(uuid, numeric, smallint) from anon;
+revoke all on function public.calculate_charge_amount(uuid, numeric, smallint) from authenticated;
+grant execute on function public.calculate_charge_amount(uuid, numeric, smallint) to service_role;
diff --git a/supabase/migrations/20260705208100_rpc_accept_proposal.sql b/supabase/migrations/20260705208100_rpc_accept_proposal.sql
