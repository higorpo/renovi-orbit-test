+import type { WebhookHandlerContext } from "../types.ts";
+import { extractReferenceCode } from "./extractTransactionPayload.ts";
+
+export type ChargeVoidApplyResult = {
+  outcome: "voided" | "already_terminal" | "skipped" | "not_found";
+  reason?: string;
+  schedule_id?: string;
+  service_id?: string;
+  from_state?: string;
+};
+
+export type ChargeVoidDeps = {
+  applyVoid: (input: {
+    referenceCode: string;
+    webhookEventId: string;
+  }) => Promise<ChargeVoidApplyResult>;
+};
+
+export async function handleChargeVoid(
+  deps: ChargeVoidDeps,
+  context: WebhookHandlerContext,
+): Promise<"processed" | "skipped"> {
+  const referenceCode = extractReferenceCode(context.payload);
+  if (!referenceCode) {
+    throw new Error("REFERENCE_CODE_MISSING");
+  }
+
+  const result = await deps.applyVoid({
+    referenceCode,
+    webhookEventId: context.eventId,
+  });
+
+  if (
+    result.outcome === "voided" ||
+    result.outcome === "already_terminal" ||
+    result.outcome === "skipped"
+  ) {
+    return "processed";
+  }
+
+  throw new Error("SCHEDULE_NOT_FOUND");
+}
