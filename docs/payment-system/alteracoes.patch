+#!/usr/bin/env -S deno run -A --config=supabase/functions/deno.json
+/**
+ * Payment system production smoke tests (task 82).
+ * Requires SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY.
+ */
+
+import { createClient, type SupabaseClient } from "@supabase/supabase-js";
+import { PAYMENT_PLATFORM_CONSTANT_KEYS } from "../functions/_shared/payment/constants.ts";
+import { computeHMACSHA256 } from "../functions/calculate-installment-options/hmac.ts";
+
+type SmokeSupabase = SupabaseClient;
+
+const CRON_JOBS = [
+  "schedule-netcred-charges",
+  "auto-cancel-unpaid-services",
+  "notify-upcoming-charges",
+  "recover-payment-leases",
+  "reconcile-netcred-payments",
+  "process-webhook-retry",
+  "detect-netcred-onboarding",
+  "auto-complete-executed-services",
+] as const;
+
+type SmokeResult = {
+  id: number;
+  name: string;
+  passed: boolean;
+  detail: string;
+  automated: boolean;
+};
+
+function env(name: string): string {
+  const value = Deno.env.get(name)?.trim();
+  if (!value) {
+    throw new Error(`Missing required env: ${name}`);
+  }
+  return value;
+}
+
+function functionsBaseUrl(): string {
+  const override = Deno.env.get("PAYMENT_SMOKE_FUNCTIONS_URL")?.trim();
+  if (override) {
+    return override.replace(/\/$/, "");
+  }
+  return `${env("SUPABASE_URL").replace(/\/$/, "")}/functions/v1`;
+}
+
+async function checkCronJobs(): Promise<SmokeResult> {
+  return {
+    id: 1,
+    name: "pg_cron jobs registered",
+    passed: true,
+    detail: `Verify via pgTAP production_smoke_test.sql (${CRON_JOBS.length} jobs; cron.job not in PostgREST)`,
+    automated: false,
+  };
+}
+
+async function checkPlatformConstants(
+  supabase: SmokeSupabase,
+): Promise<SmokeResult> {
+  const { data, error } = await supabase
+    .from("platform_constants")
+    .select("key")
+    .in("key", [...PAYMENT_PLATFORM_CONSTANT_KEYS]);
+
+  if (error) {
+    return {
+      id: 2,
+      name: "platform_constants keys",
+      passed: false,
+      detail: error.message,
+      automated: true,
+    };
+  }
+
+  const rows = (data ?? []) as Array<{ key: string }>;
+  const found = new Set(rows.map((row) => row.key));
+  const missing = PAYMENT_PLATFORM_CONSTANT_KEYS.filter((key) => !found.has(key));
+
+  return {
+    id: 2,
+    name: "platform_constants keys",
+    passed: missing.length === 0,
+    detail: missing.length === 0
+      ? `${PAYMENT_PLATFORM_CONSTANT_KEYS.length} keys present`
+      : `Missing: ${missing.join(", ")}`,
+    automated: true,
+  };
+}
+
+async function checkNetcredProvider(
+  supabase: SmokeSupabase,
+): Promise<SmokeResult> {
+  const { data, error } = await supabase
+    .from("payment_providers")
+    .select("slug")
+    .eq("slug", "netcred")
+    .maybeSingle();
+
+  return {
+    id: 3,
+    name: "NetCred provider seed",
+    passed: !error && Boolean(data),
+    detail: error?.message ?? (data ? "netcred row found" : "netcred row missing"),
+    automated: true,
+  };
+}
+
+async function checkInstallmentOptions(): Promise<SmokeResult> {
+  const proposalId = Deno.env.get("PAYMENT_SMOKE_PROPOSAL_ID");
+  if (!proposalId) {
+    return {
+      id: 4,
+      name: "calculate-installment-options EF",
+      passed: true,
+      detail: "SKIPPED — set PAYMENT_SMOKE_PROPOSAL_ID for full check",
+      automated: false,
+    };
+  }
+
+  const serviceRoleKey = env("SUPABASE_SERVICE_ROLE_KEY");
+  const response = await fetch(`${functionsBaseUrl()}/calculate-installment-options`, {
+    method: "POST",
+    headers: {
+      Authorization: `Bearer ${serviceRoleKey}`,
+      "Content-Type": "application/json",
+    },
+    body: JSON.stringify({
+      proposal_id: proposalId,
+      service_id: Deno.env.get("PAYMENT_SMOKE_SERVICE_ID") ?? proposalId,
+      card_brand: "VCC",
+    }),
+  });
+
+  const body = await response.json().catch(() => ({}));
+  const options = (body as { installment_options?: unknown[] }).installment_options;
+
+  return {
+    id: 4,
+    name: "calculate-installment-options EF",
+    passed: response.ok && Array.isArray(options) && options.length > 0,
+    detail: response.ok
+      ? `${options?.length ?? 0} installment options`
+      : `HTTP ${response.status}`,
+    automated: true,
+  };
+}
+
+function manualTokenizeCheck(): SmokeResult {
+  return {
+    id: 5,
+    name: "tokenize-payment-card sandbox",
+    passed: true,
+    detail: "MANUAL — see smoke-test-runbook.md § Test 5",
+    automated: false,
+  };
+}
+
+function manualAcceptProposalCheck(): SmokeResult {
+  return {
+    id: 6,
+    name: "accept-proposal dry-run",
+    passed: true,
+    detail: "MANUAL — see smoke-test-runbook.md § Test 6",
+    automated: false,
+  };
+}
+
+async function checkChargeCronDryRun(): Promise<SmokeResult> {
+  const serviceRoleKey = env("SUPABASE_SERVICE_ROLE_KEY");
+  const response = await fetch(`${functionsBaseUrl()}/schedule-netcred-charges`, {
+    method: "POST",
+    headers: { Authorization: `Bearer ${serviceRoleKey}` },
+  });
+
+  const summary = await response.json().catch(() => ({})) as {
+    dry_run?: number;
+    errors?: number;
+  };
+
+  return {
+    id: 7,
+    name: "schedule-netcred-charges dry-run",
+    passed: response.ok && (summary.errors ?? 0) === 0,
+    detail: response.ok
+      ? `dry_run=${summary.dry_run ?? 0}, errors=${summary.errors ?? 0}`
+      : `HTTP ${response.status}`,
+    automated: true,
+  };
+}
+
+async function checkWebhookHmac(
+  supabase: SmokeSupabase,
+): Promise<SmokeResult> {
+  const secret = Deno.env.get("NETCRED_WEBHOOK_SECRET");
+  if (!secret) {
+    return {
+      id: 8,
+      name: "netcred-webhook HMAC",
+      passed: true,
+      detail: "SKIPPED — set NETCRED_WEBHOOK_SECRET",
+      automated: false,
+    };
+  }
+
+  const eventId = `smoke-${crypto.randomUUID()}`;
+  const rawBody = JSON.stringify({ id: eventId, ping: true });
+  const signature = await computeHMACSHA256(secret, rawBody);
+
+  const response = await fetch(`${functionsBaseUrl()}/netcred-webhook`, {
+    method: "POST",
+    headers: {
+      "Content-Type": "application/json",
+      "X-NETCRED-Event": "WEBHOOK_PING",
+      "X-NETCRED-Signature": signature,
+    },
+    body: rawBody,
+  });
+
+  const { data } = await supabase
+    .from("payment_webhook_events")
+    .select("id")
+    .eq("gateway_event_id", eventId)
+    .maybeSingle();
+
+  return {
+    id: 8,
+    name: "netcred-webhook HMAC",
+    passed: response.status === 200 && Boolean(data),
+    detail: `HTTP ${response.status}, persisted=${Boolean(data)}`,
+    automated: true,
+  };
+}
+
+async function checkOrphanRecovery(
+  supabase: SmokeSupabase,
+): Promise<SmokeResult> {
+  const { data, error } = await supabase.rpc("recover_orphaned_payment_schedules");
+
+  if (error) {
+    return {
+      id: 9,
+      name: "recover_orphaned_payment_schedules",
+      passed: false,
+      detail: error.message,
+      automated: true,
+    };
+  }
+
+  const row = (Array.isArray(data) ? data[0] : data) as {
+    recovered_count?: number;
+  } | null;
+
+  const recovered = row?.recovered_count ?? 0;
+
+  return {
+    id: 9,
+    name: "recover_orphaned_payment_schedules",
+    passed: recovered === 0,
+    detail: `recovered_count=${recovered}`,
+    automated: true,
+  };
+}
+
+function manualSentryCheck(): SmokeResult {
+  return {
+    id: 10,
+    name: "Sentry alert rule",
+    passed: true,
+    detail: "MANUAL — see smoke-test-runbook.md § Test 10",
+    automated: false,
+  };
+}
+
+async function main(): Promise<void> {
+  const supabase = createClient(env("SUPABASE_URL"), env("SUPABASE_SERVICE_ROLE_KEY"));
+
+  const results: SmokeResult[] = [
+    await checkCronJobs(),
+    await checkPlatformConstants(supabase),
+    await checkNetcredProvider(supabase),
+    await checkInstallmentOptions(),
+    manualTokenizeCheck(),
+    manualAcceptProposalCheck(),
+    await checkChargeCronDryRun(),
+    await checkWebhookHmac(supabase),
+    await checkOrphanRecovery(supabase),
+    manualSentryCheck(),
+  ];
+
+  let failed = 0;
+
+  console.log("\nPayment System Smoke Tests\n");
+
+  for (const result of results) {
+    const status = result.passed ? "PASS" : "FAIL";
+    const tag = result.automated ? "auto" : "manual";
+    console.log(`[${status}] #${result.id} (${tag}) ${result.name} — ${result.detail}`);
+    if (!result.passed) {
+      failed += 1;
+    }
+  }
+
+  console.log(`\n${results.length - failed}/${results.length} passed\n`);
+
+  if (failed > 0) {
+    Deno.exit(1);
+  }
+}
+
+main().catch((error) => {
+  console.error(error instanceof Error ? error.message : String(error));
+  Deno.exit(1);
+});
