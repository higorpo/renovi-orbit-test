+create or replace function public.payment_cron_set_active(p_job_name text, p_active boolean)
+returns void
+language plpgsql
+security definer
+set search_path = extensions, public
+as $$
+begin
+  if p_job_name is null
+    or p_job_name not in (
+      'schedule-netcred-charges',
+      'auto-cancel-unpaid-services',
+      'notify-upcoming-charges',
+      'recover-payment-leases',
+      'reconcile-netcred-payments',
+      'process-webhook-retry',
+      'detect-netcred-onboarding',
+      'auto-complete-executed-services'
+    )
+  then
+    raise exception 'Unknown payment cron job: %', p_job_name
+      using errcode = '22023';
+  end if;
+
+  update cron.job j
+  set active = p_active
+  where j.jobname = p_job_name;
+
+  if not found then
+    raise exception 'Payment cron job not registered: %', p_job_name
+      using errcode = 'P0002';
+  end if;
+end;
+$$;
+
+create or replace function public.payment_cron_enable(p_job_name text)
+returns void
+language sql
+security definer
+set search_path = public, extensions
+as $$
+  select public.payment_cron_set_active(p_job_name, true);
+$$;
+
