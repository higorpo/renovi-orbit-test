+
+    vi.spyOn(injectSdkModule, "injectClearSaleSdk").mockImplementation((options) => {
+      options.onLoadFailed?.();
+      return () => {};
+    });
+
+    render(<CardStep onSessionIdGenerated={vi.fn()} />);
+
+    await waitFor(() => {
+      expect(logger.warn).toHaveBeenCalledWith("clearsale_sdk_load_failed", {
