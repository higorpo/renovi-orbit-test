+++ b/supabase/functions/update-payment-method/index.ts
@@ -0,0 +1,86 @@
+import "xhr";
+import { servePaymentFunction } from "../_shared/observability/sentry.ts";
+import { checkRateLimit } from "../_shared/rateLimiter.ts";
+import { createServiceRoleClient } from "../_shared/serviceRoleClient.ts";
+import { getVaultSecret } from "../calculate-installment-options/getVaultSecret.ts";
+import {
+  handleUpdatePaymentMethodRequest,
+  type UpdatePaymentMethodDeps,
+} from "./handleRequest.ts";
+
+function createDeps(): UpdatePaymentMethodDeps {
+  const supabase = createServiceRoleClient();
+
+  return {
+    getUser: async (token) => {
+      const { data: { user }, error } = await supabase.auth.getUser(token);
+      return { user, error: error ?? null };
+    },
+    getInstallmentSigningSecret: () =>
+      getVaultSecret(supabase, "INSTALLMENT_SIGNING_SECRET"),
+    loadContractedService: async (serviceId) => {
+      const { data, error } = await supabase
+        .from("contracted_services")
+        .select("id, client_id, status")
+        .eq("id", serviceId)
+        .maybeSingle();
+
+      if (error || !data) {
+        return null;
+      }
+
+      return data;
+    },
+    loadSchedule: async (serviceId, clientId) => {
+      const { data, error } = await supabase
+        .from("payment_schedules")
+        .select(
+          "id, contracted_service_id, client_id, payment_token_id, state, base_amount, charge_scheduled_at, installment_number",
+        )
+        .eq("contracted_service_id", serviceId)
+        .eq("client_id", clientId)
+        .maybeSingle();
+
+      if (error || !data) {
+        return null;
+      }
+
+      return data;
+    },
+    loadPaymentToken: async (tokenId, clientId) => {
+      const { data, error } = await supabase
+        .from("payment_tokens")
+        .select("id, client_id, state, card_brand")
+        .eq("id", tokenId)
+        .eq("client_id", clientId)
+        .maybeSingle();
+
+      if (error || !data) {
+        return null;
+      }
+
+      return data;
+    },
+    updatePaymentMethod: async (input) => {
+      const { data, error } = await supabase.rpc("update_payment_method_rpc", {
+        p_contracted_service_id: input.serviceId,
+        p_client_id: input.clientId,
+        p_new_payment_token_id: input.newPaymentTokenId,
+        p_actor_id: input.actorId,
+        p_old_payment_token_id: input.oldPaymentTokenId,
+        p_old_brand: input.oldBrand,
+        p_new_brand: input.newBrand,
+      });
+
+      if (error || !data) {
+        return null;
+      }
+
+      return String(data);
+    },
+    checkRateLimit,
+  };
+}
+
+servePaymentFunction("update-payment-method", (req) =>
+  handleUpdatePaymentMethodRequest(req, createDeps()));
diff --git a/supabase/functions/update-payment-method/parseBody.ts b/supabase/functions/update-payment-method/parseBody.ts
new file mode 100644
index 0000000..681d314
--- /dev/null
+++ b/supabase/functions/update-payment-method/parseBody.ts
@@ -0,0 +1,53 @@
+import type { InstallmentHmacPayload } from "../calculate-installment-options/types.ts";
+import type { UpdatePaymentMethodBody } from "./types.ts";
+
+export type ParsedUpdatePaymentMethodRequest = {
+  serviceId: string;
+  newPaymentTokenId: string;
+  installmentSelectionHmac?: string;
+  hmacPayload?: InstallmentHmacPayload;
+};
+
+export type ParseUpdatePaymentMethodError = {
+  status: 400;
+  error: string;
+};
+
+export function parseUpdatePaymentMethodBody(
+  body: UpdatePaymentMethodBody,
+): ParsedUpdatePaymentMethodRequest | ParseUpdatePaymentMethodError {
+  if (!body.service_id?.trim()) {
+    return { status: 400, error: "service_id is required" };
+  }
+
+  if (!body.new_payment_token_id?.trim()) {
+    return { status: 400, error: "new_payment_token_id is required" };
+  }
+
+  const parsed: ParsedUpdatePaymentMethodRequest = {
+    serviceId: body.service_id.trim(),
+    newPaymentTokenId: body.new_payment_token_id.trim(),
+    installmentSelectionHmac: body.installment_selection_hmac?.trim(),
+  };
+
+  if (
+    body.proposal_id &&
+    body.base_amount !== undefined &&
+    body.card_brand &&
+    body.computed_at &&
+    body.expires_at &&
+    Array.isArray(body.installment_options)
+  ) {
+    parsed.hmacPayload = {
+      proposal_id: body.proposal_id.trim(),
+      service_id: body.service_id.trim(),
+      base_amount: body.base_amount,
+      card_brand: body.card_brand.trim(),
+      installment_options: body.installment_options,
+      computed_at: body.computed_at.trim(),
+      expires_at: body.expires_at.trim(),
+    };
+  }
+
+  return parsed;
+}
