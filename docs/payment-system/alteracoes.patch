+
+Deno.test("bankersRound applies half-even at boundary values", () => {
+  assertEquals(bankersRound(2.125, 2), 2.12);
+  assertEquals(bankersRound(3.125, 2), 3.12);
+  assertEquals(postgresRound(2.125, 2), 2.13);
+  assertEquals(postgresRound(2.125, 2) !== bankersRound(2.125, 2), true);
