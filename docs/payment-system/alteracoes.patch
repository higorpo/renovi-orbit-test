@@ -0,0 +1,51 @@
+const PAYMENT_FUNCTION_DIRS = [
+  "tokenize-payment-card",
+  "accept-proposal",
+  "manual-charge-payment",
+  "schedule-netcred-charges",
+  "calculate-installment-options",
+  "netcred-webhook",
+  "process-refund",
+  "update-payment-method",
+] as const;
+
+const SOURCE_SUFFIXES = ["handleRequest.ts", "index.ts", "processSchedule.ts", "executeCharge.ts"] as const;
+
+const FORBIDDEN_LOG_PATTERNS = [
+  /logger\.(info|warn|error|debug)\([^)]*cardNumber/i,
+  /logger\.(info|warn|error|debug)\([^)]*cardData/i,
+  /logger\.(info|warn|error|debug)\([^)]*\.cvv/i,
+  /logger\.(info|warn|error|debug)\([^)]*securityCode/i,
+  /logger\.(info|warn|error|debug)\([^)]*gateway_card_token/i,
+];
+
+async function readIfExists(path: string): Promise<string | null> {
+  try {
+    return await Deno.readTextFile(path);
+  } catch {
+    return null;
+  }
+}
+
+Deno.test("payment Edge Functions do not log raw card fields", async () => {
+  const violations: string[] = [];
+  const base = new URL("../../../", import.meta.url).pathname;
+
+  for (const dir of PAYMENT_FUNCTION_DIRS) {
+    for (const suffix of SOURCE_SUFFIXES) {
+      const path = `${base}${dir}/${suffix}`;
+      const source = await readIfExists(path);
+      if (!source) continue;
+
+      for (const pattern of FORBIDDEN_LOG_PATTERNS) {
+        if (pattern.test(source)) {
+          violations.push(`${dir}/${suffix} matches ${pattern}`);
+        }
+      }
+    }
+  }
+
+  if (violations.length > 0) {
+    throw new Error(`PCI logging violations:\n${violations.join("\n")}`);
+  }
+});
