@@ -0,0 +1,85 @@
+-- Payment System — task 40: pre-charge notification claim RPC (design §4.10).
+
+create or replace function public.notify_upcoming_charges_claim_rpc(
+  p_batch_size int default 100
+)
+returns jsonb
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_batch_size int;
+  v_rows jsonb := '[]'::jsonb;
+  v_row record;
+begin
+  v_batch_size := greatest(coalesce(p_batch_size, 100), 1);
+
+  for v_row in
+    with eligible as (
+      select ps.id
+      from public.payment_schedules ps
+      join public.contracted_services cs on cs.id = ps.contracted_service_id
+      where ps.state = 'SCHEDULED'
+        and ps.upcoming_charge_notified_at is null
+        and ps.charge_scheduled_at - now() <= interval '24 hours'
+        and ps.charge_scheduled_at > now()
+        and ps.charge_scheduled_at >= now() + interval '1 hour'
+        and cs.status = 'PENDING_PAYMENT'
+        and ps.payment_token_id is not null
+      order by ps.charge_scheduled_at
+      limit v_batch_size
+      for update of ps skip locked
+    )
+    update public.payment_schedules ps
+    set
+      upcoming_charge_notified_at = now(),
+      updated_at = now()
+    from eligible e
+    where ps.id = e.id
+      and ps.upcoming_charge_notified_at is null
+    returning
+      ps.id,
+      ps.contracted_service_id,
+      ps.client_id,
+      ps.charge_scheduled_at,
+      ps.installment_number,
+      ps.base_amount,
+      ps.payment_token_id
+  loop
+    v_rows := v_rows || jsonb_build_array(jsonb_build_object(
+      'schedule_id', v_row.id,
+      'service_id', v_row.contracted_service_id,
+      'client_id', v_row.client_id,
+      'charge_scheduled_at', v_row.charge_scheduled_at,
+      'installment_number', v_row.installment_number,
+      'base_amount', v_row.base_amount,
+      'charge_amount', public.calculate_charge_amount(
+        v_row.payment_token_id,
+        v_row.base_amount,
+        v_row.installment_number
+      ),
+      'card_number_masked', (
+        select pt.card_number_masked
+        from public.payment_tokens pt
+        where pt.id = v_row.payment_token_id
+      ),
+      'card_brand', (
+        select pt.card_brand
+        from public.payment_tokens pt
+        where pt.id = v_row.payment_token_id
+      )
+    ));
+  end loop;
+
+  return v_rows;
+end;
+$$;
+
+comment on function public.notify_upcoming_charges_claim_rpc(int) is
+  'Atomically claims SCHEDULED rows within 24h of charge; sets upcoming_charge_notified_at (design §4.10).';
+
+revoke all on function public.notify_upcoming_charges_claim_rpc(int) from public;
+revoke all on function public.notify_upcoming_charges_claim_rpc(int) from anon;
+revoke all on function public.notify_upcoming_charges_claim_rpc(int) from authenticated;
+grant execute on function public.notify_upcoming_charges_claim_rpc(int) to service_role;
diff --git a/supabase/migrations/20260705209900_rpc_reconcile_netcred_payments.sql b/supabase/migrations/20260705209900_rpc_reconcile_netcred_payments.sql
new file mode 100644
index 0000000..bdfb58f
--- /dev/null
+++ b/supabase/migrations/20260705209900_rpc_reconcile_netcred_payments.sql
@@ -0,0 +1,299 @@
+-- Payment System — task 41: reconciliation polling RPCs (design §4.9).
+
+create or replace function public.reconcile_list_stale_schedules_rpc(
+  p_batch_size int default 50
+)
+returns jsonb
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_batch_size int;
+  v_rows jsonb := '[]'::jsonb;
+  v_row record;
+begin
+  v_batch_size := greatest(coalesce(p_batch_size, 50), 1);
+
+  for v_row in
+    select
+      ps.id,
+      ps.contracted_service_id,
+      ps.client_id,
+      ps.provider_id,
+      ps.state,
+      ps.installment_number,
+      ps.base_amount,
+      ps.payment_token_id,
+      ps.automatic_attempt_count,
+      ps.manual_attempt_count,
+      ps.max_attempts,
+      ps.reconciliation_failure_count
+    from public.payment_schedules ps
+    where ps.state in ('IN_ANALYSIS', 'PROCESSING', 'REFUND_REQUESTED')
+      and ps.updated_at < now() - interval '30 minutes'
+    order by ps.updated_at
+    limit v_batch_size
+  loop
+    v_rows := v_rows || jsonb_build_array(to_jsonb(v_row));
+  end loop;
+
+  return v_rows;
+end;
+$$;
+
+create or replace function public.reconcile_apply_gateway_state_rpc(
+  p_schedule_id uuid,
+  p_gateway_state text,
+  p_paid_amount numeric(12, 2) default null,
+  p_refunded_amount numeric(12, 2) default null,
+  p_gateway_charge_id text default null,
+  p_gateway_transaction_id text default null
+)
+returns jsonb
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_schedule public.payment_schedules%rowtype;
+  v_from_state text;
+  v_to_state text;
+  v_audit_event text;
+  v_event_type text;
+  v_charge_amount numeric(12, 2);
+begin
+  if p_gateway_state not in (
+    'PAID', 'REJECTED', 'REFUNDED', 'PARTIALLY_REFUNDED', 'IN_ANALYSIS'
+  ) then
+    raise exception 'INVALID_GATEWAY_STATE' using errcode = 'P0001';
+  end if;
+
+  select ps.*
+  into v_schedule
+  from public.payment_schedules ps
+  where ps.id = p_schedule_id
+    and ps.state in ('IN_ANALYSIS', 'PROCESSING', 'REFUND_REQUESTED')
+  for update;
+
+  if not found then
+    return jsonb_build_object('applied', false, 'reason', 'schedule_not_stale');
+  end if;
+
+  v_from_state := v_schedule.state;
+
+  if p_gateway_state = 'IN_ANALYSIS' and v_from_state = 'IN_ANALYSIS' then
+    return jsonb_build_object(
+      'applied', false,
+      'reason', 'still_in_analysis',
+      'reconciliation_failure_count', v_schedule.reconciliation_failure_count
+    );
+  end if;
+
+  if p_gateway_state = 'PAID' then
+    if v_from_state not in ('IN_ANALYSIS', 'PROCESSING') then
+      return jsonb_build_object('applied', false, 'reason', 'invalid_source_state');
+    end if;
+
+    v_charge_amount := coalesce(
+      p_paid_amount,
+      v_schedule.paid_amount,
+      public.calculate_charge_amount(
+        v_schedule.payment_token_id,
+        v_schedule.base_amount,
+        v_schedule.installment_number
+      )
+    );
+
+    update public.payment_schedules ps
+    set
+      state = 'PAID',
+      paid_at = coalesce(ps.paid_at, now()),
+      paid_amount = v_charge_amount,
+      gateway_charge_id = coalesce(p_gateway_charge_id, ps.gateway_charge_id),
+      gateway_transaction_id = coalesce(p_gateway_transaction_id, ps.gateway_transaction_id),
+      locked_until = null,
+      next_retry_at = null,
+      failure_code = null,
+      failure_reason = null,
+      reconciliation_failure_count = 0,
+      updated_at = now()
+    where ps.id = v_schedule.id;
+
+    update public.contracted_services cs
+    set status = 'CONFIRMED'
+    where cs.id = v_schedule.contracted_service_id
+      and cs.status = 'PENDING_PAYMENT';
+
+    v_to_state := 'PAID';
+    v_audit_event := 'RECONCILIATION_PAID';
+    v_event_type := 'ChargeSucceeded';
+  elsif p_gateway_state = 'REJECTED' then
+    if v_from_state not in ('IN_ANALYSIS', 'PROCESSING') then
+      return jsonb_build_object('applied', false, 'reason', 'invalid_source_state');
+    end if;
+
+    update public.payment_schedules ps
+    set
+      state = 'FAILED_PERMANENT',
+      failed_at = coalesce(ps.failed_at, now()),
+      failed_permanently_at = coalesce(ps.failed_permanently_at, now()),
+      locked_until = null,
+      next_retry_at = null,
+      reconciliation_failure_count = 0,
+      updated_at = now()
+    where ps.id = v_schedule.id;
+
+    v_to_state := 'FAILED_PERMANENT';
+    v_audit_event := 'RECONCILIATION_REJECTED';
+    v_event_type := 'ChargePermanentlyFailed';
+  elsif p_gateway_state = 'IN_ANALYSIS' and v_from_state = 'PROCESSING' then
+    update public.payment_schedules ps
+    set
+      state = 'IN_ANALYSIS',
+      gateway_charge_id = coalesce(p_gateway_charge_id, ps.gateway_charge_id),
+      gateway_transaction_id = coalesce(p_gateway_transaction_id, ps.gateway_transaction_id),
+      locked_until = null,
+      reconciliation_failure_count = 0,
+      updated_at = now()
+    where ps.id = v_schedule.id;
+
+    v_to_state := 'IN_ANALYSIS';
+    v_audit_event := 'RECONCILIATION_IN_ANALYSIS';
+    v_event_type := 'ChargeInAnalysis';
+  elsif p_gateway_state in ('REFUNDED', 'PARTIALLY_REFUNDED')
+    and v_from_state = 'REFUND_REQUESTED' then
+    v_to_state := p_gateway_state;
+
+    update public.payment_schedules ps
+    set
+      state = v_to_state,
+      refunded_at = coalesce(ps.refunded_at, now()),
+      refunded_amount = coalesce(p_refunded_amount, ps.refunded_amount),
+      reconciliation_failure_count = 0,
+      updated_at = now()
+    where ps.id = v_schedule.id;
+
+    v_audit_event := case
+      when p_gateway_state = 'REFUNDED' then 'RECONCILIATION_REFUNDED'
+      else 'RECONCILIATION_PARTIALLY_REFUNDED'
+    end;
+    v_event_type := 'RefundConfirmed';
+  else
+    return jsonb_build_object(
+      'applied', false,
+      'reason', 'transition_not_applicable',
+      'from_state', v_from_state,
+      'gateway_state', p_gateway_state
+    );
+  end if;
+
+  insert into public.payment_audit_log (
+    event_type,
+    entity_type,
+    entity_id,
+    service_id,
+    schedule_id,
+    from_state,
+    to_state,
+    actor,
+    metadata
+  )
+  values (
+    v_audit_event,
+    'payment_schedule',
+    v_schedule.id,
+    v_schedule.contracted_service_id,
+    v_schedule.id,
+    v_from_state,
+    v_to_state,
+    'system',
+    jsonb_build_object(
+      'gateway_state', p_gateway_state,
+      'paid_amount', p_paid_amount,
+      'refunded_amount', p_refunded_amount,
+      'gateway_charge_id', p_gateway_charge_id,
+      'gateway_transaction_id', p_gateway_transaction_id,
+      'source', 'reconcile-netcred-payments'
+    )
+  );
+
+  insert into public.payment_events (
+    event_type,
+    aggregate_type,
+    aggregate_id,
+    service_id,
+    payload
+  )
+  values (
+    v_event_type,
+    'payment_schedule',
+    v_schedule.id,
+    v_schedule.contracted_service_id,
+    jsonb_build_object(
+      'from_state', v_from_state,
+      'to_state', v_to_state,
+      'gateway_state', p_gateway_state,
+      'initiator', 'reconciliation'
+    )
+  );
+
+  return jsonb_build_object(
+    'applied', true,
+    'from_state', v_from_state,
+    'to_state', v_to_state,
+    'reconciliation_failure_count', 0,
+    'service_id', v_schedule.contracted_service_id,
+    'client_id', v_schedule.client_id,
+    'provider_id', v_schedule.provider_id,
+    'installment_number', v_schedule.installment_number,
+    'charge_amount', coalesce(p_paid_amount, v_schedule.paid_amount)
+  );
+end;
+$$;
+
+create or replace function public.reconcile_increment_failure_count_rpc(
+  p_schedule_id uuid
+)
+returns int
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_count int;
+begin
+  update public.payment_schedules ps
+  set
+    reconciliation_failure_count = ps.reconciliation_failure_count + 1,
+    updated_at = now()
+  where ps.id = p_schedule_id
+    and ps.state in ('IN_ANALYSIS', 'PROCESSING', 'REFUND_REQUESTED')
+  returning ps.reconciliation_failure_count into v_count;
+
+  return coalesce(v_count, 0);
+end;
+$$;
+
+comment on function public.reconcile_list_stale_schedules_rpc(int) is
+  'Lists stale intermediate payment_schedules for reconciliation polling (design §4.9).';
+
+comment on function public.reconcile_apply_gateway_state_rpc(
+  uuid, text, numeric, numeric, text, text
+) is
+  'Applies gateway-derived state transition during reconciliation polling.';
+
+comment on function public.reconcile_increment_failure_count_rpc(uuid) is
+  'Increments reconciliation_failure_count when gateway lookup is inconclusive.';
+
+revoke all on function public.reconcile_list_stale_schedules_rpc(int) from public, anon, authenticated;
+revoke all on function public.reconcile_apply_gateway_state_rpc(
+  uuid, text, numeric, numeric, text, text
+) from public, anon, authenticated;
+revoke all on function public.reconcile_increment_failure_count_rpc(uuid) from public, anon, authenticated;
+
+grant execute on function public.reconcile_list_stale_schedules_rpc(int) to service_role;
+grant execute on function public.reconcile_apply_gateway_state_rpc(
+  uuid, text, numeric, numeric, text, text
+) to service_role;
+grant execute on function public.reconcile_increment_failure_count_rpc(uuid) to service_role;
diff --git a/supabase/migrations/20260705210000_rpc_auto_complete_executed_services.sql b/supabase/migrations/20260705210000_rpc_auto_complete_executed_services.sql
new file mode 100644
index 0000000..41574d1
--- /dev/null
+++ b/supabase/migrations/20260705210000_rpc_auto_complete_executed_services.sql
@@ -0,0 +1,99 @@
+-- Payment System — task 42: auto_complete_executed_services_rpc (design §4.13).
+
+create or replace function public.auto_complete_executed_services_rpc()
+returns jsonb
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_service record;
+  v_results jsonb := '[]'::jsonb;
+begin
+  for v_service in
+    select
+      cs.id as service_id,
+      cs.client_id,
+      cs.provider_id,
+      cs.executed_at
+    from public.contracted_services cs
+    where cs.status = 'EXECUTED'::public.contracted_service_status
+      and cs.executed_at is not null
+      and cs.executed_at + interval '24 hours' <= now()
+    for update of cs skip locked
+  loop
+    begin
+      update public.contracted_services cs
+      set
+        status = 'COMPLETED'::public.contracted_service_status,
+        completed_at = now(),
+        completed_by = 'system'
+      where cs.id = v_service.service_id
+        and cs.status = 'EXECUTED'::public.contracted_service_status;
+
+      if not found then
+        continue;
+      end if;
+
+      insert into public.payment_audit_log (
+        event_type,
+        entity_type,
+        entity_id,
+        service_id,
+        actor,
+        metadata
+      )
+      values (
+        'SERVICE_AUTO_COMPLETED',
+        'contracted_service',
+        v_service.service_id,
+        v_service.service_id,
+        'system',
+        jsonb_build_object(
+          'executed_at', v_service.executed_at,
+          'completed_by', 'system'
+        )
+      );
+
+      insert into public.payment_events (
+        event_type,
+        aggregate_type,
+        aggregate_id,
+        service_id,
+        payload
+      )
+      values (
+        'ServiceCompleted',
+        'contracted_service',
+        v_service.service_id,
+        v_service.service_id,
+        jsonb_build_object(
+          'completed_by', 'system',
+          'executed_at', v_service.executed_at
+        )
+      );
+
+      v_results := v_results || jsonb_build_array(jsonb_build_object(
+        'service_id', v_service.service_id,
+        'client_id', v_service.client_id,
+        'provider_id', v_service.provider_id,
+        'executed_at', v_service.executed_at
+      ));
+    exception
+      when others then
+        perform pg_notify(
+          'auto_complete_error',
+          v_service.service_id::text
+        );
+    end;
+  end loop;
+
+  return v_results;
+end;
+$$;
+
+comment on function public.auto_complete_executed_services_rpc() is
+  'Promotes EXECUTED services to COMPLETED after 24h; returns rows for EF notification dispatch.';
+
+revoke all on function public.auto_complete_executed_services_rpc() from public, anon, authenticated;
+grant execute on function public.auto_complete_executed_services_rpc() to service_role;
diff --git a/supabase/migrations/20260705210100_rpc_webhook_transaction_capture.sql b/supabase/migrations/20260705210100_rpc_webhook_transaction_capture.sql
new file mode 100644
index 0000000..3a82d80
--- /dev/null
