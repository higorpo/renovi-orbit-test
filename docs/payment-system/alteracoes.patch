+import type { WebhookHandler, WebhookHandlerContext } from "../types.ts";
+import {
+  handlePaymentProfileDelete,
+  type PaymentProfileDeleteDeps,
+} from "./payment-profile-delete.ts";
+import {
+  handlePaymentProfileExpiring,
+  type PaymentProfileExpiringDeps,
+} from "./payment-profile-expiring.ts";
+import {
+  handlePaymentProfileTokenize,
+  type PaymentProfileTokenizeDeps,
+} from "./payment-profile-tokenize.ts";
+import {
+  handlePaymentProfileUpdate,
+  type PaymentProfileUpdateDeps,
+} from "./payment-profile-update.ts";
+
+export type PaymentProfileHandlersDeps = {
+  delete: PaymentProfileDeleteDeps;
+  tokenize: PaymentProfileTokenizeDeps;
+  expiring: PaymentProfileExpiringDeps;
+  update: PaymentProfileUpdateDeps;
+};
+
+export async function handlePaymentProfileEvent(
+  deps: PaymentProfileHandlersDeps,
+  context: WebhookHandlerContext,
+): Promise<"processed" | "skipped"> {
+  switch (context.eventType) {
+    case "PAYMENT_PROFILE_DELETE":
+      return handlePaymentProfileDelete(deps.delete, context);
+    case "PAYMENT_PROFILE_TOKENIZE":
+      return handlePaymentProfileTokenize(deps.tokenize, context);
+    case "PAYMENT_PROFILE_EXPIRING":
+      return handlePaymentProfileExpiring(deps.expiring, context);
+    case "PAYMENT_PROFILE_UPDATE":
+      return handlePaymentProfileUpdate(deps.update, context);
+    default:
+      return "skipped";
+  }
+}
+
+export function getPaymentProfileHandler(
+  deps: PaymentProfileHandlersDeps,
+): WebhookHandler {
+  return (context) => handlePaymentProfileEvent(deps, context);
+}
