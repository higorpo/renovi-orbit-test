+import { getSupabaseAnonKey, supabase } from "@/lib/supabase/client";
+import { logger } from "@/lib/logger";
+import type { InstallmentOption } from "../types/paymentToken.types";
+
+export type AcceptProposalPaymentRequest = {
+  proposalId: string;
+  providerId?: string;
+  serviceId: string;
+  paymentTokenId: string;
+  installmentNumber: number;
+  installmentSelectionHmac: string;
+  scheduledDate: string;
+  clearsaleSessionId?: string;
+  baseAmount: number;
+  cardBrand: string;
+  installmentOptions: InstallmentOption[];
+  computedAt: string;
+  expiresAt: string;
+  idempotencyKey: string;
+};
+
+export type AcceptProposalPaymentSuccess = {
+  contractedServiceId: string;
+  scheduleId?: string;
+  isIdempotent?: boolean;
+};
+
+export type AcceptProposalPaymentResult = {
+  data: AcceptProposalPaymentSuccess | null;
+  error: string | null;
+  errorCode?: string;
+};
+
+function getSupabaseUrl(): string {
+  const url = import.meta.env.VITE_SUPABASE_URL;
+  if (typeof url !== "string" || !url) {
+    throw new Error("VITE_SUPABASE_URL is not set");
+  }
+  return url.replace(/\/$/, "");
+}
+
+export async function acceptProposalPayment(
+  request: AcceptProposalPaymentRequest,
+): Promise<AcceptProposalPaymentResult> {
+  const { data: sessionData } = await supabase.auth.getSession();
+  const accessToken = sessionData.session?.access_token ?? getSupabaseAnonKey();
+
+  const response = await fetch(`${getSupabaseUrl()}/functions/v1/accept-proposal`, {
+    method: "POST",
+    headers: {
+      Authorization: `Bearer ${accessToken}`,
+      "Content-Type": "application/json",
+    },
+    body: JSON.stringify({
+      proposal_id: request.proposalId,
+      provider_id: request.providerId,
+      service_id: request.serviceId,
+      payment_token_id: request.paymentTokenId,
+      installment_number: request.installmentNumber,
+      installment_selection_hmac: request.installmentSelectionHmac,
+      scheduled_date: request.scheduledDate,
+      clearsale_session_id: request.clearsaleSessionId,
+      base_amount: request.baseAmount,
+      card_brand: request.cardBrand,
+      installment_options: request.installmentOptions,
+      computed_at: request.computedAt,
+      expires_at: request.expiresAt,
+      idempotency_key: request.idempotencyKey,
+    }),
+  });
+
+  const payload = await response.json().catch(() => ({}));
+
+  if (!response.ok) {
+    const errorCode = typeof payload.error_code === "string" ? payload.error_code : undefined;
+    const message = errorCode ?? (typeof payload.error === "string" ? payload.error : "Falha ao confirmar proposta");
+
+    logger.warn("accept_proposal_payment_failed", {
+      status: response.status,
+      errorCode,
+      error: message,
+    });
+
+    return {
+      data: null,
+      error: message,
+      errorCode,
+    };
+  }
+
+  return {
+    data: {
+      contractedServiceId: String(payload.contracted_service_id),
+      scheduleId: payload.schedule_id ? String(payload.schedule_id) : undefined,
+      isIdempotent: Boolean(payload.is_idempotent),
+    },
+    error: null,
+  };
+}
