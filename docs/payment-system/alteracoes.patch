@@ -0,0 +1,34 @@
+import { handleChargeVoid } from "./handlers/charge-void.ts";
+import { handlePaymentProfileEvent } from "./handlers/payment-profile-handlers.ts";
+import { handleTransactionCapture } from "./handlers/transaction-capture.ts";
+import { handleTransactionDispute } from "./handlers/transaction-dispute.ts";
+import { handleTransactionRefund } from "./handlers/transaction-refund.ts";
+import { handleTransactionUpdate } from "./handlers/transaction-update.ts";
+import type { WebhookDispatchDeps } from "./createWebhookHandlerDeps.ts";
+import type { WebhookHandlerContext } from "./types.ts";
+
+export async function dispatchWebhookEvent(
+  deps: WebhookDispatchDeps,
+  context: WebhookHandlerContext,
+): Promise<"processed" | "skipped"> {
+  switch (context.eventType) {
+    case "TRANSACTION_CAPTURE":
+      return handleTransactionCapture(deps.capture, context);
+    case "TRANSACTION_UPDATE":
+      return handleTransactionUpdate(deps.update, context);
+    case "TRANSACTION_REFUND":
+      return handleTransactionRefund(deps.refund, context);
+    case "CHARGE_VOID":
+    case "TRANSACTION_VOID":
+      return handleChargeVoid(deps.chargeVoid, context);
+    case "TRANSACTION_DISPUTE":
+      return handleTransactionDispute(deps.dispute, context);
+    case "TRANSACTION_EXPIRED":
+      return "skipped";
+    default:
+      if (context.eventType.startsWith("PAYMENT_PROFILE_")) {
+        return handlePaymentProfileEvent(deps.paymentProfile, context);
+      }
+      return "skipped";
+  }
+}
diff --git a/supabase/functions/netcred-webhook/handleRequest.ts b/supabase/functions/netcred-webhook/handleRequest.ts
new file mode 100644
index 0000000..e37b379
--- /dev/null
+++ b/supabase/functions/netcred-webhook/handleRequest.ts
@@ -0,0 +1,244 @@
+import { getCorsHeaders } from "../_shared/cors.ts";
+import { jsonResponse } from "../_shared/jsonResponse.ts";
+import {
+  createPaymentLogger,
+  PAYMENT_LOG_EVENTS,
+} from "../_shared/observability/payment-logger.ts";
+import { getClientIP } from "../_shared/rateLimiter.ts";
+import {
+  checkIPRateLimit,
+  emitIPRateLimitWarning,
+  type IPRateLimitConfig,
+} from "../_shared/security/rate-limit.ts";
+import { getWebhookHandler } from "./handlers/index.ts";
+import {
+  extractProviderEventId,
+  isHeavyWebhookEvent,
+  parseWebhookPayload,
+} from "./parseWebhook.ts";
+import type {
+  NetcredWebhookRunSummary,
+  PersistWebhookInput,
+  PersistWebhookResult,
+  WebhookHandler,
+} from "./types.ts";
+import { validateNetcredWebhookSignature } from "./validateSignature.ts";
+
+const logger = createPaymentLogger("netcred-webhook");
+const WEBHOOK_ENDPOINT = "netcred-webhook";
+const RATE_LIMIT_CONFIG: IPRateLimitConfig = { perMinute: 120, failClosed: false };
+
+export type NetcredWebhookDeps = {
+  getWebhookSecret: () => Promise<string>;
+  persistWebhookEvent: (input: PersistWebhookInput) => Promise<PersistWebhookResult>;
+  markDuplicate: (eventId: string) => Promise<void>;
+  markFailed: (eventId: string, failureReason: string) => Promise<void>;
+  markValidating: (eventId: string) => Promise<void>;
+  markProcessed: (eventId: string) => Promise<void>;
+  markProcessing: (eventId: string) => Promise<void>;
+  enqueueHeavyProcessing: (input: {
+    eventId: string;
+    eventType: string;
+  }) => Promise<void>;
+  emitInvalidSignatureWarning: (extra: Record<string, unknown>) => void;
+  checkIPRateLimit: typeof checkIPRateLimit;
+  emitIPRateLimitWarning: typeof emitIPRateLimitWarning;
+  getHandler?: (eventType: string) => WebhookHandler | null;
+};
+
+function headersToRecord(req: Request): Record<string, string> {
+  const headers: Record<string, string> = {};
+  req.headers.forEach((value, key) => {
+    headers[key.toLowerCase()] = value;
+  });
+  return headers;
+}
+
+export async function handleNetcredWebhookRequest(
+  req: Request,
+  deps: NetcredWebhookDeps,
+): Promise<Response> {
+  const cors = getCorsHeaders(req);
+
+  if (req.method === "OPTIONS") {
+    return new Response(null, { status: 204, headers: cors });
+  }
+
+  if (req.method !== "POST") {
+    return jsonResponse({ error: "method_not_allowed" }, 405, cors);
+  }
+
+  const clientIp = getClientIP(req);
+  const rateLimit = await deps.checkIPRateLimit(
+    clientIp,
+    WEBHOOK_ENDPOINT,
+    RATE_LIMIT_CONFIG,
+  );
+
+  if (!rateLimit.allowed) {
+    logger.warn("webhook_rate_limit_exceeded", {
+      source_ip: clientIp,
+      endpoint: WEBHOOK_ENDPOINT,
+      retry_after: rateLimit.retryAfter,
+    });
+    await deps.emitIPRateLimitWarning({
+      endpoint: WEBHOOK_ENDPOINT,
+      sourceIp: clientIp,
+      retryAfter: rateLimit.retryAfter,
+    });
+    return jsonResponse(
+      { error: "rate_limit_exceeded" },
+      429,
+      { ...cors, "Retry-After": String(rateLimit.retryAfter || 60) },
+    );
+  }
+
+  const startedAt = performance.now();
+
+  const rawBody = await req.text();
+  const eventType = req.headers.get("X-NETCRED-Event")?.trim() || "UNKNOWN";
+  const signature = req.headers.get("X-NETCRED-Signature")?.trim() || "";
+  const payload = parseWebhookPayload(rawBody);
+  const providerEventId = await extractProviderEventId(rawBody, payload);
+
+  let persistResult: PersistWebhookResult;
+  try {
+    persistResult = await deps.persistWebhookEvent({
+      gatewaySlug: "netcred",
+      eventType,
+      providerEventId,
+      rawPayload: payload,
+      rawHeaders: headersToRecord(req),
+    });
+  } catch (error) {
+    logger.error("webhook_persist_failed", {
+      event_type: eventType,
+      gateway_event_id: providerEventId,
+      gateway_slug: "netcred",
+      error: error instanceof Error ? error.message : String(error),
+    });
+    return jsonResponse({ error: "persist_failed" }, 500, cors);
+  }
+
+  logger.info(PAYMENT_LOG_EVENTS.WEBHOOK_RECEIVED, {
+    event_type: eventType,
+    gateway_event_id: providerEventId,
+    gateway_slug: "netcred",
+    correlation_id: providerEventId,
+  });
+
+  if (persistResult.status === "duplicate") {
+    await deps.markDuplicate(persistResult.eventId);
+    logger.info(PAYMENT_LOG_EVENTS.WEBHOOK_PROCESSED, {
+      event_type: eventType,
+      gateway_event_id: providerEventId,
+      gateway_slug: "netcred",
+      processing_duration_ms: Math.round(performance.now() - startedAt),
+      outcome: "duplicate",
+      correlation_id: providerEventId,
+    });
+    return new Response("OK", { status: 200, headers: cors });
+  }
+
+  const secret = await deps.getWebhookSecret();
+  const signatureValid = await validateNetcredWebhookSignature(
+    rawBody,
+    signature,
+    secret,
+  );
+
+  if (!signatureValid) {
+    await deps.markFailed(persistResult.eventId, "INVALID_SIGNATURE");
+    deps.emitInvalidSignatureWarning({
+      event_type: eventType,
+      gateway_event_id: providerEventId,
+      source_ip: clientIp,
+      event_id: persistResult.eventId,
+    });
+    return new Response("Unauthorized", { status: 401, headers: cors });
+  }
+
+  await deps.markValidating(persistResult.eventId);
+
+  const resolveHandler = deps.getHandler ?? getWebhookHandler;
+  const handler = resolveHandler(eventType);
+
+  if (!handler) {
+    logger.warn("webhook_unknown_event_type", {
+      event_type: eventType,
+      gateway_event_id: providerEventId,
+      gateway_slug: "netcred",
+      event_id: persistResult.eventId,
+    });
+    await deps.markProcessed(persistResult.eventId);
+    logger.info(PAYMENT_LOG_EVENTS.WEBHOOK_PROCESSED, {
+      event_type: eventType,
+      gateway_event_id: providerEventId,
+      gateway_slug: "netcred",
+      processing_duration_ms: Math.round(performance.now() - startedAt),
+      outcome: "unknown_event_type",
+      correlation_id: providerEventId,
+    });
+    return new Response("OK", { status: 200, headers: cors });
+  }
+
+  try {
+    const handlerResult = await handler({
+      eventId: persistResult.eventId,
+      eventType,
+      payload,
+    });
+
+    if (handlerResult === "queued" || isHeavyWebhookEvent(eventType)) {
+      await deps.enqueueHeavyProcessing({
+        eventId: persistResult.eventId,
+        eventType,
+      });
+      await deps.markProcessing(persistResult.eventId);
+      logger.info(PAYMENT_LOG_EVENTS.WEBHOOK_PROCESSED, {
+        event_type: eventType,
+        gateway_event_id: providerEventId,
+        gateway_slug: "netcred",
+        processing_duration_ms: Math.round(performance.now() - startedAt),
+        outcome: "queued",
+        event_id: persistResult.eventId,
+        correlation_id: providerEventId,
+      });
+      return new Response("OK", { status: 200, headers: cors });
+    }
+
+    await deps.markProcessed(persistResult.eventId);
+    logger.info(PAYMENT_LOG_EVENTS.WEBHOOK_PROCESSED, {
+      event_type: eventType,
+      gateway_event_id: providerEventId,
+      gateway_slug: "netcred",
+      processing_duration_ms: Math.round(performance.now() - startedAt),
+      outcome: "processed",
+      event_id: persistResult.eventId,
+      correlation_id: providerEventId,
+    });
+    return new Response("OK", { status: 200, headers: cors });
+  } catch (error) {
+    const failureReason = error instanceof Error ? error.message : String(error);
+    await deps.markFailed(persistResult.eventId, failureReason);
+    logger.warn(PAYMENT_LOG_EVENTS.WEBHOOK_PROCESSED, {
+      event_type: eventType,
+      gateway_event_id: providerEventId,
+      gateway_slug: "netcred",
+      processing_duration_ms: Math.round(performance.now() - startedAt),
+      outcome: "failed",
+      event_id: persistResult.eventId,
+      error: failureReason,
+      correlation_id: providerEventId,
+    });
+    return new Response("OK", { status: 200, headers: cors });
+  }
+}
+
+export function buildSummary(
+  eventType: string,
+  outcome: NetcredWebhookRunSummary["outcome"],
+  eventId?: string,
+): NetcredWebhookRunSummary {
+  return { outcome, event_type: eventType, event_id: eventId };
+}
