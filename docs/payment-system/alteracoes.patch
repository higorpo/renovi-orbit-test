+import { assertEquals } from "std/testing/asserts";
+import {
+  handleTransactionCapture,
+  type TransactionCaptureDeps,
+} from "../handlers/transaction-capture.ts";
+
+function createDeps(
+  overrides: Partial<TransactionCaptureDeps> = {},
+): TransactionCaptureDeps {
+  return {
+    applyCapture: async () => ({ outcome: "skipped" }),
+    ingestNotification: async () => {},
+    ...overrides,
+  };
+}
+
+const baseContext = {
+  eventId: "webhook-event-1",
+  eventType: "TRANSACTION_CAPTURE",
+  payload: {
+    transaction: {
+      id: "txn-1",
+      referenceCode: "service-1",
+      transactionState: "PAID",
+      paidAmount: "310.39",
+    },
+    charge: {
+      id: "charge-1",
+    },
+  },
+};
+
+Deno.test("IN_ANALYSIS schedule transitions to PAID via webhook capture", async () => {
+  const ingested: string[] = [];
+
+  const result = await handleTransactionCapture(
+    createDeps({
+      applyCapture: async () => ({
+        outcome: "paid",
+        schedule_id: "schedule-1",
+        service_id: "service-1",
+        client_id: "client-1",
+        provider_id: "provider-1",
+        installment_number: 2,
+        charge_amount: "310.39",
+        from_state: "IN_ANALYSIS",
+        service_status: "CONFIRMED",
+      }),
+      ingestNotification: async (input) => {
+        ingested.push(`${input.profileId}:${input.templateKey}`);
+      },
+    }),
+    baseContext,
+  );
+
+  assertEquals(result, "processed");
+  assertEquals(ingested.includes("client-1:payment_success"), true);
+  assertEquals(ingested.includes("client-1:payment_success_email"), true);
+  assertEquals(ingested.includes("provider-1:provider_payment_confirmed"), true);
+});
+
+Deno.test("already PAID schedule only confirms webhook without notifications", async () => {
+  let ingestCalled = false;
+
+  const result = await handleTransactionCapture(
+    createDeps({
+      applyCapture: async () => ({
+        outcome: "already_paid",
+        schedule_id: "schedule-1",
+        service_id: "service-1",
+        from_state: "PAID",
+      }),
+      ingestNotification: async () => {
+        ingestCalled = true;
+      },
+    }),
+    baseContext,
+  );
+
+  assertEquals(result, "processed");
+  assertEquals(ingestCalled, false);
+});
+
+Deno.test("PAID webhook sets contracted service to CONFIRMED in RPC result", async () => {
+  const result = await handleTransactionCapture(
+    createDeps({
+      applyCapture: async () => ({
+        outcome: "paid",
+        service_id: "service-1",
+        client_id: "client-1",
+        provider_id: "provider-1",
+        installment_number: 1,
+        charge_amount: "100.00",
+        from_state: "IN_ANALYSIS",
+        service_status: "CONFIRMED",
+      }),
+      ingestNotification: async () => {},
+    }),
+    baseContext,
+  );
+
+  assertEquals(result, "processed");
+});
+
+Deno.test("regression guard skips invalid PAID to IN_ANALYSIS transition", async () => {
+  let applyCalled = false;
+
+  const result = await handleTransactionCapture(
+    createDeps({
+      applyCapture: async () => {
+        applyCalled = true;
+        return { outcome: "paid" };
+      },
+      isValidTransition: () => false,
+    }),
+    {
+      ...baseContext,
+      payload: {
+        ...baseContext.payload,
+        from_state: "PAID",
+      },
+    },
+  );
+
+  assertEquals(result, "skipped");
+  assertEquals(applyCalled, false);
+});
