+  proposalId?: string;
+  baseAmount?: number;
+  cardBrand?: string;
+  installmentOptions?: InstallmentOption[];
+  computedAt?: string;
+  expiresAt?: string;
+};
+
+export type UpdatePaymentMethodResult = {
+  data: { scheduleId: string } | null;
+  error: string | null;
+  errorCode?: string;
+};
+
+function getSupabaseUrl(): string {
+  const url = import.meta.env.VITE_SUPABASE_URL;
+  if (typeof url !== "string" || !url) {
+    throw new Error("VITE_SUPABASE_URL is not set");
+  }
+  return url.replace(/\/$/, "");
+}
+
+export async function updatePaymentMethod(
+  request: UpdatePaymentMethodRequest,
+): Promise<UpdatePaymentMethodResult> {
+  const { data: sessionData } = await supabase.auth.getSession();
+  const accessToken = sessionData.session?.access_token ?? getSupabaseAnonKey();
+
+  const response = await fetch(`${getSupabaseUrl()}/functions/v1/update-payment-method`, {
+    method: "POST",
+    headers: {
+      Authorization: `Bearer ${accessToken}`,
+      "Content-Type": "application/json",
+    },
+    body: JSON.stringify({
+      service_id: request.contractedServiceId,
+      new_payment_token_id: request.newPaymentTokenId,
+      installment_selection_hmac: request.installmentSelectionHmac,
+      proposal_id: request.proposalId,
+      base_amount: request.baseAmount,
+      card_brand: request.cardBrand,
+      installment_options: request.installmentOptions,
+      computed_at: request.computedAt,
+      expires_at: request.expiresAt,
+    }),
+  });
+
+  const payload = await response.json().catch(() => ({}));
+
+  if (!response.ok) {
+    const errorCode = typeof payload.error_code === "string" ? payload.error_code : undefined;
+    const message = errorCode ?? (typeof payload.error === "string" ? payload.error : "Falha ao atualizar cartão");
+
+    logger.warn("update_payment_method_failed", {
+      status: response.status,
+      errorCode,
+      error: message,
+    });
+
+    return { data: null, error: message, errorCode };
+  }
+
+  return {
+    data: { scheduleId: String(payload.schedule_id) },
+    error: null,
+  };
+}
