+    p_actor_id,
+    jsonb_build_object('error_message', p_error_message)
+  );
+end;
+$$;
+
+revoke all on function public.process_refund_pre_charge_cancel_rpc(uuid, uuid, text, text) from public;
+revoke all on function public.process_refund_pre_charge_cancel_rpc(uuid, uuid, text, text) from anon;
+revoke all on function public.process_refund_pre_charge_cancel_rpc(uuid, uuid, text, text) from authenticated;
+grant execute on function public.process_refund_pre_charge_cancel_rpc(uuid, uuid, text, text) to service_role;
+
+revoke all on function public.process_refund_submit_rpc(uuid, uuid, text, text, numeric, text) from public;
+revoke all on function public.process_refund_submit_rpc(uuid, uuid, text, text, numeric, text) from anon;
+revoke all on function public.process_refund_submit_rpc(uuid, uuid, text, text, numeric, text) from authenticated;
+grant execute on function public.process_refund_submit_rpc(uuid, uuid, text, text, numeric, text) to service_role;
+
+revoke all on function public.process_refund_record_failed_rpc(uuid, uuid, uuid, text, text) from public;
+revoke all on function public.process_refund_record_failed_rpc(uuid, uuid, uuid, text, text) from anon;
+revoke all on function public.process_refund_record_failed_rpc(uuid, uuid, uuid, text, text) from authenticated;
+grant execute on function public.process_refund_record_failed_rpc(uuid, uuid, uuid, text, text) to service_role;
