+++ b/supabase/functions/accept-proposal/validateInstallmentHmac.ts
@@ -0,0 +1,49 @@
+import {
+  computeHMACSHA256,
+  serializeInstallmentHmacPayload,
+} from "../calculate-installment-options/hmac.ts";
+import type { InstallmentHmacPayload } from "../calculate-installment-options/types.ts";
+import { timingSafeEqualStrings } from "./timingSafeEqual.ts";
+
+export type InstallmentHmacValidationResult =
+  | { valid: true }
+  | {
+    valid: false;
+    expired: boolean;
+    error_code: "INSTALLMENT_SIGNATURE_EXPIRED" | "INVALID_INSTALLMENT_SIGNATURE";
+  };
+
+export function timingSafeEqualHex(left: string, right: string): boolean {
+  return timingSafeEqualStrings(left, right);
+}
+
+export async function validateInstallmentHmac(
+  submittedHmac: string,
+  payload: InstallmentHmacPayload,
+  secret: string,
+  now: Date = new Date(),
+): Promise<InstallmentHmacValidationResult> {
+  const expiresAt = new Date(payload.expires_at);
+  if (Number.isNaN(expiresAt.getTime()) || expiresAt.getTime() < now.getTime()) {
+    return {
+      valid: false,
+      expired: true,
+      error_code: "INSTALLMENT_SIGNATURE_EXPIRED",
+    };
+  }
+
+  const computed = await computeHMACSHA256(
+    secret,
+    serializeInstallmentHmacPayload(payload),
+  );
+
+  if (!timingSafeEqualHex(submittedHmac, computed)) {
+    return {
+      valid: false,
+      expired: false,
+      error_code: "INVALID_INSTALLMENT_SIGNATURE",
+    };
+  }
+
+  return { valid: true };
+}
