+import type { NotificationIngestInput } from "../../manual-charge-payment/enqueueNotifications.ts";
+
+export async function enqueueRefundConfirmedNotifications(
+  ingest: (input: NotificationIngestInput) => Promise<void>,
+  input: {
+    webhookEventId: string;
+    serviceId: string;
+    clientId: string;
+    refundedAmount: string;
+    expectedDays: string;
+  },
+): Promise<void> {
+  const baseKey = `webhook-refund:${input.webhookEventId}`;
+
+  await ingest({
+    profileId: input.clientId,
+    channel: "PUSH",
+    templateKey: "refund_confirmed_client",
+    idempotencyKey: `${baseKey}:client-push`,
+    templateVariables: {
+      serviceId: input.serviceId,
+      refundedAmount: input.refundedAmount,
+      expectedDays: input.expectedDays,
+    },
+    bypassLimits: true,
+  });
+
+  await ingest({
+    profileId: input.clientId,
+    channel: "EMAIL",
+    templateKey: "refund_confirmed_client_email",
+    idempotencyKey: `${baseKey}:client-email`,
+    templateVariables: {
+      serviceId: input.serviceId,
+      refundedAmount: input.refundedAmount,
+      expectedDays: input.expectedDays,
+    },
+    bypassLimits: true,
+  });
+}
