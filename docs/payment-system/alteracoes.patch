+import type { NotificationIngestInput } from "../../manual-charge-payment/enqueueNotifications.ts";
+import type { WebhookHandlerContext } from "../types.ts";
+import { enqueuePaymentMethodUpdateNotifications } from "./enqueuePaymentMethodUpdateNotifications.ts";
+import {
+  extractPaymentProfileId,
+  extractPaymentProfileIsActive,
+} from "./extractPaymentProfilePayload.ts";
+
+export type PaymentProfileTokenizeResult = {
+  outcome: "tokenized" | "tokenization_failed" | "not_found";
+  token_id?: string;
+  client_id?: string;
+  has_scheduled_schedule?: boolean;
+};
+
+export type PaymentProfileTokenizeDeps = {
+  applyTokenize: (input: {
+    providerPaymentProfileId: string;
+    isActive: boolean;
+    webhookEventId: string;
+  }) => Promise<PaymentProfileTokenizeResult>;
+  ingestNotification: (input: NotificationIngestInput) => Promise<void>;
+};
+
+export async function handlePaymentProfileTokenize(
+  deps: PaymentProfileTokenizeDeps,
+  context: WebhookHandlerContext,
+): Promise<"processed" | "skipped"> {
+  const providerPaymentProfileId = extractPaymentProfileId(context.payload);
+  if (!providerPaymentProfileId) {
+    throw new Error("PAYMENT_PROFILE_ID_MISSING");
+  }
+
+  const isActive = extractPaymentProfileIsActive(context.payload);
+  const result = await deps.applyTokenize({
+    providerPaymentProfileId,
+    isActive,
+    webhookEventId: context.eventId,
+  });
+
+  if (
+    result.outcome === "tokenization_failed" &&
+    result.has_scheduled_schedule &&
+    result.client_id
+  ) {
+    await enqueuePaymentMethodUpdateNotifications(deps.ingestNotification, {
+      webhookEventId: context.eventId,
+      reason: "tokenization_failed",
+      schedules: [{
+        schedule_id: `tokenize:${result.token_id}`,
+        service_id: result.token_id!,
+        client_id: result.client_id,
+      }],
+    });
+  }
+
+  if (result.outcome === "tokenized" || result.outcome === "tokenization_failed") {
+    return "processed";
+  }
+
+  throw new Error("PAYMENT_TOKEN_NOT_FOUND");
+}
