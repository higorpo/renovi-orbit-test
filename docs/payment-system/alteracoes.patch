+import type { InstallmentOption, PaymentPlatformConstants } from "./types.ts";
+import {
+  bankersRound,
+  computeInstallmentOptions as computeOptions,
+  resolveRateKey,
+  type ChargeAmountBreakdown,
+} from "../_shared/payment/fee-calculator.ts";
+
+export { bankersRound, resolveRateKey };
+
+export function computeInstallmentOptions(
+  baseAmount: number,
+  cardBrand: string,
+  constants: PaymentPlatformConstants,
+): InstallmentOption[] {
+  return computeOptions(baseAmount, cardBrand, constants).map(mapBreakdownToOption);
+}
+
+function mapBreakdownToOption(breakdown: ChargeAmountBreakdown): InstallmentOption {
+  return {
+    installment_number: breakdown.installment_number,
+    applicable_rate_pct: breakdown.applicable_rate_pct,
+    total_with_fees: breakdown.total_with_fees,
+    installment_amount: breakdown.installment_amount,
+  };
+}
