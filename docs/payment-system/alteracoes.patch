@@ -0,0 +1,74 @@
+import { supabase } from "@/lib/supabase/client";
+import { logger } from "@/lib/logger";
+
+export type BlockedPaymentSchedule = {
+  scheduleId: string;
+  contractedServiceId: string;
+  state: string;
+};
+
+export type RevokePaymentTokenOutcome =
+  | { outcome: "revoked"; paymentTokenId: string }
+  | { outcome: "blocked"; schedules: BlockedPaymentSchedule[] }
+  | { outcome: "not_found" };
+
+export type RevokePaymentTokenResult = {
+  data: RevokePaymentTokenOutcome | null;
+  error: string | null;
+};
+
+type RpcBlockedSchedule = {
+  schedule_id: string;
+  contracted_service_id: string;
+  state: string;
+};
+
+type RpcRevokeResponse = {
+  outcome: string;
+  payment_token_id?: string;
+  schedules?: RpcBlockedSchedule[];
+};
+
+function mapRpcResponse(payload: RpcRevokeResponse): RevokePaymentTokenOutcome {
+  if (payload.outcome === "revoked" && payload.payment_token_id) {
+    return {
+      outcome: "revoked",
+      paymentTokenId: payload.payment_token_id,
+    };
+  }
+
+  if (payload.outcome === "blocked") {
+    return {
+      outcome: "blocked",
+      schedules: (payload.schedules ?? []).map((schedule) => ({
+        scheduleId: schedule.schedule_id,
+        contractedServiceId: schedule.contracted_service_id,
+        state: schedule.state,
+      })),
+    };
+  }
+
+  return { outcome: "not_found" };
+}
+
+export async function revokePaymentToken(
+  paymentTokenId: string,
+): Promise<RevokePaymentTokenResult> {
+  const { data, error } = await supabase.rpc(
+    "revoke_payment_token_rpc" as never,
+    { p_payment_token_id: paymentTokenId } as never,
+  );
+
+  if (error) {
+    logger.error("revoke_payment_token_rpc_error", {
+      paymentTokenId,
+      error: error.message,
+    });
+    return { data: null, error: error.message };
+  }
+
+  return {
+    data: mapRpcResponse((data ?? { outcome: "not_found" }) as RpcRevokeResponse),
+    error: null,
+  };
+}
