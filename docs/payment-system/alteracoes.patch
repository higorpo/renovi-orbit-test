+import "xhr";
+import { servePaymentFunction } from "../_shared/observability/sentry.ts";
+import { checkRateLimit } from "../_shared/rateLimiter.ts";
+import { createServiceRoleClient } from "../_shared/serviceRoleClient.ts";
+import {
+  handleCalculateInstallmentOptionsRequest,
+} from "./handleRequest.ts";
+import { PAYMENT_PLATFORM_CONSTANT_KEYS } from "../_shared/payment/constants.ts";
+import { getVaultSecret } from "./getVaultSecret.ts";
+
+function createDeps(): CalculateInstallmentOptionsDeps {
+  const supabase = createServiceRoleClient();
+
+  return {
+    getUser: async (token) => {
+      const { data: { user }, error } = await supabase.auth.getUser(token);
+      return { user, error: error ?? null };
+    },
+    loadPlatformConstants: async () => {
+      const { data, error } = await supabase
+        .from("platform_constants")
+        .select("key, value")
+        .in("key", [...PAYMENT_PLATFORM_CONSTANT_KEYS]);
+
+      if (error) {
+        throw new Error(error.message);
+      }
+
+      return data ?? [];
+    },
+    loadProposalAmount: async (proposalId) => {
+      const { data, error } = await supabase
+        .from("provider_proposals")
+        .select("proposed_amount")
+        .eq("id", proposalId)
+        .maybeSingle();
+
+      if (error || !data?.proposed_amount) {
+        return null;
+      }
+
+      return Number(data.proposed_amount);
+    },
+    getSigningSecret: () => getVaultSecret(supabase, "INSTALLMENT_SIGNING_SECRET"),
+    checkRateLimit,
+  };
+}
+
+servePaymentFunction("calculate-installment-options", (req) =>
+  handleCalculateInstallmentOptionsRequest(req, createDeps()));
