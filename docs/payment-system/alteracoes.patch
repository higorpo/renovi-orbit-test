+-- Payment System — task 36: atomic provider KYC submission TX (design §4.1.1).
+
+create or replace function public.submit_provider_kyc_rpc(
+  p_provider_id uuid,
+  p_entity_type text,
+  p_full_name text,
+  p_document text,
+  p_phone text,
+  p_email text,
+  p_bank_institution_code text,
+  p_bank_branch text,
+  p_bank_account text,
+  p_pix_key text,
+  p_razao_social text,
+  p_nome_fantasia text,
+  p_legal_rep_full_name text,
+  p_legal_rep_cpf text,
+  p_legal_rep_phone text,
+  p_identity_doc_url text,
+  p_address_proof_url text,
+  p_corporate_charter_url text,
+  p_legal_rep_doc_url text
+)
+returns uuid
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_account public.provider_accounts%rowtype;
+  v_submission_id uuid;
+begin
+  if p_entity_type not in ('CPF', 'CNPJ') then
+    raise exception 'INVALID_ENTITY_TYPE' using errcode = 'P0001';
+  end if;
+
+  select pa.*
+  into v_account
+  from public.provider_accounts pa
+  where pa.provider_id = p_provider_id
+    and pa.gateway_slug = 'netcred'
+  for update;
+
+  if not found then
+    raise exception 'PROVIDER_ACCOUNT_NOT_FOUND' using errcode = 'P0001';
+  end if;
+
+  if v_account.onboarding_status <> 'PENDING_DOCUMENTS' then
+    raise exception 'INVALID_ONBOARDING_STATE' using errcode = 'P0001';
+  end if;
+
+  insert into public.provider_kyc_submissions (
+    provider_id,
+    entity_type,
+    full_name,
+    document,
+    phone,
+    email,
+    bank_institution_code,
+    bank_branch,
+    bank_account,
+    pix_key,
+    razao_social,
+    nome_fantasia,
+    legal_rep_full_name,
+    legal_rep_cpf,
+    legal_rep_phone,
+    identity_doc_url,
+    address_proof_url,
+    corporate_charter_url,
+    legal_rep_doc_url
+  )
+  values (
+    p_provider_id,
+    p_entity_type,
+    p_full_name,
+    p_document,
+    p_phone,
+    p_email,
+    p_bank_institution_code,
+    p_bank_branch,
+    p_bank_account,
+    p_pix_key,
+    p_razao_social,
+    p_nome_fantasia,
+    p_legal_rep_full_name,
+    p_legal_rep_cpf,
+    p_legal_rep_phone,
+    p_identity_doc_url,
+    p_address_proof_url,
+    p_corporate_charter_url,
+    p_legal_rep_doc_url
+  )
+  returning id into v_submission_id;
+
+  update public.provider_accounts pa
+  set
+    document = p_document,
+    onboarding_status = 'DOCUMENTS_SUBMITTED',
+    onboarding_submitted_at = now(),
+    updated_at = now()
+  where pa.id = v_account.id;
+
+  update public.provider_profiles_private ppp
+  set
+    phone = p_phone,
+    legal_representative_phone = p_legal_rep_phone,
+    updated_at = now()
+  where ppp.provider_id = p_provider_id;
+
+  insert into public.payment_audit_log (
+    event_type,
+    entity_type,
+    entity_id,
+    actor,
+    actor_id,
+    metadata
+  )
+  values (
+    'KYC_SUBMITTED',
+    'provider_account',
+    v_account.id,
+    'client',
+    p_provider_id,
+    jsonb_build_object(
+      'submission_id', v_submission_id,
+      'entity_type', p_entity_type,
+      'document', p_document
+    )
+  );
+
+  return v_submission_id;
+end;
+$$;
+
