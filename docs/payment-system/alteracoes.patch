@@ -0,0 +1,92 @@
+import type { InstallmentHmacPayload } from "../calculate-installment-options/types.ts";
+import type { AcceptProposalBody } from "./types.ts";
+
+export type ParsedAcceptProposalRequest = {
+  proposalId: string;
+  providerId?: string;
+  installmentNumber: number;
+  installmentSelectionHmac: string;
+  paymentTokenId: string;
+  scheduledDate: string;
+  clearsaleSessionId?: string;
+  idempotencyKey: string;
+  hmacPayload: InstallmentHmacPayload;
+};
+
+export type ParseAcceptProposalError = {
+  status: 400;
+  error: string;
+};
+
+export function parseAcceptProposalBody(
+  body: AcceptProposalBody,
+): ParsedAcceptProposalRequest | ParseAcceptProposalError {
+  if (!body.proposal_id?.trim()) {
+    return { status: 400, error: "proposal_id is required" };
+  }
+
+  if (!body.payment_token_id?.trim()) {
+    return { status: 400, error: "payment_token_id is required" };
+  }
+
+  if (!body.installment_selection_hmac?.trim()) {
+    return { status: 400, error: "installment_selection_hmac is required" };
+  }
+
+  if (!body.scheduled_date?.trim()) {
+    return { status: 400, error: "scheduled_date is required" };
+  }
+
+  if (
+    body.installment_number === undefined ||
+    !Number.isInteger(body.installment_number) ||
+    body.installment_number < 1 ||
+    body.installment_number > 12
+  ) {
+    return { status: 400, error: "installment_number must be between 1 and 12" };
+  }
+
+  if (!body.service_id?.trim()) {
+    return { status: 400, error: "service_id is required" };
+  }
+
+  if (body.base_amount === undefined || body.base_amount <= 0) {
+    return { status: 400, error: "base_amount is required" };
+  }
+
+  if (!body.card_brand?.trim()) {
+    return { status: 400, error: "card_brand is required" };
+  }
+
+  if (!body.computed_at?.trim() || !body.expires_at?.trim()) {
+    return { status: 400, error: "computed_at and expires_at are required" };
+  }
+
+  if (!Array.isArray(body.installment_options) || body.installment_options.length === 0) {
+    return { status: 400, error: "installment_options is required" };
+  }
+
+  if (!body.idempotency_key?.trim()) {
+    return { status: 400, error: "idempotency_key is required" };
+  }
+
+  return {
+    proposalId: body.proposal_id.trim(),
+    providerId: body.provider_id?.trim(),
+    installmentNumber: body.installment_number,
+    installmentSelectionHmac: body.installment_selection_hmac.trim(),
+    paymentTokenId: body.payment_token_id.trim(),
+    scheduledDate: body.scheduled_date.trim(),
+    clearsaleSessionId: body.clearsale_session_id?.trim(),
+    idempotencyKey: body.idempotency_key.trim(),
+    hmacPayload: {
+      proposal_id: body.proposal_id.trim(),
+      service_id: body.service_id.trim(),
+      base_amount: body.base_amount,
+      card_brand: body.card_brand.trim(),
+      installment_options: body.installment_options,
+      computed_at: body.computed_at.trim(),
+      expires_at: body.expires_at.trim(),
+    },
+  };
+}
