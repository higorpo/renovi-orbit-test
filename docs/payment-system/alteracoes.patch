@@ -0,0 +1,67 @@
+import type { NotificationIngestInput } from "../../manual-charge-payment/enqueueNotifications.ts";
+import type { WebhookHandlerContext } from "../types.ts";
+import { enqueueRefundConfirmedNotifications } from "./enqueueRefundConfirmedNotifications.ts";
+import {
+  extractReferenceCode,
+  extractRefundedAmount,
+} from "./extractTransactionPayload.ts";
+
+const EXPECTED_REFUND_DAYS = "30-60";
+
+export type TransactionRefundApplyResult = {
+  outcome: "refunded" | "already_terminal" | "skipped" | "not_found";
+  reason?: string;
+  schedule_id?: string;
+  service_id?: string;
+  client_id?: string;
+  from_state?: string;
+  to_state?: string;
+  refunded_amount?: number | string;
+};
+
+export type TransactionRefundDeps = {
+  applyRefund: (input: {
+    referenceCode: string;
+    webhookEventId: string;
+    refundedAmount: string;
+  }) => Promise<TransactionRefundApplyResult>;
+  ingestNotification: (input: NotificationIngestInput) => Promise<void>;
+};
+
+export async function handleTransactionRefund(
+  deps: TransactionRefundDeps,
+  context: WebhookHandlerContext,
+): Promise<"processed" | "skipped"> {
+  const referenceCode = extractReferenceCode(context.payload);
+  if (!referenceCode) {
+    throw new Error("REFERENCE_CODE_MISSING");
+  }
+
+  const refundedAmount = extractRefundedAmount(context.payload);
+  if (!refundedAmount) {
+    throw new Error("REFUNDED_AMOUNT_MISSING");
+  }
+
+  const result = await deps.applyRefund({
+    referenceCode,
+    webhookEventId: context.eventId,
+    refundedAmount,
+  });
+
+  if (result.outcome === "refunded") {
+    await enqueueRefundConfirmedNotifications(deps.ingestNotification, {
+      webhookEventId: context.eventId,
+      serviceId: result.service_id!,
+      clientId: result.client_id!,
+      refundedAmount: Number(result.refunded_amount ?? refundedAmount).toFixed(2),
+      expectedDays: EXPECTED_REFUND_DAYS,
+    });
+    return "processed";
+  }
+
+  if (result.outcome === "already_terminal" || result.outcome === "skipped") {
+    return "processed";
+  }
+
+  throw new Error("SCHEDULE_NOT_FOUND");
+}
diff --git a/supabase/functions/netcred-webhook/handlers/transaction-rejected.ts b/supabase/functions/netcred-webhook/handlers/transaction-rejected.ts
