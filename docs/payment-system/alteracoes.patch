+import { assertEquals } from "std/testing/asserts";
+import {
+  handleTransactionUpdate,
+  type TransactionUpdateDeps,
+} from "../handlers/transaction-update.ts";
+
+function createDeps(
+  overrides: Partial<TransactionUpdateDeps> = {},
+): TransactionUpdateDeps {
+  return {
+    capture: {
+      applyCapture: async () => ({ outcome: "skipped" }),
+      ingestNotification: async () => {},
+    },
+    rejected: {
+      applyRejected: async () => ({ outcome: "skipped" }),
+      ingestNotification: async () => {},
+    },
+    refund: {
+      applyRefund: async () => ({ outcome: "skipped" }),
+      ingestNotification: async () => {},
+    },
+    chargeVoid: {
+      applyVoid: async () => ({ outcome: "skipped" }),
+    },
+    ...overrides,
+  };
+}
+
+const paidContext = {
+  eventId: "webhook-event-paid",
+  eventType: "TRANSACTION_UPDATE",
+  payload: {
+    transaction: {
+      id: "txn-1",
+      referenceCode: "service-1",
+      transactionState: "PAID",
+      paidAmount: "250.00",
+    },
+  },
+};
+
+const rejectedContext = {
+  eventId: "webhook-event-rejected",
+  eventType: "TRANSACTION_UPDATE",
+  payload: {
+    transaction: {
+      id: "txn-2",
+      referenceCode: "service-2",
+      transactionState: "REJECTED",
+      reasonCode: "REJECTED",
+      reason: "Antifraude reprovou",
