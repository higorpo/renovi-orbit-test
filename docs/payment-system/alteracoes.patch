+import { getCorsHeaders } from "../_shared/cors.ts";
+import { jsonResponse } from "../_shared/jsonResponse.ts";
+import { createPaymentLogger } from "../_shared/observability/payment-logger.ts";
+import { validateCronAuth } from "../schedule-netcred-charges/auth.ts";
+import { enqueueUpcomingChargeNotifications } from "./enqueueNotifications.ts";
+import type {
+  NotifyUpcomingChargesRunSummary,
+  UpcomingChargeSchedule,
+} from "./types.ts";
+import type { NotificationIngestInput } from "../manual-charge-payment/enqueueNotifications.ts";
+
+const logger = createPaymentLogger("notify-upcoming-charges");
+
+export type NotifyUpcomingChargesDeps = {
+  claimSchedules: (batchSize?: number) => Promise<UpcomingChargeSchedule[]>;
+  ingestNotification: (input: NotificationIngestInput) => Promise<void>;
+};
+
+export async function handleNotifyUpcomingChargesRequest(
+  req: Request,
+  deps: NotifyUpcomingChargesDeps,
+): Promise<Response> {
+  const cors = getCorsHeaders(req);
+
+  if (req.method === "OPTIONS") {
+    return new Response(null, { status: 204, headers: cors });
+  }
+
+  if (req.method !== "POST") {
+    return jsonResponse({ error: "method_not_allowed" }, 405, cors);
+  }
+
+  const auth = validateCronAuth(req);
+  if (!auth.ok) {
+    return jsonResponse({ error: auth.code }, auth.status, cors);
+  }
+
+  const claimedSchedules = await deps.claimSchedules();
+  const summary: NotifyUpcomingChargesRunSummary = {
+    claimed_count: claimedSchedules.length,
+    notifications_enqueued: 0,
+  };
+
+  for (const schedule of claimedSchedules) {
+    try {
+      summary.notifications_enqueued += await enqueueUpcomingChargeNotifications(
+        deps.ingestNotification,
+        schedule,
+      );
+    } catch (error) {
+      logger.error("upcoming_charge_notification_enqueue_failed", {
+        schedule_id: schedule.schedule_id,
+        service_id: schedule.service_id,
+        error: error instanceof Error ? error.message : String(error),
+      });
+    }
+  }
+
+  logger.info("notify_upcoming_charges_completed", summary);
+
+  return jsonResponse(summary, 200, cors);
+}
