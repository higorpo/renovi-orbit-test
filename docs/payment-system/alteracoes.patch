+++ b/supabase/functions/dispatch-kyc-email/buildKycEmailHtml.ts
@@ -0,0 +1,65 @@
+import type { KycSubmissionInput } from "./types.ts";
+
+function escapeHtml(value: string): string {
+  return value
+    .replaceAll("&", "&amp;")
+    .replaceAll("<", "&lt;")
+    .replaceAll(">", "&gt;")
+    .replaceAll('"', "&quot;");
+}
+
+function linkField(label: string, url: string): string {
+  const safeUrl = escapeHtml(url);
+  return `<tr><th align="left">${escapeHtml(label)}</th><td><a href="${safeUrl}">${safeUrl}</a></td></tr>`;
+}
+
+function textField(label: string, value: string | undefined): string {
+  return `<tr><th align="left">${escapeHtml(label)}</th><td>${escapeHtml(value ?? "-")}</td></tr>`;
+}
+
+export function buildKycEmailHtml(
+  submission: KycSubmissionInput,
+  providerId: string,
+  submissionId: string,
+): string {
+  const rows = [
+    textField("Submission ID", submissionId),
+    textField("Provider ID", providerId),
+    textField("Entity Type", submission.entity_type),
+    textField("Full Name", submission.full_name),
+    textField("Document", submission.document),
+    textField("Phone", submission.phone),
+    textField("Email", submission.email),
+    textField("Bank Institution Code", submission.bank_institution_code),
+    textField("Bank Branch", submission.bank_branch),
+    textField("Bank Account", submission.bank_account),
+    textField("PIX Key", submission.pix_key),
+    linkField("Identity Document", submission.identity_doc_url),
+    linkField("Address Proof", submission.address_proof_url),
+  ];
+
+  if (submission.entity_type === "CNPJ") {
+    rows.push(
+      textField("Razão Social", submission.razao_social),
+      textField("Nome Fantasia", submission.nome_fantasia),
+      textField("Legal Representative Name", submission.legal_rep_full_name),
+      textField("Legal Representative CPF", submission.legal_rep_cpf),
+      textField("Legal Representative Phone", submission.legal_rep_phone),
+      linkField("Corporate Charter", submission.corporate_charter_url ?? ""),
+      linkField("Legal Representative Document", submission.legal_rep_doc_url ?? ""),
+    );
+  }
+
+  return `<!DOCTYPE html>
+<html>
+  <body>
+    <h1>Provider KYC Submission</h1>
+    <p>New credentialing submission received from Orbit.</p>
+    <table border="1" cellpadding="8" cellspacing="0">${rows.join("")}</table>
+  </body>
+</html>`;
+}
+
+export function buildKycEmailSubject(submission: KycSubmissionInput): string {
+  return `[Orbit KYC] ${submission.entity_type} — ${submission.full_name}`;
+}
diff --git a/supabase/functions/dispatch-kyc-email/handleRequest.ts b/supabase/functions/dispatch-kyc-email/handleRequest.ts
new file mode 100644
index 0000000..7b5a5a7
--- /dev/null
+++ b/supabase/functions/dispatch-kyc-email/handleRequest.ts
@@ -0,0 +1,171 @@
+import { getCorsHeaders } from "../_shared/cors.ts";
+import { jsonResponse } from "../_shared/jsonResponse.ts";
+import { createPaymentLogger } from "../_shared/observability/payment-logger.ts";
+import { checkRateLimit, getClientIP } from "../_shared/rateLimiter.ts";
+import type { ResendSendResult } from "../message-dispatcher-worker/resend.ts";
+import {
+  buildKycEmailHtml,
+  buildKycEmailSubject,
+} from "./buildKycEmailHtml.ts";
+import type {
+  KycSubmissionBody,
+  KycSubmissionInput,
+  SubmitKycErrorCode,
+} from "./types.ts";
+import { validateKycSubmission } from "./validateKyc.ts";
+
+const logger = createPaymentLogger("dispatch-kyc-email");
+const RATE_LIMIT_CONFIG = { perMinute: 5 };
+
+export type DispatchKycEmailDeps = {
+  getUser: (token: string) => Promise<{
+    user: { id: string; email?: string } | null;
+    error: Error | null;
+  }>;
+  submitKyc: (providerId: string, input: KycSubmissionInput) => Promise<
+    | { submissionId: string }
+    | SubmitKycErrorCode
+  >;
+  sendKycEmail: (input: {
+    recipientEmail: string;
+    subject: string;
+    html: string;
+    correlationId: string;
+  }) => Promise<ResendSendResult>;
+  markEmailDispatched: (providerId: string) => Promise<void>;
+  enqueueEmailRetry: (input: {
+    providerId: string;
+    submissionId: string;
+    subject: string;
+    html: string;
+  }) => Promise<void>;
+  getCredenciamentoEmail: () => string;
+  checkRateLimit: typeof checkRateLimit;
+};
+
+function mapSubmitErrorStatus(error: SubmitKycErrorCode): number {
+  switch (error) {
+    case "PROVIDER_ACCOUNT_NOT_FOUND":
+      return 404;
+    default:
+      return 409;
+  }
+}
+
+export async function handleDispatchKycEmailRequest(
+  req: Request,
+  deps: DispatchKycEmailDeps,
+): Promise<Response> {
+  const cors = getCorsHeaders(req);
+
+  if (req.method === "OPTIONS") {
+    return new Response(null, { status: 204, headers: cors });
+  }
+
+  if (req.method !== "POST") {
+    return jsonResponse({ error: "method_not_allowed" }, 405, cors);
+  }
+
+  const authHeader = req.headers.get("Authorization");
+  if (!authHeader?.startsWith("Bearer ")) {
+    return jsonResponse({ error: "Unauthorized" }, 401, cors);
+  }
+
+  const token = authHeader.replace("Bearer ", "");
+  const { user, error: authError } = await deps.getUser(token);
+  if (authError || !user?.email) {
+    return jsonResponse({ error: "Unauthorized" }, 401, cors);
+  }
+
+  const clientIP = getClientIP(req);
+  const rateLimit = await deps.checkRateLimit(
+    clientIP,
+    user.id,
+    "dispatch-kyc-email",
+    RATE_LIMIT_CONFIG,
+  );
+
+  if (!rateLimit.allowed) {
+    return jsonResponse(
+      {
+        error: "rate_limited",
+        message: "Too many requests. Try again shortly.",
+        retryAfter: rateLimit.retryAfter,
+      },
+      429,
+      { ...cors, "Retry-After": String(rateLimit.retryAfter) },
+    );
+  }
+
+  let body: KycSubmissionBody;
+  try {
+    body = await req.json() as KycSubmissionBody;
+  } catch {
+    return jsonResponse({ error: "Invalid JSON body" }, 400, cors);
+  }
+
+  const validated = validateKycSubmission(body as KycSubmissionInput, user.email);
+  if ("error_code" in validated) {
+    return jsonResponse(
+      { error_code: validated.error_code, field: validated.field },
+      validated.status,
+      cors,
+    );
+  }
+
+  const submitResult = await deps.submitKyc(user.id, validated);
+  if (typeof submitResult === "string") {
+    return jsonResponse(
+      { error_code: submitResult },
+      mapSubmitErrorStatus(submitResult),
+      cors,
+    );
+  }
+
+  const subject = buildKycEmailSubject(validated);
+  const html = buildKycEmailHtml(validated, user.id, submitResult.submissionId);
+  const correlationId = `kyc-email:${submitResult.submissionId}`;
+
+  const emailResult = await deps.sendKycEmail({
+    recipientEmail: deps.getCredenciamentoEmail(),
+    subject,
+    html,
+    correlationId,
+  });
+
+  if (emailResult.ok) {
+    await deps.markEmailDispatched(user.id);
+    return jsonResponse(
+      {
+        submission_id: submitResult.submissionId,
+        email_dispatched: true,
+      },
+      200,
+      cors,
+    );
+  }
+
+  logger.warn("kyc_email_dispatch_failed", {
+    provider_id: user.id,
+    submission_id: submitResult.submissionId,
+    error_code: emailResult.errorCode,
+    error_message: emailResult.errorMessage,
+  });
+
+  await deps.enqueueEmailRetry({
+    providerId: user.id,
+    submissionId: submitResult.submissionId,
+    subject,
+    html,
+  });
+
+  return jsonResponse(
+    {
+      submission_id: submitResult.submissionId,
+      email_dispatched: false,
+      email_pending: true,
+    },
+    200,
+    cors,
+  );
+}
diff --git a/supabase/functions/dispatch-kyc-email/index.ts b/supabase/functions/dispatch-kyc-email/index.ts
new file mode 100644
