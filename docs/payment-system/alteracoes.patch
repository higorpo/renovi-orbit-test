+import type { UpcomingChargeSchedule } from "./types.ts";
+import type { NotificationIngestInput } from "../manual-charge-payment/enqueueNotifications.ts";
+
+export async function enqueueUpcomingChargeNotifications(
+  ingest: (input: NotificationIngestInput) => Promise<void>,
+  schedule: UpcomingChargeSchedule,
+): Promise<number> {
+  const baseKey = `upcoming-charge:${schedule.schedule_id}`;
+  const chargeAmount = schedule.charge_amount.toFixed(2);
+  const deepLink = `renovi://services/${schedule.service_id}`;
+
+  await ingest({
+    profileId: schedule.client_id,
+    channel: "PUSH",
+    templateKey: "upcoming_charge_reminder",
+    idempotencyKey: `${baseKey}:client-push`,
+    templateVariables: {
+      serviceId: schedule.service_id,
+      chargeScheduledAt: schedule.charge_scheduled_at,
+      chargeAmount,
+      installmentNumber: schedule.installment_number,
+      cardMasked: schedule.card_number_masked,
+      cardBrand: schedule.card_brand,
+      deepLink,
+    },
+    bypassLimits: true,
+  });
+
+  await ingest({
+    profileId: schedule.client_id,
+    channel: "EMAIL",
+    templateKey: "upcoming_charge_reminder_email",
+    idempotencyKey: `${baseKey}:client-email`,
+    templateVariables: {
+      serviceId: schedule.service_id,
+      chargeScheduledAt: schedule.charge_scheduled_at,
+      chargeAmount,
+      installmentNumber: schedule.installment_number,
+      cardMasked: schedule.card_number_masked,
+      cardBrand: schedule.card_brand,
+      deepLink,
+    },
+    bypassLimits: true,
+  });
+
+  return 2;
+}
