diff --git a/supabase/migrations/20260705209700_auto_cancel_services_rpc_returns_rows.sql b/supabase/migrations/20260705209700_auto_cancel_services_rpc_returns_rows.sql
new file mode 100644
index 0000000..3f5adb0
--- /dev/null
+++ b/supabase/migrations/20260705209700_auto_cancel_services_rpc_returns_rows.sql
@@ -0,0 +1,132 @@
+-- Payment System — task 39: auto_cancel_services_rpc returns cancelled rows for notification dispatch.
+
+create or replace function public.auto_cancel_services_rpc()
+returns jsonb
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_service record;
+  v_cancel_hours int;
+  v_reason text;
+  v_results jsonb := '[]'::jsonb;
+begin
+  v_cancel_hours := public.platform_constant_int('auto_cancel_hours_before_service', 12);
+
+  for v_service in
+    select
+      cs.id as service_id,
+      cs.client_id,
+      cs.provider_id,
+      ps.id as schedule_id,
+      ps.state as schedule_state,
+      ps.failure_reason as last_failure_reason,
+      pa.onboarding_status
+    from public.contracted_services cs
+    join public.payment_schedules ps on ps.contracted_service_id = cs.id
+    left join public.provider_accounts pa
+      on pa.provider_id = ps.provider_id
+      and pa.gateway_slug = ps.gateway_slug
+    where cs.service_scheduled_at is not null
+      and cs.service_scheduled_at - now() <= make_interval(hours => v_cancel_hours)
+      and ps.state not in (
+        'PAID',
+        'IN_ANALYSIS',
+        'CANCELLED',
+        'VOIDED',
+        'REFUNDED',
+        'PARTIALLY_REFUNDED',
+        'EXPIRED',
+        'PROCESSING'
+      )
+      and cs.status not in ('CANCELLED', 'COMPLETED')
+  loop
+    begin
+      if (
+        select cs.status
+        from public.contracted_services cs
+        where cs.id = v_service.service_id
+      ) = 'CANCELLED'::public.contracted_service_status then
+        continue;
+      end if;
+
+      v_reason := case
+        when v_service.onboarding_status = 'SUSPENDED' then 'PROVIDER_SUSPENDED'
+        else 'NON_PAYMENT'
+      end;
+
+      update public.contracted_services cs
+      set
+        status = 'CANCELLED'::public.contracted_service_status,
+        cancellation_reason = v_reason
+      where cs.id = v_service.service_id;
+
+      update public.payment_schedules ps
+      set
+        state = 'CANCELLED',
+        cancelled_at = now(),
+        cancellation_reason = v_reason
+      where ps.id = v_service.schedule_id;
+
+      insert into public.payment_audit_log (
+        event_type,
+        entity_type,
+        entity_id,
+        service_id,
+        schedule_id,
+        actor,
+        from_state,
+        to_state,
+        metadata
+      )
+      values (
+        'AUTO_CANCELLED',
+        'contracted_service',
+        v_service.service_id,
+        v_service.service_id,
+        v_service.schedule_id,
+        'system',
+        v_service.schedule_state,
+        'CANCELLED',
+        jsonb_build_object('cancellation_reason', v_reason)
+      );
+
+      insert into public.payment_events (
+        event_type,
+        aggregate_type,
+        aggregate_id,
+        service_id,
+        payload
+      )
+      values (
+        'ServiceAutoCancelled',
+        'contracted_service',
+        v_service.service_id,
+        v_service.service_id,
+        jsonb_build_object(
+          'schedule_id', v_service.schedule_id,
+          'cancellation_reason', v_reason
+        )
+      );
+
+      v_results := v_results || jsonb_build_array(jsonb_build_object(
+        'service_id', v_service.service_id,
+        'schedule_id', v_service.schedule_id,
+        'client_id', v_service.client_id,
+        'provider_id', v_service.provider_id,
+        'cancellation_reason', v_reason,
+        'last_failure_reason', v_service.last_failure_reason
+      ));
+    exception
+      when others then
+        perform pg_notify('auto_cancel_error', v_service.service_id::text);
+    end;
+  end loop;
+
+  return v_results;
+end;
+$$;
+
+comment on function public.auto_cancel_services_rpc() is
+  'T-12h auto-cancel for unpaid schedules; returns cancelled rows for EF notification dispatch.';
