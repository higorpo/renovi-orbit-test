+do $seed$
+declare
+  v_service_id uuid;
+  v_client_id uuid;
+  v_provider_id uuid;
+  v_token_id uuid;
+  v_new_id uuid;
+  v_i int;
+begin
+  select cs.id, cs.client_id, cs.provider_id
+  into v_service_id, v_client_id, v_provider_id
+  from public.contracted_services cs
+  where cs.status = 'CONFIRMED'::public.contracted_service_status
+  limit 1;
+
+  if v_service_id is null then
+    select cs.id, cs.client_id, cs.provider_id
+    into v_service_id, v_client_id, v_provider_id
+    from public.contracted_services cs
+    limit 1;
+  end if;
+
+  if v_service_id is null then
+    raise exception 'cron_charge_dequeue_concurrency_test requires contracted_services seed data';
+  end if;
+
+  insert into public.provider_accounts (provider_id, gateway_slug, document, onboarding_status)
+  values (v_provider_id, 'netcred', '99999999999', 'ACTIVE')
+  on conflict (provider_id, gateway_slug) do update
+    set onboarding_status = 'ACTIVE';
+
+  select pt.id
+  into v_token_id
+  from public.payment_tokens pt
+  where pt.client_id = v_client_id
+    and pt.state = 'ACTIVE'
+  limit 1;
+
+  if v_token_id is null then
+    insert into public.payment_tokens (
+      id, client_id, provider_id, gateway_payment_profile_id,
+      card_number_masked, card_brand, gateway_card_token,
+      expiry_month, expiry_year, cardholder_name, billing_address
+    )
+    select
+      gen_random_uuid(),
+      v_client_id,
+      pp.id,
+      'dequeue-concurrency-profile',
+      '411111XXXXXX1111',
+      'VCC',
+      'tok-dequeue-concurrency',
+      12,
+      2030,
+      'Dequeue Test',
+      '{"street":"Rua A","number":"1","district":"Centro","city":"SP","state":"SP","zipCode":"01001000"}'::jsonb
+    from public.payment_providers pp
+    where pp.slug = 'netcred'
+    limit 1
+    returning id into v_token_id;
+  end if;
+
+  for v_i in 1..55 loop
+    insert into public.payment_schedules (
+      contracted_service_id,
+      client_id,
+      provider_id,
+      gateway_slug,
+      payment_token_id,
+      installment_number,
+      base_amount,
+      charge_scheduled_at,
+      state,
+      idempotency_key
+    )
+    values (
+      v_service_id,
+      v_client_id,
+      v_provider_id,
+      'netcred',
+      v_token_id,
+      1,
+      1000,
+      now() - interval '1 hour',
+      'SCHEDULED',
+      gen_random_uuid()::text
+    )
+    returning id into v_new_id;
+
+    insert into _seeded_schedule_ids (id) values (v_new_id);
+  end loop;
+end;
+$seed$;
+
+create temp table _dequeue_wave_1 as
+select jsonb_array_elements(
+  coalesce(public.cron_charge_dequeue_rpc(50), '[]'::jsonb)
+) as row;
+
+create temp table _dequeue_wave_2 as
+select jsonb_array_elements(
+  coalesce(public.cron_charge_dequeue_rpc(50), '[]'::jsonb)
+) as row;
+
+select is(
+  (
+    select count(*)::int
+    from _dequeue_wave_1 w
+    join _seeded_schedule_ids s on s.id = (w.row->>'id')::uuid
+  ),
+  50,
+  'first dequeue wave claims 50 seeded schedules'
+);
+
+select is(
+  (
+    select count(*)::int
+    from _dequeue_wave_2 w
+    join _seeded_schedule_ids s on s.id = (w.row->>'id')::uuid
+  ),
+  5,
+  'second dequeue wave claims remaining 5 seeded schedules without overlap'
+);
+
+select is(
+  (
+    select count(*)::int
+    from (
+      select (w.row->>'id')::uuid as schedule_id
+      from _dequeue_wave_1 w
+      join _seeded_schedule_ids s on s.id = (w.row->>'id')::uuid
+      union all
+      select (w.row->>'id')::uuid
+      from _dequeue_wave_2 w
+      join _seeded_schedule_ids s on s.id = (w.row->>'id')::uuid
+    ) claimed
+  ),
+  55,
+  'both waves claim all 55 seeded schedules exactly once'
+);
+
+select is(
+  (
+    select count(*)::int
+    from (
+      select (w.row->>'id')::uuid as schedule_id from _dequeue_wave_1 w
+      join _seeded_schedule_ids s on s.id = (w.row->>'id')::uuid
+      intersect
+      select (w.row->>'id')::uuid from _dequeue_wave_2 w
+      join _seeded_schedule_ids s on s.id = (w.row->>'id')::uuid
+    ) overlap
+  ),
+  0,
+  'no seeded schedule id is claimed in both dequeue waves'
+);
+
+select * from finish();
+rollback;
