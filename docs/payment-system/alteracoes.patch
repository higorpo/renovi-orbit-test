@@ -0,0 +1,83 @@
+import { getCorsHeaders } from "../_shared/cors.ts";
+import { jsonResponse } from "../_shared/jsonResponse.ts";
+import { createPaymentLogger } from "../_shared/observability/payment-logger.ts";
+import { validateCronAuth } from "../schedule-netcred-charges/auth.ts";
+import type { WebhookDispatchDeps } from "../netcred-webhook/createWebhookHandlerDeps.ts";
+import { processWebhookEvent } from "./processEvent.ts";
+import type {
+  WebhookRetryClaimRow,
+  WebhookRetryFailResult,
+  WebhookRetryRunSummary,
+} from "./types.ts";
+
+const logger = createPaymentLogger("process-webhook-retry");
+
+export type ProcessWebhookRetryDeps = {
+  claimRetryEvents: (batchSize?: number) => Promise<WebhookRetryClaimRow[]>;
+  claimQueueEvents: (batchSize?: number) => Promise<WebhookRetryClaimRow[]>;
+  handlerDeps: WebhookDispatchDeps;
+  processEvent: (
+    row: WebhookRetryClaimRow,
+  ) => Promise<"processed" | "failed" | "dead_letter" | "skipped">;
+};
+
+function emptySummary(): WebhookRetryRunSummary {
+  return {
+    claimed: 0,
+    processed: 0,
+    failed: 0,
+    dead_letter: 0,
+    skipped: 0,
+  };
+}
+
+export async function handleProcessWebhookRetryRequest(
+  req: Request,
+  deps: ProcessWebhookRetryDeps,
+): Promise<Response> {
+  const cors = getCorsHeaders(req);
+
+  if (req.method === "OPTIONS") {
+    return new Response(null, { status: 204, headers: cors });
+  }
+
+  if (req.method !== "POST") {
+    return jsonResponse({ error: "method_not_allowed" }, 405, cors);
+  }
+
+  const auth = validateCronAuth(req);
+  if (!auth.ok) {
+    return jsonResponse({ error: auth.code }, auth.status, cors);
+  }
+
+  const retryRows = await deps.claimRetryEvents();
+  const queueRows = await deps.claimQueueEvents();
+  const rows = [...retryRows, ...queueRows];
+  const summary = emptySummary();
+  summary.claimed = rows.length;
+
+  for (const row of rows) {
+    const outcome = await deps.processEvent(row);
+
+    switch (outcome) {
+      case "processed":
+        summary.processed += 1;
+        break;
+      case "failed":
+        summary.failed += 1;
+        break;
+      case "dead_letter":
+        summary.dead_letter += 1;
+        break;
+      case "skipped":
+        summary.skipped += 1;
+        break;
+    }
+  }
+
+  logger.info("webhook_retry_completed", summary);
+
+  return jsonResponse(summary.claimed > 0 ? summary : emptySummary(), 200, cors);
+}
+
+export type { WebhookRetryFailResult };
diff --git a/supabase/functions/process-webhook-retry/index.ts b/supabase/functions/process-webhook-retry/index.ts
new file mode 100644
index 0000000..c56583b
--- /dev/null
+++ b/supabase/functions/process-webhook-retry/index.ts
@@ -0,0 +1,136 @@
+import "xhr";
+import { servePaymentFunction } from "../_shared/observability/sentry.ts";
+import { captureWebhookDeadLetterCritical } from "../_shared/observability/critical-alerts.ts";
+import { createPaymentLogger } from "../_shared/observability/payment-logger.ts";
+import { createServiceRoleClient } from "../_shared/serviceRoleClient.ts";
+import { createWebhookHandlerDeps } from "../netcred-webhook/createWebhookHandlerDeps.ts";
+import { dispatchWebhookEvent } from "../netcred-webhook/dispatchWebhookEvent.ts";
+import {
+  handleProcessWebhookRetryRequest,
+  type ProcessWebhookRetryDeps,
+  type WebhookRetryFailResult,
+} from "./handleRequest.ts";
+import { processWebhookEvent } from "./processEvent.ts";
+import type { WebhookRetryClaimRow } from "./types.ts";
+
+const logger = createPaymentLogger("process-webhook-retry");
+
+function parseClaimRows(data: unknown): WebhookRetryClaimRow[] {
+  if (!Array.isArray(data)) {
+    return [];
+  }
+
+  return data.map((row) => {
+    const item = row as Record<string, unknown>;
+    return {
+      source: item.source as WebhookRetryClaimRow["source"],
+      event_id: String(item.event_id),
+      queue_id: item.queue_id ? String(item.queue_id) : undefined,
+      gateway_slug: String(item.gateway_slug),
+      event_type: String(item.event_type),
+      gateway_event_id: String(item.gateway_event_id),
+      raw_payload: (item.raw_payload ?? {}) as Record<string, unknown>,
+      retry_count: Number(item.retry_count ?? 0),
+      failure_reason: typeof item.failure_reason === "string"
+        ? item.failure_reason
+        : null,
+    };
+  });
+}
+
+async function captureDeadLetterCritical(
+  input: WebhookRetryFailResult,
+): Promise<void> {
+  captureWebhookDeadLetterCritical({
+    event_id: input.event_id,
+    event_type: input.event_type,
+    gateway_event_id: input.gateway_event_id,
+    schedule_id: input.schedule_id ?? null,
+    failure_reason: input.failure_reason,
+    retry_count: input.retry_count,
+  });
+
+  logger.error("WEBHOOK_DEAD_LETTER", {
+    event_id: input.event_id,
+    event_type: input.event_type,
+    gateway_event_id: input.gateway_event_id,
+    schedule_id: input.schedule_id ?? null,
+    failure_reason: input.failure_reason,
+    retry_count: input.retry_count,
+    gateway_slug: "netcred",
+  });
+}
+
+function createDeps(): ProcessWebhookRetryDeps {
+  const supabase = createServiceRoleClient();
+  const handlerDeps = createWebhookHandlerDeps(supabase, {
+    emitCritical: (extra) => {
+      logger.error("webhook_handler_critical", extra);
+    },
+  });
+
+  const processDeps = {
+    dispatch: dispatchWebhookEvent,
+    markProcessed: async (input: { eventId: string; queueId?: string }) => {
+      const { error } = await supabase.rpc("webhook_retry_mark_processed_rpc", {
+        p_event_id: input.eventId,
+        p_queue_id: input.queueId ?? null,
+      });
+
+      if (error) {
+        throw new Error(error.message);
+      }
+    },
+    markFailed: async (input: {
+      eventId: string;
+      queueId?: string;
+      failureReason: string;
+    }) => {
+      const { data, error } = await supabase.rpc("webhook_retry_mark_failed_rpc", {
+        p_event_id: input.eventId,
+        p_failure_reason: input.failureReason,
+        p_base_interval_minutes: null,
+        p_queue_id: input.queueId ?? null,
+      });
+
+      if (error) {
+        throw new Error(error.message);
+      }
+
+      return data as WebhookRetryFailResult;
+    },
+    emitDeadLetterCritical: (input) => {
+      void captureDeadLetterCritical(input);
+    },
+  };
+
+  return {
+    claimRetryEvents: async (batchSize?: number) => {
+      const { data, error } = await supabase.rpc("webhook_retry_claim_rpc", {
+        p_batch_size: batchSize ?? null,
+      });
+
+      if (error) {
+        throw new Error(error.message);
+      }
+
+      return parseClaimRows(data);
+    },
+    claimQueueEvents: async (batchSize?: number) => {
+      const { data, error } = await supabase.rpc("webhook_queue_claim_rpc", {
+        p_batch_size: batchSize ?? null,
+      });
+
+      if (error) {
+        throw new Error(error.message);
+      }
+
+      return parseClaimRows(data);
+    },
+    handlerDeps,
+    processEvent: (row) => processWebhookEvent(processDeps, handlerDeps, row),
+  };
+}
+
+servePaymentFunction("process-webhook-retry", (req) =>
+  handleProcessWebhookRetryRequest(req, createDeps()));
diff --git a/supabase/functions/process-webhook-retry/processEvent.ts b/supabase/functions/process-webhook-retry/processEvent.ts
