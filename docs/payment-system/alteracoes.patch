diff --git a/supabase/scripts/growth/payment_audit_log_monthly_partitions.sql b/supabase/scripts/growth/payment_audit_log_monthly_partitions.sql
new file mode 100644
index 0000000..9d1227e
--- /dev/null
+++ b/supabase/scripts/growth/payment_audit_log_monthly_partitions.sql
@@ -0,0 +1,156 @@
+-- Growth-phase stub (task 75). NOT applied in MVP migrations.
+-- Run manually during a maintenance window after backup and threshold validation.
+-- Preconditions: payment_audit_log is heap; see docs/payment-system/audit-log-partitioning.md
+
+-- ---------------------------------------------------------------------------
+-- 1) Partitioned parent (PK must include partition key on Postgres 15+)
+-- ---------------------------------------------------------------------------
+
+create table public.payment_audit_log_partitioned (
+  id uuid not null default gen_random_uuid(),
+  event_type text not null,
+  entity_type text not null,
+  entity_id uuid not null,
+  service_id uuid,
+  schedule_id uuid,
+  from_state text,
+  to_state text,
+  actor text not null
+    check (actor in ('cron', 'client', 'webhook', 'support', 'system')),
+  actor_id uuid,
+  metadata jsonb not null default '{}',
+  created_at timestamptz not null default now(),
+  primary key (id, created_at)
+) partition by range (created_at);
+
+comment on table public.payment_audit_log_partitioned is
+  'Growth-phase RANGE(created_at) parent for payment_audit_log; swap after backfill.';
+
+-- ---------------------------------------------------------------------------
+-- 2) Example monthly partitions (extend bounds for each month at cutover)
+-- ---------------------------------------------------------------------------
+
+create table public.payment_audit_log_y2026m06
+  partition of public.payment_audit_log_partitioned
+  for values from ('2026-06-01') to ('2026-07-01');
+
+create table public.payment_audit_log_y2026m07
+  partition of public.payment_audit_log_partitioned
+  for values from ('2026-07-01') to ('2026-08-01');
+
+create table public.payment_audit_log_y2026m08
+  partition of public.payment_audit_log_partitioned
+  for values from ('2026-08-01') to ('2026-09-01');
+
+-- Per-partition indexes (mirror MVP idx_audit_log_service / idx_audit_log_schedule)
+create index payment_audit_log_y2026m06_service_created_idx
+  on public.payment_audit_log_y2026m06 (service_id, created_at);
+
+create index payment_audit_log_y2026m06_schedule_created_idx
+  on public.payment_audit_log_y2026m06 (schedule_id, created_at);
+
+create index payment_audit_log_y2026m07_service_created_idx
+  on public.payment_audit_log_y2026m07 (service_id, created_at);
+
+create index payment_audit_log_y2026m07_schedule_created_idx
+  on public.payment_audit_log_y2026m07 (schedule_id, created_at);
+
+create index payment_audit_log_y2026m08_service_created_idx
+  on public.payment_audit_log_y2026m08 (service_id, created_at);
+
+create index payment_audit_log_y2026m08_schedule_created_idx
+  on public.payment_audit_log_y2026m08 (schedule_id, created_at);
+
+-- ---------------------------------------------------------------------------
+-- 3) Idempotent monthly partition pre-creation (pg_cron target)
+-- ---------------------------------------------------------------------------
+
+create or replace function public.ensure_payment_audit_log_monthly_partitions(
+  p_months_ahead int default 3
+)
+returns void
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_month_start date;
+  v_month_end date;
+  v_partition_name text;
+  v_sql text;
+  v_i int;
+begin
+  if p_months_ahead < 1 then
+    raise exception 'p_months_ahead must be >= 1';
+  end if;
+
+  for v_i in 0..(p_months_ahead - 1) loop
+    v_month_start := date_trunc('month', current_date + (v_i || ' months')::interval)::date;
+    v_month_end := (v_month_start + interval '1 month')::date;
+    v_partition_name := format(
+      'payment_audit_log_y%sm%s',
+      to_char(v_month_start, 'YYYY'),
+      to_char(v_month_start, 'MM')
+    );
+
+    if to_regclass(format('public.%I', v_partition_name)) is not null then
+      continue;
+    end if;
+
+    v_sql := format(
+      $fmt$
+        create table public.%I
+          partition of public.payment_audit_log_partitioned
+          for values from (%L) to (%L);
+
+        create index if not exists %I
+          on public.%I (service_id, created_at);
+
+        create index if not exists %I
+          on public.%I (schedule_id, created_at);
+      $fmt$,
+      v_partition_name,
+      v_month_start,
+      v_month_end,
+      v_partition_name || '_service_created_idx',
+      v_partition_name,
+      v_partition_name || '_schedule_created_idx',
+      v_partition_name
+    );
+
+    execute v_sql;
+  end loop;
+end;
+$$;
+
+comment on function public.ensure_payment_audit_log_monthly_partitions(int) is
+  'Growth ops: create upcoming monthly payment_audit_log partitions idempotently (task 75).';
+
+revoke all on function public.ensure_payment_audit_log_monthly_partitions(int) from public, anon, authenticated;
+grant execute on function public.ensure_payment_audit_log_monthly_partitions(int) to service_role;
+
+-- ---------------------------------------------------------------------------
+-- 4) pg_cron registration (run once after cutover to partitioned table)
+-- ---------------------------------------------------------------------------
+
+-- select cron.schedule(
+--   'ensure-payment-audit-log-partitions',
+--   '0 2 1 * *',
+--   $$select public.ensure_payment_audit_log_monthly_partitions(3);$$
+-- );
+
+-- ---------------------------------------------------------------------------
+-- 5) Backfill + swap outline (customize in maintenance runbook)
+-- ---------------------------------------------------------------------------
+
+-- insert into public.payment_audit_log_partitioned
+-- select * from public.payment_audit_log;
+--
+-- -- verify counts match, then:
+-- alter table public.payment_audit_log rename to payment_audit_log_heap_legacy;
+-- alter table public.payment_audit_log_partitioned rename to payment_audit_log;
+--
+-- alter table public.payment_audit_log enable row level security;
+-- create policy audit_log_client_or_provider_select on public.payment_audit_log ...;
+-- grant insert, select on public.payment_audit_log to authenticated, service_role;
+-- revoke update, delete on public.payment_audit_log from authenticated, service_role;
diff --git a/supabase/scripts/growth/payment_indexes_concurrently.sql b/supabase/scripts/growth/payment_indexes_concurrently.sql
new file mode 100644
index 0000000..b0bf796
--- /dev/null
+++ b/supabase/scripts/growth/payment_indexes_concurrently.sql
@@ -0,0 +1,48 @@
+-- Production index build (task 81). Run OUTSIDE a transaction.
+-- Usage: psql $DATABASE_URL -f supabase/scripts/growth/payment_indexes_concurrently.sql
+-- Preconditions: tables exist; prefer low-traffic window.
+
+create index concurrently if not exists idx_payment_schedules_queue
+  on public.payment_schedules (state, charge_scheduled_at)
+  where state in ('SCHEDULED', 'FAILED');
+
+create index concurrently if not exists idx_payment_schedules_service
+  on public.payment_schedules (contracted_service_id);
+
+create index concurrently if not exists idx_payment_schedules_stale
+  on public.payment_schedules (state, locked_until)
+  where state = 'PROCESSING';
+
+create index concurrently if not exists idx_payment_attempts_schedule
+  on public.payment_attempts (schedule_id, attempt_number);
+
+create index concurrently if not exists idx_webhook_events_retry
+  on public.payment_webhook_events (state, next_retry_at)
+  where state in ('FAILED', 'RETRYING');
+
+create index concurrently if not exists idx_webhook_events_dead_letter
+  on public.payment_webhook_events (state, created_at)
+  where state = 'DEAD_LETTER';
+
+create index concurrently if not exists idx_audit_log_service
+  on public.payment_audit_log (service_id, created_at);
+
+create index concurrently if not exists idx_audit_log_schedule
+  on public.payment_audit_log (schedule_id, created_at);
+
+create index concurrently if not exists idx_payment_events_type
+  on public.payment_events (event_type, created_at desc);
+
+create index concurrently if not exists idx_payment_events_service
+  on public.payment_events (service_id, created_at desc);
+
+create index concurrently if not exists idx_payment_events_aggregate
+  on public.payment_events (aggregate_type, aggregate_id, created_at desc);
+
+create index concurrently if not exists idx_webhook_queue_state
+  on public.payment_webhook_processing_queue (state, created_at)
+  where state = 'PENDING';
+
+create index concurrently if not exists idx_contracted_services_scheduled_at
+  on public.contracted_services (service_scheduled_at)
+  where status in ('PENDING_PAYMENT', 'CONFIRMED');
