@@ -0,0 +1,88 @@
+import { isValidCpf, normalizeCpf } from "../tokenize-payment-card/validateCpf.ts";
+import { isValidCnpj, normalizeCnpj } from "./validateCnpj.ts";
+import type { KycSubmissionInput } from "./types.ts";
+
+export type ValidateKycError = {
+  status: 422;
+  error_code: string;
+  field?: string;
+};
+
+function isNonEmpty(value: string | undefined): value is string {
+  return Boolean(value?.trim());
+}
+
+export function validateKycSubmission(
+  input: KycSubmissionInput,
+  accountEmail: string,
+): KycSubmissionInput | ValidateKycError {
+  const requiredCommon: Array<keyof KycSubmissionInput> = [
+    "entity_type",
+    "full_name",
+    "document",
+    "phone",
+    "email",
+    "bank_institution_code",
+    "bank_branch",
+    "bank_account",
+    "identity_doc_url",
+    "address_proof_url",
+  ];
+
+  for (const field of requiredCommon) {
+    if (!isNonEmpty(String(input[field] ?? ""))) {
+      return { status: 422, error_code: "KYC_FIELD_REQUIRED", field };
+    }
+  }
+
+  if (input.entity_type !== "CPF" && input.entity_type !== "CNPJ") {
+    return { status: 422, error_code: "INVALID_ENTITY_TYPE", field: "entity_type" };
+  }
+
+  if (input.email.trim().toLowerCase() !== accountEmail.trim().toLowerCase()) {
+    return { status: 422, error_code: "EMAIL_MISMATCH", field: "email" };
+  }
+
+  if (input.entity_type === "CPF") {
+    if (!isValidCpf(input.document)) {
+      return { status: 422, error_code: "INVALID_CPF", field: "document" };
+    }
+
+    return {
+      ...input,
+      document: normalizeCpf(input.document),
+      entity_type: "CPF",
+    };
+  }
+
+  const cnpjFields: Array<keyof KycSubmissionInput> = [
+    "razao_social",
+    "nome_fantasia",
+    "legal_rep_full_name",
+    "legal_rep_cpf",
+    "legal_rep_phone",
+    "corporate_charter_url",
+    "legal_rep_doc_url",
+  ];
+
+  for (const field of cnpjFields) {
+    if (!isNonEmpty(String(input[field] ?? ""))) {
+      return { status: 422, error_code: "KYC_FIELD_REQUIRED", field };
+    }
+  }
+
+  if (!isValidCnpj(input.document)) {
+    return { status: 422, error_code: "INVALID_CNPJ", field: "document" };
+  }
+
+  if (!isValidCpf(input.legal_rep_cpf!)) {
+    return { status: 422, error_code: "INVALID_CPF", field: "legal_rep_cpf" };
+  }
+
+  return {
+    ...input,
+    document: normalizeCnpj(input.document),
+    legal_rep_cpf: normalizeCpf(input.legal_rep_cpf!),
+    entity_type: "CNPJ",
+  };
+}
