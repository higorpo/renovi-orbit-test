@@ -0,0 +1,17 @@
+const MS_PER_MINUTE = 60_000;
+
+export function computeNextRetryAt(
+  retryCount: number,
+  baseMinutes: number,
+  nowMs = Date.now(),
+): Date {
+  const delayMs = baseMinutes * Math.pow(2, retryCount - 1) * MS_PER_MINUTE;
+  return new Date(nowMs + delayMs);
+}
+
+export function computeNextRetryDelayMinutes(
+  retryCount: number,
+  baseMinutes: number,
+): number {
+  return baseMinutes * Math.pow(2, retryCount - 1);
+}
