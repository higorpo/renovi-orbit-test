+export type InstallmentQueryParams = {
+  proposalId: string;
+  serviceId: string;
+  cardBrand: string;
+};
+
+export function parseInstallmentQuery(req: Request): InstallmentQueryParams | null {
+  const url = new URL(req.url);
+  const proposalId = url.searchParams.get("proposal_id")?.trim() ?? "";
+  const serviceId = url.searchParams.get("service_id")?.trim() ?? "";
+  const cardBrand = url.searchParams.get("card_brand")?.trim() ?? "";
+
+  if (!proposalId || !serviceId || !cardBrand) {
+    return null;
+  }
+
+  return { proposalId, serviceId, cardBrand };
+}
