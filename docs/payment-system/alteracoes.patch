diff --git a/supabase/migrations/20260624000001_enable_extensions.sql b/supabase/migrations/20260624000001_enable_extensions.sql
new file mode 100644
index 0000000..cc8dc5c
--- /dev/null
+++ b/supabase/migrations/20260624000001_enable_extensions.sql
@@ -0,0 +1,57 @@
+-- Payment System — Phase 1 task 1: bootstrap pg_cron and required extensions.
+-- Requirements: 10, 26. Acceptance: 26.1, 10A.1.
+-- design.md §6.1 (pg_cron scheduling for payment workers).
+
+-- pgcrypto: gen_random_uuid() for payment table PKs.
+create extension if not exists pgcrypto with schema extensions;
+
+-- pg_cron: charge cron, onboarding detection, reconcile, orphan janitor (design §6.1).
+-- Hosted Supabase: also enable pg_cron in the dashboard before cron registration tasks.
+create extension if not exists pg_cron with schema extensions;
+
+-- pg_net: pg_cron → Edge Function HTTP invocations (Supabase pattern).
+create extension if not exists pg_net with schema extensions;
+
+-- pg_stat_statements: query performance observability for payment RPCs.
+create extension if not exists pg_stat_statements with schema extensions;
+
+grant usage on schema cron to postgres;
+grant all privileges on all tables in schema cron to postgres;
+
+-- Validation: required extensions and pg_cron readiness (runs on migration apply).
+do $validate$
+declare
+  v_missing text[];
+  v_col_count int;
+begin
+  select array_agg(req.ext order by req.ext)
+  into v_missing
+  from (values ('pgcrypto'), ('pg_cron'), ('pg_net'), ('pg_stat_statements')) as req(ext)
+  where not exists (
+    select 1
+    from pg_extension e
+    where e.extname = req.ext
+  );
+
+  if v_missing is not null then
+    raise exception 'Payment bootstrap: missing extensions: %', array_to_string(v_missing, ', ');
+  end if;
+
+  -- Sanity-check pg_cron catalog (cron.job must be readable).
+  perform 1 from cron.job limit 1;
+
+  select count(*)
+  into v_col_count
+  from information_schema.columns
+  where table_schema = 'cron'
+    and table_name = 'job'
+    and column_name in (
+      'jobid', 'schedule', 'command', 'nodename', 'nodeport',
+      'database', 'username', 'active'
+    );
+
+  if v_col_count < 8 then
+    raise exception 'Payment bootstrap: cron.job missing expected columns (found % of 8)', v_col_count;
+  end if;
+end;
+$validate$;
