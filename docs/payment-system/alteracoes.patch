+export function extractPaymentProfileId(
+  payload: Record<string, unknown>,
+): string | null {
+  const profile = payload.paymentProfile as Record<string, unknown> | undefined;
+
+  const candidates = [
+    payload.paymentProfileId,
+    payload.payment_profile_id,
+    profile?.id,
+    payload.id,
+  ];
+
+  for (const candidate of candidates) {
+    if (typeof candidate === "string" && candidate.trim().length > 0) {
+      return candidate.trim();
+    }
+    if (typeof candidate === "number" && Number.isFinite(candidate)) {
+      return String(candidate);
+    }
+  }
+
+  return null;
+}
+
+export function extractPaymentProfileIsActive(
+  payload: Record<string, unknown>,
+): boolean {
+  const profile = payload.paymentProfile as Record<string, unknown> | undefined;
+
+  const candidates = [
+    payload.isActive,
+    payload.is_active,
+    profile?.isActive,
+  ];
+
+  for (const candidate of candidates) {
+    if (typeof candidate === "boolean") {
+      return candidate;
+    }
+  }
+
+  return false;
+}
+
+export function extractPaymentProfileMetadata(payload: Record<string, unknown>): {
+  cardBrand?: string;
+  expiryMonth?: number;
+  expiryYear?: number;
+  cardNumberMasked?: string;
+} {
+  const profile = payload.paymentProfile as Record<string, unknown> | undefined;
+  const card = profile?.card as Record<string, unknown> | undefined;
+
+  const cardBrand = [
+    payload.cardBrand,
+    payload.card_brand,
+    profile?.cardBrand,
+    card?.brand,
+  ].find((value) => typeof value === "string" && value.trim().length > 0);
+
+  const cardNumberMasked = [
+    payload.cardNumberMasked,
+    payload.card_number_masked,
+    profile?.cardNumberMasked,
+    card?.numberMasked,
+  ].find((value) => typeof value === "string" && value.trim().length > 0);
+
+  const expiryMonth = [
+    payload.expiryMonth,
+    payload.expiry_month,
+    profile?.expiryMonth,
+    card?.expiryMonth,
+  ].find((value) => typeof value === "number" && Number.isFinite(value));
+
+  const expiryYear = [
+    payload.expiryYear,
+    payload.expiry_year,
+    profile?.expiryYear,
+    card?.expiryYear,
+  ].find((value) => typeof value === "number" && Number.isFinite(value));
+
+  return {
+    cardBrand: typeof cardBrand === "string" ? cardBrand : undefined,
+    cardNumberMasked: typeof cardNumberMasked === "string" ? cardNumberMasked : undefined,
+    expiryMonth: typeof expiryMonth === "number" ? expiryMonth : undefined,
+    expiryYear: typeof expiryYear === "number" ? expiryYear : undefined,
+  };
+}
+
+export type PaymentProfileScheduleRow = {
+  schedule_id: string;
+  service_id: string;
+  client_id: string;
+};
