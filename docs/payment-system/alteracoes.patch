@@ -0,0 +1,246 @@
+import type { Json } from "../_shared/database.types.ts";
+import { createPaymentLogger } from "../_shared/observability/payment-logger.ts";
+import type { NotificationIngestInput } from "../manual-charge-payment/enqueueNotifications.ts";
+import type { createServiceRoleClient } from "../_shared/serviceRoleClient.ts";
+import type { ChargeVoidDeps } from "./handlers/charge-void.ts";
+import type { PaymentProfileHandlersDeps } from "./handlers/payment-profile-handlers.ts";
+import type { TransactionCaptureDeps } from "./handlers/transaction-capture.ts";
+import type { TransactionDisputeDeps } from "./handlers/transaction-dispute.ts";
+import type { TransactionRefundDeps } from "./handlers/transaction-refund.ts";
+import type { TransactionRejectedDeps } from "./handlers/transaction-rejected.ts";
+import type { TransactionUpdateDeps } from "./handlers/transaction-update.ts";
+import {
+  extractPaymentProfileId,
+  extractPaymentProfileIsActive,
+  extractPaymentProfileMetadata,
+} from "./handlers/extractPaymentProfilePayload.ts";
+import {
+  extractPaidAmount,
+  extractProviderIds,
+  extractRefundedAmount,
+} from "./handlers/extractTransactionPayload.ts";
+
+const logger = createPaymentLogger("netcred-webhook-handlers");
+
+export type WebhookDispatchDeps = {
+  capture: TransactionCaptureDeps;
+  update: TransactionUpdateDeps;
+  refund: TransactionRefundDeps;
+  chargeVoid: ChargeVoidDeps;
+  dispute: TransactionDisputeDeps;
+  paymentProfile: PaymentProfileHandlersDeps;
+};
+
+function parseRpcResult<T>(data: unknown): T {
+  return data as T;
+}
+
+export function createWebhookHandlerDeps(
+  supabase: ReturnType<typeof createServiceRoleClient>,
+  options: {
+    emitCritical?: (extra: Record<string, unknown>) => void;
+  } = {},
+): WebhookDispatchDeps {
+  const emitCritical = options.emitCritical ?? ((extra) => {
+    logger.error("webhook_critical", extra);
+  });
+
+  const ingestNotification = async (input: NotificationIngestInput): Promise<void> => {
+    const { error } = await supabase.schema("message_dispatcher").rpc(
+      "message_dispatcher_ingest",
+      {
+        p_idempotency_key: input.idempotencyKey,
+        p_profile_id: input.profileId,
+        p_channel: input.channel,
+        p_template_key: input.templateKey,
+        p_template_variables: input.templateVariables as Json,
+        p_scheduled_for: null,
+        p_source_system: "payments",
+        p_metadata: {} as Json,
+        p_bypass_limits: input.bypassLimits,
+      },
+    );
+
+    if (error) {
+      throw new Error(error.message);
+    }
+  };
+
+  const capture: TransactionCaptureDeps = {
+    applyCapture: async (input) => {
+      const { data, error } = await supabase.rpc("webhook_transaction_capture_rpc", {
+        p_reference_code: input.referenceCode,
+        p_webhook_event_id: input.webhookEventId,
+        p_paid_amount: input.paidAmount ?? null,
+        p_gateway_charge_id: input.providerChargeId ?? null,
+        p_gateway_transaction_id: input.providerTransactionId ?? null,
+      });
+
+      if (error) {
+        throw new Error(error.message);
+      }
+
+      return parseRpcResult(data);
+    },
+    ingestNotification,
+  };
+
+  const rejected: TransactionRejectedDeps = {
+    applyRejected: async (input) => {
+      const { data, error } = await supabase.rpc("webhook_transaction_rejected_rpc", {
+        p_reference_code: input.referenceCode,
+        p_webhook_event_id: input.webhookEventId,
+        p_failure_code: input.failureCode ?? null,
+        p_failure_reason: input.failureReason ?? null,
+      });
+
+      if (error) {
+        throw new Error(error.message);
+      }
+
+      return parseRpcResult(data);
+    },
+    ingestNotification,
+  };
+
+  const refund: TransactionRefundDeps = {
+    applyRefund: async (input) => {
+      const { data, error } = await supabase.rpc("webhook_transaction_refund_rpc", {
+        p_reference_code: input.referenceCode,
+        p_webhook_event_id: input.webhookEventId,
+        p_refunded_amount: input.refundedAmount,
+      });
+
+      if (error) {
+        throw new Error(error.message);
+      }
+
+      return parseRpcResult(data);
+    },
+    ingestNotification,
+  };
+
+  const chargeVoid: ChargeVoidDeps = {
+    applyVoid: async (input) => {
+      const { data, error } = await supabase.rpc("webhook_charge_void_rpc", {
+        p_reference_code: input.referenceCode,
+        p_webhook_event_id: input.webhookEventId,
+      });
+
+      if (error) {
+        throw new Error(error.message);
+      }
+
+      return parseRpcResult(data);
+    },
+  };
+
+  const dispute: TransactionDisputeDeps = {
+    applyDispute: async (input) => {
+      const { data, error } = await supabase.rpc("webhook_transaction_dispute_rpc", {
+        p_reference_code: input.referenceCode,
+        p_webhook_event_id: input.webhookEventId,
+        p_gateway_transaction_id: input.providerTransactionId ?? null,
+      });
+
+      if (error) {
+        throw new Error(error.message);
+      }
+
+      return parseRpcResult(data);
+    },
+    emitCritical,
+  };
+
+  const update: TransactionUpdateDeps = {
+    capture,
+    rejected,
+    refund,
+    chargeVoid,
+  };
+
+  const paymentProfile: PaymentProfileHandlersDeps = {
+    delete: {
+      applyDelete: async (input) => {
+        const { data, error } = await supabase.rpc("webhook_payment_profile_delete_rpc", {
+          p_gateway_payment_profile_id: input.providerPaymentProfileId,
+          p_webhook_event_id: input.webhookEventId,
+        });
+
+        if (error) {
+          throw new Error(error.message);
+        }
+
+        return parseRpcResult(data);
+      },
+      ingestNotification,
+    },
+    tokenize: {
+      applyTokenize: async (input) => {
+        const { data, error } = await supabase.rpc("webhook_payment_profile_tokenize_rpc", {
+          p_gateway_payment_profile_id: input.providerPaymentProfileId,
+          p_is_active: input.isActive,
+          p_webhook_event_id: input.webhookEventId,
+        });
+
+        if (error) {
+          throw new Error(error.message);
+        }
+
+        return parseRpcResult(data);
+      },
+      ingestNotification,
+    },
+    expiring: {
+      applyExpiring: async (input) => {
+        const { data, error } = await supabase.rpc("webhook_payment_profile_expiring_rpc", {
+          p_gateway_payment_profile_id: input.providerPaymentProfileId,
+          p_webhook_event_id: input.webhookEventId,
+        });
+
+        if (error) {
+          throw new Error(error.message);
+        }
+
+        return parseRpcResult(data);
+      },
+      ingestNotification,
+    },
+    update: {
+      applyUpdate: async (input) => {
+        const { data, error } = await supabase.rpc("webhook_payment_profile_update_rpc", {
+          p_gateway_payment_profile_id: input.providerPaymentProfileId,
+          p_webhook_event_id: input.webhookEventId,
+          p_card_brand: input.cardBrand ?? null,
+          p_expiry_month: input.expiryMonth ?? null,
+          p_expiry_year: input.expiryYear ?? null,
+          p_card_number_masked: input.cardNumberMasked ?? null,
+        });
+
+        if (error) {
+          throw new Error(error.message);
+        }
+
+        return parseRpcResult(data);
+      },
+    },
+  };
+
+  return {
+    capture,
+    update,
+    refund,
+    chargeVoid,
+    dispute,
+    paymentProfile,
+  };
+}
+
+export {
+  extractPaidAmount,
+  extractPaymentProfileId,
+  extractPaymentProfileIsActive,
+  extractPaymentProfileMetadata,
+  extractProviderIds,
+  extractRefundedAmount,
+};
diff --git a/supabase/functions/netcred-webhook/dedup.test.ts b/supabase/functions/netcred-webhook/dedup.test.ts
new file mode 100644
index 0000000..0652608
--- /dev/null
+++ b/supabase/functions/netcred-webhook/dedup.test.ts
@@ -0,0 +1,431 @@
+import { assertEquals } from "std/testing/asserts";
+import { computeHMACSHA256 } from "../calculate-installment-options/hmac.ts";
+import { dispatchWebhookEvent } from "./dispatchWebhookEvent.ts";
+import {
+  handleNetcredWebhookRequest,
+  type NetcredWebhookDeps,
+} from "./handleRequest.ts";
+import { handleTransactionCapture } from "./handlers/transaction-capture.ts";
+import { handleTransactionRefund } from "./handlers/transaction-refund.ts";
+import type { PersistWebhookInput, PersistWebhookResult } from "./types.ts";
+
+const WEBHOOK_SECRET = "dedup-test-secret";
+
+type StoredWebhookEvent = {
+  id: string;
+  gateway_slug: string;
+  event_type: string;
+  gateway_event_id: string;
+  state: string;
+  is_duplicate: boolean;
+  processed_at: string | null;
+};
+
+class WebhookDedupStore {
+  private events = new Map<string, StoredWebhookEvent>();
+  private idCounter = 0;
+
+  private key(input: PersistWebhookInput): string {
+    return `${input.gatewaySlug}:${input.eventType}:${input.providerEventId}`;
+  }
+
+  persist(input: PersistWebhookInput): PersistWebhookResult {
+    const existingKey = this.key(input);
+    const existing = [...this.events.values()].find((event) =>
+      `${event.gateway_slug}:${event.event_type}:${event.gateway_event_id}` === existingKey
+    );
+
+    if (existing) {
+      return { status: "duplicate", eventId: existing.id };
+    }
+
+    const id = `evt-${++this.idCounter}`;
+    this.events.set(id, {
+      id,
+      gateway_slug: input.gatewaySlug,
+      event_type: input.eventType,
+      gateway_event_id: input.providerEventId,
+      state: "RECEIVED",
+      is_duplicate: false,
+      processed_at: null,
+    });
+
+    return { status: "inserted", eventId: id };
+  }
+
+  markDuplicate(eventId: string): void {
+    const event = this.events.get(eventId);
+    if (!event) {
+      return;
+    }
+    event.is_duplicate = true;
+    event.state = "DUPLICATE";
+    event.processed_at = new Date().toISOString();
+  }
+
+  markProcessed(eventId: string): void {
+    const event = this.events.get(eventId);
+    if (!event) {
+      return;
+    }
+    event.state = "PROCESSED";
+    event.processed_at = new Date().toISOString();
+  }
+
+  get(eventId: string): StoredWebhookEvent | undefined {
+    return this.events.get(eventId);
+  }
+
+  resetDeadLetter(eventId: string): void {
+    const event = this.events.get(eventId);
+    if (!event) {
+      throw new Error("event_not_found");
+    }
+    event.state = "PENDING_RETRY";
+  }
+}
+
+type ScheduleRecord = {
+  id: string;
+  service_id: string;
+  state: "IN_ANALYSIS" | "PAID" | "REFUND_REQUESTED";
+  client_id: string;
+  provider_id: string;
+  paid_amount: string;
+};
+
+class OutOfOrderScheduleStore {
+  schedules = new Map<string, ScheduleRecord>();
+  auditEntries: string[] = [];
+  processedWebhookIds = new Set<string>();
+
+  seedInAnalysis(serviceId: string): ScheduleRecord {
+    const schedule: ScheduleRecord = {
+      id: `schedule-${serviceId}`,
+      service_id: serviceId,
+      state: "IN_ANALYSIS",
+      client_id: "client-1",
+      provider_id: "provider-1",
+      paid_amount: "1024.29",
+    };
+    this.schedules.set(serviceId, schedule);
+    return schedule;
+  }
+
+  applyRefund(serviceId: string, webhookEventId: string) {
+    const schedule = this.schedules.get(serviceId);
+    if (!schedule) {
+      return { outcome: "not_found" as const };
+    }
+
+    if (schedule.state !== "REFUND_REQUESTED") {
+      return {
+        outcome: "skipped" as const,
+        reason: "invalid_transition",
+        from_state: schedule.state,
+      };
+    }
+
+    schedule.state = "REFUND_REQUESTED";
+    this.auditEntries.push(`refund:${webhookEventId}`);
+    return { outcome: "refunded" as const };
+  }
+
+  applyCapture(serviceId: string, webhookEventId: string) {
+    const schedule = this.schedules.get(serviceId);
+    if (!schedule) {
+      return { outcome: "not_found" as const };
+    }
+
+    if (this.processedWebhookIds.has(webhookEventId)) {
+      if (schedule.state === "PAID") {
+        return {
+          outcome: "already_paid" as const,
+          from_state: "PAID",
+          service_id: serviceId,
+        };
+      }
+    }
+
+    if (schedule.state === "PAID") {
+      return {
+        outcome: "already_paid" as const,
+        from_state: "PAID",
+        service_id: serviceId,
+      };
+    }
+
+    if (schedule.state !== "IN_ANALYSIS") {
+      return {
+        outcome: "skipped" as const,
+        from_state: schedule.state,
+      };
+    }
+
+    schedule.state = "PAID";
+    this.processedWebhookIds.add(webhookEventId);
+    this.auditEntries.push(`capture:${webhookEventId}`);
+    return {
+      outcome: "paid" as const,
+      service_id: serviceId,
+      client_id: schedule.client_id,
+      provider_id: schedule.provider_id,
+      installment_number: 1,
+      charge_amount: schedule.paid_amount,
+      from_state: "IN_ANALYSIS",
+    };
+  }
+}
+
+function createBaseDeps(
+  store: WebhookDedupStore,
+  overrides: Partial<NetcredWebhookDeps> = {},
+): NetcredWebhookDeps {
+  return {
+    getWebhookSecret: async () => WEBHOOK_SECRET,
+    persistWebhookEvent: async (input) => store.persist(input),
+    markDuplicate: async (eventId) => store.markDuplicate(eventId),
+    markFailed: async () => {},
+    markValidating: async () => {},
+    markProcessed: async (eventId) => store.markProcessed(eventId),
+    markProcessing: async () => {},
+    enqueueHeavyProcessing: async () => {},
+    emitInvalidSignatureWarning: () => {},
+    checkIPRateLimit: async () => ({ allowed: true, remaining: 10, retryAfter: 0 }),
+    emitIPRateLimitWarning: async () => {},
+    ...overrides,
+  };
+}
+
+async function signedWebhookRequest(
+  rawBody: string,
+  eventType: string,
+): Promise<Request> {
+  const signature = await computeHMACSHA256(WEBHOOK_SECRET, rawBody);
+  return new Request("https://example.com/netcred-webhook", {
+    method: "POST",
+    headers: {
+      "Content-Type": "application/json",
+      "X-NETCRED-Event": eventType,
+      "X-NETCRED-Signature": signature,
+    },
+    body: rawBody,
+  });
+}
+
+Deno.test("duplicate gateway_event_id returns HTTP 200, marks is_duplicate, skips handler", async () => {
+  const store = new WebhookDedupStore();
+  let handlerInvocations = 0;
+  const rawBody = '{"id":"provider-evt-dup-1","transaction":{"referenceCode":"service-1"}}';
+
+  const deps = createBaseDeps(store, {
+    getHandler: () => async () => {
+      handlerInvocations += 1;
+      return "processed";
+    },
+  });
+
+  const first = await handleNetcredWebhookRequest(
+    await signedWebhookRequest(rawBody, "TRANSACTION_CAPTURE"),
+    deps,
+  );
+  const second = await handleNetcredWebhookRequest(
+    await signedWebhookRequest(rawBody, "TRANSACTION_CAPTURE"),
+    deps,
+  );
+
+  assertEquals(first.status, 200);
+  assertEquals(second.status, 200);
+  assertEquals(handlerInvocations, 1);
+
+  const duplicateEvent = store.get("evt-1");
+  assertEquals(duplicateEvent?.is_duplicate, true);
+  assertEquals(duplicateEvent?.state, "DUPLICATE");
+});
+
+Deno.test("out-of-order TRANSACTION_REFUND before TRANSACTION_CAPTURE skips gracefully on IN_ANALYSIS", async () => {
+  const scheduleStore = new OutOfOrderScheduleStore();
+  scheduleStore.seedInAnalysis("service-oo-1");
+
+  const refundResult = await handleTransactionRefund(
+    {
+      applyRefund: async ({ referenceCode, webhookEventId }) =>
+        scheduleStore.applyRefund(referenceCode, webhookEventId),
+      ingestNotification: async () => {},
+    },
+    {
+      eventId: "webhook-refund-oo",
+      eventType: "TRANSACTION_REFUND",
+      payload: {
+        transaction: {
+          referenceCode: "service-oo-1",
+          refundedAmount: "1024.29",
+        },
+      },
+    },
+  );
+
+  assertEquals(refundResult, "processed");
+  assertEquals(scheduleStore.schedules.get("service-oo-1")?.state, "IN_ANALYSIS");
+  assertEquals(scheduleStore.auditEntries.length, 0);
+
+  const captureResult = await handleTransactionCapture(
+    {
+      applyCapture: async ({ referenceCode, webhookEventId }) =>
+        scheduleStore.applyCapture(referenceCode, webhookEventId),
+      ingestNotification: async () => {},
+    },
+    {
+      eventId: "webhook-capture-oo",
+      eventType: "TRANSACTION_CAPTURE",
+      payload: {
+        transaction: {
+          referenceCode: "service-oo-1",
+          transactionState: "PAID",
+          paidAmount: "1024.29",
+        },
+      },
+    },
+  );
+
+  assertEquals(captureResult, "processed");
+  assertEquals(scheduleStore.schedules.get("service-oo-1")?.state, "PAID");
+  assertEquals(scheduleStore.auditEntries, ["capture:webhook-capture-oo"]);
+});
+
+Deno.test("TRANSACTION_CAPTURE on already-PAID schedule leaves state unchanged and marks PROCESSED", async () => {
+  const store = new WebhookDedupStore();
+  const scheduleStore = new OutOfOrderScheduleStore();
+  const seeded = scheduleStore.seedInAnalysis("service-paid-1");
+  seeded.state = "PAID";
+
+  let notificationsSent = 0;
+
+  const result = await handleTransactionCapture(
+    {
+      applyCapture: async ({ referenceCode, webhookEventId }) =>
+        scheduleStore.applyCapture(referenceCode, webhookEventId),
+      ingestNotification: async () => {
+        notificationsSent += 1;
+      },
+    },
+    {
+      eventId: "webhook-capture-paid",
+      eventType: "TRANSACTION_CAPTURE",
+      payload: {
+        transaction: {
+          referenceCode: "service-paid-1",
+          transactionState: "PAID",
+          paidAmount: "1024.29",
+        },
+      },
+    },
+  );
+
+  assertEquals(result, "processed");
+  assertEquals(scheduleStore.schedules.get("service-paid-1")?.state, "PAID");
+  assertEquals(notificationsSent, 0);
+  assertEquals(scheduleStore.auditEntries.length, 0);
+
+  const webhookStore = store;
+  const persist = webhookStore.persist({
+    gatewaySlug: "netcred",
+    eventType: "TRANSACTION_CAPTURE",
+    providerEventId: "provider-capture-paid",
+    rawPayload: {},
+    rawHeaders: {},
+  });
+  webhookStore.markProcessed(persist.eventId);
+  assertEquals(webhookStore.get(persist.eventId)?.state, "PROCESSED");
+});
+
+Deno.test("dead letter reset and replay does not duplicate PAID transition", async () => {
+  const store = new WebhookDedupStore();
+  const scheduleStore = new OutOfOrderScheduleStore();
+  scheduleStore.seedInAnalysis("service-dead-letter");
+
+  const persist = store.persist({
+    gatewaySlug: "netcred",
+    eventType: "TRANSACTION_CAPTURE",
+    providerEventId: "provider-dead-letter-1",
+    rawPayload: {},
+    rawHeaders: {},
+  });
+
+  store.markProcessed(persist.eventId);
+  store.resetDeadLetter(persist.eventId);
+
+  const captureDeps = {
+    applyCapture: async ({ referenceCode, webhookEventId }: {
+      referenceCode: string;
+      webhookEventId: string;
+    }) => scheduleStore.applyCapture(referenceCode, webhookEventId),
+    ingestNotification: async () => {},
+  };
+
+  const firstReplay = await dispatchWebhookEvent(
+    {
+      capture: captureDeps,
+      update: { applyUpdate: async () => ({ outcome: "skipped" }) },
+      refund: {
+        applyRefund: async () => ({ outcome: "skipped" }),
+        ingestNotification: async () => {},
+      },
+      chargeVoid: { applyVoid: async () => ({ outcome: "skipped" }) },
+      dispute: { applyDispute: async () => ({ outcome: "disputed" }), emitCritical: () => {} },
+      paymentProfile: {
+        applyTokenize: async () => ({ outcome: "skipped" }),
+        applyDelete: async () => ({ outcome: "skipped" }),
+        applyUpdate: async () => ({ outcome: "skipped" }),
+        applyExpiring: async () => ({ outcome: "skipped" }),
+        ingestNotification: async () => {},
+      },
+    },
+    {
+      eventId: persist.eventId,
+      eventType: "TRANSACTION_CAPTURE",
+      payload: {
+        transaction: {
+          referenceCode: "service-dead-letter",
+          paidAmount: "1024.29",
+        },
+      },
+    },
+  );
+
+  const secondReplay = await dispatchWebhookEvent(
+    {
+      capture: captureDeps,
+      update: { applyUpdate: async () => ({ outcome: "skipped" }) },
+      refund: {
+        applyRefund: async () => ({ outcome: "skipped" }),
+        ingestNotification: async () => {},
+      },
+      chargeVoid: { applyVoid: async () => ({ outcome: "skipped" }) },
+      dispute: { applyDispute: async () => ({ outcome: "disputed" }), emitCritical: () => {} },
+      paymentProfile: {
+        applyTokenize: async () => ({ outcome: "skipped" }),
+        applyDelete: async () => ({ outcome: "skipped" }),
+        applyUpdate: async () => ({ outcome: "skipped" }),
+        applyExpiring: async () => ({ outcome: "skipped" }),
+        ingestNotification: async () => {},
+      },
+    },
+    {
+      eventId: persist.eventId,
+      eventType: "TRANSACTION_CAPTURE",
+      payload: {
+        transaction: {
+          referenceCode: "service-dead-letter",
+          paidAmount: "1024.29",
+        },
+      },
+    },
+  );
+
+  assertEquals(firstReplay, "processed");
+  assertEquals(secondReplay, "processed");
+  assertEquals(scheduleStore.schedules.get("service-dead-letter")?.state, "PAID");
+  assertEquals(scheduleStore.auditEntries.filter((entry) => entry.startsWith("capture:")).length, 1);
+  assertEquals(store.get(persist.eventId)?.state, "PENDING_RETRY");
+});
diff --git a/supabase/functions/netcred-webhook/dispatchWebhookEvent.ts b/supabase/functions/netcred-webhook/dispatchWebhookEvent.ts
