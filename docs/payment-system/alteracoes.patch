+  TokenizeCardInput,
+  TokenizeCardResult,
+} from "./types.ts";
+
+const DEFAULT_GRAPHQL_URL = "https://api.netcredbrasil.com.br/graphql";
+
+type GraphQLError = {
+  code?: string | null;
+  message?: string | null;
+  field?: string | null;
+};
+
+type ChargeCreateGraphQLResponse = {
+  data?: {
+    chargeCreate?: {
+      errors?: GraphQLError[] | null;
+      charge?: {
+        id?: string | null;
+        referenceCode?: string | null;
