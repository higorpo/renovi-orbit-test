+create or replace function public.cron_recover_payment_leases()
+returns void
+language plpgsql
+security definer
+set search_path = public, extensions
+as $$
+declare
+  v_job_name constant text := 'recover-payment-leases';
+  v_job_run_id bigint;
+  v_started_at timestamptz := clock_timestamp();
+  v_recovered_count int := 0;
+  v_recovered_to_scheduled int := 0;
+  v_recovered_to_failed int := 0;
+begin
+  v_job_run_id := public.job_run_begin(v_job_name, 'v1');
+  begin
+    select
+      coalesce(r.recovered_count, 0),
+      coalesce(r.recovered_to_scheduled, 0),
+      coalesce(r.recovered_to_failed, 0)
+    into
+      v_recovered_count,
+      v_recovered_to_scheduled,
+      v_recovered_to_failed
+    from public.recover_orphaned_payment_schedules() r;
+
+    perform public.job_run_finish(
+      v_job_run_id,
+      v_started_at,
+      v_recovered_count,
+      v_recovered_to_scheduled + v_recovered_to_failed,
+      0,
+      jsonb_build_object(
+        'recovered_to_scheduled', v_recovered_to_scheduled,
+        'recovered_to_failed', v_recovered_to_failed
+      ),
+      null
+    );
+  exception
+    when others then
+      perform public.job_run_abort_latest(v_job_name, sqlerrm);
+      raise;
+  end;
+end;
+$$;
