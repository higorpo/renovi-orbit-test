+          {
+            scheduleId: "schedule-1",
+            contractedServiceId: "service-1",
+            state: "SCHEDULED",
+          },
+        ],
+      },
+      error: null,
+    });
+
+    const { result } = renderHook(() => useSavedCards(), { wrapper: createWrapper() });
+
+    await waitFor(() => {
+      expect(result.current.cards).toHaveLength(2);
+    });
