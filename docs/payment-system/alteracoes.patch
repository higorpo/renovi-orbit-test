new file mode 100644
index 0000000..5046138
--- /dev/null
+++ b/supabase/functions/netcred-webhook/handlers/transaction-capture.ts
@@ -0,0 +1,80 @@
+import { isValidWebhookTransition } from "../../_shared/payment/error-classification.ts";
+import type { NotificationIngestInput } from "../../manual-charge-payment/enqueueNotifications.ts";
+import type { WebhookHandlerContext } from "../types.ts";
+import { enqueuePaymentSuccessNotifications } from "./enqueuePaymentSuccessNotifications.ts";
+import {
+  extractPaidAmount,
+  extractProviderIds,
+  extractReferenceCode,
+} from "./extractTransactionPayload.ts";
+
+export type TransactionCaptureApplyResult = {
+  outcome: "paid" | "already_paid" | "skipped" | "not_found";
+  reason?: string;
+  schedule_id?: string;
+  service_id?: string;
+  client_id?: string;
+  provider_id?: string;
+  installment_number?: number;
+  charge_amount?: number | string;
+  from_state?: string;
+  service_status?: string;
+};
+
+export type TransactionCaptureDeps = {
+  applyCapture: (input: {
+    referenceCode: string;
+    webhookEventId: string;
+    paidAmount?: string;
+    providerChargeId?: string;
+    providerTransactionId?: string;
+  }) => Promise<TransactionCaptureApplyResult>;
+  ingestNotification: (input: NotificationIngestInput) => Promise<void>;
+  isValidTransition?: typeof isValidWebhookTransition;
+};
+
+export async function handleTransactionCapture(
+  deps: TransactionCaptureDeps,
+  context: WebhookHandlerContext,
+): Promise<"processed" | "skipped"> {
+  const referenceCode = extractReferenceCode(context.payload);
+  if (!referenceCode) {
+    throw new Error("REFERENCE_CODE_MISSING");
+  }
+
+  const fromState = typeof context.payload.from_state === "string"
+    ? context.payload.from_state
+    : undefined;
+  const validateTransition = deps.isValidTransition ?? isValidWebhookTransition;
+
+  if (fromState && !validateTransition(fromState, "PAID")) {
+    return "skipped";
+  }
+
+  const providerIds = extractProviderIds(context.payload);
+  const result = await deps.applyCapture({
+    referenceCode,
+    webhookEventId: context.eventId,
+    paidAmount: extractPaidAmount(context.payload) ?? undefined,
+    providerChargeId: providerIds.chargeId,
+    providerTransactionId: providerIds.transactionId,
+  });
+
+  if (result.outcome === "paid") {
+    await enqueuePaymentSuccessNotifications(deps.ingestNotification, {
+      webhookEventId: context.eventId,
+      serviceId: result.service_id!,
+      clientId: result.client_id!,
+      providerId: result.provider_id!,
+      installmentNumber: result.installment_number ?? 1,
+      chargeAmount: Number(result.charge_amount ?? 0).toFixed(2),
+    });
+    return "processed";
+  }
+
+  if (result.outcome === "already_paid" || result.outcome === "skipped") {
+    return "processed";
+  }
+
+  throw new Error("SCHEDULE_NOT_FOUND");
+}
