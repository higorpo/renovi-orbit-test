+-- Payment System — Phase 1 task 5: payment_tokens + RLS (design §3.3).
+-- Requirements: 6, 24, 26, 28. Acceptance: 6A.3, 24A.2, 26A.3, 28A.1.
+-- PCI: no PAN/CVV columns — tokenization references only.
+
+create table public.payment_tokens (
+  id uuid primary key default gen_random_uuid(),
+  client_id uuid not null references public.profiles (id),
+  provider_id uuid not null references public.payment_providers (id),
+  gateway_payment_profile_id text not null,
+  card_number_masked text not null,
+  card_brand text not null,
+  gateway_card_token text not null,
+  expiry_month smallint not null check (expiry_month between 1 and 12),
+  expiry_year smallint not null,
+  cardholder_name text not null,
+  billing_address jsonb not null,
+  state text not null default 'ACTIVE'
+    check (state in ('ACTIVE', 'EXPIRED', 'REVOKED', 'TOKENIZATION_FAILED')),
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now(),
+  unique (client_id, gateway_payment_profile_id)
+);
+
+comment on table public.payment_tokens is
+  'PCI-scoped card token references; no raw PAN or CVV columns.';
+
+comment on column public.payment_tokens.gateway_payment_profile_id is
+  'Gateway-issued payment profile id (e.g. NetCred paymentProfile.id).';
+
+comment on column public.payment_tokens.billing_address is
+  'PII JSON: {street, number, district, city, state, zipCode, additionalDetails}.';
+
+create index idx_payment_tokens_client_state
+  on public.payment_tokens (client_id, state);
+
+create trigger payment_tokens_updated_at
+  before update on public.payment_tokens
+  for each row execute procedure public.set_updated_at();
+
+alter table public.payment_tokens enable row level security;
+
+create policy payment_tokens_client_select
+  on public.payment_tokens
+  for select
+  using ((select auth.uid()) = client_id);
+
+create policy payment_tokens_service_insert
+  on public.payment_tokens
+  for insert
+  with check (true);
+
+create policy payment_tokens_service_update
+  on public.payment_tokens
+  for update
+  using (true);
+
+revoke insert, update, delete on public.payment_tokens from authenticated;
+grant select on public.payment_tokens to authenticated;
+grant select, insert, update on public.payment_tokens to service_role;
