@@ -0,0 +1,50 @@
+import type { WebhookHandlerContext } from "../types.ts";
+import {
+  handleChargeVoid,
+  type ChargeVoidDeps,
+} from "./charge-void.ts";
+import {
+  handleTransactionCapture,
+  type TransactionCaptureDeps,
+} from "./transaction-capture.ts";
+import {
+  handleTransactionRefund,
+  type TransactionRefundDeps,
+} from "./transaction-refund.ts";
+import {
+  handleTransactionRejected,
+  type TransactionRejectedDeps,
+} from "./transaction-rejected.ts";
+import { extractTransactionState } from "./extractTransactionPayload.ts";
+
+export type TransactionUpdateDeps = {
+  capture: TransactionCaptureDeps;
+  rejected: TransactionRejectedDeps;
+  refund: TransactionRefundDeps;
+  chargeVoid: ChargeVoidDeps;
+};
+
+export async function handleTransactionUpdate(
+  deps: TransactionUpdateDeps,
+  context: WebhookHandlerContext,
+): Promise<"processed" | "skipped"> {
+  const transactionState = extractTransactionState(context.payload);
+
+  if (!transactionState) {
+    throw new Error("TRANSACTION_STATE_MISSING");
+  }
+
+  switch (transactionState) {
+    case "PAID":
+      return handleTransactionCapture(deps.capture, context);
+    case "REJECTED":
+      return handleTransactionRejected(deps.rejected, context);
+    case "REFUNDED":
+    case "PARTIALLY_REFUNDED":
+      return handleTransactionRefund(deps.refund, context);
+    case "VOIDED":
+      return handleChargeVoid(deps.chargeVoid, context);
+    default:
+      return "skipped";
+  }
+}
diff --git a/supabase/functions/netcred-webhook/index.ts b/supabase/functions/netcred-webhook/index.ts
new file mode 100644
