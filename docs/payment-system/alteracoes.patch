+  it("generates a new clearsaleSessionId after unmount and remount", async () => {
+    vi.spyOn(generateSessionModule, "generateClearSaleSessionId")
+      .mockReturnValueOnce("first-session-id")
+      .mockReturnValueOnce("second-session-id");
