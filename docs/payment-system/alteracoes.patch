diff --git a/supabase/migrations/20260705210500_rpc_process_webhook_retry.sql b/supabase/migrations/20260705210500_rpc_process_webhook_retry.sql
new file mode 100644
index 0000000..707bedb
--- /dev/null
+++ b/supabase/migrations/20260705210500_rpc_process_webhook_retry.sql
@@ -0,0 +1,343 @@
+-- Payment System — task 49: webhook retry claim/complete/fail RPCs (design §4.7.3).
+
+create or replace function public.webhook_mark_failed_rpc(
+  p_event_id text,
+  p_failure_reason text,
+  p_base_interval_minutes int default null
+)
+returns jsonb
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_base int;
+  v_retry_count smallint;
+begin
+  v_base := coalesce(
+    p_base_interval_minutes,
+    (
+      select pc.value::int
+      from public.platform_constants pc
+      where pc.key = 'webhook_base_retry_interval_minutes'
+    ),
+    5
+  );
+
+  update public.payment_webhook_events e
+  set
+    state = 'FAILED',
+    failure_reason = left(p_failure_reason, 4000),
+    retry_count = e.retry_count + 1,
+    next_retry_at = now() + (
+      v_base * power(2, greatest(e.retry_count, 0)) * interval '1 minute'
+    ),
+    updated_at = now()
+  where e.id = p_event_id
+  returning e.retry_count into v_retry_count;
+
+  if not found then
+    raise exception 'WEBHOOK_EVENT_NOT_FOUND' using errcode = 'P0001';
+  end if;
+
+  return jsonb_build_object(
+    'event_id', p_event_id,
+    'retry_count', v_retry_count,
+    'outcome', case when v_retry_count >= 3 then 'dead_letter_pending' else 'failed' end
+  );
+end;
+$$;
+
+create or replace function public.webhook_retry_claim_rpc(
+  p_batch_size int default 25
+)
+returns jsonb
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_batch_size int;
+  v_rows jsonb := '[]'::jsonb;
+  v_row record;
+begin
+  v_batch_size := greatest(coalesce(p_batch_size, 25), 1);
+
+  for v_row in
+    with eligible as (
+      select e.id
+      from public.payment_webhook_events e
+      where e.state = 'FAILED'
+        and e.retry_count < 3
+        and (e.next_retry_at is null or e.next_retry_at <= now())
+      order by coalesce(e.next_retry_at, e.created_at)
+      limit v_batch_size
+      for update of e skip locked
+    )
+    update public.payment_webhook_events e
+    set
+      state = 'PROCESSING',
+      updated_at = now()
+    from eligible el
+    where e.id = el.id
+    returning
+      e.id,
+      e.gateway_slug,
+      e.event_type,
+      e.gateway_event_id,
+      e.raw_payload,
+      e.retry_count,
+      e.failure_reason
+  loop
+    v_rows := v_rows || jsonb_build_array(jsonb_build_object(
+      'source', 'failed_retry',
+      'event_id', v_row.id,
+      'gateway_slug', v_row.gateway_slug,
+      'event_type', v_row.event_type,
+      'gateway_event_id', v_row.gateway_event_id,
+      'raw_payload', v_row.raw_payload,
+      'retry_count', v_row.retry_count,
+      'failure_reason', v_row.failure_reason
+    ));
+  end loop;
+
+  return v_rows;
+end;
+$$;
+
+create or replace function public.webhook_queue_claim_rpc(
+  p_batch_size int default 25
+)
+returns jsonb
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_batch_size int;
+  v_rows jsonb := '[]'::jsonb;
+  v_row record;
+begin
+  v_batch_size := greatest(coalesce(p_batch_size, 25), 1);
+
+  for v_row in
+    with eligible as (
+      select q.id
+      from public.payment_webhook_processing_queue q
+      where q.state = 'PENDING'
+        and q.scheduled_at <= now()
+      order by q.scheduled_at
+      limit v_batch_size
+      for update of q skip locked
+    )
+    update public.payment_webhook_processing_queue q
+    set
+      state = 'PROCESSING',
+      attempted_at = now(),
+      attempt_count = q.attempt_count + 1
+    from eligible el
+    where q.id = el.id
+    returning
+      q.id,
+      q.webhook_event_id,
+      q.gateway_slug,
+      q.event_type
+  loop
+    v_rows := v_rows || jsonb_build_array(jsonb_build_object(
+      'source', 'processing_queue',
+      'queue_id', v_row.id,
+      'event_id', v_row.webhook_event_id,
+      'gateway_slug', v_row.gateway_slug,
+      'event_type', v_row.event_type,
+      'gateway_event_id', (
+        select e.gateway_event_id
+        from public.payment_webhook_events e
+        where e.id = v_row.webhook_event_id
+      ),
+      'raw_payload', (
+        select e.raw_payload
+        from public.payment_webhook_events e
+        where e.id = v_row.webhook_event_id
+      ),
+      'retry_count', (
+        select e.retry_count
+        from public.payment_webhook_events e
+        where e.id = v_row.webhook_event_id
+      ),
+      'failure_reason', (
+        select e.failure_reason
+        from public.payment_webhook_events e
+        where e.id = v_row.webhook_event_id
+      )
+    ));
+  end loop;
+
+  return v_rows;
+end;
+$$;
+
+create or replace function public.webhook_retry_mark_processed_rpc(
+  p_event_id text,
+  p_queue_id uuid default null
+)
+returns void
+language plpgsql
+security definer
+set search_path = public
+as $$
+begin
+  update public.payment_webhook_events e
+  set
+    state = 'PROCESSED',
+    processed_at = now(),
+    failure_reason = null,
+    updated_at = now()
+  where e.id = p_event_id;
+
+  if not found then
+    raise exception 'WEBHOOK_EVENT_NOT_FOUND' using errcode = 'P0001';
+  end if;
+
+  if p_queue_id is not null then
+    update public.payment_webhook_processing_queue q
+    set state = 'PROCESSED'
+    where q.id = p_queue_id;
+  end if;
+end;
+$$;
+
+create or replace function public.webhook_retry_mark_failed_rpc(
+  p_event_id text,
+  p_failure_reason text,
+  p_base_interval_minutes int default null,
+  p_queue_id uuid default null
+)
+returns jsonb
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_base int;
+  v_retry_count smallint;
+  v_event public.payment_webhook_events%rowtype;
+  v_schedule_id text;
+begin
+  v_base := coalesce(
+    p_base_interval_minutes,
+    (
+      select pc.value::int
+      from public.platform_constants pc
+      where pc.key = 'webhook_base_retry_interval_minutes'
+    ),
+    5
+  );
+
+  select e.*
+  into v_event
+  from public.payment_webhook_events e
+  where e.id = p_event_id
+  for update;
+
+  if not found then
+    raise exception 'WEBHOOK_EVENT_NOT_FOUND' using errcode = 'P0001';
+  end if;
+
+  v_retry_count := v_event.retry_count + 1;
+
+  if v_retry_count >= 3 then
+    update public.payment_webhook_events e
+    set
+      state = 'DEAD_LETTER',
+      failure_reason = left(p_failure_reason, 4000),
+      retry_count = v_retry_count,
+      next_retry_at = null,
+      updated_at = now()
+    where e.id = p_event_id;
+
+    if p_queue_id is not null then
+      update public.payment_webhook_processing_queue q
+      set state = 'FAILED'
+      where q.id = p_queue_id;
+    end if;
+
+    select ps.id
+    into v_schedule_id
+    from public.payment_schedules ps
+    where ps.contracted_service_id::text = coalesce(
+      v_event.raw_payload #>> '{transaction,referenceCode}',
+      v_event.raw_payload #>> '{referenceCode}',
+      v_event.raw_payload #>> '{charge,referenceCode}'
+    )
+    limit 1;
+
+    return jsonb_build_object(
+      'outcome', 'dead_letter',
+      'event_id', p_event_id,
+      'event_type', v_event.event_type,
+      'gateway_event_id', v_event.gateway_event_id,
+      'retry_count', v_retry_count,
+      'failure_reason', left(p_failure_reason, 4000),
+      'schedule_id', v_schedule_id
+    );
+  end if;
+
+  update public.payment_webhook_events e
+  set
+    state = 'FAILED',
+    failure_reason = left(p_failure_reason, 4000),
+    retry_count = v_retry_count,
+    next_retry_at = now() + (
+      v_base * power(2, greatest(v_retry_count - 1, 0)) * interval '1 minute'
+    ),
+    updated_at = now()
+  where e.id = p_event_id;
+
+  if p_queue_id is not null then
+    update public.payment_webhook_processing_queue q
+    set state = 'FAILED'
+    where q.id = p_queue_id;
+  end if;
+
+  return jsonb_build_object(
+    'outcome', 'failed',
+    'event_id', p_event_id,
+    'event_type', v_event.event_type,
+    'gateway_event_id', v_event.gateway_event_id,
+    'retry_count', v_retry_count,
+    'failure_reason', left(p_failure_reason, 4000),
+    'next_retry_at', (
+      select e.next_retry_at
+      from public.payment_webhook_events e
+      where e.id = p_event_id
+    )
+  );
+end;
+$$;
+
+comment on function public.webhook_mark_failed_rpc(text, text, int) is
+  'Initial webhook handler failure: FAILED + retry_count increment + backoff schedule.';
+
+comment on function public.webhook_retry_claim_rpc(int) is
+  'Claims FAILED webhook events eligible for retry (SKIP LOCKED).';
+
+comment on function public.webhook_queue_claim_rpc(int) is
+  'Claims PENDING heavy-processing queue rows (SKIP LOCKED).';
+
+comment on function public.webhook_retry_mark_processed_rpc(text, uuid) is
+  'Marks webhook event PROCESSED; optionally completes queue row.';
+
+comment on function public.webhook_retry_mark_failed_rpc(text, text, int, uuid) is
+  'Retry failure: exponential backoff or DEAD_LETTER after 3 failures.';
+
+revoke all on function public.webhook_mark_failed_rpc(text, text, int) from public, anon, authenticated;
+revoke all on function public.webhook_retry_claim_rpc(int) from public, anon, authenticated;
+revoke all on function public.webhook_queue_claim_rpc(int) from public, anon, authenticated;
+revoke all on function public.webhook_retry_mark_processed_rpc(text, uuid) from public, anon, authenticated;
+revoke all on function public.webhook_retry_mark_failed_rpc(text, text, int, uuid) from public, anon, authenticated;
+
+grant execute on function public.webhook_mark_failed_rpc(text, text, int) to service_role;
+grant execute on function public.webhook_retry_claim_rpc(int) to service_role;
+grant execute on function public.webhook_queue_claim_rpc(int) to service_role;
+grant execute on function public.webhook_retry_mark_processed_rpc(text, uuid) to service_role;
+grant execute on function public.webhook_retry_mark_failed_rpc(text, text, int, uuid) to service_role;
diff --git a/supabase/migrations/20260705221100_rpc_checkout_step_requirements.sql b/supabase/migrations/20260705221100_rpc_checkout_step_requirements.sql
new file mode 100644
index 0000000..2f1e747
--- /dev/null
+++ b/supabase/migrations/20260705221100_rpc_checkout_step_requirements.sql
@@ -0,0 +1,43 @@
+-- Payment System — task 50: checkout stepper profile completeness RPC (design §4.2.1).
+
+create or replace function public.get_checkout_step_requirements()
+returns jsonb
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_user_id uuid := auth.uid();
+begin
+  if v_user_id is null then
+    raise exception 'UNAUTHENTICATED' using errcode = 'P0001';
+  end if;
+
+  return jsonb_build_object(
+    'needs_cpf', not exists (
+      select 1
+      from public.client_profiles_private cpp
+      where cpp.client_id = v_user_id
+        and nullif(trim(cpp.cpf), '') is not null
+    ),
+    'needs_phone', not exists (
+      select 1
+      from public.profiles p
+      where p.id = v_user_id
+        and nullif(trim(p.phone), '') is not null
+    ),
+    'needs_card', not exists (
+      select 1
+      from public.payment_tokens pt
+      where pt.client_id = v_user_id
+        and pt.state = 'ACTIVE'
+    )
+  );
+end;
+$$;
+
+comment on function public.get_checkout_step_requirements() is
+  'Returns conditional checkout stepper requirements for the authenticated client.';
+
+revoke all on function public.get_checkout_step_requirements() from public, anon;
+grant execute on function public.get_checkout_step_requirements() to authenticated;
diff --git a/supabase/migrations/20260705221200_rpc_revoke_payment_token.sql b/supabase/migrations/20260705221200_rpc_revoke_payment_token.sql
new file mode 100644
index 0000000..aee3152
--- /dev/null
+++ b/supabase/migrations/20260705221200_rpc_revoke_payment_token.sql
@@ -0,0 +1,73 @@
+-- Payment System — task 56: revoke_payment_token_rpc (Req 28 AC28A.3, AC28A.4).
+
+create or replace function public.revoke_payment_token_rpc(
+  p_payment_token_id uuid
+)
+returns jsonb
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_token public.payment_tokens%rowtype;
+  v_blocked_schedules jsonb;
+begin
+  if auth.uid() is null then
+    raise exception 'UNAUTHORIZED' using errcode = 'P0001';
+  end if;
+
+  select *
+  into v_token
+  from public.payment_tokens pt
+  where pt.id = p_payment_token_id
+    and pt.client_id = auth.uid()
+    and pt.state = 'ACTIVE'
+  for update;
+
+  if not found then
+    return jsonb_build_object('outcome', 'not_found');
+  end if;
+
+  select coalesce(
+    jsonb_agg(
+      jsonb_build_object(
+        'schedule_id', ps.id,
+        'contracted_service_id', ps.contracted_service_id,
+        'state', ps.state
+      )
+      order by ps.created_at desc
+    ),
+    '[]'::jsonb
+  )
+  into v_blocked_schedules
+  from public.payment_schedules ps
+  where ps.payment_token_id = p_payment_token_id
+    and ps.client_id = auth.uid()
+    and ps.state in ('SCHEDULED', 'FAILED');
+
+  if jsonb_array_length(v_blocked_schedules) > 0 then
+    return jsonb_build_object(
+      'outcome', 'blocked',
+      'schedules', v_blocked_schedules
+    );
+  end if;
+
+  update public.payment_tokens
+  set
+    state = 'REVOKED',
+    updated_at = now()
+  where id = p_payment_token_id;
+
+  return jsonb_build_object(
+    'outcome', 'revoked',
+    'payment_token_id', p_payment_token_id
+  );
+end;
+$$;
+
+comment on function public.revoke_payment_token_rpc(uuid) is
+  'Revokes an ACTIVE payment token for the authenticated client when no SCHEDULED/FAILED schedules reference it.';
+
+revoke all on function public.revoke_payment_token_rpc(uuid) from public;
+revoke all on function public.revoke_payment_token_rpc(uuid) from anon;
+grant execute on function public.revoke_payment_token_rpc(uuid) to authenticated;
diff --git a/supabase/migrations/20260705221300_create_provider_kyc_storage_bucket.sql b/supabase/migrations/20260705221300_create_provider_kyc_storage_bucket.sql
new file mode 100644
index 0000000..9218442
--- /dev/null
+++ b/supabase/migrations/20260705221300_create_provider_kyc_storage_bucket.sql
@@ -0,0 +1,45 @@
+-- Payment System — task 58: private storage bucket for provider KYC documents.
+
+insert into storage.buckets (id, name, public)
+values ('provider-kyc-documents', 'provider-kyc-documents', false)
+on conflict (id) do update set
+  name = excluded.name,
+  public = excluded.public;
+
+create policy "Providers can upload own KYC documents"
+  on storage.objects for insert
+  to authenticated
+  with check (
+    bucket_id = 'provider-kyc-documents'
+    and (storage.foldername(name))[1] = 'providers'
+    and (storage.foldername(name))[2] = (select auth.uid())::text
+  );
+
+create policy "Providers can update own KYC documents"
+  on storage.objects for update
+  to authenticated
+  using (
+    bucket_id = 'provider-kyc-documents'
+    and (storage.foldername(name))[1] = 'providers'
+    and (storage.foldername(name))[2] = (select auth.uid())::text
+  )
+  with check (
+    bucket_id = 'provider-kyc-documents'
+    and (storage.foldername(name))[1] = 'providers'
+    and (storage.foldername(name))[2] = (select auth.uid())::text
+  );
+
+create policy "Providers can read own KYC documents"
+  on storage.objects for select
+  to authenticated
+  using (
+    bucket_id = 'provider-kyc-documents'
+    and (storage.foldername(name))[1] = 'providers'
+    and (storage.foldername(name))[2] = (select auth.uid())::text
+  );
+
+create policy "Service role manages KYC documents"
+  on storage.objects for all
+  to service_role
+  using (bucket_id = 'provider-kyc-documents')
+  with check (bucket_id = 'provider-kyc-documents');
diff --git a/supabase/migrations/20260705221400_charge_commit_processing_state_guard.sql b/supabase/migrations/20260705221400_charge_commit_processing_state_guard.sql
new file mode 100644
index 0000000..5f0e190
--- /dev/null
+++ b/supabase/migrations/20260705221400_charge_commit_processing_state_guard.sql
@@ -0,0 +1,508 @@
+-- Payment System — task 64: PROCESSING state guard on charge commit UPDATEs (design §4.6).
+
+create or replace function public.cron_charge_commit_result_rpc(
+  p_schedule_id uuid,
+  p_outcome text,
+  p_charge_amount numeric(12, 2),
+  p_gateway_charge_id text,
+  p_gateway_transaction_id text,
+  p_failure_code text,
+  p_failure_reason text,
+  p_gateway_latency_ms int,
+  p_provider_response_summary jsonb,
+  p_undo_attempt_increment boolean default false
+)
+returns uuid
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_schedule public.payment_schedules%rowtype;
+  v_retry_minutes int;
+  v_max_attempts int;
+  v_audit_event text;
+  v_event_type text;
+  v_attempt_count smallint;
+begin
+  if p_outcome not in ('PAID', 'IN_ANALYSIS', 'FAILED', 'FAILED_PERMANENT') then
+    raise exception 'INVALID_OUTCOME' using errcode = 'P0001';
+  end if;
+
+  select ps.*
+  into v_schedule
+  from public.payment_schedules ps
+  where ps.id = p_schedule_id
+    and ps.state = 'PROCESSING'
+  for update;
+
+  if not found then
+    raise exception 'INVALID_SCHEDULE_STATE' using errcode = 'P0001';
+  end if;
+
+  v_retry_minutes := public.platform_constant_int('charge_retry_interval_minutes', 30);
+  v_max_attempts := public.platform_constant_int('max_charge_attempts', 3);
+  v_attempt_count := v_schedule.automatic_attempt_count;
+
+  if p_undo_attempt_increment then
+    v_attempt_count := greatest(0, v_schedule.automatic_attempt_count - 1)::smallint;
+  end if;
+
+  if p_outcome = 'PAID' then
+    update public.payment_schedules ps
+    set
+      state = 'PAID',
+      paid_at = now(),
+      paid_amount = p_charge_amount,
+      gateway_charge_id = p_gateway_charge_id,
+      gateway_transaction_id = p_gateway_transaction_id,
+      locked_until = null,
+      next_retry_at = null,
+      failure_code = null,
+      failure_reason = null,
+      automatic_attempt_count = v_attempt_count,
+      updated_at = now()
+    where ps.id = v_schedule.id
+      and ps.state = 'PROCESSING';
+
+    update public.contracted_services cs
+    set status = 'CONFIRMED'
+    where cs.id = v_schedule.contracted_service_id
+      and cs.status = 'PENDING_PAYMENT';
+
+    v_audit_event := 'CHARGE_PAID';
+    v_event_type := 'ChargeSucceeded';
+  elsif p_outcome = 'IN_ANALYSIS' then
+    update public.payment_schedules ps
+    set
+      state = 'IN_ANALYSIS',
+      gateway_charge_id = coalesce(p_gateway_charge_id, ps.gateway_charge_id),
+      gateway_transaction_id = coalesce(p_gateway_transaction_id, ps.gateway_transaction_id),
+      locked_until = null,
+      automatic_attempt_count = v_attempt_count,
+      updated_at = now()
+    where ps.id = v_schedule.id
+      and ps.state = 'PROCESSING';
+
+    v_audit_event := 'CHARGE_IN_ANALYSIS';
+    v_event_type := 'ChargeInAnalysis';
+  elsif p_outcome = 'FAILED_PERMANENT' then
+    update public.payment_schedules ps
+    set
+      state = 'FAILED_PERMANENT',
+      failed_at = now(),
+      failed_permanently_at = coalesce(ps.failed_permanently_at, now()),
+      failure_code = p_failure_code,
+      failure_reason = p_failure_reason,
+      locked_until = null,
+      next_retry_at = null,
+      automatic_attempt_count = v_attempt_count,
+      updated_at = now()
+    where ps.id = v_schedule.id
+      and ps.state = 'PROCESSING';
+
+    v_audit_event := 'CHARGE_FAILED_PERMANENT';
+    v_event_type := 'ChargePermanentlyFailed';
+  else
+    update public.payment_schedules ps
+    set
+      state = 'FAILED',
+      failed_at = now(),
+      failure_code = p_failure_code,
+      failure_reason = p_failure_reason,
+      locked_until = null,
+      next_retry_at = now() + make_interval(mins => v_retry_minutes),
+      automatic_attempt_count = v_attempt_count,
+      updated_at = now()
+    where ps.id = v_schedule.id
+      and ps.state = 'PROCESSING';
+
+    v_audit_event := 'CHARGE_FAILED';
+    v_event_type := 'ChargeFailed';
+  end if;
+
+  insert into public.payment_attempts (
+    schedule_id,
+    attempt_number,
+    initiator,
+    completed_at,
+    outcome,
+    provider_response_summary,
+    failure_code,
+    failure_reason,
+    charge_amount,
+    gateway_latency_ms
+  )
+  values (
+    v_schedule.id,
+    v_schedule.automatic_attempt_count,
+    'cron',
+    now(),
+    case p_outcome
+      when 'PAID' then 'PAID'
+      when 'IN_ANALYSIS' then 'IN_ANALYSIS'
+      else 'REJECTED'
+    end,
+    p_provider_response_summary,
+    p_failure_code,
+    p_failure_reason,
+    p_charge_amount,
+    p_gateway_latency_ms
+  );
+
+  insert into public.payment_audit_log (
+    event_type,
+    entity_type,
+    entity_id,
+    service_id,
+    schedule_id,
+    from_state,
+    to_state,
+    actor,
+    metadata
+  )
+  values (
+    v_audit_event,
+    'payment_schedule',
+    v_schedule.id,
+    v_schedule.contracted_service_id,
+    v_schedule.id,
+    'PROCESSING',
+    p_outcome,
+    'cron',
+    jsonb_build_object(
+      'charge_amount', p_charge_amount,
+      'automatic_attempt_count', v_attempt_count,
+      'max_attempts', v_max_attempts,
+      'undo_attempt_increment', p_undo_attempt_increment
+    )
+  );
+
+  insert into public.payment_events (
+    event_type,
+    aggregate_type,
+    aggregate_id,
+    service_id,
+    payload
+  )
+  values (
+    v_event_type,
+    'payment_schedule',
+    v_schedule.id,
+    v_schedule.contracted_service_id,
+    jsonb_build_object(
+      'outcome', p_outcome,
+      'charge_amount', p_charge_amount,
+      'initiator', 'cron'
+    )
+  );
+
+  return v_schedule.id;
+end;
+$$;
+
+create or replace function public.manual_charge_commit_result_rpc(
+  p_schedule_id uuid,
+  p_client_id uuid,
+  p_outcome text,
+  p_charge_amount numeric(12, 2),
+  p_gateway_charge_id text,
+  p_gateway_transaction_id text,
+  p_failure_code text,
+  p_failure_reason text,
+  p_gateway_latency_ms int,
+  p_provider_response_summary jsonb,
+  p_actor_id uuid
+)
+returns uuid
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_schedule public.payment_schedules%rowtype;
+  v_from_state text;
+  v_audit_event text;
+  v_event_type text;
+begin
+  if p_outcome not in ('PAID', 'IN_ANALYSIS', 'FAILED', 'FAILED_PERMANENT') then
+    raise exception 'INVALID_OUTCOME' using errcode = 'P0001';
+  end if;
+
+  select ps.*
+  into v_schedule
+  from public.payment_schedules ps
+  where ps.id = p_schedule_id
+    and ps.client_id = p_client_id
+    and ps.state = 'PROCESSING'
+  for update;
+
+  if not found then
+    raise exception 'INVALID_SCHEDULE_STATE' using errcode = 'P0001';
+  end if;
+
+  v_from_state := v_schedule.state;
+
+  if p_outcome = 'PAID' then
+    update public.payment_schedules ps
+    set
+      state = 'PAID',
+      paid_at = now(),
+      paid_amount = p_charge_amount,
+      gateway_charge_id = p_gateway_charge_id,
+      gateway_transaction_id = p_gateway_transaction_id,
+      locked_until = null,
+      failure_code = null,
+      failure_reason = null,
+      updated_at = now()
+    where ps.id = v_schedule.id
+      and ps.state = 'PROCESSING';
+
+    update public.contracted_services cs
+    set status = 'CONFIRMED'
+    where cs.id = v_schedule.contracted_service_id
+      and cs.status = 'PENDING_PAYMENT';
+
+    v_audit_event := 'CHARGE_PAID';
+    v_event_type := 'ChargeSucceeded';
+  elsif p_outcome = 'IN_ANALYSIS' then
+    update public.payment_schedules ps
+    set
+      state = 'IN_ANALYSIS',
+      gateway_charge_id = coalesce(p_gateway_charge_id, ps.gateway_charge_id),
+      gateway_transaction_id = coalesce(p_gateway_transaction_id, ps.gateway_transaction_id),
+      locked_until = null,
+      updated_at = now()
+    where ps.id = v_schedule.id
+      and ps.state = 'PROCESSING';
+
+    v_audit_event := 'CHARGE_IN_ANALYSIS';
+    v_event_type := 'ChargeInAnalysis';
+  elsif p_outcome = 'FAILED_PERMANENT' then
+    update public.payment_schedules ps
+    set
+      state = 'FAILED_PERMANENT',
+      failed_at = now(),
+      failed_permanently_at = coalesce(ps.failed_permanently_at, now()),
+      failure_code = p_failure_code,
+      failure_reason = p_failure_reason,
+      locked_until = null,
+      updated_at = now()
+    where ps.id = v_schedule.id
+      and ps.state = 'PROCESSING';
+
+    v_audit_event := 'CHARGE_FAILED_PERMANENT';
+    v_event_type := 'ChargePermanentlyFailed';
+  else
+    update public.payment_schedules ps
+    set
+      state = 'FAILED',
+      failed_at = now(),
+      failure_code = p_failure_code,
+      failure_reason = p_failure_reason,
+      locked_until = null,
+      updated_at = now()
+    where ps.id = v_schedule.id
+      and ps.state = 'PROCESSING';
+
+    v_audit_event := 'CHARGE_FAILED';
+    v_event_type := 'ChargeFailed';
+  end if;
+
+  insert into public.payment_attempts (
+    schedule_id,
+    attempt_number,
+    initiator,
+    completed_at,
+    outcome,
+    provider_response_summary,
+    failure_code,
+    failure_reason,
+    charge_amount,
+    gateway_latency_ms
+  )
+  values (
+    v_schedule.id,
+    v_schedule.manual_attempt_count,
+    'client',
+    now(),
+    case p_outcome
+      when 'PAID' then 'PAID'
+      when 'IN_ANALYSIS' then 'IN_ANALYSIS'
+      else 'REJECTED'
+    end,
+    p_provider_response_summary,
+    p_failure_code,
+    p_failure_reason,
+    p_charge_amount,
+    p_gateway_latency_ms
+  );
+
+  insert into public.payment_audit_log (
+    event_type,
+    entity_type,
+    entity_id,
+    service_id,
+    schedule_id,
+    from_state,
+    to_state,
+    actor,
+    actor_id,
+    metadata
+  )
+  values (
+    v_audit_event,
+    'payment_schedule',
+    v_schedule.id,
+    v_schedule.contracted_service_id,
+    v_schedule.id,
+    v_from_state,
+    p_outcome,
+    'client',
+    p_actor_id,
+    jsonb_build_object(
+      'charge_amount', p_charge_amount,
+      'manual_attempt_count', v_schedule.manual_attempt_count,
+      'gateway_charge_id', p_gateway_charge_id,
+      'gateway_transaction_id', p_gateway_transaction_id
+    )
+  );
+
+  insert into public.payment_events (
+    event_type,
+    aggregate_type,
+    aggregate_id,
+    service_id,
+    payload
+  )
+  values (
+    v_event_type,
+    'payment_schedule',
+    v_schedule.id,
+    v_schedule.contracted_service_id,
+    jsonb_build_object(
+      'outcome', p_outcome,
+      'charge_amount', p_charge_amount,
+      'initiator', 'client'
+    )
+  );
+
+  return v_schedule.id;
+end;
+$$;
+-- Payment System — Phase 3 task 19: recover_orphaned_payment_schedules janitor (design §4.6).
+-- Requirements: 23, 11. Acceptance: 23A.2, 11A.1.
+
+create or replace function public.recover_orphaned_payment_schedules()
+returns table (
+  recovered_count int,
+  recovered_to_scheduled int,
+  recovered_to_failed int
+)
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_row public.payment_schedules%rowtype;
+  v_count int := 0;
+  v_sched int := 0;
+  v_fail int := 0;
+  v_new_state text;
+  v_retry_minutes int;
+begin
+  v_retry_minutes := public.platform_constant_int('charge_retry_interval_minutes', 30);
+
+  for v_row in
+    select ps.*
+    from public.payment_schedules ps
+    where ps.state = 'PROCESSING'
+      and ps.locked_until is not null
+      and ps.locked_until < now()
+    for update skip locked
+  loop
+    v_new_state := case
+      when v_row.automatic_attempt_count = 0 then 'SCHEDULED'
+      else 'FAILED'
+    end;
+
+    update public.payment_schedules ps
+    set
+      state = v_new_state,
+      locked_until = null,
+      next_retry_at = case
+        when v_row.automatic_attempt_count > 0
+          then now() + make_interval(mins => v_retry_minutes)
+        else null
+      end,
+      updated_at = now()
+    where ps.id = v_row.id
+      and ps.state = 'PROCESSING';
+
+    insert into public.payment_audit_log (
+      event_type,
+      entity_type,
+      entity_id,
+      service_id,
+      schedule_id,
+      from_state,
+      to_state,
+      actor,
+      metadata
+    )
+    values (
+      'ORPHAN_RECOVERED',
+      'payment_schedule',
+      v_row.id,
+      v_row.contracted_service_id,
+      v_row.id,
+      'PROCESSING',
+      v_new_state,
+      'system',
+      jsonb_build_object(
+        'recovered_at', now(),
+        'locked_until_was', v_row.locked_until,
+        'automatic_attempt_count', v_row.automatic_attempt_count
+      )
+    );
+
+    insert into public.payment_events (
+      event_type,
+      aggregate_type,
+      aggregate_id,
+      service_id,
+      payload
+    )
+    values (
+      'ChargeFailed',
+      'payment_schedule',
+      v_row.id,
+      v_row.contracted_service_id,
+      jsonb_build_object(
+        'from_state', 'PROCESSING',
+        'to_state', v_new_state,
+        'reason', 'orphan_recovery'
+      )
+    );
+
+    v_count := v_count + 1;
+
+    if v_new_state = 'SCHEDULED' then
+      v_sched := v_sched + 1;
+    else
+      v_fail := v_fail + 1;
+    end if;
+  end loop;
+
+  return query
+  select v_count, v_sched, v_fail;
+end;
+$$;
+
+comment on function public.recover_orphaned_payment_schedules() is
+  'Recovers PROCESSING schedules with expired leases; SKIP LOCKED for concurrent janitors.';
+
+revoke all on function public.recover_orphaned_payment_schedules() from public;
+revoke all on function public.recover_orphaned_payment_schedules() from anon;
+revoke all on function public.recover_orphaned_payment_schedules() from authenticated;
+grant execute on function public.recover_orphaned_payment_schedules() to service_role;
diff --git a/supabase/migrations/20260705221500_rpc_operator_payment_tools.sql b/supabase/migrations/20260705221500_rpc_operator_payment_tools.sql
new file mode 100644
