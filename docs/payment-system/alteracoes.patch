+
+Deno.test("bankers rounding mode differs from postgres at half-up boundaries", () => {
+  const constants = PAYMENT_PLATFORM_CONSTANT_DEFAULTS;
+  const bankers = calculateChargeAmount(1000, "VCC", 2, constants, "bankers");
+  const postgres = calculateChargeAmount(1000, "VCC", 2, constants, "postgres");
+
+  assertEquals(postgres.installment_amount, 513.15);
+  assertEquals(bankers.installment_amount, 513.14);
