+-- Payment System — task 48: PAYMENT_PROFILE_* webhook RPCs.
+
+create or replace function public.webhook_payment_profile_delete_rpc(
+  p_gateway_payment_profile_id text,
+  p_webhook_event_id text
+)
+returns jsonb
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_token public.payment_tokens%rowtype;
+  v_schedules jsonb := '[]'::jsonb;
+  v_schedule record;
+begin
+  select pt.*
+  into v_token
+  from public.payment_tokens pt
+  where pt.gateway_payment_profile_id = p_gateway_payment_profile_id
+  for update;
+
+  if not found then
+    return jsonb_build_object('outcome', 'not_found');
+  end if;
+
+  update public.payment_tokens pt
+  set state = 'REVOKED'
+  where pt.id = v_token.id;
+
+  for v_schedule in
+    update public.payment_schedules ps
+    set needs_payment_method_update = true
+    where ps.payment_token_id = v_token.id
+      and ps.state in ('SCHEDULED', 'FAILED')
+    returning ps.id, ps.contracted_service_id, ps.client_id
+  loop
+    v_schedules := v_schedules || jsonb_build_array(jsonb_build_object(
+      'schedule_id', v_schedule.id,
+      'service_id', v_schedule.contracted_service_id,
+      'client_id', v_schedule.client_id
+    ));
+  end loop;
+
+  insert into public.payment_audit_log (
+    event_type,
+    entity_type,
+    entity_id,
+    actor,
+    metadata
+  )
+  values (
+    'PAYMENT_PROFILE_DELETED',
+    'payment_token',
+    v_token.id,
+    'webhook',
+    jsonb_build_object(
+      'webhook_event_id', p_webhook_event_id,
+      'gateway_payment_profile_id', p_gateway_payment_profile_id,
+      'affected_schedules', v_schedules
+    )
+  );
+
+  return jsonb_build_object(
+    'outcome', 'deleted',
+    'token_id', v_token.id,
+    'client_id', v_token.client_id,
+    'schedules', v_schedules
+  );
+end;
+$$;
+
+create or replace function public.webhook_payment_profile_tokenize_rpc(
+  p_gateway_payment_profile_id text,
+  p_is_active boolean,
+  p_webhook_event_id text
+)
+returns jsonb
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_token public.payment_tokens%rowtype;
+  v_has_scheduled boolean := false;
+begin
+  select pt.*
+  into v_token
+  from public.payment_tokens pt
+  where pt.gateway_payment_profile_id = p_gateway_payment_profile_id
+  for update;
+
+  if not found then
+    return jsonb_build_object('outcome', 'not_found');
+  end if;
+
+  if not coalesce(p_is_active, false) then
+    update public.payment_tokens pt
+    set state = 'TOKENIZATION_FAILED'
+    where pt.id = v_token.id;
+  end if;
+
+  select exists (
+    select 1
+    from public.payment_schedules ps
+    where ps.payment_token_id = v_token.id
+      and ps.state = 'SCHEDULED'
+  )
+  into v_has_scheduled;
+
+  return jsonb_build_object(
+    'outcome', case when p_is_active then 'tokenized' else 'tokenization_failed' end,
+    'token_id', v_token.id,
+    'client_id', v_token.client_id,
+    'has_scheduled_schedule', v_has_scheduled,
+    'is_active', coalesce(p_is_active, false)
+  );
+end;
+$$;
+
