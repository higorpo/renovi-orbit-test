+import { isValidWebhookTransition } from "../../_shared/payment/error-classification.ts";
+import type { NotificationIngestInput } from "../../manual-charge-payment/enqueueNotifications.ts";
+import type { WebhookHandlerContext } from "../types.ts";
+import { enqueuePaymentFailedPermanentNotifications } from "./enqueuePaymentFailedPermanentNotifications.ts";
+import {
+  extractFailureDetails,
+  extractReferenceCode,
+} from "./extractTransactionPayload.ts";
+
+export type TransactionRejectedApplyResult = {
+  outcome: "rejected" | "already_terminal" | "skipped" | "not_found";
+  reason?: string;
+  schedule_id?: string;
+  service_id?: string;
+  client_id?: string;
+  provider_id?: string;
+  from_state?: string;
+};
+
+export type TransactionRejectedDeps = {
+  applyRejected: (input: {
+    referenceCode: string;
+    webhookEventId: string;
+    failureCode?: string;
+    failureReason?: string;
+  }) => Promise<TransactionRejectedApplyResult>;
+  ingestNotification: (input: NotificationIngestInput) => Promise<void>;
+  isValidTransition?: typeof isValidWebhookTransition;
+};
+
+export async function handleTransactionRejected(
+  deps: TransactionRejectedDeps,
+  context: WebhookHandlerContext,
+): Promise<"processed" | "skipped"> {
+  const referenceCode = extractReferenceCode(context.payload);
+  if (!referenceCode) {
+    throw new Error("REFERENCE_CODE_MISSING");
+  }
+
+  const fromState = typeof context.payload.from_state === "string"
+    ? context.payload.from_state
+    : undefined;
+  const validateTransition = deps.isValidTransition ?? isValidWebhookTransition;
+
+  if (fromState && !validateTransition(fromState, "FAILED_PERMANENT")) {
+    return "skipped";
+  }
+
+  const failureDetails = extractFailureDetails(context.payload);
+  const result = await deps.applyRejected({
+    referenceCode,
+    webhookEventId: context.eventId,
+    failureCode: failureDetails.failureCode,
+    failureReason: failureDetails.failureReason,
+  });
+
+  if (result.outcome === "rejected") {
+    await enqueuePaymentFailedPermanentNotifications(deps.ingestNotification, {
+      webhookEventId: context.eventId,
+      serviceId: result.service_id!,
+      clientId: result.client_id!,
+      providerId: result.provider_id!,
+    });
+    return "processed";
+  }
+
+  if (
+    result.outcome === "already_terminal" ||
+    result.outcome === "skipped"
+  ) {
+    return "processed";
+  }
+
+  throw new Error("SCHEDULE_NOT_FOUND");
+}
