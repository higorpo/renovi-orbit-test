+  p_provider_id uuid,
+  p_gateway_slug text,
+  p_payment_token_id uuid,
+  p_installment_number smallint,
+  p_base_amount numeric(12, 2),
+  p_service_scheduled_at timestamptz,
+  p_clearsale_session_id text,
+  p_client_ip_address text,
+  p_actor_id uuid,
+  p_idempotency_key uuid
+)
+returns table (
+  contracted_service_id uuid,
+  schedule_id uuid,
+  is_idempotent boolean
+)
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_proposal public.provider_proposals%rowtype;
+  v_service_id uuid;
+  v_schedule_id uuid;
+  v_charge_at timestamptz;
+  v_emergency boolean := false;
+  v_request_hash text;
+  v_cached jsonb;
+  v_response jsonb;
+  v_slot jsonb;
+  v_max_attempts smallint;
+  v_is_idempotent boolean := false;
+begin
+  if p_idempotency_key is null then
+    raise exception 'p_idempotency_key is required' using errcode = '22023';
+  end if;
+
+  v_request_hash := md5(
+    concat_ws(
+      '|',
+      p_proposal_id::text,
+      p_client_id::text,
+      p_payment_token_id::text,
+      p_installment_number::text,
+      p_base_amount::text
+    )
+  );
+
+  v_cached := public.idempotency_begin_for_actor(
+    p_actor_id,
+    'payments.accept_proposal',
+    p_idempotency_key,
+    v_request_hash
+  );
+
+  if v_cached is not null then
+    return query
+    select
+      (v_cached -> 'response_body' ->> 'contracted_service_id')::uuid,
+      (v_cached -> 'response_body' ->> 'schedule_id')::uuid,
+      true;
+    return;
+  end if;
+
+  if p_service_scheduled_at - now() < interval '48 hours' then
+    v_charge_at := now();
+    v_emergency := true;
+  else
+    v_charge_at := p_service_scheduled_at - interval '2 days';
+  end if;
+
+  v_max_attempts := public.platform_constant_int('max_charge_attempts', 3)::smallint;
+
+  select cs.id, ps.id
+  into v_service_id, v_schedule_id
+  from public.contracted_services cs
+  left join public.payment_schedules ps on ps.contracted_service_id = cs.id
+  where cs.accepted_proposal_id = p_proposal_id
+    and cs.client_id = p_client_id;
+
+  if v_service_id is not null and v_schedule_id is not null then
+    v_is_idempotent := true;
+  end if;
+
+  if v_service_id is null then
+    select *
+    into v_proposal
+    from public.provider_proposals pp
+    where pp.id = p_proposal_id;
+
+    if not found then
+      raise exception 'PROPOSAL_NOT_FOUND: %', p_proposal_id using errcode = 'P0001';
+    end if;
+
+    if v_proposal.provider_id <> p_provider_id then
+      raise exception 'PROVIDER_MISMATCH' using errcode = 'P0001';
+    end if;
+
+    v_slot := coalesce(
+      v_proposal.selected_slot,
+      jsonb_build_object(
+        'start_date', to_char(p_service_scheduled_at at time zone 'UTC', 'YYYY-MM-DD'),
+        'shift', 'morning'
+      )
+    );
+
+    begin
+      insert into public.contracted_services (
+        service_request_id,
+        accepted_proposal_id,
+        client_id,
+        provider_id,
+        duration_unit,
+        duration_value,
+        scheduled_start_date,
+        scheduled_end_date,
+        scheduled_shift,
+        agreed_slot,
+        status,
+        service_scheduled_at
+      )
+      values (
+        v_proposal.service_request_id,
+        p_proposal_id,
+        p_client_id,
+        p_provider_id,
+        v_proposal.proposal_duration_unit,
+        v_proposal.proposal_duration_value,
+        coalesce((v_slot ->> 'start_date')::date, p_service_scheduled_at::date),
+        nullif(v_slot ->> 'end_date', '')::date,
+        coalesce(v_slot ->> 'shift', 'morning'),
+        v_slot,
+        'PENDING_PAYMENT'::public.contracted_service_status,
+        p_service_scheduled_at
+      )
+      returning id into v_service_id;
+    exception
+      when unique_violation then
+        select cs.id
+        into v_service_id
+        from public.contracted_services cs
+        where cs.accepted_proposal_id = p_proposal_id
+          and cs.client_id = p_client_id;
+        v_is_idempotent := true;
+    end;
+  else
+    update public.contracted_services cs
+    set service_scheduled_at = coalesce(cs.service_scheduled_at, p_service_scheduled_at)
+    where cs.id = v_service_id
+      and cs.service_scheduled_at is null;
+  end if;
+
+  if v_schedule_id is null then
+    begin
+      insert into public.payment_schedules (
+        contracted_service_id,
+        client_id,
+        provider_id,
+        gateway_slug,
+        payment_token_id,
+        installment_number,
+        base_amount,
+        charge_scheduled_at,
+        state,
+        idempotency_key,
+        clearsale_session_id,
+        client_ip_address,
+        max_attempts
+      )
+      values (
+        v_service_id,
+        p_client_id,
+        p_provider_id,
+        p_gateway_slug,
+        p_payment_token_id,
+        p_installment_number,
+        p_base_amount,
+        v_charge_at,
+        'SCHEDULED',
+        v_service_id::text,
+        p_clearsale_session_id,
+        p_client_ip_address,
+        v_max_attempts
+      )
+      returning id into v_schedule_id;
+    exception
+      when unique_violation then
+        select ps.id
+        into v_schedule_id
+        from public.payment_schedules ps
+        where ps.idempotency_key = v_service_id::text;
+        v_is_idempotent := true;
+    end;
+
+    insert into public.payment_audit_log (
+      event_type,
+      entity_type,
+      entity_id,
+      service_id,
+      schedule_id,
+      actor,
+      actor_id,
+      metadata
+    )
+    values
+      (
+        'CHARGE_SCHEDULED',
+        'payment_schedule',
+        v_schedule_id,
+        v_service_id,
+        v_schedule_id,
+        'client',
+        p_actor_id,
+        jsonb_build_object(
+          'charge_scheduled_at', v_charge_at,
+          'emergency_scheduling', v_emergency,
+          'installment_number', p_installment_number,
+          'base_amount', p_base_amount
+        )
+      ),
+      (
+        'PAYMENT_TERMS_ACCEPTED',
+        'payment_schedule',
+        v_schedule_id,
+        v_service_id,
+        v_schedule_id,
+        'client',
+        p_actor_id,
+        jsonb_build_object(
+          'gateway_slug', p_gateway_slug,
+          'accepted_at', now()
+        )
+      );
+
+    insert into public.payment_events (
+      event_type,
+      aggregate_type,
+      aggregate_id,
+      service_id,
+      payload
+    )
+    values (
+      'ChargeScheduled',
+      'payment_schedule',
+      v_schedule_id,
+      v_service_id,
+      jsonb_build_object(
+        'charge_scheduled_at', v_charge_at,
+        'gateway_slug', p_gateway_slug
+      )
+    );
+  end if;
+
+  v_response := jsonb_build_object(
+    'contracted_service_id', v_service_id,
+    'schedule_id', v_schedule_id
+  );
+
+  perform public.idempotency_commit_for_actor(
+    p_actor_id,
+    'payments.accept_proposal',
+    p_idempotency_key,
+    v_request_hash,
+    200,
+    v_response
+  );
+
+  return query
+  select v_service_id, v_schedule_id, v_is_idempotent;
+end;
+$$;
+
+comment on function public.accept_proposal_rpc(
+  uuid, uuid, uuid, text, uuid, smallint, numeric, timestamptz, text, text, uuid, uuid
+) is
+  'Atomic payment acceptance: contracted_services + payment_schedules + audit/events; idempotent via rpc_idempotency_records.';
+
+revoke all on function public.accept_proposal_rpc(
+  uuid, uuid, uuid, text, uuid, smallint, numeric, timestamptz, text, text, uuid, uuid
+) from public;
+revoke all on function public.accept_proposal_rpc(
+  uuid, uuid, uuid, text, uuid, smallint, numeric, timestamptz, text, text, uuid, uuid
+) from anon;
+revoke all on function public.accept_proposal_rpc(
+  uuid, uuid, uuid, text, uuid, smallint, numeric, timestamptz, text, text, uuid, uuid
+) from authenticated;
+grant execute on function public.accept_proposal_rpc(
+  uuid, uuid, uuid, text, uuid, smallint, numeric, timestamptz, text, text, uuid, uuid
+) to service_role;
diff --git a/supabase/migrations/20260705208200_rpc_recover_orphaned_schedules.sql b/supabase/migrations/20260705208200_rpc_recover_orphaned_schedules.sql
new file mode 100644
index 0000000..8b159d9
--- /dev/null
+++ b/supabase/migrations/20260705208200_rpc_recover_orphaned_schedules.sql
@@ -0,0 +1,115 @@
+-- Payment System — Phase 3 task 19: recover_orphaned_payment_schedules janitor (design §4.6).
+-- Requirements: 23, 11. Acceptance: 23A.2, 11A.1.
+
+create or replace function public.recover_orphaned_payment_schedules()
+returns table (
+  recovered_count int,
+  recovered_to_scheduled int,
+  recovered_to_failed int
+)
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_row public.payment_schedules%rowtype;
+  v_count int := 0;
+  v_sched int := 0;
+  v_fail int := 0;
+  v_new_state text;
+  v_retry_minutes int;
+begin
+  v_retry_minutes := public.platform_constant_int('charge_retry_interval_minutes', 30);
+
+  for v_row in
+    select ps.*
+    from public.payment_schedules ps
+    where ps.state = 'PROCESSING'
+      and ps.locked_until is not null
+      and ps.locked_until < now()
+    for update skip locked
+  loop
+    v_new_state := case
+      when v_row.automatic_attempt_count = 0 then 'SCHEDULED'
+      else 'FAILED'
+    end;
+
+    update public.payment_schedules ps
+    set
+      state = v_new_state,
+      locked_until = null,
+      next_retry_at = case
+        when v_row.automatic_attempt_count > 0
+          then now() + make_interval(mins => v_retry_minutes)
+        else null
+      end,
+      updated_at = now()
+    where ps.id = v_row.id;
+
+    insert into public.payment_audit_log (
+      event_type,
+      entity_type,
+      entity_id,
+      service_id,
+      schedule_id,
+      from_state,
+      to_state,
+      actor,
+      metadata
+    )
+    values (
+      'ORPHAN_RECOVERED',
+      'payment_schedule',
+      v_row.id,
+      v_row.contracted_service_id,
+      v_row.id,
+      'PROCESSING',
+      v_new_state,
+      'system',
+      jsonb_build_object(
+        'recovered_at', now(),
+        'locked_until_was', v_row.locked_until,
+        'automatic_attempt_count', v_row.automatic_attempt_count
+      )
+    );
+
+    insert into public.payment_events (
+      event_type,
+      aggregate_type,
+      aggregate_id,
+      service_id,
+      payload
+    )
+    values (
+      'ChargeFailed',
+      'payment_schedule',
+      v_row.id,
+      v_row.contracted_service_id,
+      jsonb_build_object(
+        'from_state', 'PROCESSING',
+        'to_state', v_new_state,
+        'reason', 'orphan_recovery'
+      )
+    );
+
+    v_count := v_count + 1;
+
+    if v_new_state = 'SCHEDULED' then
+      v_sched := v_sched + 1;
+    else
+      v_fail := v_fail + 1;
+    end if;
+  end loop;
+
+  return query
+  select v_count, v_sched, v_fail;
+end;
+$$;
+
+comment on function public.recover_orphaned_payment_schedules() is
+  'Recovers PROCESSING schedules with expired leases; SKIP LOCKED for concurrent janitors.';
+
+revoke all on function public.recover_orphaned_payment_schedules() from public;
+revoke all on function public.recover_orphaned_payment_schedules() from anon;
+revoke all on function public.recover_orphaned_payment_schedules() from authenticated;
+grant execute on function public.recover_orphaned_payment_schedules() to service_role;
diff --git a/supabase/migrations/20260705208300_rpc_auto_cancel_services.sql b/supabase/migrations/20260705208300_rpc_auto_cancel_services.sql
new file mode 100644
index 0000000..2c884af
--- /dev/null
+++ b/supabase/migrations/20260705208300_rpc_auto_cancel_services.sql
@@ -0,0 +1,123 @@
+-- Payment System — Phase 3 task 20: auto_cancel_services_rpc T-12h (design §4.12).
+-- Requirements: 14. Acceptance: 14A.1, 14A.2, 14A.4, 14A.6, 14A.7.
+
+create or replace function public.auto_cancel_services_rpc()
+returns void
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_service record;
+  v_cancel_hours int;
+  v_reason text;
+begin
+  v_cancel_hours := public.platform_constant_int('auto_cancel_hours_before_service', 12);
+
+  for v_service in
+    select
+      cs.id as service_id,
+      ps.id as schedule_id,
+      ps.state as schedule_state,
+      pa.onboarding_status
+    from public.contracted_services cs
+    join public.payment_schedules ps on ps.contracted_service_id = cs.id
+    left join public.provider_accounts pa
+      on pa.provider_id = ps.provider_id
+      and pa.gateway_slug = ps.gateway_slug
+    where cs.service_scheduled_at is not null
+      and cs.service_scheduled_at - now() <= make_interval(hours => v_cancel_hours)
+      and ps.state not in (
+        'PAID',
+        'IN_ANALYSIS',
+        'CANCELLED',
+        'VOIDED',
+        'REFUNDED',
+        'PARTIALLY_REFUNDED',
+        'EXPIRED',
+        'PROCESSING'
+      )
+      and cs.status not in ('CANCELLED', 'COMPLETED')
+  loop
+    begin
+      if (
+        select cs.status
+        from public.contracted_services cs
+        where cs.id = v_service.service_id
+      ) = 'CANCELLED'::public.contracted_service_status then
+        continue;
+      end if;
+
+      v_reason := case
+        when v_service.onboarding_status = 'SUSPENDED' then 'PROVIDER_SUSPENDED'
+        else 'NON_PAYMENT'
+      end;
+
+      update public.contracted_services cs
+      set
+        status = 'CANCELLED'::public.contracted_service_status,
+        cancellation_reason = v_reason
+      where cs.id = v_service.service_id;
+
+      update public.payment_schedules ps
+      set
+        state = 'CANCELLED',
+        cancelled_at = now(),
+        cancellation_reason = v_reason
+      where ps.id = v_service.schedule_id;
+
+      insert into public.payment_audit_log (
+        event_type,
+        entity_type,
+        entity_id,
+        service_id,
+        schedule_id,
+        actor,
+        from_state,
+        to_state,
+        metadata
+      )
+      values (
+        'AUTO_CANCELLED',
+        'contracted_service',
+        v_service.service_id,
+        v_service.service_id,
+        v_service.schedule_id,
+        'system',
+        v_service.schedule_state,
+        'CANCELLED',
+        jsonb_build_object('cancellation_reason', v_reason)
+      );
+
+      insert into public.payment_events (
+        event_type,
+        aggregate_type,
+        aggregate_id,
+        service_id,
+        payload
+      )
+      values (
+        'ServiceAutoCancelled',
+        'contracted_service',
+        v_service.service_id,
+        v_service.service_id,
+        jsonb_build_object(
+          'schedule_id', v_service.schedule_id,
+          'cancellation_reason', v_reason
+        )
+      );
+    exception
+      when others then
+        perform pg_notify('auto_cancel_error', v_service.service_id::text);
+    end;
+  end loop;
+end;
+$$;
+
+comment on function public.auto_cancel_services_rpc() is
+  'T-12h auto-cancel for unpaid schedules; IN_ANALYSIS exempt; per-service error isolation.';
+
+revoke all on function public.auto_cancel_services_rpc() from public;
+revoke all on function public.auto_cancel_services_rpc() from anon;
+revoke all on function public.auto_cancel_services_rpc() from authenticated;
+grant execute on function public.auto_cancel_services_rpc() to service_role;
diff --git a/supabase/migrations/20260705208400_rpc_mark_service_executed.sql b/supabase/migrations/20260705208400_rpc_mark_service_executed.sql
new file mode 100644
index 0000000..7b84a64
--- /dev/null
+++ b/supabase/migrations/20260705208400_rpc_mark_service_executed.sql
@@ -0,0 +1,76 @@
+-- Payment System — Phase 3 task 21: mark_service_executed RPC (design §4.13).
+-- Requirements: 32. Acceptance: 32A.1, 32A.5.
+
+create or replace function public.mark_service_executed(p_service_id uuid)
+returns void
+language plpgsql
+security definer
+set search_path = public, auth
+as $$
+declare
+  v_cs public.contracted_services%rowtype;
+begin
+  select *
+  into v_cs
+  from public.contracted_services cs
+  where cs.id = p_service_id
+    and cs.provider_id = (select auth.uid())
+  for update;
+
+  if not found then
+    raise exception 'SERVICE_NOT_FOUND_OR_UNAUTHORIZED'
+      using errcode = 'P0003';
+  end if;
+
+  if v_cs.status <> 'CONFIRMED'::public.contracted_service_status then
+    raise exception 'INVALID_STATUS_TRANSITION'
+      using errcode = 'P0001';
+  end if;
+
+  if v_cs.scheduled_start_date > current_date then
+    raise exception 'SERVICE_NOT_YET_DUE'
+      using errcode = 'P0002';
+  end if;
+
+  update public.contracted_services cs
+  set
+    status = 'EXECUTED'::public.contracted_service_status,
+    executed_at = now()
+  where cs.id = p_service_id;
+
+  insert into public.payment_audit_log (
+    event_type,
+    entity_type,
+    entity_id,
+    service_id,
+    actor,
+    actor_id
+  )
+  values (
+    'SERVICE_EXECUTED',
+    'contracted_service',
+    p_service_id,
+    p_service_id,
+    'provider',
+    (select auth.uid())
+  );
+
+  insert into public.payment_events (
+    event_type,
+    aggregate_type,
+    aggregate_id,
+    service_id
+  )
+  values (
+    'ServiceExecuted',
+    'contracted_service',
+    p_service_id,
+    p_service_id
+  );
+end;
+$$;
+
+comment on function public.mark_service_executed(uuid) is
+  'Provider marks CONFIRMED service executed on or after scheduled_start_date.';
+
+grant execute on function public.mark_service_executed(uuid) to authenticated;
diff --git a/supabase/migrations/20260705208500_rpc_match_provider_jobs_gate.sql b/supabase/migrations/20260705208500_rpc_match_provider_jobs_gate.sql
new file mode 100644
index 0000000..d67acd1
--- /dev/null
+++ b/supabase/migrations/20260705208500_rpc_match_provider_jobs_gate.sql
@@ -0,0 +1,231 @@
+-- Payment System — Phase 3 task 22: provider credentialing gate (design §4.1.1, Req 3, 29).
+-- Applies to list_provider_opportunities (successor to match_provider_jobs) and cns_initiate_conversation.
+
+create or replace function public.payment_is_provider_credentialed(
+  p_provider_id uuid,
+  p_gateway_slug text default 'netcred'
+)
+returns boolean
+language sql
+stable
+security definer
+set search_path = public
+as $$
+  select coalesce(
+    (
+      select pa.onboarding_status = 'ACTIVE'
+      from public.provider_accounts pa
+      where pa.provider_id = p_provider_id
+        and pa.gateway_slug = p_gateway_slug
+    ),
+    false
+  );
+$$;
+
+comment on function public.payment_is_provider_credentialed(uuid, text) is
+  'True when provider has ACTIVE onboarding_status for the payment gateway.';
+
+revoke all on function public.payment_is_provider_credentialed(uuid, text) from public;
+revoke all on function public.payment_is_provider_credentialed(uuid, text) from anon;
+revoke all on function public.payment_is_provider_credentialed(uuid, text) from authenticated;
+grant execute on function public.payment_is_provider_credentialed(uuid, text) to service_role;
+
+create or replace function public.cns_initiate_conversation(
+  p_service_request_id uuid,
+  p_idempotency_key uuid
+)
+returns jsonb
+language plpgsql
+security definer
+set search_path = public, auth
+as $$
+declare
+  v_actor uuid := auth.uid();
+  v_chat public.chats%rowtype;
+  v_sr public.service_requests%rowtype;
+  v_stats public.service_request_negotiation_stats%rowtype;
+  v_slot_limit int;
+  v_is_new_chat boolean := false;
+  v_cached jsonb;
+  v_request_hash text;
+  v_response jsonb;
+begin
+  if v_actor is null then
+    raise exception 'Authentication required for cns_initiate_conversation'
+      using errcode = '42501';
+  end if;
+
+  if p_service_request_id is null then
+    raise exception 'p_service_request_id is required'
+      using errcode = '22023';
+  end if;
+
+  if p_idempotency_key is null then
+    raise exception 'p_idempotency_key is required'
+      using errcode = '22023';
+  end if;
+
+  if not public.payment_is_provider_credentialed(v_actor, 'netcred') then
+    raise exception 'PROVIDER_NOT_CREDENTIALED'
+      using
+        errcode = 'P0001',
+        detail = jsonb_build_object('code', 'PROVIDER_NOT_CREDENTIALED')::text;
+  end if;
+
+  v_request_hash := md5(p_service_request_id::text);
+
+  v_cached := public.idempotency_begin(
+    'chats.initiate_conversation',
+    p_idempotency_key,
+    v_request_hash
+  );
+
+  if v_cached is not null then
+    return v_cached->'response_body';
+  end if;
+
+  select *
+  into v_sr
+  from public.service_requests sr
+  where sr.id = p_service_request_id
+  for update;
+
+  if not found then
+    raise exception 'Service request not found: %', p_service_request_id
+      using errcode = '22023';
+  end if;
+
+  if v_sr.status <> 'OPEN'::public.service_request_status then
+    raise exception 'SR_NOT_OPEN'
+      using
+        errcode = 'P0001',
+        detail = jsonb_build_object('code', 'SR_NOT_OPEN')::text;
+  end if;
+
+  if v_actor = v_sr.client_id then
+    raise exception 'Only the provider may initiate a new conversation'
+      using errcode = '42501';
+  end if;
+
+  select *
+  into v_chat
+  from public.chats c
+  where c.service_request_id = p_service_request_id
+    and c.provider_id = v_actor
+  for update;
+
+  if not found then
+    insert into public.service_request_negotiation_stats (service_request_id)
+    values (v_sr.id)
+    on conflict (service_request_id) do nothing;
+
+    select *
+    into v_stats
+    from public.service_request_negotiation_stats s
+    where s.service_request_id = v_sr.id
+    for update;
+
+    v_slot_limit := public.platform_constant_int(
+      'chats.max_active_slots_per_service_request',
+      4
+    );
+
+    if v_stats.active_chat_count >= v_slot_limit then
+      raise log 'cns_slot_rejection_total service_request_id=% active_chat_count=% slot_limit=%',
+        v_sr.id,
+        v_stats.active_chat_count,
+        v_slot_limit;
+
+      raise exception 'NO_ACTIVE_SLOT'
+        using
+          errcode = 'P0001',
+          detail = jsonb_build_object('code', 'NO_ACTIVE_SLOT')::text;
+    end if;
+
+    begin
+      insert into public.chats (
+        service_request_id,
+        client_id,
+        provider_id,
+        status,
+        activated_at,
+        last_interaction_at
+      )
+      values (
+        v_sr.id,
+        v_sr.client_id,
+        v_actor,
+        'ACTIVE'::public.cns_conversation_status,
+        now(),
+        now()
+      )
+      returning * into v_chat;
+
+      v_is_new_chat := true;
+    exception
+      when unique_violation then
+        select *
+        into v_chat
+        from public.chats c
+        where c.service_request_id = p_service_request_id
+          and c.provider_id = v_actor
+        for update;
+    end;
+
+    if v_is_new_chat then
+      update public.service_request_negotiation_stats
+      set
+        active_chat_count = active_chat_count + 1,
+        version = version + 1
+      where service_request_id = v_sr.id;
+    end if;
+  elsif v_actor <> v_chat.provider_id then
+    raise exception 'NOT_A_PARTICIPANT'
+      using errcode = '42501';
+  end if;
+
+  if v_chat.status = 'CLOSED'::public.cns_conversation_status then
+    raise exception 'CONVERSATION_CLOSED'
+      using
+        errcode = 'P0001',
+        detail = jsonb_build_object(
+          'code', 'CONVERSATION_CLOSED',
+          'closure_type', v_chat.closure_type,
+          'closure_reason', v_chat.closure_reason
+        )::text;
+  end if;
+
+  raise log 'cns_initiate_conversation chat_id=% service_request_id=% idempotency_key=% new_chat=%',
+    v_chat.id,
+    p_service_request_id,
+    p_idempotency_key,
+    v_is_new_chat;
+
+  v_response := jsonb_build_object(
+    'conversation', jsonb_build_object(
+      'id', v_chat.id,
+      'service_request_id', v_chat.service_request_id,
+      'client_id', v_chat.client_id,
+      'provider_id', v_chat.provider_id,
+      'status', v_chat.status,
+      'activated_at', v_chat.activated_at,
+      'last_interaction_at', v_chat.last_interaction_at
+    )
+  );
+
+  perform public.idempotency_commit(
+    'chats.initiate_conversation',
+    p_idempotency_key,
+    v_request_hash,
+    200,
+    v_response
+  );
+
+  return v_response;
+end;
+$$;
+
+comment on function public.cns_initiate_conversation(uuid, uuid) is
+  'Provider-only chat create/get; requires ACTIVE payment credentialing (payments.accept_proposal gate pattern).';
+
+grant execute on function public.cns_initiate_conversation(uuid, uuid) to authenticated;
diff --git a/supabase/migrations/20260705208600_rpc_reschedule_charge_date.sql b/supabase/migrations/20260705208600_rpc_reschedule_charge_date.sql
