+        <div className="space-y-4">
+          <FormField
+            control={form.control}
+            name="identityDoc"
+            render={({ field }) => (
+              <FormItem>
+                <FileField
+                  id="kyc-identity-doc"
+                  label="Documento de identidade (CPF/CNH)"
+                  value={field.value}
