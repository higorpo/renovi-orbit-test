--- /dev/null
+++ b/supabase/functions/netcred-webhook/index.ts
@@ -0,0 +1,153 @@
+import "xhr";
+import { servePaymentFunction } from "../_shared/observability/sentry.ts";
+import type { Json } from "../_shared/database.types.ts";
+import { createLogger } from "../_shared/logger.ts";
+import {
+  checkIPRateLimit,
+  emitIPRateLimitWarning,
+} from "../_shared/security/rate-limit.ts";
+import { getVaultSecret } from "../calculate-installment-options/getVaultSecret.ts";
+import { createServiceRoleClient } from "../_shared/serviceRoleClient.ts";
+import {
+  handleNetcredWebhookRequest,
+  type NetcredWebhookDeps,
+} from "./handleRequest.ts";
+import type { PersistWebhookInput, PersistWebhookResult } from "./types.ts";
+
+const logger = createLogger("netcred-webhook");
+
+async function findExistingEventId(
+  supabase: ReturnType<typeof createServiceRoleClient>,
+  input: PersistWebhookInput,
+): Promise<string | null> {
+  const { data, error } = await supabase
+    .from("payment_webhook_events")
+    .select("id")
+    .eq("gateway_slug", input.gatewaySlug)
+    .eq("event_type", input.eventType)
+    .eq("gateway_event_id", input.providerEventId)
+    .maybeSingle();
+
+  if (error || !data) {
+    return null;
+  }
+
+  return data.id;
+}
+
+function createDeps(): NetcredWebhookDeps {
+  const supabase = createServiceRoleClient();
+
+  return {
+    getWebhookSecret: () => getVaultSecret(supabase, "NETCRED_WEBHOOK_SECRET"),
+    persistWebhookEvent: async (input) => {
+      const { data, error } = await supabase
+        .from("payment_webhook_events")
+        .insert({
+          gateway_slug: input.gatewaySlug,
+          event_type: input.eventType,
+          gateway_event_id: input.providerEventId,
+          raw_payload: input.rawPayload as Json,
+          raw_headers: input.rawHeaders as Json,
+          state: "RECEIVED",
+        })
+        .select("id")
+        .single();
+
+      if (error?.code === "23505") {
+        const existingId = await findExistingEventId(supabase, input);
+        if (!existingId) {
+          throw new Error(error.message);
+        }
+
+        return { status: "duplicate", eventId: existingId } satisfies PersistWebhookResult;
+      }
+
+      if (error || !data) {
+        throw new Error(error?.message ?? "webhook_insert_failed");
+      }
+
+      return { status: "inserted", eventId: data.id } satisfies PersistWebhookResult;
+    },
+    markDuplicate: async (eventId) => {
+      const { error } = await supabase
+        .from("payment_webhook_events")
+        .update({
+          is_duplicate: true,
+          state: "DUPLICATE",
+          processed_at: new Date().toISOString(),
+        })
+        .eq("id", eventId);
+
+      if (error) {
+        throw new Error(error.message);
+      }
+    },
+    markFailed: async (eventId, failureReason) => {
+      const { error } = await supabase.rpc("webhook_mark_failed_rpc", {
+        p_event_id: eventId,
+        p_failure_reason: failureReason,
+        p_base_interval_minutes: null,
+      });
+
+      if (error) {
+        throw new Error(error.message);
+      }
+    },
+    markValidating: async (eventId) => {
+      const { error } = await supabase
+        .from("payment_webhook_events")
+        .update({ state: "VALIDATING" })
+        .eq("id", eventId);
+
+      if (error) {
+        throw new Error(error.message);
+      }
+    },
+    markProcessed: async (eventId) => {
+      const { error } = await supabase
+        .from("payment_webhook_events")
+        .update({
+          state: "PROCESSED",
+          processed_at: new Date().toISOString(),
+        })
+        .eq("id", eventId);
+
+      if (error) {
+        throw new Error(error.message);
+      }
+    },
+    markProcessing: async (eventId) => {
+      const { error } = await supabase
+        .from("payment_webhook_events")
+        .update({ state: "PROCESSING" })
+        .eq("id", eventId);
+
+      if (error) {
+        throw new Error(error.message);
+      }
+    },
+    enqueueHeavyProcessing: async ({ eventId, eventType }) => {
+      const { error } = await supabase
+        .from("payment_webhook_processing_queue")
+        .insert({
+          webhook_event_id: eventId,
+          gateway_slug: "netcred",
+          event_type: eventType,
+          state: "PENDING",
+        });
+
+      if (error) {
+        throw new Error(error.message);
+      }
+    },
+    emitInvalidSignatureWarning: (extra) => {
+      logger.warn("webhook_signature_invalid", extra);
+    },
+    checkIPRateLimit,
+    emitIPRateLimitWarning,
+  };
+}
+
+servePaymentFunction("netcred-webhook", (req) =>
+  handleNetcredWebhookRequest(req, createDeps()));
