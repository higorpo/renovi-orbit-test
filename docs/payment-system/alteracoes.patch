--- /dev/null
+++ b/supabase/migrations/20260705208600_rpc_reschedule_charge_date.sql
@@ -0,0 +1,83 @@
+-- Payment System — Phase 3 task 23: reschedule_charge_date integration RPC (design §4.x).
+-- Requirements: 9, 33. Acceptance: 9A.3, 9A.4, 33A.5.
+
+create or replace function public.reschedule_charge_date(
+  p_service_id uuid,
+  p_new_service_scheduled_at timestamptz
+)
+returns void
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_ps public.payment_schedules%rowtype;
+  v_new_charge_at timestamptz;
+  v_emergency boolean;
+begin
+  select *
+  into v_ps
+  from public.payment_schedules ps
+  where ps.contracted_service_id = p_service_id
+  for update;
+
+  if not found then
+    return;
+  end if;
+
+  if v_ps.state = 'PAID' then
+    update public.contracted_services cs
+    set
+      service_scheduled_at = p_new_service_scheduled_at,
+      scheduled_start_date = p_new_service_scheduled_at::date
+    where cs.id = p_service_id;
+
+    return;
+  end if;
+
+  if v_ps.state not in ('SCHEDULED', 'FAILED', 'IN_ANALYSIS') then
+    return;
+  end if;
+
+  v_new_charge_at := greatest(now(), p_new_service_scheduled_at - interval '2 days');
+  v_emergency := (p_new_service_scheduled_at - now() < interval '48 hours');
+
+  update public.payment_schedules ps
+  set
+    charge_scheduled_at = v_new_charge_at,
+    upcoming_charge_notified_at = null,
+    updated_at = now()
+  where ps.id = v_ps.id;
+
+  insert into public.payment_audit_log (
+    event_type,
+    entity_type,
+    entity_id,
+    service_id,
+    schedule_id,
+    actor,
+    metadata
+  )
+  values (
+    'CHARGE_RESCHEDULED',
+    'payment_schedule',
+    v_ps.id,
+    p_service_id,
+    v_ps.id,
+    'system',
+    jsonb_build_object(
+      'old_charge_scheduled_at', v_ps.charge_scheduled_at,
+      'new_charge_scheduled_at', v_new_charge_at,
+      'emergency_scheduling', v_emergency
+    )
+  );
+end;
+$$;
+
+comment on function public.reschedule_charge_date(uuid, timestamptz) is
+  'Rescheduling integration: recalculates charge_scheduled_at for unpaid schedules; PAID updates service date only.';
+
+revoke all on function public.reschedule_charge_date(uuid, timestamptz) from public;
+revoke all on function public.reschedule_charge_date(uuid, timestamptz) from anon;
+revoke all on function public.reschedule_charge_date(uuid, timestamptz) from authenticated;
+grant execute on function public.reschedule_charge_date(uuid, timestamptz) to service_role;
