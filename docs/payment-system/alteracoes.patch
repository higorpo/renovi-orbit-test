@@ -0,0 +1,53 @@
+import type { InstallmentHmacPayload } from "../calculate-installment-options/types.ts";
+
+export type AcceptProposalBody = {
+  proposal_id?: string;
+  provider_id?: string;
+  service_id?: string;
+  installment_number?: number;
+  installment_selection_hmac?: string;
+  payment_token_id?: string;
+  clearsale_session_id?: string;
+  scheduled_date?: string;
+  base_amount?: number;
+  card_brand?: string;
+  installment_options?: InstallmentHmacPayload["installment_options"];
+  computed_at?: string;
+  expires_at?: string;
+  idempotency_key?: string;
+};
+
+export type AcceptProposalSuccess = {
+  contracted_service_id: string;
+  schedule_id?: string;
+  is_idempotent?: boolean;
+};
+
+export type AcceptProposalErrorCode =
+  | "INSTALLMENT_SIGNATURE_EXPIRED"
+  | "INVALID_INSTALLMENT_SIGNATURE"
+  | "PROPOSAL_PRICING_INVALID"
+  | "PAYMENT_TOKEN_INACTIVE"
+  | "PROVIDER_NOT_CREDENTIALED"
