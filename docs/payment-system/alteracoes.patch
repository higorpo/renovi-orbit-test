diff --git a/supabase/tests/payment/orphan_recovery_correctness_test.sql b/supabase/tests/payment/orphan_recovery_correctness_test.sql
new file mode 100644
index 0000000..89e40aa
--- /dev/null
+++ b/supabase/tests/payment/orphan_recovery_correctness_test.sql
@@ -0,0 +1,159 @@
+-- pgTAP: orphan recovery edge cases — lease TTL, active lease skip, late commit (task 64).
+
+begin;
+
+select plan(6);
+
+select is(
+  public.platform_constant_int('payment_lease_duration_minutes', 10),
+  10,
+  'lease TTL reads 10 minutes from platform_constants'
+);
+
+select is(
+  public.platform_constant_int('reconciliation_poll_interval_minutes', 30),
+  30,
+  'janitor/reconcile poll interval is 30 minutes'
+);
+
+do $seed$
+declare
+  v_cs_id uuid := gen_random_uuid();
+  v_active uuid := gen_random_uuid();
+  v_late uuid := gen_random_uuid();
+begin
+  insert into public.contracted_services (
+    id,
+    service_request_id,
+    accepted_proposal_id,
+    client_id,
+    provider_id,
+    duration_unit,
+    duration_value,
+    scheduled_start_date,
+    scheduled_shift,
+    agreed_slot,
+    status
+  )
+  select
+    v_cs_id,
+    sr.id,
+    gen_random_uuid(),
+    sr.client_id,
+    '00000000-0000-0000-0000-000000000002'::uuid,
+    'hours',
+    2,
+    current_date + 1,
+    'morning',
+    '{"start_date":"2099-01-01","shift":"morning"}'::jsonb,
+    'PENDING_PAYMENT'::public.contracted_service_status
+  from public.service_requests sr
+  limit 1;
+
+  insert into public.payment_schedules (
+    id,
+    contracted_service_id,
+    client_id,
+    provider_id,
+    gateway_slug,
+    installment_number,
+    base_amount,
+    charge_scheduled_at,
+    state,
+    automatic_attempt_count,
+    locked_until,
+    idempotency_key
+  )
+  values
+    (
+      v_active,
+      v_cs_id,
+      (select client_id from public.contracted_services where id = v_cs_id),
+      (select provider_id from public.contracted_services where id = v_cs_id),
+      'netcred',
+      1,
+      100.00,
+      now() + interval '2 days',
+      'PROCESSING',
+      1,
+      now() + interval '10 minutes',
+      v_active::text
+    ),
+    (
+      v_late,
+      v_cs_id,
+      (select client_id from public.contracted_services where id = v_cs_id),
+      (select provider_id from public.contracted_services where id = v_cs_id),
+      'netcred',
+      1,
+      100.00,
+      now() + interval '2 days',
+      'PROCESSING',
+      0,
+      now() - interval '1 minute',
+      v_late::text
+    );
+
+  perform set_config('test.orphan_active_id', v_active::text, true);
+  perform set_config('test.orphan_late_id', v_late::text, true);
+end;
+$seed$;
+
+select is(
+  (select r.recovered_count from public.recover_orphaned_payment_schedules() r),
+  1,
+  'janitor skips active lease and recovers only expired orphan'
+);
+
+select is(
+  (
+    select ps.state
+    from public.payment_schedules ps
+    where ps.id = current_setting('test.orphan_active_id')::uuid
+  ),
+  'PROCESSING',
+  'active lease row remains PROCESSING'
+);
+
+select is(
+  (
+    select ps.state
+    from public.payment_schedules ps
+    where ps.id = current_setting('test.orphan_late_id')::uuid
+  ),
+  'SCHEDULED',
+  'expired orphan with attempt_count=0 recovers to SCHEDULED'
+);
+
+select throws_ok(
+  $$
+    select public.cron_charge_commit_result_rpc(
+      current_setting('test.orphan_late_id')::uuid,
+      'PAID',
+      100.00,
+      '417417',
+      'tx-late',
+      null,
+      null,
+      120,
+      '{}'::jsonb,
+      false
+    )
+  $$,
+  'P0001',
+  'late PAID commit rejected after janitor recovery'
+);
+
+select ok(
+  (
+    select pg_get_functiondef(p.oid) ~* 'state = ''PROCESSING'''
+    from pg_proc p
+    join pg_namespace n on n.oid = p.pronamespace
+    where n.nspname = 'public'
+      and p.proname = 'cron_charge_commit_result_rpc'
+  ),
+  'cron_charge_commit_result_rpc UPDATE guards include PROCESSING state'
+);
+
+select * from finish();
+rollback;
diff --git a/supabase/tests/payment/pci_schema_compliance_test.sql b/supabase/tests/payment/pci_schema_compliance_test.sql
new file mode 100644
index 0000000..a8f2b90
--- /dev/null
+++ b/supabase/tests/payment/pci_schema_compliance_test.sql
@@ -0,0 +1,65 @@
+-- pgTAP: PCI DSS schema compliance — no PAN/CVV columns on payment tables (task 68).
+
+begin;
+
+select plan(4);
+
+select is(
+  (
+    select count(*)::int
+    from information_schema.columns c
+    where c.table_schema = 'public'
+      and c.table_name in (
+        'payment_tokens',
+        'payment_schedules',
+        'payment_attempts',
+        'payment_webhook_events',
+        'payment_audit_log',
+        'payment_events',
+        'payment_webhook_processing_queue',
+        'payment_providers',
+        'payment_gateway_tokens',
+        'provider_accounts',
+        'provider_kyc_submissions'
+      )
+      and lower(c.column_name) in ('pan', 'cvv', 'cvc', 'security_code', 'card_number')
+  ),
+  0,
+  'payment tables have no forbidden PAN/CVV column names'
+);
+
+select ok(
+  exists (
+    select 1
+    from information_schema.columns
+    where table_schema = 'public'
+      and table_name = 'payment_tokens'
+      and column_name = 'gateway_card_token'
+  ),
+  'payment_tokens stores gateway-issued gateway_card_token reference'
+);
+
+select ok(
+  exists (
+    select 1
+    from information_schema.columns
+    where table_schema = 'public'
+      and table_name = 'payment_tokens'
+      and column_name = 'card_number_masked'
+  ),
+  'payment_tokens stores masked PAN only (card_number_masked)'
+);
+
+select ok(
+  not exists (
+    select 1
+    from information_schema.columns
+    where table_schema = 'public'
+      and table_name = 'payment_tokens'
+      and lower(column_name) like '%full%pan%'
+  ),
+  'payment_tokens has no full PAN column variants'
+);
+
+select * from finish();
+rollback;
