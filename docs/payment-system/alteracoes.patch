+++ b/supabase/functions/dispatch-kyc-email/index.ts
@@ -0,0 +1,100 @@
+import "xhr";
+import { servePaymentFunction } from "../_shared/observability/sentry.ts";
+import type { Json } from "../_shared/database.types.ts";
+import { checkRateLimit } from "../_shared/rateLimiter.ts";
+import { createServiceRoleClient } from "../_shared/serviceRoleClient.ts";
+import { sendResendEmail } from "../message-dispatcher-worker/resend.ts";
+import {
+  handleDispatchKycEmailRequest,
+  type DispatchKycEmailDeps,
+} from "./handleRequest.ts";
+import type { KycSubmissionInput, SubmitKycErrorCode } from "./types.ts";
+
+const DEFAULT_CREDENCIAMENTO_EMAIL = "credenciamento@renovi.com.br";
+
+function mapRpcError(message: string): SubmitKycErrorCode | null {
+  if (message.includes("PROVIDER_ACCOUNT_NOT_FOUND")) {
+    return "PROVIDER_ACCOUNT_NOT_FOUND";
+  }
+  if (message.includes("INVALID_ONBOARDING_STATE")) {
+    return "INVALID_ONBOARDING_STATE";
+  }
+  return null;
+}
+
+function createDeps(): DispatchKycEmailDeps {
+  const supabase = createServiceRoleClient();
+
+  return {
+    getUser: async (token) => {
+      const { data: { user }, error } = await supabase.auth.getUser(token);
+      return { user, error: error ?? null };
+    },
+    submitKyc: async (providerId, input) => {
+      const { data, error } = await supabase.rpc("submit_provider_kyc_rpc", {
+        p_provider_id: providerId,
+        p_entity_type: input.entity_type,
+        p_full_name: input.full_name,
+        p_document: input.document,
+        p_phone: input.phone,
+        p_email: input.email,
+        p_bank_institution_code: input.bank_institution_code,
+        p_bank_branch: input.bank_branch,
+        p_bank_account: input.bank_account,
+        p_pix_key: input.pix_key ?? null,
+        p_razao_social: input.razao_social ?? null,
+        p_nome_fantasia: input.nome_fantasia ?? null,
+        p_legal_rep_full_name: input.legal_rep_full_name ?? null,
+        p_legal_rep_cpf: input.legal_rep_cpf ?? null,
+        p_legal_rep_phone: input.legal_rep_phone ?? null,
+        p_identity_doc_url: input.identity_doc_url,
+        p_address_proof_url: input.address_proof_url,
+        p_corporate_charter_url: input.corporate_charter_url ?? null,
+        p_legal_rep_doc_url: input.legal_rep_doc_url ?? null,
+      });
+
+      if (error) {
+        return mapRpcError(error.message) ?? "INVALID_ONBOARDING_STATE";
+      }
+
+      return { submissionId: String(data) };
+    },
+    sendKycEmail: (input) =>
+      sendResendEmail({
+        recipientEmail: input.recipientEmail,
+        subject: input.subject,
+        html: input.html,
+        correlationId: input.correlationId,
+      }),
+    markEmailDispatched: async (providerId) => {
+      await supabase.rpc("mark_kyc_email_dispatched_rpc", {
+        p_provider_id: providerId,
+      });
+    },
+    enqueueEmailRetry: async (input) => {
+      await supabase.schema("message_dispatcher").rpc("message_dispatcher_ingest", {
+        p_idempotency_key: `kyc-email-retry:${input.submissionId}`,
+        p_profile_id: input.providerId,
+        p_channel: "EMAIL",
+        p_template_key: "payment_kyc_credenciamento",
+        p_template_variables: {
+          submissionId: input.submissionId,
+          subject: input.subject,
+          html: input.html,
+          recipientEmail: Deno.env.get("KYC_CREDENCIAMENTO_EMAIL")
+            ?? DEFAULT_CREDENCIAMENTO_EMAIL,
+        } as Json,
+        p_scheduled_for: null,
+        p_source_system: "payments",
+        p_metadata: { kind: "kyc_credenciamento_retry" } as Json,
+        p_bypass_limits: true,
+      });
+    },
+    getCredenciamentoEmail: () =>
+      Deno.env.get("KYC_CREDENCIAMENTO_EMAIL")?.trim() ?? DEFAULT_CREDENCIAMENTO_EMAIL,
+    checkRateLimit,
+  };
+}
+
+servePaymentFunction("dispatch-kyc-email", (req) =>
+  handleDispatchKycEmailRequest(req, createDeps()));
