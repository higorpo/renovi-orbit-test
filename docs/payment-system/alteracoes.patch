diff --git a/src/features/payments/__tests__/concurrency.test.ts b/src/features/payments/__tests__/concurrency.test.ts
new file mode 100644
index 0000000..0967c01
--- /dev/null
+++ b/src/features/payments/__tests__/concurrency.test.ts
@@ -0,0 +1,98 @@
+import { describe, expect, it } from "vitest";
+import { PaymentConcurrencyHarness, runParallel } from "./concurrencyHarness";
+
+describe("payment concurrency harness", () => {
+  it("23A.1: parallel cron dequeues claim the same schedule at most once", async () => {
+    const harness = new PaymentConcurrencyHarness();
+    harness.seedEligibleSchedule("schedule-1");
+
+    const clientA = harness.createClient("cron-a");
+    const clientB = harness.createClient("cron-b");
+
+    const [firstWave, secondWave] = await runParallel([
+      () => clientA.rpc("cron_charge_dequeue_rpc", { p_batch_size: 1 }),
+      () => clientB.rpc("cron_charge_dequeue_rpc", { p_batch_size: 1 }),
+    ]);
+
+    const claimedIds = [
+      ...(firstWave.data as Array<{ id: string }> ?? []),
+      ...(secondWave.data as Array<{ id: string }> ?? []),
+    ].map((row) => row.id);
+
+    expect(claimedIds).toEqual(["schedule-1"]);
+    expect(harness.getSchedule("schedule-1").state).toBe("PROCESSING");
+  });
+
+  it("23A.2: manual charge returns PAYMENT_ALREADY_IN_PROGRESS while cron holds lease", async () => {
+    const harness = new PaymentConcurrencyHarness();
+    harness.seedEligibleSchedule("schedule-1");
+    harness.holdCronLease("schedule-1");
+
+    const client = harness.createClient("manual-client");
+    const result = await client.rpc("manual_charge_acquire_lease_rpc", {
+      p_schedule_id: "schedule-1",
+    });
+
+    expect(result.error?.message).toBe("PAYMENT_ALREADY_IN_PROGRESS");
+    expect(result.data).toBeNull();
+  });
+
+  it("23A.3: janitor recovers expired lease and cron re-processes schedule", async () => {
+    const harness = new PaymentConcurrencyHarness();
+    harness.seedEligibleSchedule("schedule-1");
+    harness.holdCronLease("schedule-1");
+    harness.expireLease("schedule-1");
+
+    const janitor = harness.createClient("janitor");
+    const cron = harness.createClient("cron");
+
+    const recovery = await janitor.rpc("recover_orphaned_payment_schedules");
+    expect(recovery.data).toBe(1);
+    expect(harness.getSchedule("schedule-1").state).toBe("SCHEDULED");
+
+    const dequeue = await cron.rpc("cron_charge_dequeue_rpc", { p_batch_size: 1 });
+    expect((dequeue.data as Array<{ id: string }>).map((row) => row.id)).toEqual([
+      "schedule-1",
+    ]);
+    expect(harness.getSchedule("schedule-1").state).toBe("PROCESSING");
+  });
+
+  it("23A.4: concurrent accept_proposal with same idempotency key returns existing IDs", async () => {
+    const harness = new PaymentConcurrencyHarness();
+    const clientA = harness.createClient("accept-a");
+    const clientB = harness.createClient("accept-b");
+    const idempotencyKey = "11111111-1111-1111-1111-111111111111";
+
+    const [first, second] = await runParallel([
+      () => clientA.rpc("accept_proposal_rpc", {
+        p_idempotency_key: idempotencyKey,
+        p_proposal_id: "proposal-1",
+      }),
+      () => clientB.rpc("accept_proposal_rpc", {
+        p_idempotency_key: idempotencyKey,
+        p_proposal_id: "proposal-1",
+      }),
+    ]);
+
+    expect(first.data).toEqual(second.data);
+    expect(first.data).toEqual({
+      contracted_service_id: "service-proposal-1",
+      payment_schedule_id: "schedule-proposal-1",
+    });
+  });
+
+  it("23A.5: concurrent token refresh issues a single tokenAuth call", async () => {
+    const harness = new PaymentConcurrencyHarness();
+    harness.markNetcredTokenStale();
+
+    const clientA = harness.createClient("gateway-a");
+    const clientB = harness.createClient("gateway-b");
+
+    await runParallel([
+      () => clientA.rpc("acquire_or_refresh_netcred_token"),
+      () => clientB.rpc("acquire_or_refresh_netcred_token"),
+    ]);
+
+    expect(harness.getTokenAuthCallCount()).toBe(1);
+  });
+});
diff --git a/src/features/payments/__tests__/concurrencyHarness.ts b/src/features/payments/__tests__/concurrencyHarness.ts
new file mode 100644
index 0000000..b797bd5
--- /dev/null
+++ b/src/features/payments/__tests__/concurrencyHarness.ts
@@ -0,0 +1,241 @@
+type RpcResult<T> = { data: T | null; error: { message: string; code?: string } | null };
+
+export type HarnessSchedule = {
+  id: string;
+  state: "SCHEDULED" | "PROCESSING" | "FAILED" | "PAID";
+  locked_until: number | null;
+  automatic_attempt_count: number;
+};
+
+export type AcceptProposalResponse = {
+  contracted_service_id: string;
+  payment_schedule_id: string;
+};
+
+type IdempotencyRecord = {
+  response: AcceptProposalResponse;
+};
+
+const LEASE_MS = 10 * 60 * 1000;
+
+export class PaymentConcurrencyHarness {
+  private schedules = new Map<string, HarnessSchedule>();
+  private dequeueLocks = new Set<string>();
+  private idempotencyRecords = new Map<string, IdempotencyRecord>();
+  private acceptProposalInFlight = new Map<string, Promise<AcceptProposalResponse>>();
+  private netcredToken = "cached-jwt";
+  private tokenAuthCalls = 0;
+  private tokenRefreshPromise: Promise<string> | null = null;
+
+  seedEligibleSchedule(id = "schedule-1"): HarnessSchedule {
+    const schedule: HarnessSchedule = {
+      id,
+      state: "SCHEDULED",
+      locked_until: null,
+      automatic_attempt_count: 0,
+    };
+    this.schedules.set(id, schedule);
+    return schedule;
+  }
+
+  holdCronLease(scheduleId: string, ttlMs = LEASE_MS): void {
+    const schedule = this.requireSchedule(scheduleId);
+    schedule.state = "PROCESSING";
+    schedule.locked_until = Date.now() + ttlMs;
+    schedule.automatic_attempt_count += 1;
+  }
+
+  expireLease(scheduleId: string): void {
+    const schedule = this.requireSchedule(scheduleId);
+    schedule.locked_until = Date.now() - 1000;
+  }
+
+  getSchedule(scheduleId: string): HarnessSchedule {
+    return this.requireSchedule(scheduleId);
+  }
+
+  getTokenAuthCallCount(): number {
+    return this.tokenAuthCalls;
+  }
+
+  createClient(clientId: string) {
+    return {
+      id: clientId,
+      rpc: async (name: string, args?: Record<string, unknown>): Promise<RpcResult<unknown>> => {
+        switch (name) {
+          case "cron_charge_dequeue_rpc":
+            return { data: this.dequeue(Number(args?.p_batch_size ?? 10)), error: null };
+          case "manual_charge_acquire_lease_rpc":
+            return this.manualAcquireLease(String(args?.p_schedule_id));
+          case "recover_orphaned_payment_schedules":
+            return { data: this.recoverOrphanedLeases(), error: null };
+          case "accept_proposal_rpc":
+            return this.acceptProposal(
+              String(args?.p_idempotency_key),
+              String(args?.p_proposal_id),
+            );
+          case "acquire_or_refresh_netcred_token":
+            return this.acquireNetcredToken(args);
+          default:
+            return { data: null, error: { message: `unexpected rpc ${name}` } };
+        }
+      },
+    };
+  }
+
+  private dequeue(batchSize: number): HarnessSchedule[] {
+    const claimed: HarnessSchedule[] = [];
+
+    for (const schedule of this.schedules.values()) {
+      if (claimed.length >= batchSize) {
+        break;
+      }
+
+      if (schedule.state !== "SCHEDULED" && schedule.state !== "FAILED") {
+        continue;
+      }
+
+      if (this.dequeueLocks.has(schedule.id)) {
+        continue;
+      }
+
+      if (schedule.locked_until !== null && schedule.locked_until > Date.now()) {
+        continue;
+      }
+
+      this.dequeueLocks.add(schedule.id);
+      try {
+        schedule.state = "PROCESSING";
+        schedule.automatic_attempt_count += 1;
+        schedule.locked_until = Date.now() + LEASE_MS;
+        claimed.push({ ...schedule });
+      } finally {
+        this.dequeueLocks.delete(schedule.id);
+      }
+    }
+
+    return claimed;
+  }
+
+  private manualAcquireLease(scheduleId: string): RpcResult<HarnessSchedule> {
+    const schedule = this.requireSchedule(scheduleId);
+
+    if (schedule.state === "PROCESSING" && schedule.locked_until !== null
+      && schedule.locked_until > Date.now()) {
+      return {
+        data: null,
+        error: { message: "PAYMENT_ALREADY_IN_PROGRESS", code: "P0001" },
+      };
+    }
+
+    schedule.state = "PROCESSING";
+    schedule.locked_until = Date.now() + LEASE_MS;
+    return { data: { ...schedule }, error: null };
+  }
+
+  private recoverOrphanedLeases(): number {
+    let recovered = 0;
+
+    for (const schedule of this.schedules.values()) {
+      if (schedule.state !== "PROCESSING") {
+        continue;
+      }
+
+      if (schedule.locked_until !== null && schedule.locked_until <= Date.now()) {
+        schedule.state = "SCHEDULED";
+        schedule.locked_until = null;
+        recovered += 1;
+      }
+    }
+
+    return recovered;
+  }
+
+  private async acceptProposal(
+    idempotencyKey: string,
+    proposalId: string,
+  ): Promise<RpcResult<AcceptProposalResponse>> {
+    const cached = this.idempotencyRecords.get(idempotencyKey);
+    if (cached) {
+      return { data: cached.response, error: null };
+    }
+
+    const inflight = this.acceptProposalInFlight.get(idempotencyKey);
+    if (inflight) {
+      const response = await inflight;
+      return { data: response, error: null };
+    }
+
+    const operation = (async () => {
+      await new Promise((resolve) => setTimeout(resolve, 15));
+      const response: AcceptProposalResponse = {
+        contracted_service_id: `service-${proposalId}`,
+        payment_schedule_id: `schedule-${proposalId}`,
+      };
+      this.idempotencyRecords.set(idempotencyKey, { response });
+      return response;
+    })();
+
+    this.acceptProposalInFlight.set(idempotencyKey, operation);
+
+    try {
+      const response = await operation;
+      return { data: response, error: null };
+    } finally {
+      this.acceptProposalInFlight.delete(idempotencyKey);
+    }
+  }
+
+  private async acquireNetcredToken(
+    args?: Record<string, unknown>,
+  ): Promise<RpcResult<{ status: string; token: string }>> {
+    if (args?.p_new_token) {
+      this.netcredToken = String(args.p_new_token);
+      return {
+        data: { status: "refreshed", token: this.netcredToken },
+        error: null,
+      };
+    }
+
+    if (this.netcredToken && this.netcredToken !== "stale") {
+      return { data: { status: "cached", token: this.netcredToken }, error: null };
+    }
+
+    if (this.tokenRefreshPromise) {
+      const token = await this.tokenRefreshPromise;
+      return { data: { status: "cached", token }, error: null };
+    }
+
+    this.tokenRefreshPromise = (async () => {
+      this.tokenAuthCalls += 1;
+      await new Promise((resolve) => setTimeout(resolve, 20));
+      this.netcredToken = "fresh-jwt";
+      return this.netcredToken;
+    })();
+
+    try {
+      const token = await this.tokenRefreshPromise;
+      return { data: { status: "needs_refresh", token }, error: null };
+    } finally {
+      this.tokenRefreshPromise = null;
+    }
+  }
+
+  markNetcredTokenStale(): void {
+    this.netcredToken = "stale";
+  }
+
+  private requireSchedule(scheduleId: string): HarnessSchedule {
+    const schedule = this.schedules.get(scheduleId);
+    if (!schedule) {
+      throw new Error(`schedule_not_found:${scheduleId}`);
+    }
+    return schedule;
+  }
+}
+
+export async function runParallel<T>(
+  tasks: Array<() => Promise<T>>,
+): Promise<T[]> {
+  return Promise.all(tasks.map((task) => task()));
+}
