+        service_id: "service-1",
+        client_id: "client-1",
+        from_state: "REFUND_REQUESTED",
+        to_state: "PARTIALLY_REFUNDED",
+        refunded_amount: input.refundedAmount,
+      };
+    },
+    ingestNotification: async () => {},
+  };
+
+  const result = await handleTransactionRefund(refundDeps, {
+    eventId: "webhook-refund-1",
+    eventType: "TRANSACTION_REFUND",
+    payload: {
+      transaction: {
+        referenceCode: "service-1",
+        refundedAmount: "50.00",
+      },
+    },
+  });
+
+  assertEquals(result, "processed");
+  assertEquals(appliedAmount, "50.00");
+});
+
+Deno.test("dispute sets is_disputed without changing schedule state", async () => {
+  const criticalEvents: Record<string, unknown>[] = [];
+
+  const disputeDeps: TransactionDisputeDeps = {
+    applyDispute: async () => ({
+      outcome: "disputed",
+      schedule_id: "schedule-1",
+      service_id: "service-1",
+      state: "PAID",
+      gateway_transaction_id: "txn-dispute-1",
+      is_disputed: true,
+    }),
+    emitCritical: (extra) => {
+      criticalEvents.push(extra);
+    },
+  };
+
+  const result = await handleTransactionDispute(disputeDeps, {
+    eventId: "webhook-dispute-1",
+    eventType: "TRANSACTION_DISPUTE",
+    payload: {
+      transaction: {
+        id: "txn-dispute-1",
+        referenceCode: "service-1",
+      },
+    },
+  });
+
+  assertEquals(result, "processed");
+  assertEquals(criticalEvents.length, 1);
+  assertEquals(criticalEvents[0]?.contracted_service_id, "service-1");
+  assertEquals(criticalEvents[0]?.schedule_state, "PAID");
+  assertEquals(criticalEvents[0]?.gateway_transaction_id, "txn-dispute-1");
+});
