@@ -0,0 +1,126 @@
+import { assertEquals } from "std/testing/asserts";
+import {
+  handleDispatchKycEmailRequest,
+  type DispatchKycEmailDeps,
+} from "../handleRequest.ts";
+
+const validCpfPayload = {
+  entity_type: "CPF",
+  full_name: "Maria Silva",
+  document: "529.982.247-25",
+  phone: "+5511999999999",
+  email: "provider@example.com",
+  bank_institution_code: "001",
+  bank_branch: "1234",
+  bank_account: "56789-0",
+  identity_doc_url: "https://storage.example.com/id.pdf",
+  address_proof_url: "https://storage.example.com/address.pdf",
+};
+
+function createDeps(overrides: Partial<DispatchKycEmailDeps> = {}): DispatchKycEmailDeps {
+  return {
+    getUser: async () => ({
+      user: { id: "provider-1", email: "provider@example.com" },
+      error: null,
+    }),
+    submitKyc: async () => ({ submissionId: "submission-1" }),
+    sendKycEmail: async () => ({
+      ok: true,
+      vendorMessageId: "email-1",
+      httpStatus: 200,
+    }),
+    markEmailDispatched: async () => {},
+    enqueueEmailRetry: async () => {},
+    getCredenciamentoEmail: () => "credenciamento@renovi.com.br",
+    checkRateLimit: async () => ({ allowed: true, retryAfter: 0 }),
+    ...overrides,
+  };
+}
+
+function authRequest(body: Record<string, unknown>): Request {
+  return new Request("https://example.com/dispatch-kyc-email", {
+    method: "POST",
+    headers: {
+      Authorization: "Bearer jwt-token",
+      "Content-Type": "application/json",
+    },
+    body: JSON.stringify(body),
+  });
+}
+
+Deno.test("invalid CPF format returns HTTP 422 before any DB call", async () => {
+  let submitCalled = false;
+
+  const response = await handleDispatchKycEmailRequest(
+    authRequest({
+      ...validCpfPayload,
+      document: "111.111.111-11",
+    }),
+    createDeps({
+      submitKyc: async () => {
+        submitCalled = true;
+        return { submissionId: "submission-1" };
+      },
+    }),
+  );
+
+  assertEquals(response.status, 422);
+  assertEquals(submitCalled, false);
+  const body = await response.json();
+  assertEquals(body.error_code, "INVALID_CPF");
+});
+
+Deno.test("TX is committed before email call", async () => {
+  const callOrder: string[] = [];
+
+  const response = await handleDispatchKycEmailRequest(
+    authRequest(validCpfPayload),
+    createDeps({
+      submitKyc: async () => {
+        callOrder.push("submit");
+        return { submissionId: "submission-1" };
+      },
+      sendKycEmail: async () => {
+        callOrder.push("email");
+        return {
+          ok: true,
+          vendorMessageId: "email-1",
+          httpStatus: 200,
+        };
+      },
+    }),
+  );
+
+  assertEquals(response.status, 200);
+  assertEquals(callOrder, ["submit", "email"]);
+});
+
+Deno.test("email failure preserves submission and enqueues retry", async () => {
+  let retryEnqueued = false;
+  let markDispatchedCalled = false;
+
+  const response = await handleDispatchKycEmailRequest(
+    authRequest(validCpfPayload),
+    createDeps({
+      sendKycEmail: async () => ({
+        ok: false,
+        httpStatus: 503,
+        errorCode: "resend_send_failed",
+        errorMessage: "upstream unavailable",
+      }),
+      markEmailDispatched: async () => {
+        markDispatchedCalled = true;
+      },
+      enqueueEmailRetry: async () => {
+        retryEnqueued = true;
+      },
+    }),
+  );
+
+  assertEquals(response.status, 200);
+  assertEquals(retryEnqueued, true);
+  assertEquals(markDispatchedCalled, false);
+  const body = await response.json();
+  assertEquals(body.email_pending, true);
+  assertEquals(body.submission_id, "submission-1");
+});
