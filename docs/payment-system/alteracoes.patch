+import { assertEquals } from "std/testing/asserts";
+import {
+  computeHMACSHA256,
+  serializeInstallmentHmacPayload,
+} from "../hmac.ts";
+import type { InstallmentHmacPayload } from "../types.ts";
+
+const samplePayload: InstallmentHmacPayload = {
+  proposal_id: "11111111-1111-1111-1111-111111111111",
+  service_id: "22222222-2222-2222-2222-222222222222",
+  base_amount: 1000,
+  card_brand: "VCC",
+  installment_options: [{
+    installment_number: 1,
+    applicable_rate_pct: 2.39,
+    total_with_fees: 1024.29,
+    installment_amount: 1024.29,
+  }],
+  computed_at: "2026-06-24T12:00:00.000Z",
+  expires_at: "2026-06-24T12:10:00.000Z",
+};
+
+Deno.test("computeHMACSHA256 produces deterministic hex output", async () => {
+  const message = serializeInstallmentHmacPayload(samplePayload);
+  const first = await computeHMACSHA256("test-installment-secret", message);
+  const second = await computeHMACSHA256("test-installment-secret", message);
+
+  assertEquals(first, second);
+  assertEquals(first.length, 64);
+  assertEquals(/^[0-9a-f]{64}$/.test(first), true);
+});
+
+Deno.test("computeHMACSHA256 changes when payload changes", async () => {
+  const baseMessage = serializeInstallmentHmacPayload(samplePayload);
+  const tamperedMessage = serializeInstallmentHmacPayload({
+    ...samplePayload,
+    base_amount: 1001,
+  });
+
+  const baseHmac = await computeHMACSHA256("test-installment-secret", baseMessage);
+  const tamperedHmac = await computeHMACSHA256("test-installment-secret", tamperedMessage);
+
+  assertEquals(baseHmac === tamperedHmac, false);
+});
