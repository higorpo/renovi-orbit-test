+-- Payment System — task 38: provider onboarding activation RPCs (design §4.1.2).
+
+create or replace function public.activate_provider_account_rpc(
+  p_provider_account_id uuid,
+  p_netcred_company_id text,
+  p_netcred_bank_account_id text
+)
+returns uuid
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_account public.provider_accounts%rowtype;
+begin
+  select pa.*
+  into v_account
+  from public.provider_accounts pa
+  where pa.id = p_provider_account_id
+  for update;
+
+  if not found then
+    raise exception 'PROVIDER_ACCOUNT_NOT_FOUND' using errcode = 'P0001';
+  end if;
+
+  if v_account.onboarding_status not in ('DOCUMENTS_SUBMITTED', 'UNDER_NETCRED_REVIEW') then
+    raise exception 'INVALID_ONBOARDING_STATE' using errcode = 'P0001';
+  end if;
+
+  update public.provider_accounts pa
+  set
+    onboarding_status = 'ACTIVE',
+    netcred_company_id = p_netcred_company_id,
+    netcred_bank_account_id = p_netcred_bank_account_id,
+    onboarding_activated_at = now(),
+    updated_at = now()
+  where pa.id = p_provider_account_id;
+
+  insert into public.payment_audit_log (
+    event_type,
+    entity_type,
+    entity_id,
+    actor,
+    actor_id,
+    metadata
+  )
+  values (
+    'PROVIDER_ACTIVATED',
+    'provider_account',
+    p_provider_account_id,
+    'cron',
+    v_account.provider_id,
+    jsonb_build_object(
+      'netcred_company_id', p_netcred_company_id,
+      'netcred_bank_account_id', p_netcred_bank_account_id
+    )
+  );
+
+  insert into public.payment_events (
+    event_type,
+    aggregate_type,
+    aggregate_id,
+    payload
+  )
+  values (
+    'ProviderCredentialed',
+    'provider_account',
+    p_provider_account_id,
+    jsonb_build_object(
+      'provider_id', v_account.provider_id,
+      'netcred_company_id', p_netcred_company_id
+    )
+  );
+
+  return p_provider_account_id;
+end;
+$$;
+
+create or replace function public.mark_provider_under_netcred_review_rpc(
+  p_provider_account_id uuid
+)
+returns uuid
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_account public.provider_accounts%rowtype;
+begin
+  select pa.*
+  into v_account
+  from public.provider_accounts pa
+  where pa.id = p_provider_account_id
+  for update;
+
+  if not found then
+    raise exception 'PROVIDER_ACCOUNT_NOT_FOUND' using errcode = 'P0001';
+  end if;
+
+  if v_account.onboarding_status = 'ACTIVE' then
+    return p_provider_account_id;
+  end if;
+
+  update public.provider_accounts pa
+  set
+    onboarding_status = 'UNDER_NETCRED_REVIEW',
+    updated_at = now()
+  where pa.id = p_provider_account_id;
+
+  return p_provider_account_id;
+end;
+$$;
