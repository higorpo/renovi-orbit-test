+Deno.test("resolveRateKey covers all 6 brand x 3 range combinations", () => {
+  for (const brand of BRANDS) {
+    for (const installmentNumber of [1, 3, 10]) {
+      assertEquals(
+        resolveRateKey(brand, installmentNumber),
+        EXPECTED_RATE_KEYS[brand][installmentNumber],
+      );
+    }
+  }
