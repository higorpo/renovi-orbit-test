+import { assertEquals } from "std/testing/asserts";
+import {
+  PAYMENT_PLATFORM_CONSTANT_DEFAULTS,
+  resolvePaymentPlatformConstants,
+} from "../../_shared/payment/constants.ts";
+import type { PaymentPlatformConstants } from "../types.ts";
+
+const INSTALLMENT_CONSTANT_KEYS: Array<keyof PaymentPlatformConstants> = [
+  "cc_visa_master_1x_rate",
+  "cc_visa_master_2_6x_rate",
+  "cc_visa_master_7_12x_rate",
+  "cc_elo_other_1x_rate",
+  "cc_elo_other_2_6x_rate",
+  "cc_elo_other_7_12x_rate",
+  "cc_fixed_processing_fee_brl",
+  "installment_hmac_expires_minutes",
+];
+
+function pickInstallmentConstants(
+  constants: typeof PAYMENT_PLATFORM_CONSTANT_DEFAULTS,
+): PaymentPlatformConstants {
+  return {
+    cc_visa_master_1x_rate: constants.cc_visa_master_1x_rate,
+    cc_visa_master_2_6x_rate: constants.cc_visa_master_2_6x_rate,
+    cc_visa_master_7_12x_rate: constants.cc_visa_master_7_12x_rate,
+    cc_elo_other_1x_rate: constants.cc_elo_other_1x_rate,
+    cc_elo_other_2_6x_rate: constants.cc_elo_other_2_6x_rate,
+    cc_elo_other_7_12x_rate: constants.cc_elo_other_7_12x_rate,
+    cc_fixed_processing_fee_brl: constants.cc_fixed_processing_fee_brl,
+    installment_hmac_expires_minutes: constants.installment_hmac_expires_minutes,
+  };
+}
+
+Deno.test("resolvePaymentPlatformConstants uses defaults when installment keys are missing", () => {
+  const warnings: Array<{ event: string; context?: Record<string, unknown> }> = [];
+
+  const resolved = pickInstallmentConstants(
+    resolvePaymentPlatformConstants([], (event, context) => {
+      warnings.push({ event, context });
+    }),
+  );
+
+  assertEquals(resolved, pickInstallmentConstants(PAYMENT_PLATFORM_CONSTANT_DEFAULTS));
+  assertEquals(
+    warnings.filter((entry) =>
+      INSTALLMENT_CONSTANT_KEYS.includes(entry.context?.key as keyof PaymentPlatformConstants)
+    ).length,
+    8,
+  );
+  assertEquals(warnings.every((entry) => entry.event === "platform_constant_missing"), true);
+});
+
+Deno.test("resolvePaymentPlatformConstants overrides present keys and warns on invalid values", () => {
+  const warnings: string[] = [];
+
+  const resolved = pickInstallmentConstants(
+    resolvePaymentPlatformConstants([
+      { key: "cc_visa_master_1x_rate", value: 1.99 },
+      { key: "cc_fixed_processing_fee_brl", value: "not-a-number" },
+    ], (event, context) => {
+      warnings.push(`${event}:${String(context?.key)}`);
+    }),
+  );
+
+  assertEquals(resolved.cc_visa_master_1x_rate, 1.99);
+  assertEquals(resolved.cc_fixed_processing_fee_brl, 0.39);
+  assertEquals(
+    warnings.includes("platform_constant_missing:cc_fixed_processing_fee_brl"),
+    true,
+  );
+});
