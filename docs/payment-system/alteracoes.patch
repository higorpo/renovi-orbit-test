+import { useMutation } from "@tanstack/react-query";
+import {
+  acceptProposalPayment,
+  type AcceptProposalPaymentRequest,
+  type AcceptProposalPaymentSuccess,
+} from "../api/acceptProposalPayment.api";
+
+export function useAcceptProposalPayment() {
+  return useMutation<AcceptProposalPaymentSuccess, Error, AcceptProposalPaymentRequest>({
+    mutationFn: async (request) => {
+      const result = await acceptProposalPayment(request);
