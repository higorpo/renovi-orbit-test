+-- pgTAP: calculate_charge_amount fee formula and constant fallbacks (task 17).
+
+begin;
+
+select plan(6);
+
+select ok(
+  (
+    select p.prosecdef
+    from pg_proc p
+    join pg_namespace n on n.oid = p.pronamespace
+    where n.nspname = 'public'
+      and p.proname = 'calculate_charge_amount'
+  ),
+  'calculate_charge_amount is SECURITY DEFINER'
+);
+
+select ok(
+  has_function_privilege(
+    'service_role',
+    'public.calculate_charge_amount(uuid, numeric, smallint)',
+    'EXECUTE'
+  )
+  and not has_function_privilege(
+    'authenticated',
+    'public.calculate_charge_amount(uuid, numeric, smallint)',
+    'EXECUTE'
+  ),
+  'service_role only may execute calculate_charge_amount'
+);
+
+do $seed$
+declare
+  v_client_id uuid := gen_random_uuid();
+  v_provider_id uuid;
+  v_token_vcc uuid := gen_random_uuid();
+  v_token_elo uuid := gen_random_uuid();
+begin
+  insert into auth.users (
+    instance_id,
+    id,
+    aud,
+    role,
+    email,
+    encrypted_password,
+    email_confirmed_at,
+    raw_app_meta_data,
+    raw_user_meta_data,
+    created_at,
+    updated_at,
+    confirmation_token,
+    email_change,
+    email_change_token_new,
+    recovery_token
+  )
+  values (
+    '00000000-0000-0000-0000-000000000000',
+    v_client_id,
+    'authenticated',
+    'authenticated',
+    v_client_id::text || '@payment-calc-charge-test.local',
+    crypt('Abc123', gen_salt('bf')),
+    now(),
+    '{"provider":"email","providers":["email"]}'::jsonb,
+    json_build_object('full_name', 'Payment calc test client', 'role', 'client')::jsonb,
+    now(),
+    now(),
+    '',
+    '',
+    '',
+    ''
+  );
+
+  insert into public.profiles (id, role, full_name)
+  values (v_client_id, 'client', 'Payment calc test client')
+  on conflict (id) do update
+    set role = excluded.role,
+        full_name = excluded.full_name;
+
+  select pp.id
+  into v_provider_id
+  from public.payment_providers pp
+  where pp.slug = 'netcred'
+  limit 1;
+
+  insert into public.payment_tokens (
+    id,
+    client_id,
+    provider_id,
+    gateway_payment_profile_id,
+    card_number_masked,
+    card_brand,
+    gateway_card_token,
+    expiry_month,
+    expiry_year,
+    cardholder_name,
+    billing_address
+  )
+  values
+    (
+      v_token_vcc,
+      v_client_id,
+      v_provider_id,
+      'profile-vcc-test',
+      '497010XXXXXX0048',
+      'VCC',
+      'tok_vcc',
+      12,
+      2030,
+      'Test Client',
+      '{"street":"Rua A","number":"1","district":"Centro","city":"SP","state":"SP","zipCode":"01001000"}'::jsonb
+    ),
+    (
+      v_token_elo,
+      v_client_id,
+      v_provider_id,
+      'profile-elo-test',
+      '636297XXXXXX0048',
+      'ELO',
+      'tok_elo',
+      12,
+      2030,
+      'Test Client',
+      '{"street":"Rua A","number":"1","district":"Centro","city":"SP","state":"SP","zipCode":"01001000"}'::jsonb
+    );
+
+  perform set_config('test.payment_token_vcc', v_token_vcc::text, true);
+  perform set_config('test.payment_token_elo', v_token_elo::text, true);
+end;
+$seed$;
+
+-- VCC 1x: (1000 * 1.0239) + 0.39 = 1024.29
+select is(
+  public.calculate_charge_amount(
+    current_setting('test.payment_token_vcc')::uuid,
+    1000.00,
+    1::smallint
+  ),
+  1024.29::numeric(12, 2),
+  'VCC 1x uses cc_visa_master_1x_rate'
+);
+
+-- ELO 6x: total (1000 * 1.0289) + 0.39 = 1029.29; per installment 171.55
+select is(
+  public.calculate_charge_amount(
+    current_setting('test.payment_token_elo')::uuid,
+    1000.00,
+    6::smallint
+  ),
+  171.55::numeric(12, 2),
+  'ELO 6x uses cc_elo_other_2_6x_rate'
+);
+
+select throws_ok(
+  $$select public.calculate_charge_amount(gen_random_uuid(), 100.00, 1::smallint)$$,
+  'P0001',
+  'TOKEN_NOT_FOUND',
+  'missing token raises TOKEN_NOT_FOUND'
+);
+
+-- Fallback when platform constant key is absent
+delete from public.platform_constants
+where key = 'cc_visa_master_1x_rate';
+
+select is(
+  public.calculate_charge_amount(
+    current_setting('test.payment_token_vcc')::uuid,
+    1000.00,
+    1::smallint
+  ),
+  1026.89::numeric(12, 2),
+  'missing cc_visa_master_1x_rate falls back to default 2.69%'
+);
+
+select * from finish();
+rollback;
