@@ -0,0 +1,48 @@
+import {
+  computeHMACSHA256,
+} from "../calculate-installment-options/hmac.ts";
+import { timingSafeEqualStrings } from "./timingSafeEqual.ts";
+
+function roundFixed(value: number, decimals: number): string {
+  return value.toFixed(decimals);
+}
+
+export function buildPricingSignatureMessage(input: {
+  proposed_amount: number;
+  tax_rate: number;
+  tax_amount: number;
+  final_amount: number;
+}): string {
+  return [
+    roundFixed(input.proposed_amount, 2),
+    roundFixed(input.tax_rate, 4),
+    roundFixed(input.tax_amount, 2),
+    roundFixed(input.final_amount, 2),
+  ].join("|");
+}
+
+export async function computePricingSignature(
+  secret: string,
+  input: {
+    proposed_amount: number;
+    tax_rate: number;
+    tax_amount: number;
+    final_amount: number;
+  },
+): Promise<string> {
+  return computeHMACSHA256(secret, buildPricingSignatureMessage(input));
+}
+
+export async function validatePricingSignature(
+  secret: string,
+  proposal: {
+    proposed_amount: number;
+    tax_rate: number;
+    tax_amount: number;
+    final_amount: number;
+    pricing_signature: string;
+  },
+): Promise<boolean> {
+  const expected = await computePricingSignature(secret, proposal);
+  return timingSafeEqualStrings(expected, proposal.pricing_signature);
+}
