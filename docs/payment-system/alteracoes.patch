+import { assertEquals } from "std/testing/asserts";
+import {
+  handleAutoCancelUnpaidServicesRequest,
+  type AutoCancelUnpaidServicesDeps,
+} from "../handleRequest.ts";
+
+function createDeps(
+  overrides: Partial<AutoCancelUnpaidServicesDeps> = {},
+): AutoCancelUnpaidServicesDeps {
+  return {
+    autoCancelServices: async () => [],
+    ingestNotification: async () => {},
+    emitWarning: () => {},
+    ...overrides,
+  };
+}
+
+function cronRequest(): Request {
+  return new Request("https://example.com/auto-cancel-unpaid-services", {
+    method: "POST",
+    headers: { Authorization: "Bearer test-service-role" },
+  });
+}
+
+Deno.test("cancelled services trigger client and provider notifications", async () => {
+  const ingested: string[] = [];
+  let warningsEmitted = 0;
+
+  Deno.env.set("SUPABASE_SERVICE_ROLE_KEY", "test-service-role");
+  try {
+    const response = await handleAutoCancelUnpaidServicesRequest(
+      cronRequest(),
+      createDeps({
+        autoCancelServices: async () => [{
+          service_id: "service-1",
+          schedule_id: "schedule-1",
+          client_id: "client-1",
+          provider_id: "provider-1",
+          cancellation_reason: "NON_PAYMENT",
+          last_failure_reason: "REJECTED",
+        }],
+        ingestNotification: async (input) => {
+          ingested.push(`${input.profileId}:${input.templateKey}`);
+        },
+        emitWarning: () => {
+          warningsEmitted += 1;
+        },
+      }),
+    );
+
+    assertEquals(response.status, 200);
+    const body = await response.json();
+    assertEquals(body.cancelled_count, 1);
+    assertEquals(body.notifications_enqueued, 3);
+    assertEquals(warningsEmitted, 1);
+    assertEquals(ingested.includes("client-1:service_auto_cancelled_client"), true);
+    assertEquals(ingested.includes("client-1:service_auto_cancelled_client_email"), true);
+    assertEquals(ingested.includes("provider-1:service_auto_cancelled_provider"), true);
+  } finally {
+    Deno.env.delete("SUPABASE_SERVICE_ROLE_KEY");
+  }
+});
+
+Deno.test("IN_ANALYSIS exemption yields no cancellations or notifications", async () => {
+  let ingestCalled = false;
+
+  Deno.env.set("SUPABASE_SERVICE_ROLE_KEY", "test-service-role");
+  try {
+    const response = await handleAutoCancelUnpaidServicesRequest(
+      cronRequest(),
+      createDeps({
+        autoCancelServices: async () => [],
+        ingestNotification: async () => {
+          ingestCalled = true;
+        },
+      }),
+    );
+
+    assertEquals(response.status, 200);
+    const body = await response.json();
+    assertEquals(body.cancelled_count, 0);
+    assertEquals(body.notifications_enqueued, 0);
+    assertEquals(ingestCalled, false);
+  } finally {
+    Deno.env.delete("SUPABASE_SERVICE_ROLE_KEY");
+  }
+});
diff --git a/supabase/functions/auto-cancel-unpaid-services/handleRequest.ts b/supabase/functions/auto-cancel-unpaid-services/handleRequest.ts
new file mode 100644
index 0000000..c700ee4
--- /dev/null
+++ b/supabase/functions/auto-cancel-unpaid-services/handleRequest.ts
@@ -0,0 +1,117 @@
+import { getCorsHeaders } from "../_shared/cors.ts";
+import { jsonResponse } from "../_shared/jsonResponse.ts";
+import { createPaymentLogger } from "../_shared/observability/payment-logger.ts";
+import { validateCronAuth } from "../schedule-netcred-charges/auth.ts";
+import type { AutoCancelledService, AutoCancelRunSummary } from "./types.ts";
+import type { NotificationIngestInput } from "../manual-charge-payment/enqueueNotifications.ts";
+
+const logger = createPaymentLogger("auto-cancel-unpaid-services");
+
+export type AutoCancelUnpaidServicesDeps = {
+  autoCancelServices: () => Promise<AutoCancelledService[]>;
+  ingestNotification: (input: NotificationIngestInput) => Promise<void>;
+  emitWarning: (extra: Record<string, unknown>) => void;
+};
+
+async function enqueueAutoCancelNotifications(
+  ingest: AutoCancelUnpaidServicesDeps["ingestNotification"],
+  cancelled: AutoCancelledService,
+): Promise<number> {
+  const baseKey = `auto-cancel:${cancelled.service_id}:${cancelled.schedule_id}`;
+  let count = 0;
+
+  await ingest({
+    profileId: cancelled.client_id,
+    channel: "PUSH",
+    templateKey: "service_auto_cancelled_client",
+    idempotencyKey: `${baseKey}:client-push`,
+    templateVariables: {
+      serviceId: cancelled.service_id,
+      cancellationReason: cancelled.cancellation_reason,
+    },
+    bypassLimits: true,
+  });
+  count += 1;
+
+  await ingest({
+    profileId: cancelled.client_id,
+    channel: "EMAIL",
+    templateKey: "service_auto_cancelled_client_email",
+    idempotencyKey: `${baseKey}:client-email`,
+    templateVariables: {
+      serviceId: cancelled.service_id,
+      cancellationReason: cancelled.cancellation_reason,
+    },
+    bypassLimits: true,
+  });
+  count += 1;
+
+  await ingest({
+    profileId: cancelled.provider_id,
+    channel: "PUSH",
+    templateKey: "service_auto_cancelled_provider",
+    idempotencyKey: `${baseKey}:provider-push`,
+    templateVariables: {
+      serviceId: cancelled.service_id,
+      cancellationReason: cancelled.cancellation_reason,
+    },
+    bypassLimits: true,
+  });
+  count += 1;
+
+  return count;
+}
+
+export async function handleAutoCancelUnpaidServicesRequest(
+  req: Request,
+  deps: AutoCancelUnpaidServicesDeps,
+): Promise<Response> {
+  const cors = getCorsHeaders(req);
+
+  if (req.method === "OPTIONS") {
+    return new Response(null, { status: 204, headers: cors });
+  }
+
+  if (req.method !== "POST") {
+    return jsonResponse({ error: "method_not_allowed" }, 405, cors);
+  }
+
+  const auth = validateCronAuth(req);
+  if (!auth.ok) {
+    return jsonResponse({ error: auth.code }, auth.status, cors);
+  }
+
+  const cancelledServices = await deps.autoCancelServices();
+  const summary: AutoCancelRunSummary = {
+    cancelled_count: cancelledServices.length,
+    notifications_enqueued: 0,
+    warnings_emitted: 0,
+  };
+
+  for (const cancelled of cancelledServices) {
+    deps.emitWarning({
+      service_id: cancelled.service_id,
+      schedule_id: cancelled.schedule_id,
+      last_failure_reason: cancelled.last_failure_reason,
+      cancellation_reason: cancelled.cancellation_reason,
+    });
+    summary.warnings_emitted += 1;
+
+    try {
+      summary.notifications_enqueued += await enqueueAutoCancelNotifications(
+        deps.ingestNotification,
+        cancelled,
+      );
+    } catch (error) {
+      logger.error("auto_cancel_notification_enqueue_failed", {
+        service_id: cancelled.service_id,
+        schedule_id: cancelled.schedule_id,
+        error: error instanceof Error ? error.message : String(error),
+      });
+    }
+  }
+
+  logger.info("auto_cancel_completed", summary);
+
+  return jsonResponse(summary, 200, cors);
+}
