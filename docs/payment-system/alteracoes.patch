+select is(
+  (
+    select ps.state
+    from public.payment_schedules ps
+    where ps.id = current_setting('test.orphan_scheduled_id')::uuid
+  ),
+  'SCHEDULED',
+  'attempt_count=0 orphan recovers to SCHEDULED'
+);
+
+select is(
+  (
+    select ps.state
+    from public.payment_schedules ps
+    where ps.id = current_setting('test.orphan_failed_id')::uuid
+  ),
+  'FAILED',
+  'attempt_count>0 orphan recovers to FAILED'
+);
+
+select ok(
+  (
+    select ps.next_retry_at is not null
+    from public.payment_schedules ps
+    where ps.id = current_setting('test.orphan_failed_id')::uuid
+  ),
+  'attempt_count>0 orphan sets next_retry_at'
+);
+
+select * from finish();
+rollback;
diff --git a/supabase/tests/payment/reschedule_charge_date_test.sql b/supabase/tests/payment/reschedule_charge_date_test.sql
new file mode 100644
index 0000000..a0ae7d2
--- /dev/null
+++ b/supabase/tests/payment/reschedule_charge_date_test.sql
@@ -0,0 +1,193 @@
+-- pgTAP: reschedule_charge_date RPC (task 23).
+
+begin;
+
+select plan(6);
+
+do $seed$
+declare
+  v_client_id uuid := gen_random_uuid();
+  v_provider_id uuid := gen_random_uuid();
+  v_scheduled_service_id uuid := gen_random_uuid();
+  v_paid_service_id uuid := gen_random_uuid();
+  v_scheduled_schedule_id uuid := gen_random_uuid();
+  v_paid_schedule_id uuid := gen_random_uuid();
+  v_old_charge_at timestamptz := now() + interval '5 days';
+  v_old_service_at timestamptz := now() + interval '7 days';
+  v_new_service_at timestamptz := now() + interval '14 days';
+begin
+  insert into auth.users (
+    instance_id, id, aud, role, email, encrypted_password, email_confirmed_at,
+    raw_app_meta_data, raw_user_meta_data, created_at, updated_at,
+    confirmation_token, email_change, email_change_token_new, recovery_token
+  )
+  values
+    (
+      '00000000-0000-0000-0000-000000000000', v_client_id, 'authenticated', 'authenticated',
+      v_client_id::text || '@reschedule-client.local', crypt('Abc123', gen_salt('bf')), now(),
+      '{"provider":"email"}'::jsonb, '{}'::jsonb, now(), now(), '', '', '', ''
+    ),
+    (
+      '00000000-0000-0000-0000-000000000000', v_provider_id, 'authenticated', 'authenticated',
+      v_provider_id::text || '@reschedule-provider.local', crypt('Abc123', gen_salt('bf')), now(),
+      '{"provider":"email"}'::jsonb, '{}'::jsonb, now(), now(), '', '', '', ''
+    );
+
+  insert into public.profiles (id, role, full_name)
+  values
+    (v_client_id, 'client', 'Reschedule client'),
+    (v_provider_id, 'provider', 'Reschedule provider');
+
+  insert into public.contracted_services (
+    id, service_request_id, accepted_proposal_id, client_id, provider_id,
+    duration_unit, duration_value, scheduled_start_date, scheduled_shift,
+    agreed_slot, status, service_scheduled_at
+  )
+  select
+    v_scheduled_service_id, sr.id, gen_random_uuid(), v_client_id, v_provider_id,
+    'hours', 2, v_old_service_at::date, 'morning',
+    jsonb_build_object('start_date', to_char(v_old_service_at, 'YYYY-MM-DD'), 'shift', 'morning'),
+    'PENDING_PAYMENT'::public.contracted_service_status,
+    v_old_service_at
+  from public.service_requests sr
+  limit 1;
+
+  insert into public.contracted_services (
+    id, service_request_id, accepted_proposal_id, client_id, provider_id,
+    duration_unit, duration_value, scheduled_start_date, scheduled_shift,
+    agreed_slot, status, service_scheduled_at
+  )
+  select
+    v_paid_service_id, sr.id, gen_random_uuid(), v_client_id, v_provider_id,
+    'hours', 2, v_old_service_at::date, 'morning',
+    jsonb_build_object('start_date', to_char(v_old_service_at, 'YYYY-MM-DD'), 'shift', 'morning'),
+    'CONFIRMED'::public.contracted_service_status,
+    v_old_service_at
+  from public.service_requests sr
+  offset 1
+  limit 1;
+
+  insert into public.payment_schedules (
+    id,
+    contracted_service_id,
+    client_id,
+    provider_id,
+    gateway_slug,
+    installment_number,
+    base_amount,
+    charge_scheduled_at,
+    state,
+    idempotency_key,
+    upcoming_charge_notified_at
+  )
+  values
+    (
+      v_scheduled_schedule_id,
+      v_scheduled_service_id,
+      v_client_id,
+      v_provider_id,
+      'netcred',
+      1,
+      500.00,
+      v_old_charge_at,
+      'SCHEDULED',
+      v_scheduled_service_id::text,
+      now()
+    ),
+    (
+      v_paid_schedule_id,
+      v_paid_service_id,
+      v_client_id,
+      v_provider_id,
+      'netcred',
+      1,
+      500.00,
+      v_old_charge_at,
+      'PAID',
+      v_paid_service_id::text,
+      now()
+    );
+
+  perform set_config('test.reschedule_scheduled_service', v_scheduled_service_id::text, true);
+  perform set_config('test.reschedule_paid_service', v_paid_service_id::text, true);
+  perform set_config('test.reschedule_scheduled_schedule', v_scheduled_schedule_id::text, true);
+  perform set_config('test.reschedule_new_service_at', v_new_service_at::text, true);
+  perform set_config('test.reschedule_old_charge_at', v_old_charge_at::text, true);
+end;
+$seed$;
+
+select lives_ok(
+  format(
+    $sql$
+    select public.reschedule_charge_date(
+      %L::uuid,
+      %L::timestamptz
+    );
+    $sql$,
+    current_setting('test.reschedule_scheduled_service'),
+    current_setting('test.reschedule_new_service_at')
+  ),
+  'SCHEDULED schedule reschedules without error'
+);
+
+select is(
+  (
+    select ps.charge_scheduled_at
+    from public.payment_schedules ps
+    where ps.id = current_setting('test.reschedule_scheduled_schedule')::uuid
+  ),
+  (
+    select greatest(
+      now(),
+      current_setting('test.reschedule_new_service_at')::timestamptz - interval '2 days'
+    )
+  ),
+  'SCHEDULED state updates charge_scheduled_at to MAX(now(), new_service - 2 days)'
+);
+
+select is(
+  (
+    select ps.upcoming_charge_notified_at
+    from public.payment_schedules ps
+    where ps.id = current_setting('test.reschedule_scheduled_schedule')::uuid
+  ),
+  null::timestamptz,
+  'SCHEDULED state resets upcoming_charge_notified_at'
+);
+
+select lives_ok(
+  format(
+    $sql$
+    select public.reschedule_charge_date(
+      %L::uuid,
+      %L::timestamptz
+    );
+    $sql$,
+    current_setting('test.reschedule_paid_service'),
+    current_setting('test.reschedule_new_service_at')
+  ),
+  'PAID schedule reschedules service date without error'
+);
+
+select is(
+  (
+    select cs.service_scheduled_at
+    from public.contracted_services cs
+    where cs.id = current_setting('test.reschedule_paid_service')::uuid
+  ),
+  current_setting('test.reschedule_new_service_at')::timestamptz,
+  'PAID state updates contracted_services.service_scheduled_at only'
+);
+
+select is(
+  (
+    select ps.charge_scheduled_at
+    from public.payment_schedules ps
+    where ps.contracted_service_id = current_setting('test.reschedule_paid_service')::uuid
+  ),
+  current_setting('test.reschedule_old_charge_at')::timestamptz,
+  'PAID state leaves payment_schedules.charge_scheduled_at unchanged'
+);
+
+select * from finish();
+rollback;
diff --git a/supabase/tests/payment/reset_dead_letter_event_test.sql b/supabase/tests/payment/reset_dead_letter_event_test.sql
new file mode 100644
index 0000000..a27eede
--- /dev/null
+++ b/supabase/tests/payment/reset_dead_letter_event_test.sql
@@ -0,0 +1,74 @@
+-- pgTAP: operator payment tools — dead-letter reset + audit lifecycle (task 66).
+
+begin;
+
+select plan(4);
+
+do $seed$
+declare
+  v_event_id text := 'evt-dead-letter-1';
+begin
+  insert into public.payment_webhook_events (
+    id,
+    gateway_slug,
+    event_type,
+    gateway_event_id,
+    raw_payload,
+    raw_headers,
+    state,
+    retry_count,
+    failure_reason
+  )
+  values (
+    v_event_id,
+    'netcred',
+    'TRANSACTION_CAPTURE',
+    'prov-evt-1',
+    '{"transaction":{"referenceCode":"00000000-0000-4000-8000-000000000001"}}'::jsonb,
+    '{}'::jsonb,
+    'DEAD_LETTER',
+    3,
+    'handler timeout'
+  );
+
+  perform set_config('test.dead_letter_event_id', v_event_id, true);
+end;
+$seed$;
+
+select throws_ok(
+  $$
+    select public.reset_dead_letter_event('missing-event')
+  $$,
+  'P0001',
+  'reset rejects non dead-letter event ids'
+);
+
+select ok(
+  (
+    select (public.reset_dead_letter_event(current_setting('test.dead_letter_event_id'))) is not null
+  ),
+  'reset_dead_letter_event returns payload for dead-letter row'
+);
+
+select is(
+  (
+    select e.state
+    from public.payment_webhook_events e
+    where e.id = current_setting('test.dead_letter_event_id')
+  ),
+  'RECEIVED',
+  'dead-letter event moves to RECEIVED with retry_count reset'
+);
+
+select is(
+  (
+    select e.retry_count
+    from public.payment_webhook_events e
+    where e.id = current_setting('test.dead_letter_event_id')
+  ),
+  0::smallint,
+  'retry_count reset to zero'
+);
+
+select * from finish();
+rollback;
