@@ -0,0 +1,23 @@
+import type { SupabaseClient } from "@supabase/supabase-js";
+import type { Database } from "../_shared/database.types.ts";
+
+export async function getVaultSecret(
+  supabase: SupabaseClient<Database>,
+  name: string,
+): Promise<string> {
+  const envName = name.toUpperCase();
+  const fromEnv = Deno.env.get(envName)?.trim();
+  if (fromEnv) {
+    return fromEnv;
+  }
+
+  const { data, error } = await supabase.rpc("read_vault_secret", {
+    p_name: name,
+  });
+
+  if (error || !data) {
+    throw new Error(`VAULT_SECRET_NOT_CONFIGURED:${name}`);
+  }
+
+  return String(data);
+}
diff --git a/supabase/functions/calculate-installment-options/handleRequest.ts b/supabase/functions/calculate-installment-options/handleRequest.ts
new file mode 100644
index 0000000..564d442
--- /dev/null
+++ b/supabase/functions/calculate-installment-options/handleRequest.ts
@@ -0,0 +1,151 @@
+import { getCorsHeaders } from "../_shared/cors.ts";
+import { jsonResponse } from "../_shared/jsonResponse.ts";
+import { createPaymentLogger } from "../_shared/observability/payment-logger.ts";
+import { checkRateLimit, getClientIP } from "../_shared/rateLimiter.ts";
+import { computeInstallmentOptions } from "./computeInstallments.ts";
+import { getVaultSecret } from "./getVaultSecret.ts";
+import {
+  computeHMACSHA256,
+  serializeInstallmentHmacPayload,
+} from "./hmac.ts";
+import { parseInstallmentQuery } from "./parseQuery.ts";
+import {
+  PAYMENT_PLATFORM_CONSTANT_KEYS,
+  resolvePaymentPlatformConstants,
+} from "../_shared/payment/constants.ts";
+import type { InstallmentHmacPayload, PaymentPlatformConstants } from "./types.ts";
+
+const logger = createPaymentLogger("calculate-installment-options");
+const RATE_LIMIT_CONFIG = { perMinute: 60 };
+const INSTALLMENT_SIGNING_SECRET_NAME = "INSTALLMENT_SIGNING_SECRET";
+
+export type CalculateInstallmentOptionsDeps = {
+  getUser: (token: string) => Promise<{ user: { id: string } | null; error: Error | null }>;
+  loadPlatformConstants: () => Promise<Array<{ key: string; value: unknown }>>;
+  loadProposalAmount: (proposalId: string) => Promise<number | null>;
+  getSigningSecret: () => Promise<string>;
+  checkRateLimit: typeof checkRateLimit;
+  now?: () => Date;
+};
+
+export async function handleCalculateInstallmentOptionsRequest(
+  req: Request,
+  deps: CalculateInstallmentOptionsDeps,
+): Promise<Response> {
+  const cors = getCorsHeaders(req);
+
+  if (req.method === "OPTIONS") {
+    return new Response(null, { status: 204, headers: cors });
+  }
+
+  if (req.method !== "GET") {
+    return jsonResponse({ error: "method_not_allowed" }, 405, cors);
+  }
+
+  const authHeader = req.headers.get("Authorization");
+  if (!authHeader?.startsWith("Bearer ")) {
+    return jsonResponse({ error: "Unauthorized" }, 401, cors);
+  }
+
+  const token = authHeader.replace("Bearer ", "");
+  const { user, error: authError } = await deps.getUser(token);
+  if (authError || !user) {
+    return jsonResponse({ error: "Unauthorized" }, 401, cors);
+  }
+
+  const clientIP = getClientIP(req);
+  const rateLimit = await deps.checkRateLimit(
+    clientIP,
+    user.id,
+    "calculate-installment-options",
+    RATE_LIMIT_CONFIG,
+  );
+
+  if (!rateLimit.allowed) {
+    return jsonResponse(
+      {
+        error: "rate_limited",
+        message: "Too many requests. Try again shortly.",
+        retryAfter: rateLimit.retryAfter,
+      },
+      429,
+      { ...cors, "Retry-After": String(rateLimit.retryAfter) },
+    );
+  }
+
+  const query = parseInstallmentQuery(req);
+  if (!query) {
+    return jsonResponse(
+      { error: "proposal_id, service_id, and card_brand are required" },
+      400,
+      cors,
+    );
+  }
+
+  const baseAmount = await deps.loadProposalAmount(query.proposalId);
+  if (baseAmount === null || baseAmount <= 0) {
+    return jsonResponse({ error: "proposal_not_found" }, 404, cors);
+  }
+
+  const allConstants = resolvePaymentPlatformConstants(
+    await deps.loadPlatformConstants(),
+    (event, context) => logger.warn(event, context),
+  );
+  const constants: PaymentPlatformConstants = {
+    cc_visa_master_1x_rate: allConstants.cc_visa_master_1x_rate,
+    cc_visa_master_2_6x_rate: allConstants.cc_visa_master_2_6x_rate,
+    cc_visa_master_7_12x_rate: allConstants.cc_visa_master_7_12x_rate,
+    cc_elo_other_1x_rate: allConstants.cc_elo_other_1x_rate,
+    cc_elo_other_2_6x_rate: allConstants.cc_elo_other_2_6x_rate,
+    cc_elo_other_7_12x_rate: allConstants.cc_elo_other_7_12x_rate,
+    cc_fixed_processing_fee_brl: allConstants.cc_fixed_processing_fee_brl,
+    installment_hmac_expires_minutes: allConstants.installment_hmac_expires_minutes,
+  };
+
+  const installmentOptions = computeInstallmentOptions(
+    baseAmount,
+    query.cardBrand,
+    constants,
+  );
+
+  const now = deps.now?.() ?? new Date();
+  const computedAt = now.toISOString();
+  const expiresAt = new Date(
+    now.getTime() + constants.installment_hmac_expires_minutes * 60_000,
+  ).toISOString();
+
+  const payload: InstallmentHmacPayload = {
+    proposal_id: query.proposalId,
+    service_id: query.serviceId,
+    base_amount: baseAmount,
+    card_brand: query.cardBrand,
+    installment_options: installmentOptions,
+    computed_at: computedAt,
+    expires_at: expiresAt,
+  };
+
+  let signingSecret: string;
+  try {
+    signingSecret = await deps.getSigningSecret();
+  } catch (error) {
+    logger.error("installment_signing_secret_missing", {
+      error: error instanceof Error ? error.message : String(error),
+    });
+    return jsonResponse({ error: "signing_secret_unavailable" }, 500, cors);
+  }
+
+  const hmac = await computeHMACSHA256(
+    signingSecret,
+    serializeInstallmentHmacPayload(payload),
+  );
+
+  return jsonResponse(
+    {
+      installment_options: installmentOptions,
+      installment_selection_hmac: hmac,
+      expires_at: expiresAt,
+    },
+    200,
+    cors,
+  );
+}
diff --git a/supabase/functions/calculate-installment-options/hmac.ts b/supabase/functions/calculate-installment-options/hmac.ts
new file mode 100644
index 0000000..eb838f4
--- /dev/null
+++ b/supabase/functions/calculate-installment-options/hmac.ts
@@ -0,0 +1,28 @@
+import type { InstallmentHmacPayload } from "./types.ts";
+
+export function serializeInstallmentHmacPayload(payload: InstallmentHmacPayload): string {
+  return JSON.stringify(payload);
+}
+
+export async function computeHMACSHA256(
+  secret: string,
+  message: string,
+): Promise<string> {
+  const key = await crypto.subtle.importKey(
+    "raw",
+    new TextEncoder().encode(secret),
+    { name: "HMAC", hash: "SHA-256" },
+    false,
+    ["sign"],
+  );
+
+  const signature = await crypto.subtle.sign(
+    "HMAC",
+    key,
+    new TextEncoder().encode(message),
+  );
+
+  return Array.from(new Uint8Array(signature))
+    .map((byte) => byte.toString(16).padStart(2, "0"))
+    .join("");
+}
