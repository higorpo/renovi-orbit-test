@@ -0,0 +1,312 @@
+-- Payment System — task 37: cron charge dequeue + commit (design §4.5).
+
+create or replace function public.cron_charge_dequeue_rpc(
+  p_batch_size int default null
+)
+returns jsonb
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_batch_size int;
+  v_lease_minutes int;
+  v_max_attempts int;
+  v_rows jsonb := '[]'::jsonb;
+  v_row record;
+begin
+  v_batch_size := coalesce(
+    p_batch_size,
+    public.platform_constant_int('charge_batch_size', 10)
+  );
+  v_lease_minutes := public.platform_constant_int('payment_lease_duration_minutes', 10);
+  v_max_attempts := public.platform_constant_int('max_charge_attempts', 3);
+
+  for v_row in
+    with eligible as (
+      select ps.id
+      from public.payment_schedules ps
+      join public.contracted_services cs on cs.id = ps.contracted_service_id
+      join public.provider_accounts pa
+        on pa.provider_id = ps.provider_id
+       and pa.gateway_slug = ps.gateway_slug
+      where ps.state in ('SCHEDULED', 'FAILED')
+        and ps.automatic_attempt_count < v_max_attempts
+        and ps.charge_scheduled_at::date <= current_date
+        and (ps.locked_until is null or ps.locked_until < now())
+        and (ps.next_retry_at is null or ps.next_retry_at <= now())
+        and cs.status not in ('CANCELLED', 'COMPLETED')
+        and ps.payment_token_id is not null
+        and pa.onboarding_status = 'ACTIVE'
+      order by ps.charge_scheduled_at
+      limit v_batch_size
+      for update of ps skip locked
+    )
+    update public.payment_schedules ps
+    set
+      state = 'PROCESSING',
+      locked_until = now() + make_interval(mins => v_lease_minutes),
+      automatic_attempt_count = ps.automatic_attempt_count + 1,
+      updated_at = now()
+    from eligible e
+    where ps.id = e.id
+    returning
+      ps.id,
+      ps.contracted_service_id,
+      ps.client_id,
+      ps.provider_id,
+      ps.gateway_slug,
+      ps.payment_token_id,
+      ps.installment_number,
+      ps.base_amount,
+      ps.automatic_attempt_count,
+      ps.max_attempts,
+      ps.clearsale_session_id,
+      ps.client_ip_address
+  loop
+    insert into public.payment_audit_log (
+      event_type,
+      entity_type,
+      entity_id,
+      service_id,
+      schedule_id,
+      from_state,
+      to_state,
+      actor,
+      metadata
+    )
+    values (
+      'CHARGE_ATTEMPT_STARTED',
+      'payment_schedule',
+      v_row.id,
+      v_row.contracted_service_id,
+      v_row.id,
+      'SCHEDULED',
+      'PROCESSING',
+      'cron',
+      jsonb_build_object(
+        'automatic_attempt_count', v_row.automatic_attempt_count
+      )
+    );
+
+    v_rows := v_rows || jsonb_build_array(to_jsonb(v_row));
+  end loop;
+
+  return v_rows;
+end;
+$$;
+
+create or replace function public.cron_charge_commit_result_rpc(
+  p_schedule_id uuid,
+  p_outcome text,
+  p_charge_amount numeric(12, 2),
+  p_gateway_charge_id text,
+  p_gateway_transaction_id text,
+  p_failure_code text,
+  p_failure_reason text,
+  p_gateway_latency_ms int,
+  p_provider_response_summary jsonb,
+  p_undo_attempt_increment boolean default false
+)
+returns uuid
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_schedule public.payment_schedules%rowtype;
+  v_retry_minutes int;
+  v_max_attempts int;
+  v_audit_event text;
+  v_event_type text;
+  v_attempt_count smallint;
+begin
+  if p_outcome not in ('PAID', 'IN_ANALYSIS', 'FAILED', 'FAILED_PERMANENT') then
+    raise exception 'INVALID_OUTCOME' using errcode = 'P0001';
+  end if;
+
+  select ps.*
+  into v_schedule
+  from public.payment_schedules ps
+  where ps.id = p_schedule_id
+    and ps.state = 'PROCESSING'
+  for update;
+
+  if not found then
+    raise exception 'INVALID_SCHEDULE_STATE' using errcode = 'P0001';
+  end if;
+
+  v_retry_minutes := public.platform_constant_int('charge_retry_interval_minutes', 30);
+  v_max_attempts := public.platform_constant_int('max_charge_attempts', 3);
+  v_attempt_count := v_schedule.automatic_attempt_count;
+
+  if p_undo_attempt_increment then
+    v_attempt_count := greatest(0, v_schedule.automatic_attempt_count - 1)::smallint;
+  end if;
+
+  if p_outcome = 'PAID' then
+    update public.payment_schedules ps
+    set
+      state = 'PAID',
+      paid_at = now(),
+      paid_amount = p_charge_amount,
+      gateway_charge_id = p_gateway_charge_id,
+      gateway_transaction_id = p_gateway_transaction_id,
+      locked_until = null,
+      next_retry_at = null,
+      failure_code = null,
+      failure_reason = null,
+      automatic_attempt_count = v_attempt_count,
+      updated_at = now()
+    where ps.id = v_schedule.id;
+
+    update public.contracted_services cs
+    set status = 'CONFIRMED'
+    where cs.id = v_schedule.contracted_service_id
+      and cs.status = 'PENDING_PAYMENT';
+
+    v_audit_event := 'CHARGE_PAID';
+    v_event_type := 'ChargeSucceeded';
+  elsif p_outcome = 'IN_ANALYSIS' then
+    update public.payment_schedules ps
+    set
+      state = 'IN_ANALYSIS',
+      gateway_charge_id = coalesce(p_gateway_charge_id, ps.gateway_charge_id),
+      gateway_transaction_id = coalesce(p_gateway_transaction_id, ps.gateway_transaction_id),
+      locked_until = null,
+      automatic_attempt_count = v_attempt_count,
+      updated_at = now()
+    where ps.id = v_schedule.id;
+
+    v_audit_event := 'CHARGE_IN_ANALYSIS';
+    v_event_type := 'ChargeInAnalysis';
+  elsif p_outcome = 'FAILED_PERMANENT' then
+    update public.payment_schedules ps
+    set
+      state = 'FAILED_PERMANENT',
+      failed_at = now(),
+      failed_permanently_at = coalesce(ps.failed_permanently_at, now()),
+      failure_code = p_failure_code,
+      failure_reason = p_failure_reason,
+      locked_until = null,
+      next_retry_at = null,
+      automatic_attempt_count = v_attempt_count,
+      updated_at = now()
+    where ps.id = v_schedule.id;
+
+    v_audit_event := 'CHARGE_FAILED_PERMANENT';
+    v_event_type := 'ChargePermanentlyFailed';
+  else
+    update public.payment_schedules ps
+    set
+      state = 'FAILED',
+      failed_at = now(),
+      failure_code = p_failure_code,
+      failure_reason = p_failure_reason,
+      locked_until = null,
+      next_retry_at = now() + make_interval(mins => v_retry_minutes),
+      automatic_attempt_count = v_attempt_count,
+      updated_at = now()
+    where ps.id = v_schedule.id;
+
+    v_audit_event := 'CHARGE_FAILED';
+    v_event_type := 'ChargeFailed';
+  end if;
+
+  insert into public.payment_attempts (
+    schedule_id,
+    attempt_number,
+    initiator,
+    completed_at,
+    outcome,
+    provider_response_summary,
+    failure_code,
+    failure_reason,
+    charge_amount,
+    gateway_latency_ms
+  )
+  values (
+    v_schedule.id,
+    v_schedule.automatic_attempt_count,
+    'cron',
+    now(),
+    case p_outcome
+      when 'PAID' then 'PAID'
+      when 'IN_ANALYSIS' then 'IN_ANALYSIS'
+      else 'REJECTED'
+    end,
+    p_provider_response_summary,
+    p_failure_code,
+    p_failure_reason,
+    p_charge_amount,
+    p_gateway_latency_ms
+  );
+
+  insert into public.payment_audit_log (
+    event_type,
+    entity_type,
+    entity_id,
+    service_id,
+    schedule_id,
+    from_state,
+    to_state,
+    actor,
+    metadata
+  )
+  values (
+    v_audit_event,
+    'payment_schedule',
+    v_schedule.id,
+    v_schedule.contracted_service_id,
+    v_schedule.id,
+    'PROCESSING',
+    p_outcome,
+    'cron',
+    jsonb_build_object(
+      'charge_amount', p_charge_amount,
+      'automatic_attempt_count', v_attempt_count,
+      'max_attempts', v_max_attempts,
+      'undo_attempt_increment', p_undo_attempt_increment
+    )
+  );
+
+  insert into public.payment_events (
+    event_type,
+    aggregate_type,
+    aggregate_id,
+    service_id,
+    payload
+  )
+  values (
+    v_event_type,
+    'payment_schedule',
+    v_schedule.id,
+    v_schedule.contracted_service_id,
+    jsonb_build_object(
+      'outcome', p_outcome,
+      'charge_amount', p_charge_amount,
+      'initiator', 'cron'
+    )
+  );
+
+  return v_schedule.id;
+end;
+$$;
+
