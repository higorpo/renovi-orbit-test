@@ -0,0 +1,16 @@
+export function extractClientIp(req: Request): string | null {
+  const cfConnectingIp = req.headers.get("CF-Connecting-IP")?.trim();
+  if (cfConnectingIp) {
+    return cfConnectingIp;
+  }
+
+  const forwardedFor = req.headers.get("X-Forwarded-For");
+  if (forwardedFor) {
+    const firstHop = forwardedFor.split(",")[0]?.trim();
+    if (firstHop) {
+      return firstHop;
+    }
+  }
+
+  return null;
+}
diff --git a/supabase/functions/accept-proposal/handleRequest.ts b/supabase/functions/accept-proposal/handleRequest.ts
new file mode 100644
index 0000000..cba615d
--- /dev/null
+++ b/supabase/functions/accept-proposal/handleRequest.ts
@@ -0,0 +1,198 @@
+import { getCorsHeaders } from "../_shared/cors.ts";
+import { jsonResponse } from "../_shared/jsonResponse.ts";
+import { createPaymentLogger } from "../_shared/observability/payment-logger.ts";
+import { checkRateLimit, getClientIP } from "../_shared/rateLimiter.ts";
+import { extractClientIp } from "./extractClientIp.ts";
+import { parseAcceptProposalBody } from "./parseBody.ts";
+import type {
+  AcceptProposalSuccess,
+  PaymentTokenRecord,
+  ProposalRecord,
+  ProviderAccountRecord,
+} from "./types.ts";
+import { validateInstallmentHmac } from "./validateInstallmentHmac.ts";
+import { validatePricingSignature } from "./validatePricingSignature.ts";
+import { isPaymentSystemV1Enabled } from "./checkPaymentFeatureFlag.ts";
+
+const logger = createPaymentLogger("accept-proposal");
+const RATE_LIMIT_CONFIG = { perMinute: 20 };
+
+export type AcceptProposalRpcResult = {
+  contracted_service_id: string;
+  schedule_id: string;
+  is_idempotent: boolean;
+};
+
+export type AcceptProposalDeps = {
+  getUser: (token: string) => Promise<{ user: { id: string } | null; error: Error | null }>;
+  getInstallmentSigningSecret: () => Promise<string>;
+  getPricingSignatureSecret: () => Promise<string>;
+  loadProposal: (proposalId: string) => Promise<ProposalRecord | null>;
+  loadPaymentToken: (
+    paymentTokenId: string,
+    clientId: string,
+  ) => Promise<PaymentTokenRecord | null>;
+  loadProviderAccount: (providerId: string) => Promise<ProviderAccountRecord | null>;
+  acceptProposalRpc: (input: {
+    proposalId: string;
+    clientId: string;
+    providerId: string;
+    paymentTokenId: string;
+    installmentNumber: number;
+    baseAmount: number;
+    serviceScheduledAt: string;
+    clearsaleSessionId?: string;
+    clientIpAddress: string | null;
+    actorId: string;
+    idempotencyKey: string;
+  }) => Promise<AcceptProposalRpcResult | null>;
+  getPaymentRolloutPercentage: () => Promise<number>;
+  rolloutRandom?: () => number;
+  checkRateLimit: typeof checkRateLimit;
+  now?: () => Date;
+};
+
+export async function handleAcceptProposalRequest(
+  req: Request,
+  deps: AcceptProposalDeps,
+): Promise<Response> {
+  const cors = getCorsHeaders(req);
+
+  if (req.method === "OPTIONS") {
+    return new Response(null, { status: 204, headers: cors });
+  }
+
+  if (req.method !== "POST") {
+    return jsonResponse({ error: "method_not_allowed" }, 405, cors);
+  }
+
+  const authHeader = req.headers.get("Authorization");
+  if (!authHeader?.startsWith("Bearer ")) {
+    return jsonResponse({ error: "Unauthorized" }, 401, cors);
+  }
+
+  const token = authHeader.replace("Bearer ", "");
+  const { user, error: authError } = await deps.getUser(token);
+  if (authError || !user) {
+    return jsonResponse({ error: "Unauthorized" }, 401, cors);
+  }
+
+  const rolloutPercentage = await deps.getPaymentRolloutPercentage();
+  if (!isPaymentSystemV1Enabled(
+    rolloutPercentage,
+    deps.rolloutRandom?.() ?? Math.random() * 100,
+  )) {
+    return jsonResponse({ error: "feature_not_available" }, 403, cors);
+  }
+
+  const clientIP = getClientIP(req);
+  const rateLimit = await deps.checkRateLimit(
+    clientIP,
+    user.id,
+    "accept-proposal",
+    RATE_LIMIT_CONFIG,
+  );
+
+  if (!rateLimit.allowed) {
+    return jsonResponse(
+      {
+        error: "rate_limited",
+        message: "Too many requests. Try again shortly.",
+        retryAfter: rateLimit.retryAfter,
+      },
+      429,
+      { ...cors, "Retry-After": String(rateLimit.retryAfter) },
+    );
+  }
+
+  let body: Record<string, unknown>;
+  try {
+    body = await req.json() as Record<string, unknown>;
+  } catch {
+    return jsonResponse({ error: "Invalid JSON body" }, 400, cors);
+  }
+
+  const parsed = parseAcceptProposalBody(body);
+  if ("error" in parsed) {
+    return jsonResponse({ error: parsed.error }, parsed.status, cors);
+  }
+
+  const proposal = await deps.loadProposal(parsed.proposalId);
+  if (!proposal) {
+    return jsonResponse({ error_code: "PROPOSAL_NOT_FOUND" }, 404, cors);
+  }
+
+  const providerId = parsed.providerId ?? proposal.provider_id;
+  if (providerId !== proposal.provider_id) {
+    return jsonResponse({ error_code: "PROVIDER_MISMATCH" }, 400, cors);
+  }
+
+  if (parsed.hmacPayload.base_amount !== proposal.proposed_amount) {
+    return jsonResponse({ error_code: "PROPOSAL_PRICING_INVALID" }, 400, cors);
+  }
+
+  const pricingSecret = await deps.getPricingSignatureSecret();
+  const pricingValid = await validatePricingSignature(pricingSecret, proposal);
+  if (!pricingValid) {
+    return jsonResponse({ error_code: "PROPOSAL_PRICING_INVALID" }, 400, cors);
+  }
+
+  const installmentSecret = await deps.getInstallmentSigningSecret();
+  const hmacValidation = await validateInstallmentHmac(
+    parsed.installmentSelectionHmac,
+    parsed.hmacPayload,
+    installmentSecret,
+    deps.now?.() ?? new Date(),
+  );
+
+  if (!hmacValidation.valid) {
+    return jsonResponse(
+      { error_code: hmacValidation.error_code },
+      400,
+      cors,
+    );
+  }
+
+  const paymentToken = await deps.loadPaymentToken(parsed.paymentTokenId, user.id);
+  if (!paymentToken || paymentToken.state !== "ACTIVE") {
+    return jsonResponse({ error_code: "PAYMENT_TOKEN_INACTIVE" }, 422, cors);
+  }
+
+  const providerAccount = await deps.loadProviderAccount(providerId);
+  if (!providerAccount || providerAccount.onboarding_status !== "ACTIVE") {
+    return jsonResponse({ error_code: "PROVIDER_NOT_CREDENTIALED" }, 409, cors);
+  }
+
+  if (!parsed.clearsaleSessionId) {
+    logger.warn("missing_clearsale_session_id", {
+      proposal_id: parsed.proposalId,
+      client_id: user.id,
+    });
+  }
+
+  const rpcResult = await deps.acceptProposalRpc({
+    proposalId: parsed.proposalId,
+    clientId: user.id,
+    providerId,
+    paymentTokenId: parsed.paymentTokenId,
+    installmentNumber: parsed.installmentNumber,
+    baseAmount: proposal.proposed_amount,
+    serviceScheduledAt: parsed.scheduledDate,
+    clearsaleSessionId: parsed.clearsaleSessionId,
+    clientIpAddress: extractClientIp(req),
+    actorId: user.id,
+    idempotencyKey: parsed.idempotencyKey,
+  });
+
+  if (!rpcResult) {
+    return jsonResponse({ error: "accept_proposal_failed" }, 500, cors);
+  }
+
+  const response: AcceptProposalSuccess = {
+    contracted_service_id: rpcResult.contracted_service_id,
+    schedule_id: rpcResult.schedule_id,
+    is_idempotent: rpcResult.is_idempotent,
+  };
+
+  return jsonResponse(response, 200, cors);
+}
