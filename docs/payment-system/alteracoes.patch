+-- Payment System — task 46: TRANSACTION_UPDATE REJECTED webhook transition.
+
+create or replace function public.webhook_transaction_rejected_rpc(
+  p_reference_code uuid,
+  p_webhook_event_id text,
+  p_failure_code text default null,
+  p_failure_reason text default null
+)
+returns jsonb
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_schedule public.payment_schedules%rowtype;
+  v_from_state text;
+begin
+  select ps.*
+  into v_schedule
+  from public.payment_schedules ps
+  where ps.contracted_service_id = p_reference_code
+  for update;
+
+  if not found then
+    return jsonb_build_object('outcome', 'not_found');
+  end if;
+
+  v_from_state := v_schedule.state;
+
+  if v_schedule.state = 'FAILED_PERMANENT' then
+    return jsonb_build_object(
+      'outcome', 'already_terminal',
+      'schedule_id', v_schedule.id,
+      'service_id', v_schedule.contracted_service_id,
+      'from_state', v_from_state
+    );
+  end if;
+
+  if v_schedule.state not in ('IN_ANALYSIS', 'PROCESSING') then
+    return jsonb_build_object(
+      'outcome', 'skipped',
+      'reason', 'invalid_transition',
+      'schedule_id', v_schedule.id,
+      'service_id', v_schedule.contracted_service_id,
+      'from_state', v_from_state
+    );
+  end if;
+
+  update public.payment_schedules ps
+  set
+    state = 'FAILED_PERMANENT',
+    failed_at = coalesce(ps.failed_at, now()),
+    failed_permanently_at = coalesce(ps.failed_permanently_at, now()),
+    failure_code = p_failure_code,
+    failure_reason = p_failure_reason,
+    locked_until = null,
+    next_retry_at = null,
+    updated_at = now()
+  where ps.id = v_schedule.id;
+
+  insert into public.payment_audit_log (
+    event_type,
+    entity_type,
+    entity_id,
+    service_id,
+    schedule_id,
+    from_state,
+    to_state,
+    actor,
+    metadata
+  )
+  values (
+    'CHARGE_FAILED_PERMANENT',
+    'payment_schedule',
+    v_schedule.id,
+    v_schedule.contracted_service_id,
+    v_schedule.id,
+    v_from_state,
+    'FAILED_PERMANENT',
+    'webhook',
+    jsonb_build_object(
+      'webhook_event_id', p_webhook_event_id,
+      'failure_code', p_failure_code,
+      'failure_reason', p_failure_reason,
+      'source', 'TRANSACTION_UPDATE'
+    )
+  );
+
+  insert into public.payment_events (
+    event_type,
+    aggregate_type,
+    aggregate_id,
+    service_id,
+    payload
+  )
+  values (
+    'ChargePermanentlyFailed',
+    'payment_schedule',
+    v_schedule.id,
+    v_schedule.contracted_service_id,
+    jsonb_build_object(
+      'outcome', 'FAILED_PERMANENT',
+      'initiator', 'webhook',
+      'webhook_event_id', p_webhook_event_id
+    )
+  );
+
+  return jsonb_build_object(
+    'outcome', 'rejected',
+    'schedule_id', v_schedule.id,
+    'service_id', v_schedule.contracted_service_id,
+    'client_id', v_schedule.client_id,
+    'provider_id', v_schedule.provider_id,
+    'from_state', v_from_state
+  );
+end;
+$$;
+
+comment on function public.webhook_transaction_rejected_rpc(
+  uuid, text, text, text
+) is
+  'TRANSACTION_UPDATE webhook: IN_ANALYSIS/PROCESSING → FAILED_PERMANENT when transactionState=REJECTED.';
+
+revoke all on function public.webhook_transaction_rejected_rpc(
+  uuid, text, text, text
+) from public, anon, authenticated;
+grant execute on function public.webhook_transaction_rejected_rpc(
+  uuid, text, text, text
+) to service_role;
diff --git a/supabase/migrations/20260705210300_rpc_webhook_refund_void_dispute.sql b/supabase/migrations/20260705210300_rpc_webhook_refund_void_dispute.sql
new file mode 100644
