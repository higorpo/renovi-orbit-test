+import type { NotificationIngestInput } from "../../manual-charge-payment/enqueueNotifications.ts";
+import type { PaymentProfileScheduleRow } from "./extractPaymentProfilePayload.ts";
+
+export async function enqueuePaymentMethodUpdateNotifications(
+  ingest: (input: NotificationIngestInput) => Promise<void>,
+  input: {
+    webhookEventId: string;
+    reason: "profile_deleted" | "profile_expiring" | "tokenization_failed";
+    schedules: PaymentProfileScheduleRow[];
+  },
+): Promise<number> {
+  let count = 0;
+
+  for (const schedule of input.schedules) {
+    const baseKey = `payment-profile:${input.reason}:${input.webhookEventId}:${schedule.schedule_id}`;
+
+    await ingest({
+      profileId: schedule.client_id,
+      channel: "PUSH",
+      templateKey: "payment_method_update_required",
+      idempotencyKey: `${baseKey}:push`,
+      templateVariables: {
+        serviceId: schedule.service_id,
+        reason: input.reason,
+        deepLink: `renovi://services/${schedule.service_id}/payment-method`,
+      },
+      bypassLimits: true,
+    });
+    count += 1;
+
+    await ingest({
+      profileId: schedule.client_id,
+      channel: "EMAIL",
+      templateKey: "payment_method_update_required_email",
+      idempotencyKey: `${baseKey}:email`,
+      templateVariables: {
+        serviceId: schedule.service_id,
+        reason: input.reason,
+      },
+      bypassLimits: true,
+    });
+    count += 1;
+  }
+
+  return count;
+}
