+import { assertEquals } from "std/testing/asserts";
+import {
+  AUDIT_EVENT_GAPS,
+  DESIGN_AUDIT_EVENTS,
+} from "../audit-log-catalog.ts";
+
+const MIGRATIONS_DIR = new URL(
+  "../../../../migrations/",
+  import.meta.url,
+);
+
+async function migrationFilesIncludeAuditEvent(eventType: string): Promise<boolean> {
+  for await (const entry of Deno.readDir(MIGRATIONS_DIR)) {
+    if (!entry.isFile || !entry.name.endsWith(".sql")) {
+      continue;
+    }
+
+    const content = await Deno.readTextFile(
+      new URL(entry.name, MIGRATIONS_DIR),
+    );
+
+    if (
+      content.includes("payment_audit_log") &&
+      content.includes(`'${eventType}'`)
+    ) {
+      return true;
+    }
+  }
+
+  return false;
+}
+
+Deno.test("design §10.3 audit events are present in payment_audit_log migrations", async () => {
+  const missing: string[] = [];
+
+  for (const eventType of DESIGN_AUDIT_EVENTS) {
+    const found = await migrationFilesIncludeAuditEvent(eventType);
+    if (!found) {
+      missing.push(eventType);
+    }
+  }
+
+  assertEquals(missing, []);
+});
+
+Deno.test("documented audit gaps are not falsely present in catalog", () => {
+  for (const gap of AUDIT_EVENT_GAPS) {
+    assertEquals(
+      (DESIGN_AUDIT_EVENTS as readonly string[]).includes(gap),
+      false,
+    );
+  }
+});
+
+Deno.test("IN_ANALYSIS design alias maps to CHARGE_IN_ANALYSIS implementation", async () => {
+  const found = await migrationFilesIncludeAuditEvent("CHARGE_IN_ANALYSIS");
+  assertEquals(found, true);
+});
