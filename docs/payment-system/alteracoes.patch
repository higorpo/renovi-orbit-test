+import { assertEquals } from "std/testing/asserts";
+import {
+  computeNextRetryAt,
+  computeNextRetryDelayMinutes,
+} from "../computeNextRetryAt.ts";
+
+Deno.test("exponential backoff timing uses base * 2^(retryCount - 1) minutes", () => {
+  const base = Date.UTC(2026, 5, 24, 12, 0, 0);
+
+  assertEquals(computeNextRetryDelayMinutes(1, 5), 5);
+  assertEquals(computeNextRetryDelayMinutes(2, 5), 10);
+  assertEquals(computeNextRetryDelayMinutes(3, 5), 20);
+
+  assertEquals(
+    computeNextRetryAt(1, 5, base).toISOString(),
+    new Date(base + 5 * 60_000).toISOString(),
+  );
+  assertEquals(
+    computeNextRetryAt(2, 5, base).toISOString(),
+    new Date(base + 10 * 60_000).toISOString(),
+  );
+  assertEquals(
+    computeNextRetryAt(3, 5, base).toISOString(),
+    new Date(base + 20 * 60_000).toISOString(),
+  );
+});
diff --git a/supabase/functions/process-webhook-retry/__tests__/handleRequest_test.ts b/supabase/functions/process-webhook-retry/__tests__/handleRequest_test.ts
new file mode 100644
index 0000000..19820ee
--- /dev/null
+++ b/supabase/functions/process-webhook-retry/__tests__/handleRequest_test.ts
@@ -0,0 +1,135 @@
+import { assertEquals } from "std/testing/asserts";
+import type { WebhookDispatchDeps } from "../../netcred-webhook/createWebhookHandlerDeps.ts";
+import {
+  handleProcessWebhookRetryRequest,
+  type ProcessWebhookRetryDeps,
+} from "../handleRequest.ts";
+import { processWebhookEvent } from "../processEvent.ts";
+import type { WebhookRetryClaimRow, WebhookRetryFailResult } from "../types.ts";
+
+const baseRow: WebhookRetryClaimRow = {
+  source: "failed_retry",
+  event_id: "event-1",
+  gateway_slug: "netcred",
+  event_type: "TRANSACTION_CAPTURE",
+  gateway_event_id: "provider-1",
+  raw_payload: {
+    transaction: {
+      referenceCode: "service-1",
+      transactionState: "PAID",
+    },
+  },
+  retry_count: 1,
+};
+
+const stubHandlerDeps = {} as WebhookDispatchDeps;
+
+function cronRequest(): Request {
+  return new Request("https://example.com/process-webhook-retry", {
+    method: "POST",
+    headers: { Authorization: "Bearer test-service-role" },
+  });
+}
+
+Deno.test("retry success marks event processed", async () => {
+  let markedProcessed = false;
+
+  const outcome = await processWebhookEvent(
+    {
+      dispatch: async () => "processed",
+      markProcessed: async () => {
+        markedProcessed = true;
+      },
+      markFailed: async () => ({
+        outcome: "failed",
+        event_id: "event-1",
+        event_type: "TRANSACTION_CAPTURE",
+        gateway_event_id: "provider-1",
+        retry_count: 2,
+        failure_reason: "should-not-happen",
+      }),
+      emitDeadLetterCritical: () => {},
+    },
+    stubHandlerDeps,
+    baseRow,
+  );
+
+  assertEquals(outcome, "processed");
+  assertEquals(markedProcessed, true);
+});
+
+Deno.test("three consecutive failures promote event to dead letter with critical alert", async () => {
+  const deadLetters: WebhookRetryFailResult[] = [];
+  let failureCount = 0;
+
+  const deps = {
+    dispatch: async () => {
+      throw new Error(`handler_failed_${failureCount + 1}`);
+    },
+    markProcessed: async () => {},
+    markFailed: async () => {
+      failureCount += 1;
+      if (failureCount < 3) {
+        return {
+          outcome: "failed" as const,
+          event_id: "event-1",
+          event_type: "TRANSACTION_CAPTURE",
+          gateway_event_id: "provider-1",
+          retry_count: failureCount + 1,
+          failure_reason: `handler_failed_${failureCount}`,
+          next_retry_at: new Date(Date.now() + failureCount * 5 * 60_000).toISOString(),
+        };
+      }
+
+      return {
+        outcome: "dead_letter" as const,
+        event_id: "event-1",
+        event_type: "TRANSACTION_CAPTURE",
+        gateway_event_id: "provider-1",
+        retry_count: 3,
+        failure_reason: "handler_failed_3",
+        schedule_id: "schedule-1",
+      };
+    },
+    emitDeadLetterCritical: (input: WebhookRetryFailResult) => {
+      deadLetters.push(input);
+    },
+  };
+
+  assertEquals(
+    await processWebhookEvent(deps, stubHandlerDeps, { ...baseRow, retry_count: 1 }),
+    "failed",
+  );
+  assertEquals(
+    await processWebhookEvent(deps, stubHandlerDeps, { ...baseRow, retry_count: 2 }),
+    "failed",
+  );
+  assertEquals(
+    await processWebhookEvent(deps, stubHandlerDeps, { ...baseRow, retry_count: 3 }),
+    "dead_letter",
+  );
+  assertEquals(deadLetters.length, 1);
+  assertEquals(deadLetters[0]?.outcome, "dead_letter");
+  assertEquals(deadLetters[0]?.schedule_id, "schedule-1");
+});
+
+Deno.test("cron worker aggregates processed and dead-letter counts", async () => {
+  Deno.env.set("SUPABASE_SERVICE_ROLE_KEY", "test-service-role");
+  try {
+    const deps: ProcessWebhookRetryDeps = {
+      claimRetryEvents: async () => [baseRow],
+      claimQueueEvents: async () => [],
+      handlerDeps: stubHandlerDeps,
+      processEvent: async () => "processed",
+    };
+
+    const response = await handleProcessWebhookRetryRequest(cronRequest(), deps);
+    assertEquals(response.status, 200);
+    const body = await response.json();
+    assertEquals(body.claimed, 1);
+    assertEquals(body.processed, 1);
+    assertEquals(body.dead_letter, 0);
+  } finally {
+    Deno.env.delete("SUPABASE_SERVICE_ROLE_KEY");
+  }
+});
