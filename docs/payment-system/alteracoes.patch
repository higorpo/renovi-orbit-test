+import { getCorsHeaders } from "../_shared/cors.ts";
+import { jsonResponse } from "../_shared/jsonResponse.ts";
+import { createPaymentLogger } from "../_shared/observability/payment-logger.ts";
+import { validateCronAuth } from "../schedule-netcred-charges/auth.ts";
+import type { RecoverySummary } from "./types.ts";
+
+const logger = createPaymentLogger("recover-payment-leases");
+
+export type RecoverPaymentLeasesDeps = {
+  recoverOrphanedSchedules: () => Promise<RecoverySummary>;
+  emitRecoveryInfo: (summary: RecoverySummary) => void;
+};
+
+function emptySummary(): RecoverySummary {
+  return {
+    recovered_count: 0,
+    recovered_to_scheduled: 0,
+    recovered_to_failed: 0,
+  };
+}
+
+export async function handleRecoverPaymentLeasesRequest(
+  req: Request,
+  deps: RecoverPaymentLeasesDeps,
+): Promise<Response> {
+  const cors = getCorsHeaders(req);
+
+  if (req.method === "OPTIONS") {
+    return new Response(null, { status: 204, headers: cors });
+  }
+
+  if (req.method !== "POST") {
+    return jsonResponse({ error: "method_not_allowed" }, 405, cors);
+  }
+
+  const auth = validateCronAuth(req);
+  if (!auth.ok) {
+    return jsonResponse({ error: auth.code }, auth.status, cors);
+  }
+
+  const summary = await deps.recoverOrphanedSchedules();
+
+  if (summary.recovered_count > 0) {
+    deps.emitRecoveryInfo(summary);
+  }
+
+  logger.info("orphan_recovery_completed", summary);
+
+  return jsonResponse(summary.recovered_count > 0 ? summary : emptySummary(), 200, cors);
+}
