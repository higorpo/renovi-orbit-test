+import "xhr";
+import { servePaymentFunction } from "../_shared/observability/sentry.ts";
+import { checkRateLimit } from "../_shared/rateLimiter.ts";
+import { createServiceRoleClient } from "../_shared/serviceRoleClient.ts";
+import { getVaultSecret } from "../calculate-installment-options/getVaultSecret.ts";
+import {
+  parseChargeCronDryRun,
+  PAYMENT_PLATFORM_CONSTANT_DEFAULTS,
+} from "../_shared/payment/constants.ts";
+import {
+  handleAcceptProposalRequest,
+  type AcceptProposalDeps,
+  type AcceptProposalRpcResult,
+} from "./handleRequest.ts";
+
+function createDeps(): AcceptProposalDeps {
+  const supabase = createServiceRoleClient();
+
+  return {
+    getUser: async (token) => {
+      const { data: { user }, error } = await supabase.auth.getUser(token);
+      return { user, error: error ?? null };
+    },
+    getInstallmentSigningSecret: () =>
+      getVaultSecret(supabase, "INSTALLMENT_SIGNING_SECRET"),
+    getPricingSignatureSecret: () =>
+      getVaultSecret(supabase, "pricing_signature_secret"),
+    loadProposal: async (proposalId) => {
+      const { data, error } = await supabase
+        .from("provider_proposals")
+        .select(
+          "id, provider_id, proposed_amount, tax_rate, tax_amount, final_amount, pricing_signature",
+        )
+        .eq("id", proposalId)
+        .maybeSingle();
+
+      if (error || !data) {
+        return null;
+      }
+
+      return data;
+    },
+    loadPaymentToken: async (paymentTokenId, clientId) => {
+      const { data, error } = await supabase
+        .from("payment_tokens")
+        .select("id, client_id, state")
+        .eq("id", paymentTokenId)
+        .eq("client_id", clientId)
+        .maybeSingle();
+
+      if (error || !data) {
+        return null;
+      }
+
+      return data;
+    },
+    loadProviderAccount: async (providerId) => {
+      const { data, error } = await supabase
+        .from("provider_accounts")
+        .select("provider_id, onboarding_status")
+        .eq("provider_id", providerId)
+        .eq("gateway_slug", "netcred")
+        .maybeSingle();
+
+      if (error || !data) {
+        return null;
+      }
+
+      return data;
+    },
+    acceptProposalRpc: async (input) => {
+      const { data, error } = await supabase.rpc("accept_proposal_rpc", {
+        p_proposal_id: input.proposalId,
+        p_client_id: input.clientId,
+        p_provider_id: input.providerId,
+        p_gateway_slug: "netcred",
+        p_payment_token_id: input.paymentTokenId,
+        p_installment_number: input.installmentNumber,
+        p_base_amount: input.baseAmount,
+        p_service_scheduled_at: input.serviceScheduledAt,
+        p_clearsale_session_id: input.clearsaleSessionId ?? null,
+        p_client_ip_address: input.clientIpAddress,
+        p_actor_id: input.actorId,
+        p_idempotency_key: input.idempotencyKey,
+      });
+
+      if (error || !data) {
+        return null;
+      }
+
+      const row = (Array.isArray(data) ? data[0] : data) as AcceptProposalRpcResult | undefined;
+      if (!row?.contracted_service_id) {
+        return null;
+      }
+
+      return row;
+    },
+    checkRateLimit,
+    getPaymentRolloutPercentage: async () => {
+      const { data, error } = await supabase.rpc("platform_constant_int", {
+        p_key: "payment_system_rollout_percentage",
+        p_default: PAYMENT_PLATFORM_CONSTANT_DEFAULTS.payment_system_rollout_percentage,
+      });
+
+      if (error || data === null) {
+        return PAYMENT_PLATFORM_CONSTANT_DEFAULTS.payment_system_rollout_percentage;
+      }
+
+      return Number(data);
+    },
+  };
+}
+
+servePaymentFunction("accept-proposal", (req) =>
+  handleAcceptProposalRequest(req, createDeps()));
