@@ -0,0 +1,103 @@
+import { assertEquals } from "std/testing/asserts";
+import {
+  handleUpdatePaymentMethodRequest,
+  type UpdatePaymentMethodDeps,
+} from "../handleRequest.ts";
+
+const schedule = {
+  id: "schedule-1",
+  contracted_service_id: "service-1",
+  client_id: "client-1",
+  payment_token_id: "token-old",
+  state: "SCHEDULED",
+  base_amount: 1000,
+  charge_scheduled_at: "2026-07-01T10:00:00.000Z",
+  installment_number: 1,
+};
+
+function createDeps(overrides: Partial<UpdatePaymentMethodDeps> = {}): UpdatePaymentMethodDeps {
+  return {
+    getUser: async () => ({ user: { id: "client-1" }, error: null }),
+    getInstallmentSigningSecret: async () => "installment-secret",
+    loadContractedService: async () => ({
+      id: "service-1",
+      client_id: "client-1",
+      status: "PENDING_PAYMENT",
+    }),
+    loadSchedule: async () => ({ ...schedule }),
+    loadPaymentToken: async (tokenId) => {
+      if (tokenId === "token-old") {
+        return {
+          id: "token-old",
+          client_id: "client-1",
+          state: "ACTIVE",
+          card_brand: "VCC",
+        };
+      }
+
+      return {
+        id: "token-new",
+        client_id: "client-1",
+        state: "ACTIVE",
+        card_brand: "ELO",
+      };
+    },
+    updatePaymentMethod: async () => "schedule-1",
+    checkRateLimit: async () => ({ allowed: true, retryAfter: 0 }),
+    ...overrides,
+  };
+}
+
+function authRequest(body: Record<string, unknown>): Request {
+  return new Request("https://example.com/update-payment-method", {
+    method: "POST",
+    headers: {
+      Authorization: "Bearer jwt-token",
+      "Content-Type": "application/json",
+    },
+    body: JSON.stringify(body),
+  });
+}
+
+Deno.test("brand change without HMAC returns HTTP 400 INSTALLMENT_HMAC_REQUIRED", async () => {
+  const response = await handleUpdatePaymentMethodRequest(
+    authRequest({
+      service_id: "service-1",
+      new_payment_token_id: "token-new",
+    }),
+    createDeps(),
+  );
+
+  assertEquals(response.status, 400);
+  const body = await response.json();
+  assertEquals(body.error_code, "INSTALLMENT_HMAC_REQUIRED");
+  assertEquals(body.reason, "card_brand_changed");
+});
+
+Deno.test("same brand update succeeds without HMAC", async () => {
+  let updateCalled = false;
+
+  const response = await handleUpdatePaymentMethodRequest(
+    authRequest({
+      service_id: "service-1",
+      new_payment_token_id: "token-new",
+    }),
+    createDeps({
+      loadPaymentToken: async (tokenId) => ({
+        id: tokenId,
+        client_id: "client-1",
+        state: "ACTIVE",
+        card_brand: "VCC",
+      }),
+      updatePaymentMethod: async () => {
+        updateCalled = true;
+        return "schedule-1";
+      },
+    }),
+  );
+
+  assertEquals(response.status, 200);
+  assertEquals(updateCalled, true);
+  const body = await response.json();
+  assertEquals(body.schedule_id, "schedule-1");
+});
diff --git a/supabase/functions/update-payment-method/handleRequest.ts b/supabase/functions/update-payment-method/handleRequest.ts
new file mode 100644
index 0000000..5656725
--- /dev/null
+++ b/supabase/functions/update-payment-method/handleRequest.ts
@@ -0,0 +1,175 @@
+import { getCorsHeaders } from "../_shared/cors.ts";
+import { jsonResponse } from "../_shared/jsonResponse.ts";
+import { createPaymentLogger } from "../_shared/observability/payment-logger.ts";
+import { checkRateLimit, getClientIP } from "../_shared/rateLimiter.ts";
+import { validateInstallmentHmac } from "../accept-proposal/validateInstallmentHmac.ts";
+import { parseUpdatePaymentMethodBody } from "./parseBody.ts";
+import type {
+  ContractedServiceRecord,
+  PaymentScheduleRecord,
+  PaymentTokenBrandRecord,
+  UpdatePaymentMethodBody,
+} from "./types.ts";
+
+const logger = createPaymentLogger("update-payment-method");
+const RATE_LIMIT_CONFIG = { perMinute: 20 };
+
+export type UpdatePaymentMethodDeps = {
+  getUser: (token: string) => Promise<{ user: { id: string } | null; error: Error | null }>;
+  getInstallmentSigningSecret: () => Promise<string>;
+  loadContractedService: (serviceId: string) => Promise<ContractedServiceRecord | null>;
+  loadSchedule: (serviceId: string, clientId: string) => Promise<PaymentScheduleRecord | null>;
+  loadPaymentToken: (tokenId: string, clientId: string) => Promise<PaymentTokenBrandRecord | null>;
+  updatePaymentMethod: (input: {
+    serviceId: string;
+    clientId: string;
+    newPaymentTokenId: string;
+    actorId: string;
+    oldPaymentTokenId: string | null;
+    oldBrand: string | null;
+    newBrand: string;
+  }) => Promise<string | null>;
+  checkRateLimit: typeof checkRateLimit;
+  now?: () => Date;
+};
+
+function isEligibleScheduleState(state: string): boolean {
+  return state === "SCHEDULED" || state === "FAILED";
+}
+
+export async function handleUpdatePaymentMethodRequest(
+  req: Request,
+  deps: UpdatePaymentMethodDeps,
+): Promise<Response> {
+  const cors = getCorsHeaders(req);
+
+  if (req.method === "OPTIONS") {
+    return new Response(null, { status: 204, headers: cors });
+  }
+
+  if (req.method !== "POST") {
+    return jsonResponse({ error: "method_not_allowed" }, 405, cors);
+  }
+
+  const authHeader = req.headers.get("Authorization");
+  if (!authHeader?.startsWith("Bearer ")) {
+    return jsonResponse({ error: "Unauthorized" }, 401, cors);
+  }
+
+  const token = authHeader.replace("Bearer ", "");
+  const { user, error: authError } = await deps.getUser(token);
+  if (authError || !user) {
+    return jsonResponse({ error: "Unauthorized" }, 401, cors);
+  }
+
+  const clientIP = getClientIP(req);
+  const rateLimit = await deps.checkRateLimit(
+    clientIP,
+    user.id,
+    "update-payment-method",
+    RATE_LIMIT_CONFIG,
+  );
+
+  if (!rateLimit.allowed) {
+    return jsonResponse(
+      {
+        error: "rate_limited",
+        message: "Too many requests. Try again shortly.",
+        retryAfter: rateLimit.retryAfter,
+      },
+      429,
+      { ...cors, "Retry-After": String(rateLimit.retryAfter) },
+    );
+  }
+
+  let body: UpdatePaymentMethodBody;
+  try {
+    body = await req.json() as UpdatePaymentMethodBody;
+  } catch {
+    return jsonResponse({ error: "Invalid JSON body" }, 400, cors);
+  }
+
+  const parsed = parseUpdatePaymentMethodBody(body);
+  if ("error" in parsed) {
+    return jsonResponse({ error: parsed.error }, parsed.status, cors);
+  }
+
+  const service = await deps.loadContractedService(parsed.serviceId);
+  if (!service || service.client_id !== user.id) {
+    return jsonResponse({ error: "service_not_found" }, 404, cors);
+  }
+
+  if (service.status !== "PENDING_PAYMENT") {
+    return jsonResponse({ error_code: "INVALID_SCHEDULE_STATE" }, 409, cors);
+  }
+
+  const schedule = await deps.loadSchedule(parsed.serviceId, user.id);
+  if (!schedule || !isEligibleScheduleState(schedule.state)) {
+    return jsonResponse({ error_code: "INVALID_SCHEDULE_STATE" }, 409, cors);
+  }
+
+  const newToken = await deps.loadPaymentToken(parsed.newPaymentTokenId, user.id);
+  if (!newToken || newToken.state !== "ACTIVE") {
+    return jsonResponse({ error_code: "PAYMENT_TOKEN_INACTIVE" }, 422, cors);
+  }
+
+  const oldToken = schedule.payment_token_id
+    ? await deps.loadPaymentToken(schedule.payment_token_id, user.id)
+    : null;
+
+  const oldBrand = oldToken?.card_brand ?? null;
+  const brandChanged = oldBrand !== null && oldBrand !== newToken.card_brand;
+
+  if (brandChanged) {
+    if (!parsed.installmentSelectionHmac || !parsed.hmacPayload) {
+      return jsonResponse(
+        {
+          error_code: "INSTALLMENT_HMAC_REQUIRED",
+          reason: "card_brand_changed",
+        },
+        400,
+        cors,
+      );
+    }
+
+    if (parsed.hmacPayload.base_amount !== schedule.base_amount) {
+      return jsonResponse({ error_code: "INVALID_INSTALLMENT_SIGNATURE" }, 400, cors);
+    }
+
+    const installmentSecret = await deps.getInstallmentSigningSecret();
+    const hmacValidation = await validateInstallmentHmac(
+      parsed.installmentSelectionHmac,
+      parsed.hmacPayload,
+      installmentSecret,
+      deps.now?.() ?? new Date(),
+    );
+
+    if (!hmacValidation.valid) {
+      return jsonResponse(
+        { error_code: hmacValidation.error_code },
+        400,
+        cors,
+      );
+    }
+  }
+
+  const scheduleId = await deps.updatePaymentMethod({
+    serviceId: parsed.serviceId,
+    clientId: user.id,
+    newPaymentTokenId: parsed.newPaymentTokenId,
+    actorId: user.id,
+    oldPaymentTokenId: schedule.payment_token_id,
+    oldBrand,
+    newBrand: newToken.card_brand,
+  });
+
+  if (!scheduleId) {
+    logger.error("update_payment_method_rpc_failed", {
+      service_id: parsed.serviceId,
+      client_id: user.id,
+    });
+    return jsonResponse({ error: "update_payment_method_failed" }, 500, cors);
+  }
+
+  return jsonResponse({ schedule_id: scheduleId }, 200, cors);
+}
diff --git a/supabase/functions/update-payment-method/index.ts b/supabase/functions/update-payment-method/index.ts
