@@ -0,0 +1,109 @@
+-- Payment System — task 66: operator recovery RPCs (design §8.3).
+
+create or replace function public.reset_dead_letter_event(p_event_id text)
+returns jsonb
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_event public.payment_webhook_events%rowtype;
+  v_rows int;
+begin
+  update public.payment_webhook_events e
+  set
+    state = 'RECEIVED',
+    retry_count = 0,
+    next_retry_at = now(),
+    failure_reason = null,
+    processed_at = null,
+    updated_at = now()
+  where e.id = p_event_id
+    and e.state = 'DEAD_LETTER';
+
+  get diagnostics v_rows = row_count;
+
+  if v_rows = 0 then
+    raise exception 'EVENT_NOT_FOUND_OR_NOT_DEAD_LETTER' using errcode = 'P0001';
+  end if;
+
+  select e.*
+  into v_event
+  from public.payment_webhook_events e
+  where e.id = p_event_id;
+
+  insert into public.payment_audit_log (
+    event_type,
+    entity_type,
+    entity_id,
+    service_id,
+    actor,
+    metadata
+  )
+  values (
+    'WEBHOOK_DEAD_LETTER_RESET',
+    'payment_webhook_event',
+    gen_random_uuid(),
+    null,
+    'support',
+    jsonb_build_object(
+      'event_id', v_event.id,
+      'event_type', v_event.event_type,
+      'gateway_event_id', v_event.gateway_event_id,
+      'gateway_slug', v_event.gateway_slug
+    )
+  );
+
+  return jsonb_build_object(
+    'event_id', v_event.id,
+    'event_type', v_event.event_type,
+    'gateway_event_id', v_event.gateway_event_id,
+    'state', v_event.state,
+    'retry_count', v_event.retry_count,
+    'next_retry_at', v_event.next_retry_at
+  );
+end;
+$$;
+
+create or replace function public.reconstruct_payment_audit_lifecycle(p_service_id uuid)
+returns jsonb
+language sql
+security definer
+set search_path = public
+stable
+as $$
+  select coalesce(
+    jsonb_agg(
+      jsonb_build_object(
+        'id', pal.id,
+        'created_at', pal.created_at,
+        'event_type', pal.event_type,
+        'entity_type', pal.entity_type,
+        'entity_id', pal.entity_id,
+        'service_id', pal.service_id,
+        'schedule_id', pal.schedule_id,
+        'from_state', pal.from_state,
+        'to_state', pal.to_state,
+        'actor', pal.actor,
+        'actor_id', pal.actor_id,
+        'metadata', pal.metadata
+      )
+      order by pal.created_at asc, pal.id asc
+    ),
+    '[]'::jsonb
+  )
+  from public.payment_audit_log pal
+  where pal.service_id = p_service_id;
+$$;
+
+comment on function public.reset_dead_letter_event(text) is
+  'Operator tool: re-queue a DEAD_LETTER webhook for processing (task 66).';
+
+comment on function public.reconstruct_payment_audit_lifecycle(uuid) is
+  'Operator diagnostic: chronological payment_audit_log for a contracted service.';
+
+revoke all on function public.reset_dead_letter_event(text) from public, anon, authenticated;
+grant execute on function public.reset_dead_letter_event(text) to service_role;
+
+revoke all on function public.reconstruct_payment_audit_lifecycle(uuid) from public, anon, authenticated;
+grant execute on function public.reconstruct_payment_audit_lifecycle(uuid) to service_role;
diff --git a/supabase/migrations/20260705221600_rpc_webhook_platform_constant_fallback.sql b/supabase/migrations/20260705221600_rpc_webhook_platform_constant_fallback.sql
new file mode 100644
index 0000000..a3186fe
--- /dev/null
+++ b/supabase/migrations/20260705221600_rpc_webhook_platform_constant_fallback.sql
@@ -0,0 +1,148 @@
+-- Payment System — task 67: webhook RPCs use platform_constant_int fallback + WARN.
+
+create or replace function public.webhook_mark_failed_rpc(
+  p_event_id text,
+  p_failure_reason text,
+  p_base_interval_minutes int default null
+)
+returns jsonb
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_base int;
+  v_retry_count smallint;
+begin
+  v_base := coalesce(
+    p_base_interval_minutes,
+    public.platform_constant_int('webhook_base_retry_interval_minutes', 5)
+  );
+
+  update public.payment_webhook_events e
+  set
+    state = 'FAILED',
+    failure_reason = left(p_failure_reason, 4000),
+    retry_count = e.retry_count + 1,
+    next_retry_at = now() + (
+      v_base * power(2, greatest(e.retry_count, 0)) * interval '1 minute'
+    ),
+    updated_at = now()
+  where e.id = p_event_id
+  returning e.retry_count into v_retry_count;
+
+  if not found then
+    raise exception 'WEBHOOK_EVENT_NOT_FOUND' using errcode = 'P0001';
+  end if;
+
+  return jsonb_build_object(
+    'event_id', p_event_id,
+    'retry_count', v_retry_count,
+    'outcome', case when v_retry_count >= 3 then 'dead_letter_pending' else 'failed' end
+  );
+end;
+$$;
+
+create or replace function public.webhook_retry_mark_failed_rpc(
+  p_event_id text,
+  p_failure_reason text,
+  p_base_interval_minutes int default null,
+  p_queue_id uuid default null
+)
+returns jsonb
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_base int;
+  v_retry_count smallint;
+  v_event public.payment_webhook_events%rowtype;
+  v_schedule_id text;
+begin
+  v_base := coalesce(
+    p_base_interval_minutes,
+    public.platform_constant_int('webhook_base_retry_interval_minutes', 5)
+  );
+
+  select e.*
+  into v_event
+  from public.payment_webhook_events e
+  where e.id = p_event_id
+  for update;
+
+  if not found then
+    raise exception 'WEBHOOK_EVENT_NOT_FOUND' using errcode = 'P0001';
+  end if;
+
+  v_retry_count := v_event.retry_count + 1;
+
+  if v_retry_count >= 3 then
+    update public.payment_webhook_events e
+    set
+      state = 'DEAD_LETTER',
+      failure_reason = left(p_failure_reason, 4000),
+      retry_count = v_retry_count,
+      next_retry_at = null,
+      updated_at = now()
+    where e.id = p_event_id;
+
+    if p_queue_id is not null then
+      update public.payment_webhook_processing_queue q
+      set state = 'FAILED'
+      where q.id = p_queue_id;
+    end if;
+
+    select ps.id
+    into v_schedule_id
+    from public.payment_schedules ps
+    where ps.contracted_service_id::text = coalesce(
+      v_event.raw_payload #>> '{transaction,referenceCode}',
+      v_event.raw_payload #>> '{referenceCode}',
+      v_event.raw_payload #>> '{charge,referenceCode}'
+    )
+    limit 1;
+
+    return jsonb_build_object(
+      'outcome', 'dead_letter',
+      'event_id', p_event_id,
+      'event_type', v_event.event_type,
+      'gateway_event_id', v_event.gateway_event_id,
+      'retry_count', v_retry_count,
+      'failure_reason', left(p_failure_reason, 4000),
+      'schedule_id', v_schedule_id
+    );
+  end if;
+
+  update public.payment_webhook_events e
+  set
+    state = 'FAILED',
+    failure_reason = left(p_failure_reason, 4000),
+    retry_count = v_retry_count,
+    next_retry_at = now() + (
+      v_base * power(2, greatest(v_retry_count - 1, 0)) * interval '1 minute'
+    ),
+    updated_at = now()
+  where e.id = p_event_id;
+
+  if p_queue_id is not null then
+    update public.payment_webhook_processing_queue q
+    set state = 'FAILED'
+    where q.id = p_queue_id;
+  end if;
+
+  return jsonb_build_object(
+    'outcome', 'failed',
+    'event_id', p_event_id,
+    'event_type', v_event.event_type,
+    'gateway_event_id', v_event.gateway_event_id,
+    'retry_count', v_retry_count,
+    'failure_reason', left(p_failure_reason, 4000),
+    'next_retry_at', (
+      select e.next_retry_at
+      from public.payment_webhook_events e
+      where e.id = p_event_id
+    )
+  );
+end;
+$$;
