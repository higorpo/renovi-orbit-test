+import type { WebhookHandler } from "./types.ts";
+
+export function getWebhookHandler(eventType: string): WebhookHandler | null {
+  if (eventType === "WEBHOOK_PING") {
+    return async () => "processed";
+  }
+
+  if (
+    eventType === "TRANSACTION_CAPTURE" ||
+    eventType === "TRANSACTION_UPDATE" ||
+    eventType === "TRANSACTION_REFUND" ||
+    eventType === "CHARGE_VOID" ||
+    eventType === "TRANSACTION_VOID" ||
+    eventType === "TRANSACTION_DISPUTE" ||
+    eventType === "TRANSACTION_EXPIRED" ||
+    eventType.startsWith("PAYMENT_PROFILE_")
+  ) {
+    return async () => "queued";
+  }
+
+  return null;
+}
