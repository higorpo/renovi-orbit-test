--- /dev/null
+++ b/supabase/functions/process-webhook-retry/processEvent.ts
@@ -0,0 +1,67 @@
+import { dispatchWebhookEvent } from "../netcred-webhook/dispatchWebhookEvent.ts";
+import type { WebhookDispatchDeps } from "../netcred-webhook/createWebhookHandlerDeps.ts";
+import type { WebhookHandlerContext } from "../netcred-webhook/types.ts";
+import type {
+  WebhookRetryClaimRow,
+  WebhookRetryFailResult,
+} from "./types.ts";
+
+export type ProcessWebhookEventDeps = {
+  dispatch: typeof dispatchWebhookEvent;
+  markProcessed: (input: {
+    eventId: string;
+    queueId?: string;
+  }) => Promise<void>;
+  markFailed: (input: {
+    eventId: string;
+    queueId?: string;
+    failureReason: string;
+  }) => Promise<WebhookRetryFailResult>;
+  emitDeadLetterCritical: (input: WebhookRetryFailResult) => void;
+};
+
+function toHandlerContext(row: WebhookRetryClaimRow): WebhookHandlerContext {
+  return {
+    eventId: row.event_id,
+    eventType: row.event_type,
+    payload: row.raw_payload,
+  };
+}
+
+export async function processWebhookEvent(
+  deps: ProcessWebhookEventDeps,
+  handlerDeps: WebhookDispatchDeps,
+  row: WebhookRetryClaimRow,
+): Promise<"processed" | "failed" | "dead_letter" | "skipped"> {
+  try {
+    const outcome = await deps.dispatch(handlerDeps, toHandlerContext(row));
+
+    if (outcome === "skipped") {
+      await deps.markProcessed({
+        eventId: row.event_id,
+        queueId: row.queue_id,
+      });
+      return "skipped";
+    }
+
+    await deps.markProcessed({
+      eventId: row.event_id,
+      queueId: row.queue_id,
+    });
+    return "processed";
+  } catch (error) {
+    const failureReason = error instanceof Error ? error.message : String(error);
+    const failResult = await deps.markFailed({
+      eventId: row.event_id,
+      queueId: row.queue_id,
+      failureReason,
+    });
+
+    if (failResult.outcome === "dead_letter") {
+      deps.emitDeadLetterCritical(failResult);
+      return "dead_letter";
+    }
+
+    return "failed";
+  }
+}
diff --git a/supabase/functions/process-webhook-retry/types.ts b/supabase/functions/process-webhook-retry/types.ts
