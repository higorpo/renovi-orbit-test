+import "xhr";
+import { servePaymentFunction } from "../_shared/observability/sentry.ts";
+import {
+  createPaymentLogger,
+  PAYMENT_LOG_EVENTS,
+} from "../_shared/observability/payment-logger.ts";
+import { createServiceRoleClient } from "../_shared/serviceRoleClient.ts";
+import {
+  handleRecoverPaymentLeasesRequest,
+  type RecoverPaymentLeasesDeps,
+} from "./handleRequest.ts";
+import type { RecoverySummary } from "./types.ts";
+
+const logger = createPaymentLogger("recover-payment-leases");
+
+function parseRecoverySummary(data: unknown): RecoverySummary {
+  const row = Array.isArray(data) ? data[0] : data;
+
+  if (!row || typeof row !== "object") {
+    return {
+      recovered_count: 0,
+      recovered_to_scheduled: 0,
+      recovered_to_failed: 0,
+    };
+  }
+
+  const summary = row as Record<string, unknown>;
+
+  return {
+    recovered_count: Number(summary.recovered_count ?? 0),
+    recovered_to_scheduled: Number(summary.recovered_to_scheduled ?? 0),
+    recovered_to_failed: Number(summary.recovered_to_failed ?? 0),
+  };
+}
+
+function createDeps(): RecoverPaymentLeasesDeps {
+  const supabase = createServiceRoleClient();
+
+  return {
+    recoverOrphanedSchedules: async () => {
+      const { data, error } = await supabase.rpc("recover_orphaned_payment_schedules");
+
+      if (error) {
+        throw new Error(error.message);
+      }
+
+      return parseRecoverySummary(data);
+    },
+    emitRecoveryInfo: (summary) => {
+      for (let index = 0; index < summary.recovered_to_scheduled; index += 1) {
+        logger.info(PAYMENT_LOG_EVENTS.ORPHAN_RECOVERED, {
+          recovery_index: index + 1,
+          target_state: "SCHEDULED",
+          gateway_slug: "netcred",
+        });
+      }
+
+      for (let index = 0; index < summary.recovered_to_failed; index += 1) {
+        logger.info(PAYMENT_LOG_EVENTS.ORPHAN_RECOVERED, {
+          recovery_index: index + 1,
+          target_state: "FAILED",
+          gateway_slug: "netcred",
+        });
+      }
+    },
+  };
+}
+
+servePaymentFunction("recover-payment-leases", (req) =>
+  handleRecoverPaymentLeasesRequest(req, createDeps()));
