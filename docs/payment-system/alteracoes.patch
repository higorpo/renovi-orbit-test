+-- Payment System Phase 1–2 rollback (task 81).
+-- MANUAL maintenance script — NOT run by Supabase migrations.
+-- Destructive: drops payment tables and Phase 2 columns. Backup first.
+
+begin;
+
+-- Phase 2: RLS policies
+drop policy if exists audit_log_client_or_provider_select on public.payment_audit_log;
+drop policy if exists payment_schedules_client_or_provider_select on public.payment_schedules;
+drop policy if exists provider_accounts_owner_select on public.provider_accounts;
+
+-- Phase 2: triggers
+drop trigger if exists trig_validate_payment_schedule_state on public.payment_schedules;
+drop function if exists public.validate_payment_schedule_transition();
+
+-- Phase 2: tables (dependency order)
+drop table if exists public.payment_webhook_processing_queue cascade;
+drop table if exists public.payment_events cascade;
+drop table if exists public.payment_audit_log cascade;
+drop table if exists public.payment_webhook_events cascade;
+drop table if exists public.payment_attempts cascade;
+drop table if exists public.payment_schedules cascade;
+
+-- Phase 2: contracted_services payment columns
+alter table if exists public.contracted_services
+  drop constraint if exists contracted_services_completed_by_check;
+
+alter table if exists public.contracted_services
+  drop column if exists service_scheduled_at,
+  drop column if exists cancellation_reason,
+  drop column if exists executed_at,
+  drop column if exists completed_at,
+  drop column if exists completed_by;
+
+drop index if exists public.idx_contracted_services_scheduled_at;
+
+-- Phase 1: tables
+drop table if exists public.provider_kyc_submissions cascade;
+drop table if exists public.provider_accounts cascade;
+drop table if exists public.payment_tokens cascade;
+drop table if exists public.payment_gateway_tokens cascade;
+
+-- Phase 1: payment provider seed (table may pre-exist for other features)
+delete from public.payment_providers where slug = 'netcred';
+
+-- Phase 1: payment platform constant keys (table shared — keys only)
+delete from public.platform_constants
+where key in (
+  'cc_visa_master_1x_rate',
+  'cc_visa_master_2_6x_rate',
+  'cc_visa_master_7_12x_rate',
+  'cc_elo_other_1x_rate',
+  'cc_elo_other_2_6x_rate',
+  'cc_elo_other_7_12x_rate',
+  'cc_fixed_processing_fee_brl',
+  'max_charge_attempts',
+  'charge_retry_interval_minutes',
+  'payment_lease_duration_minutes',
+  'provider_onboarding_batch_size',
+  'auto_cancel_hours_before_service',
+  'scheduled_charge_hours_before_service',
+  'installment_hmac_expires_minutes',
+  'reconciliation_poll_interval_minutes',
+  'webhook_base_retry_interval_minutes',
+  'payment_system_rollout_percentage',
+  'charge_cron_dry_run'
+);
+
+commit;
+
+-- Phase 1 extensions (pg_cron, pg_net) intentionally retained.
diff --git a/supabase/tests/payment/accept_proposal_rpc_test.sql b/supabase/tests/payment/accept_proposal_rpc_test.sql
