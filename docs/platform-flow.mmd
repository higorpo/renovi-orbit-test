%% PROPOSAL STATES LEGEND
%% =====================================================

subgraph PROPOSAL_STATES ["PROPOSAL STATES"]
PS1["PENDING"]
PS2["ACCEPTED"]
PS3["REJECTED"]
PS4["EXPIRED"]
PS5["REVISION_REQUESTED"]
PS6["REVISED"]
PS7["REJECTED_AUTOMATICALLY"]
end

%% =====================================================
%% SERVICE REQUEST STATES LEGEND
%% =====================================================

subgraph REQUEST_STATES ["SERVICE REQUEST STATES"]
RS1["OPEN"]
RS2["IN_NEGOTIATION"]
RS3["SCHEDULED"]
RS4["COMPLETED"]
RS5["CANCELLED"]
end