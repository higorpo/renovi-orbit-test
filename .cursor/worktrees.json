{
  "setup-worktree-unix": [
    "export NVM_DIR=\"${NVM_DIR:-$HOME/.nvm}\"; if [ -s \"$NVM_DIR/nvm.sh\" ]; then . \"$NVM_DIR/nvm.sh\" && nvm use; fi; yarn install",
    "[ -n \"$ROOT_WORKTREE_PATH\" ] && [ -f \"$ROOT_WORKTREE_PATH/.env\" ] && cp \"$ROOT_WORKTREE_PATH/.env\" .env || true",
    "[ -n \"$ROOT_WORKTREE_PATH\" ] && [ -f \"$ROOT_WORKTREE_PATH/.env.local\" ] && cp \"$ROOT_WORKTREE_PATH/.env.local\" .env.local || true"
  ],
  "setup-worktree-windows": [
    "yarn install",
    "if exist \"%ROOT_WORKTREE_PATH%\\.env\" copy /Y \"%ROOT_WORKTREE_PATH%\\.env\" .env",
    "if exist \"%ROOT_WORKTREE_PATH%\\.env.local\" copy /Y \"%ROOT_WORKTREE_PATH%\\.env.local\" .env.local"
  ],
  "setup-worktree": [
    "yarn install"
  ]
}
