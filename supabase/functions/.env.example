# Copy to .env and fill. Loaded automatically on `supabase start`.
# Required for generate-smart-description edge function.
OPENAI_API_KEY=
GEMINI_API_KEY=

# CORS: comma-separated origins allowed to call Edge Functions (e.g. create-request-quote-order, generate-smart-description).
# Set in Supabase Dashboard > Edge Functions > Secrets for production.
# Example: https://app.example.com,http://localhost:5173
ALLOWED_ORIGINS=

# Google reCAPTCHA v3 secret key (server-side validation in Edge Functions)
# Example format: 6LcXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
RECAPTCHA_SECRET_KEY=

# --- Internal pg_net → Edge Functions (docs/internal-edge-functions-auth.md) ---
# MUST match ORBIT_CRON_SECRET in repo root .env (Postgres vault) on the same environment.
ORBIT_CRON_SECRET=local-dev-orbit-cron-secret-min-32-chars

# --- MMD (Multichannel Message Dispatcher) — design §11.6 ---
# See docs/message-dispatcher/docs/edge-secrets.md

# Resend API key (MMD worker + local auth SMTP in config.toml)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Orbit

# Resend webhook Svix signing secret (message-dispatcher-webhook-resend)
RESEND_WEBHOOK_SECRET=

# FCM service account JSON as a single line (message-dispatcher-worker)
FCM_SERVICE_ACCOUNT=

# Sentry DSN for Edge Functions (optional; design §10.3, task 81).
SENTRY_DSN=

# --- Payment / NetCred (docs/payment-system/vault-secrets-runbook.md) ---
# Secrets: set in this file for local Edge runtime only — never commit real values.
# Production: Supabase Dashboard → Edge Functions → Secrets.
NETCRED_USERNAME=
NETCRED_PASSWORD=
NETCRED_WEBHOOK_SECRET=
NETCRED_API_BASE_URL=https://api.sandbox.netcredbrasil.com.br
NETCRED_PLATFORM_BANK_ACCOUNT_ID=
NETCRED_PLATFORM_COMPANY_ID=

# --- Local dev: route MMD emails to Inbucket (Mailpit) ---
# When INBUCKET_SMTP_HOST is set, the worker sends emails via SMTP to the local
# Inbucket server (http://127.0.0.1:54324) instead of the Resend API.
# Leave empty or remove in production to use Resend.
INBUCKET_SMTP_HOST=host.docker.internal
INBUCKET_SMTP_PORT=54325
