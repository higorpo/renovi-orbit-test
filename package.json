{
  "name": "my-vue-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "portless run --name orbit vite",
    "dev:vite": "vite",
    "build": "tsc -b && vite build",
    "preview": "portless run --name orbit vite preview",
    "preview:vite": "vite preview",
    "lint": "eslint src --cache --cache-location node_modules/.cache/eslint",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "generate-supabase-types": "node scripts/generate-supabase-types.mjs",
    "db:migrate": "npx supabase db push",
    "db:reset": "npx supabase db reset",
    "seed:load-test-images": "node supabase/scripts/seed-load-test-images.mjs",
    "seed:load-test-images-real": "node supabase/scripts/seed-load-test-images.mjs --picsum",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:mobile-safari": "playwright test --project=mobile-safari --workers=1",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=html",
    "test:watch": "vitest --watch",
    "prerelease": "node scripts/prerelease.mjs",
    "cap:sync": "npx cap sync",
    "android": "npm run build && npx cap sync android && npx cap open android",
    "ios": "npm run build && npx cap sync ios && npx cap open ios",
    "dev:host": "portless run --name orbit --app-port 5854 vite --host --port 5854"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/core": "^8.3.4",
